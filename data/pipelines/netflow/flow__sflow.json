{
  "id": "dm_netflow_flow_sflow",
  "conf": {
    "output": "default",
    "description": "netflow, flow dataset, sflow format: parse sflowtool/hsflowd JSON (no stock sFlow decoder exists on either Cribl or Elastic), scale sampled volume by sampling_rate, expand tcp_flags bitmask, then map to ECS/custom.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "netflow / flow / sflow. sFlow has no template handshake and no stock decoder in Cribl's NetFlow source or the Elastic netflow input, so the wire format here is already sflowtool -J / hsflowd JSON, not the binary datagram. A flow sample is ONE sampled packet, not an aggregated flow, so network.bytes/network.packets below are statistical estimates (packet_size/sampling_rate * sampling_rate), flagged sflow.sampled:true per the map's instruction not to let them be read as measured counters."
        },
        "description": "record the sFlow decode assumption and the estimate-vs-measured distinction"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": { "mode": "extract", "type": "json", "srcField": "_raw" },
        "description": "parse the sflowtool/hsflowd JSON line"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "network.transport",
              "value": "__e['IP_protocol']===6?'tcp':(__e['IP_protocol']===17?'udp':(__e['IP_protocol']===1?'icmp':undefined))"
            },
            {
              "name": "sflow.tcp_flags",
              "value": "__e['tcp_flags']===undefined?undefined:[].concat((__e['tcp_flags']&1)?['FIN']:[],(__e['tcp_flags']&2)?['SYN']:[],(__e['tcp_flags']&4)?['RST']:[],(__e['tcp_flags']&8)?['PSH']:[],(__e['tcp_flags']&16)?['ACK']:[],(__e['tcp_flags']&32)?['URG']:[],(__e['tcp_flags']&64)?['ECE']:[],(__e['tcp_flags']&128)?['CWR']:[])"
            },
            {
              "name": "sflow.tcp_flags_raw",
              "value": "__e['tcp_flags']"
            },
            {
              "name": "observer.ingress.interface.id",
              "value": "__e['inputPort']!==undefined?String(__e['inputPort']):undefined"
            },
            {
              "name": "observer.egress.interface.id",
              "value": "__e['outputPort']!==undefined?String(__e['outputPort']):undefined"
            },
            {
              "name": "network.bytes",
              "value": "(__e['packet_size']!==undefined&&__e['sampling_rate']!==undefined)?__e['packet_size']*__e['sampling_rate']:undefined"
            },
            {
              "name": "network.packets",
              "value": "__e['sampling_rate']"
            },
            {
              "name": "sflow.sampled",
              "value": "true"
            }
          ]
        },
        "description": "compute derived/estimated fields from the ORIGINAL vendor names, before renaming (rename would nest and break bracket reads)"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            { "currentName": "srcIP", "newName": "source.ip" },
            { "currentName": "dstIP", "newName": "destination.ip" },
            { "currentName": "tcp_src_port", "newName": "source.port" },
            { "currentName": "tcp_dst_port", "newName": "destination.port" },
            { "currentName": "IP_protocol", "newName": "network.iana_number" },
            { "currentName": "sampling_rate", "newName": "sflow.sampling_rate" },
            { "currentName": "packet_size", "newName": "sflow.sampled_packet_size" },
            { "currentName": "in_vlan", "newName": "network.vlan.id" },
            { "currentName": "out_vlan", "newName": "sflow.out_vlan" },
            { "currentName": "src_as", "newName": "source.as.number" },
            { "currentName": "dst_as", "newName": "destination.as.number" },
            { "currentName": "header", "newName": "sflow.raw_header" },
            { "currentName": "drops", "newName": "sflow.drops" },
            { "currentName": "sample_pool", "newName": "sflow.sample_pool" }
          ]
        },
        "description": "batch-rename every clean vendor key straight to its ECS/custom target"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [{ "name": "event.dataset", "value": "'netflow.flow'" }],
          "remove": ["tcp_flags", "inputPort", "outputPort", "_raw"]
        },
        "description": "tag the dataset and drop the raw copy plus the fields already replaced by computed equivalents"
      }
    ]
  }
}
