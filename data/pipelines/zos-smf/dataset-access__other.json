{
  "id": "dm_zos_smf_dataset_access_other",
  "conf": {
    "output": "default",
    "description": "zos-smf dataset-access, format other: hand-built SMF14/15 + SMF42.6 KVP-delimited parse, branch on SMF14RTY (14/15 open) vs S42DSN (42.6 I/O stats) presence, open-intent/timestamps/indicator-array resolved before rename.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "zos-smf/dataset-access/other. Site formatter output assumed KVP (key=value tokens) using the literal SMF14*/S42* names the field table uses, consistent with this technology's tcpip/other precedent - real column grammar not confirmed against a sample. Two branches, one document type: SMF14/15 open records (keyed on SMF14RTY) and SMF42 subtype 6 I/O-stats records (keyed on S42DSN), landing field-compatible in one data stream. No LPAR-offset lookup exists anywhere in this work order, so Date.parse runs directly against the formatter's date/time strings with no UTC correction - same gap category as tcpip."
        },
        "description": "document format assumption, branch shape, and timestamp-offset gap"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "kvp",
          "srcField": "_raw"
        },
        "description": "extract SMF14*/S42* key=value tokens from the formatter's delimited output"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "event.action",
              "value": "Number(__e['SMF14RTY'])===14?'dataset-open-input':(Number(__e['SMF14RTY'])===15?'dataset-open-output':undefined)"
            },
            {
              "name": "_time",
              "value": "(__e['SMF14DTE']!==undefined && __e['SMF14TME']!==undefined) ? Math.floor(Date.parse(__e['SMF14DTE']+' '+__e['SMF14TME'])/1000) : (__e['SMF42PTS']!==undefined ? Math.floor(Date.parse(__e['SMF42PTS'])/1000) : undefined)"
            },
            {
              "name": "event.start",
              "value": "(__e['SMF14DTE']!==undefined && __e['SMF14OPE']!==undefined) ? Math.floor(Date.parse(__e['SMF14DTE']+' '+__e['SMF14OPE'])/1000) : (__e['SMF42PTS']!==undefined ? Math.floor(Date.parse(__e['SMF42PTS'])/1000) : undefined)"
            },
            {
              "name": "event.end",
              "value": "__e['SMF42PTE']!==undefined ? Math.floor(Date.parse(__e['SMF42PTE'])/1000) : undefined"
            },
            {
              "name": "file.created",
              "value": "__e['SMF14_JFCBCRDT']!==undefined ? Math.floor(Date.parse(__e['SMF14_JFCBCRDT'])/1000) : undefined"
            },
            {
              "name": "zos.smf.dataset_access.expiration_date",
              "value": "__e['SMF14_JFCBXPDT']!==undefined ? Math.floor(Date.parse(__e['SMF14_JFCBXPDT'])/1000) : undefined"
            },
            {
              "name": "zos.smf.dataset_access.dataset_indicators",
              "value": "__e['SMF14RIN']!==undefined ? String(__e['SMF14RIN']).split(',') : undefined"
            },
            {
              "name": "SMF14UCBDV",
              "value": "__e['SMF14UCBDV']!==undefined ? (Array.isArray(__e['SMF14UCBDV']) ? __e['SMF14UCBDV'] : [__e['SMF14UCBDV']]) : undefined"
            }
          ]
        },
        "description": "compute every derived/branched field from ORIGINAL vendor names before rename: open-intent from record type, _time/event.start/event.end date+time combination across both branches, packed-date fields, indicator-bit split to array, and repeating-UCB scalar-to-array normalization so a multi-volume record is never truncated to its first volume"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            { "currentName": "SMF14SID", "newName": "host.name" },
            { "currentName": "SMF14JBN", "newName": "process.name" },
            { "currentName": "SMFJOBID", "newName": "zos.smf.dataset_access.jes_job_id" },
            { "currentName": "SMFPLXID", "newName": "zos.smf.sysplex_name" },
            { "currentName": "SMF14UID", "newName": "zos.smf.dataset_access.user_identification" },
            { "currentName": "SMF14_JFCBDSNM", "newName": "file.path" },
            { "currentName": "SMF14_JFCBELNM", "newName": "file.name" },
            { "currentName": "SMF14DCBOR", "newName": "zos.smf.dataset_access.dataset_organization" },
            { "currentName": "SMF14DCBRF", "newName": "zos.smf.dataset_access.record_format" },
            { "currentName": "SMF14UCBDV", "newName": "zos.smf.dataset_access.device_number" },
            { "currentName": "SMF14EXCP", "newName": "zos.smf.dataset_access.excp_count" },
            { "currentName": "S42DSN", "newName": "file.path" },
            { "currentName": "S42JDJNM", "newName": "process.name" },
            { "currentName": "S42JDUID", "newName": "zos.smf.dataset_access.io_user_identification" },
            { "currentName": "S42DSVOL", "newName": "zos.smf.dataset_access.volume_serial" },
            { "currentName": "SMF42SID", "newName": "host.name" },
            { "currentName": "S42DSION", "newName": "zos.smf.dataset_access.io_count" },
            { "currentName": "S42DSRDT", "newName": "zos.smf.dataset_access.read_count" },
            { "currentName": "S42DSMXR", "newName": "zos.smf.dataset_access.max_response_time" }
          ]
        },
        "description": "batch rename every straightforward mapped/custom field, clean source identifiers, no transform needed - SMF14* and S42* pairs sharing one ECS target (host.name, process.name, file.path) are mutually exclusive per branch"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            { "name": "event.dataset", "value": "'zos_smf.dataset_access'" }
          ],
          "remove": [
            "SMF14RTY",
            "SMF14DTE",
            "SMF14TME",
            "SMF14OPE",
            "SMF14_JFCBCRDT",
            "SMF14_JFCBXPDT",
            "SMF14RIN",
            "SMF42PTS",
            "SMF42PTE",
            "_raw"
          ]
        },
        "description": "event.dataset (no hyphen), and cleanup of the raw packed/branch-discriminator keys fully consumed above plus _raw - user.name deliberately never populated from SMF14UID (see README)"
      }
    ]
  }
}
