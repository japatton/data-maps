{
  "id": "dm_zos_smf_tcpip_other",
  "conf": {
    "output": "default",
    "description": "zos-smf tcpip, format other: hand-built SMF119 KVP-delimited parse, branch on FTP-transfer (subtype 70/3) vs TCP-connection (subtype 2), orientation resolved from SMF119AP_TTStatus before rename.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "zos-smf/tcpip/other. Site formatter output assumed KVP (key=value tokens); real column grammar not given in the work order, verify against a captured sample. Two branches over one common TI header: FT (subtype 70/3 FTP transfer) and AP (subtype 2 TCP connection, Telnet section for TN3270). Orientation for AP resolved from SMF119AP_TTStatus per recommendations.direct.cribl."
        },
        "description": "document format assumption and branch shape"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "kvp",
          "srcField": "_raw"
        },
        "description": "extract SMF119* key=value tokens from the formatter's delimited output"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "event.action",
              "value": "__e['SMF119FT_FSOper']==='Retrieve' ? 'ftp-download' : ((__e['SMF119FT_FSOper']==='Store' || __e['SMF119FT_FSOper']==='Store Unique') ? 'ftp-upload' : (__e['SMF119FT_FSOper']==='Append' ? 'ftp-append' : (__e['SMF119FT_FSOper']==='Delete' ? 'ftp-delete' : (__e['SMF119FT_FSOper']==='Rename' ? 'ftp-rename' : undefined))))"
            },
            {
              "name": "event.start",
              "value": "(__e['SMF119FT_FSSDate'] && __e['SMF119FT_FSSTime']) ? Math.floor(Date.parse(__e['SMF119FT_FSSDate']+' '+__e['SMF119FT_FSSTime'])/1000) : ((__e['SMF119AP_TTSDate'] && __e['SMF119AP_TTSTime']) ? Math.floor(Date.parse(__e['SMF119AP_TTSDate']+' '+__e['SMF119AP_TTSTime'])/1000) : undefined)"
            },
            {
              "name": "event.end",
              "value": "(__e['SMF119FT_FSEDate'] && __e['SMF119FT_FSETime']) ? Math.floor(Date.parse(__e['SMF119FT_FSEDate']+' '+__e['SMF119FT_FSETime'])/1000) : ((__e['SMF119AP_TTEDate'] && __e['SMF119AP_TTETime']) ? Math.floor(Date.parse(__e['SMF119AP_TTEDate']+' '+__e['SMF119AP_TTETime'])/1000) : undefined)"
            },
            {
              "name": "_time",
              "value": "(__e['SMF119FT_FSEDate'] && __e['SMF119FT_FSETime']) ? Math.floor(Date.parse(__e['SMF119FT_FSEDate']+' '+__e['SMF119FT_FSETime'])/1000) : ((__e['SMF119AP_TTEDate'] && __e['SMF119AP_TTETime']) ? Math.floor(Date.parse(__e['SMF119AP_TTEDate']+' '+__e['SMF119AP_TTETime'])/1000) : undefined)"
            },
            {
              "name": "event.duration",
              "value": "__e['SMF119FT_FSDur'] !== undefined ? __e['SMF119FT_FSDur']*10000000 : undefined"
            },
            {
              "name": "event.outcome",
              "value": "__e['SMF119FT_FSLReply'] !== undefined ? (__e['SMF119FT_FSLReply']>=200 && __e['SMF119FT_FSLReply']<300 ? 'success' : (__e['SMF119FT_FSLReply']>=400 && __e['SMF119FT_FSLReply']<600 ? 'failure' : 'unknown')) : undefined"
            },
            {
              "name": "zos.smf.tcpip.ftp_reply_code",
              "value": "__e['SMF119FT_FSLReply']"
            },
            {
              "name": "file.path",
              "value": "__e['SMF119FT_FSFileName1'] !== undefined ? (String(__e['SMF119FT_FSFileName1']).length>1024 ? String(__e['SMF119FT_FSFileName1']).substring(0,1024) : __e['SMF119FT_FSFileName1']) : undefined"
            },
            {
              "name": "source.ip",
              "value": "__e['SMF119FT_FSDRIP'] !== undefined ? __e['SMF119FT_FSDRIP'] : (__e['SMF119AP_TTStatus'] !== undefined ? (String(__e['SMF119AP_TTStatus']).toLowerCase().indexOf('pass')===0 ? __e['SMF119AP_TTRIP'] : __e['SMF119AP_TTLIP']) : undefined)"
            },
            {
              "name": "destination.ip",
              "value": "__e['SMF119FT_FSDLIP'] !== undefined ? __e['SMF119FT_FSDLIP'] : (__e['SMF119AP_TTStatus'] !== undefined ? (String(__e['SMF119AP_TTStatus']).toLowerCase().indexOf('pass')===0 ? __e['SMF119AP_TTLIP'] : __e['SMF119AP_TTRIP']) : undefined)"
            },
            {
              "name": "source.port",
              "value": "__e['SMF119FT_FSDRPort'] !== undefined ? __e['SMF119FT_FSDRPort'] : (__e['SMF119AP_TTStatus'] !== undefined ? (String(__e['SMF119AP_TTStatus']).toLowerCase().indexOf('pass')===0 ? __e['SMF119AP_TTRPort'] : __e['SMF119AP_TTLPort']) : undefined)"
            },
            {
              "name": "destination.port",
              "value": "__e['SMF119FT_FSDLPort'] !== undefined ? __e['SMF119FT_FSDLPort'] : (__e['SMF119AP_TTStatus'] !== undefined ? (String(__e['SMF119AP_TTStatus']).toLowerCase().indexOf('pass')===0 ? __e['SMF119AP_TTLPort'] : __e['SMF119AP_TTRPort']) : undefined)"
            },
            {
              "name": "source.bytes",
              "value": "__e['SMF119AP_TTStatus'] !== undefined ? (String(__e['SMF119AP_TTStatus']).toLowerCase().indexOf('pass')===0 ? __e['SMF119AP_TTInBytes'] : __e['SMF119AP_TTOutBytes']) : undefined"
            },
            {
              "name": "destination.bytes",
              "value": "__e['SMF119AP_TTStatus'] !== undefined ? (String(__e['SMF119AP_TTStatus']).toLowerCase().indexOf('pass')===0 ? __e['SMF119AP_TTOutBytes'] : __e['SMF119AP_TTInBytes']) : undefined"
            },
            {
              "name": "event.reason",
              "value": "__e['SMF119AP_TTTermCode'] !== undefined ? String(__e['SMF119AP_TTTermCode']) : undefined"
            },
            {
              "name": "network.transport",
              "value": "'tcp'"
            },
            {
              "name": "event.dataset",
              "value": "'zos_smf.tcpip'"
            }
          ],
          "remove": [
            "SMF119FT_FSOper",
            "SMF119FT_FSSDate",
            "SMF119FT_FSSTime",
            "SMF119FT_FSEDate",
            "SMF119FT_FSETime",
            "SMF119FT_FSDur",
            "SMF119FT_FSLReply",
            "SMF119FT_FSDRIP",
            "SMF119FT_FSDLIP",
            "SMF119FT_FSDRPort",
            "SMF119FT_FSDLPort",
            "SMF119FT_FSFileName1",
            "SMF119AP_TTRIP",
            "SMF119AP_TTLIP",
            "SMF119AP_TTRPort",
            "SMF119AP_TTLPort",
            "SMF119AP_TTInBytes",
            "SMF119AP_TTOutBytes",
            "SMF119AP_TTSDate",
            "SMF119AP_TTSTime",
            "SMF119AP_TTEDate",
            "SMF119AP_TTETime",
            "SMF119AP_TTTermCode",
            "_raw"
          ]
        },
        "description": "compute every derived/branched field from ORIGINAL vendor names before rename: verb mapping, start/end/_time, duration->ns, outcome from reply code, orientation-resolved addresses/ports/bytes, file.path cap, transport/dataset constants; then drop consumed raw keys and _raw"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "SMF119TI_SYSName",
              "newName": "host.name"
            },
            {
              "currentName": "SMF119TI_SysplexName",
              "newName": "zos.smf.sysplex_name"
            },
            {
              "currentName": "SMF119TI_Stack",
              "newName": "zos.smf.tcpip.stack_name"
            },
            {
              "currentName": "SMF119TI_Comp",
              "newName": "zos.smf.tcpip.component"
            },
            {
              "currentName": "SMF119TI_ASName",
              "newName": "process.name"
            },
            {
              "currentName": "SMF119TI_ASID",
              "newName": "process.pid"
            },
            {
              "currentName": "SMF119TI_UserID",
              "newName": "zos.smf.tcpip.record_writer_userid"
            },
            {
              "currentName": "SMF119FT_FSCmd",
              "newName": "zos.smf.tcpip.ftp_command"
            },
            {
              "currentName": "SMF119FT_FSSUser",
              "newName": "user.name"
            },
            {
              "currentName": "SMF119FT_FSFileName2",
              "newName": "zos.smf.tcpip.ftp_target_name"
            },
            {
              "currentName": "SMF119FT_FSM1",
              "newName": "file.name"
            },
            {
              "currentName": "SMF119FT_FSDsType",
              "newName": "zos.smf.tcpip.ftp_dataset_type"
            },
            {
              "currentName": "SMF119FT_FSCRIP",
              "newName": "client.ip"
            },
            {
              "currentName": "SMF119FT_FSCRPort",
              "newName": "client.port"
            },
            {
              "currentName": "SMF119FT_FSBytes",
              "newName": "network.bytes"
            },
            {
              "currentName": "SMF119FT_FSMechanism",
              "newName": "zos.smf.tcpip.ftp_protection_mechanism"
            },
            {
              "currentName": "SMF119FT_FSLoginMech",
              "newName": "zos.smf.tcpip.ftp_login_mechanism"
            },
            {
              "currentName": "SMF119AP_TTRName",
              "newName": "zos.smf.tcpip.connection_owner_asname"
            },
            {
              "currentName": "SMF119AP_TTStatus",
              "newName": "zos.smf.tcpip.socket_role"
            },
            {
              "currentName": "SMF119AP_TTConnID",
              "newName": "zos.smf.tcpip.connection_id"
            },
            {
              "currentName": "SMF119AP_TTTelLUName",
              "newName": "zos.smf.tcpip.telnet_lu_name"
            },
            {
              "currentName": "SMF119AP_TTTelAppl",
              "newName": "zos.smf.tcpip.telnet_application"
            },
            {
              "currentName": "SMF119AP_TTTelLogmode",
              "newName": "zos.smf.tcpip.telnet_logmode"
            },
            {
              "currentName": "SMF119AP_TTTelTermCode",
              "newName": "zos.smf.tcpip.telnet_termination_code"
            }
          ]
        },
        "description": "batch rename every straightforward mapped/custom field (clean source identifiers, no transform needed)"
      }
    ]
  }
}