{
  "id": "dm_zos_smf_dataset_access_syslog_cef",
  "conf": {
    "output": "default",
    "description": "zos-smf dataset-access, format syslog-cef: BMC AMI Defender CEF envelope over the same SMF14/15 + SMF42.6 field set as the other/dump-path pipeline (CEF extension keys are the SMF14*/S42* names per the agent's FIELDS parameter). cef function NOT used (serializer only) -- header split with regex_extract, extension with serde kvp.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "zos-smf/dataset-access/syslog-cef. BMC AMI Defender CEF:0 envelope. Extension keys are the same SMF14*/S42* names tabled on the other/dump-path pipeline (agent FIELDS parameter), so this pipeline reuses that exact ECS mapping and branch shape (SMF14RTY open records vs S42DSN I/O-stats records). CEF header (vendor/product/version/sig id/name/severity) is captured to zos.smf.dataset_access.cef_* but not otherwise interpreted -- BMC's per-record-type header values could not be retrieved for this work order. The agent resolves JFCB/UCB/step-info sections into named keys and transcodes EBCDIC before framing, so the section-walking problem the dump path has does not apply here."
        },
        "description": "document CEF envelope, field-set reuse, and section-walking non-issue"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/CEF:0\\|(?<cef_vendor>[^|]*)\\|(?<cef_product>[^|]*)\\|(?<cef_version>[^|]*)\\|(?<cef_sigid>[^|]*)\\|(?<cef_name>[^|]*)\\|(?<cef_severity>[^|]*)\\|(?<cef_extension>.*)$/",
          "source": "_raw"
        },
        "description": "split the CEF:0 pipe-delimited header from the extension blob"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "kvp",
          "srcField": "cef_extension"
        },
        "description": "extract SMF14*/S42* key=value pairs from the CEF extension"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'event.action'",
              "value": "Number(__e['SMF14RTY'])===14?'dataset-open-input':(Number(__e['SMF14RTY'])===15?'dataset-open-output':undefined)"
            },
            {
              "name": "__dm_time",
              "value": "(__e['SMF14DTE']!==undefined && __e['SMF14TME']!==undefined) ? Math.floor(Date.parse(__e['SMF14DTE']+' '+__e['SMF14TME'])/1000) : (__e['SMF42PTS']!==undefined ? Math.floor(Date.parse(__e['SMF42PTS'])/1000) : undefined)"
            },
            {
              "name": "_time",
              "value": "__e['__dm_time'] !== undefined && __e['__dm_time'] !== null && __e['__dm_time'] === __e['__dm_time'] ? __e['__dm_time'] : __e['_time']"
            },
            {
              "name": "'event.start'",
              "value": "(__e['SMF14DTE']!==undefined && __e['SMF14OPE']!==undefined) ? Math.floor(Date.parse(__e['SMF14DTE']+' '+__e['SMF14OPE'])/1000) : (__e['SMF42PTS']!==undefined ? Math.floor(Date.parse(__e['SMF42PTS'])/1000) : undefined)"
            },
            {
              "name": "'event.end'",
              "value": "__e['SMF42PTE']!==undefined ? Math.floor(Date.parse(__e['SMF42PTE'])/1000) : undefined"
            },
            {
              "name": "'file.created'",
              "value": "__e['SMF14_JFCBCRDT']!==undefined ? Math.floor(Date.parse(__e['SMF14_JFCBCRDT'])/1000) : undefined"
            },
            {
              "name": "'zos.smf.dataset_access.expiration_date'",
              "value": "__e['SMF14_JFCBXPDT']!==undefined ? Math.floor(Date.parse(__e['SMF14_JFCBXPDT'])/1000) : undefined"
            },
            {
              "name": "'zos.smf.dataset_access.dataset_indicators'",
              "value": "__e['SMF14RIN']!==undefined ? String(__e['SMF14RIN']).split(',') : undefined"
            },
            {
              "name": "SMF14UCBDV",
              "value": "__e['SMF14UCBDV']!==undefined ? (Array.isArray(__e['SMF14UCBDV']) ? __e['SMF14UCBDV'] : [__e['SMF14UCBDV']]) : undefined"
            }
          ]
        },
        "description": "identical derived-field computation to the other/dump-path pipeline, applied to the CEF-extension-extracted keys: open-intent from record type, _time/event.start/event.end date+time combination across both branches, packed-date fields, indicator-bit split to array, repeating-UCB scalar-to-array normalization - all before rename"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "SMF14SID",
              "newName": "'host.name'"
            },
            {
              "currentName": "SMF14JBN",
              "newName": "'process.name'"
            },
            {
              "currentName": "SMFJOBID",
              "newName": "'zos.smf.dataset_access.jes_job_id'"
            },
            {
              "currentName": "SMFPLXID",
              "newName": "'zos.smf.sysplex_name'"
            },
            {
              "currentName": "SMF14UID",
              "newName": "'zos.smf.dataset_access.user_identification'"
            },
            {
              "currentName": "SMF14_JFCBDSNM",
              "newName": "'file.path'"
            },
            {
              "currentName": "SMF14_JFCBELNM",
              "newName": "'file.name'"
            },
            {
              "currentName": "SMF14DCBOR",
              "newName": "'zos.smf.dataset_access.dataset_organization'"
            },
            {
              "currentName": "SMF14DCBRF",
              "newName": "'zos.smf.dataset_access.record_format'"
            },
            {
              "currentName": "SMF14UCBDV",
              "newName": "'zos.smf.dataset_access.device_number'"
            },
            {
              "currentName": "SMF14EXCP",
              "newName": "'zos.smf.dataset_access.excp_count'"
            },
            {
              "currentName": "S42DSN",
              "newName": "'file.path'"
            },
            {
              "currentName": "S42JDJNM",
              "newName": "'process.name'"
            },
            {
              "currentName": "S42JDUID",
              "newName": "'zos.smf.dataset_access.io_user_identification'"
            },
            {
              "currentName": "S42DSVOL",
              "newName": "'zos.smf.dataset_access.volume_serial'"
            },
            {
              "currentName": "SMF42SID",
              "newName": "'host.name'"
            },
            {
              "currentName": "S42DSION",
              "newName": "'zos.smf.dataset_access.io_count'"
            },
            {
              "currentName": "S42DSRDT",
              "newName": "'zos.smf.dataset_access.read_count'"
            },
            {
              "currentName": "S42DSMXR",
              "newName": "'zos.smf.dataset_access.max_response_time'"
            },
            {
              "currentName": "cef_vendor",
              "newName": "'zos.smf.dataset_access.cef_vendor'"
            },
            {
              "currentName": "cef_product",
              "newName": "'zos.smf.dataset_access.cef_product'"
            },
            {
              "currentName": "cef_version",
              "newName": "'zos.smf.dataset_access.cef_version'"
            },
            {
              "currentName": "cef_sigid",
              "newName": "'zos.smf.dataset_access.cef_signature_id'"
            },
            {
              "currentName": "cef_name",
              "newName": "'zos.smf.dataset_access.cef_name'"
            },
            {
              "currentName": "cef_severity",
              "newName": "'zos.smf.dataset_access.cef_severity'"
            }
          ]
        },
        "description": "batch rename every straightforward mapped/custom SMF field plus the captured CEF header context - SMF14*/S42* pairs sharing one ECS target (host.name, process.name, file.path) are mutually exclusive per branch, same as the dump-path pipeline"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'event.dataset'",
              "value": "'zos_smf.dataset_access'"
            }
          ],
          "remove": [
            "SMF14RTY",
            "SMF14DTE",
            "SMF14TME",
            "SMF14OPE",
            "SMF14_JFCBCRDT",
            "SMF14_JFCBXPDT",
            "SMF14RIN",
            "SMF42PTS",
            "SMF42PTE",
            "_raw",
            "cef_extension"
          ]
        },
        "description": "event.dataset (no hyphen, shared with the dump-path pipeline's data stream), cleanup of raw packed/branch-discriminator keys plus _raw and the extension scratch field - user.name deliberately never populated from SMF14UID (see README)"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
