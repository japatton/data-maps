{
  "id": "dm_zos_smf_job_accounting_syslog_cef",
  "conf": {
    "output": "default",
    "description": "zos-smf job-accounting, syslog-cef: BMC AMI Defender CEF envelope over the same SMF30 field set as the other/dump-path pipeline. cef function NOT used (serializer only) -- header split with regex_extract, extension with serde kvp.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "zos-smf/job-accounting/syslog-cef. BMC AMI Defender CEF:0 envelope; extension keys are the same SMF30* names the other/dump-path pipeline tables (agent FIELDS parameter), so this pipeline reuses that exact ECS mapping and the same subtype dead-letter-by-drop, date+time and termination-flag logic. CEF header (vendor/product/version/sig id/name/severity) is captured to zos.smf.job_accounting.cef_* but not otherwise interpreted -- BMC's per-subtype header values could not be retrieved for this work order (README gap). Same naive-local-time gap as the dump path: no LPAR-UTC-offset table exists here, and the agent's event time is documented as naive local. Same SMF30SCC abend-flag and process.command_line gaps as the other format."
        },
        "description": "document format assumption and gaps"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/^CEF:0\\|(?<cef_vendor>[^|]*)\\|(?<cef_product>[^|]*)\\|(?<cef_version>[^|]*)\\|(?<cef_sigid>[^|]*)\\|(?<cef_name>[^|]*)\\|(?<cef_severity>[^|]*)\\|(?<cef_extension>.*)$/",
          "source": "_raw"
        },
        "description": "split the CEF:0 pipe-delimited header from the extension blob"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "kvp",
          "srcField": "cef_extension"
        },
        "description": "extract SMF30* key=value pairs from the CEF extension"
      },
      {
        "id": "drop",
        "filter": "__e['SMF30STP'] !== undefined && ['1','2','3','4','5'].indexOf(String(__e['SMF30STP'])) === -1",
        "conf": {},
        "description": "dead-letter approximation: discard records whose SMF30STP subtype is not one of the five documented values, rather than landing with an empty event.action (no Route-level dead-letter destination is in scope here, so this pipeline drops instead)"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "event.action",
              "value": "__e['SMF30STP'] !== undefined ? (Number(__e['SMF30STP'])===1 ? 'job-start' : (Number(__e['SMF30STP'])===4 ? 'step-end' : (Number(__e['SMF30STP'])===5 ? 'job-end' : ((Number(__e['SMF30STP'])===2 || Number(__e['SMF30STP'])===3) ? 'interval-accounting' : undefined)))) : undefined"
            },
            {
              "name": "_time",
              "value": "(__e['SMF30DTE'] !== undefined && __e['SMF30TME'] !== undefined) ? Math.floor(Date.parse(__e['SMF30DTE']+' '+__e['SMF30TME'])/1000) : undefined"
            },
            {
              "name": "process.exit_code",
              "value": "__e['SMF30SCC'] !== undefined ? Number(__e['SMF30SCC']) : undefined"
            },
            {
              "name": "zos.smf.job_accounting.termination_flags",
              "value": "__e['SMF30STI'] !== undefined ? String(__e['SMF30STI']).split(',') : undefined"
            }
          ]
        },
        "description": "identical derived-field computation to the other/dump-path pipeline: subtype verb, date+time combination, completion code copy, termination-flag array -- all before rename"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "SMF30SID",
              "newName": "host.name"
            },
            {
              "currentName": "SMF30SYN",
              "newName": "host.hostname"
            },
            {
              "currentName": "SMF30SYP",
              "newName": "zos.smf.sysplex_name"
            },
            {
              "currentName": "SMF30JBN",
              "newName": "process.name"
            },
            {
              "currentName": "SMF30PGM",
              "newName": "process.executable"
            },
            {
              "currentName": "SMF30STM",
              "newName": "zos.smf.job_accounting.step_name"
            },
            {
              "currentName": "SMF30STN",
              "newName": "zos.smf.job_accounting.step_number"
            },
            {
              "currentName": "SMF30JNM",
              "newName": "zos.smf.job_accounting.jes_job_id"
            },
            {
              "currentName": "SMF30ASI",
              "newName": "process.pid"
            },
            {
              "currentName": "SMF30RUD",
              "newName": "user.name"
            },
            {
              "currentName": "SMF30GRP",
              "newName": "user.group.name"
            },
            {
              "currentName": "SMF30USR",
              "newName": "user.full_name"
            },
            {
              "currentName": "SMF30TID",
              "newName": "zos.smf.job_accounting.terminal"
            },
            {
              "currentName": "SMF30CL8",
              "newName": "zos.smf.job_accounting.job_class"
            },
            {
              "currentName": "SMF30UIF",
              "newName": "zos.smf.job_accounting.user_identification"
            },
            {
              "currentName": "SMF30PSN",
              "newName": "zos.smf.job_accounting.procedure_name"
            },
            {
              "currentName": "SMF30ARC",
              "newName": "zos.smf.job_accounting.abend_reason_code"
            },
            {
              "currentName": "cef_vendor",
              "newName": "zos.smf.job_accounting.cef_vendor"
            },
            {
              "currentName": "cef_product",
              "newName": "zos.smf.job_accounting.cef_product"
            },
            {
              "currentName": "cef_version",
              "newName": "zos.smf.job_accounting.cef_version"
            },
            {
              "currentName": "cef_sigid",
              "newName": "zos.smf.job_accounting.cef_signature_id"
            },
            {
              "currentName": "cef_name",
              "newName": "zos.smf.job_accounting.cef_name"
            },
            {
              "currentName": "cef_severity",
              "newName": "zos.smf.job_accounting.cef_severity"
            }
          ]
        },
        "description": "batch rename straightforward SMF30 fields plus the captured CEF header context"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "event.dataset",
              "value": "'zos_smf.job_accounting'"
            }
          ],
          "remove": [
            "SMF30STP",
            "SMF30DTE",
            "SMF30TME",
            "SMF30SCC",
            "SMF30STI",
            "_raw",
            "cef_extension"
          ]
        },
        "description": "tag event.dataset (no hyphen) and drop the raw subtype/packed-time/completion/termination keys, _raw, and the extension scratch field"
      }
    ]
  }
}