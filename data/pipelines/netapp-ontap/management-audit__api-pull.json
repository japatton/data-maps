{
  "id": "dm_netapp_ontap_management_audit_api_pull",
  "conf": {
    "output": "default",
    "description": "NetApp ONTAP management audit log, api-pull (REST Collector JSON from GET /api/security/audit/messages): map JSON keys to ECS, mask credential-bearing command text.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "NetApp ONTAP audit.log (management-audit), api-pull. Per recommendations.direct.cribl this runs high-side against the core worker group with no framing/pairing needed - REST already returns one record per command with its terminal state. Watermarking/paging is a Collector schedule concern, not pipeline logic. Choose REST poll OR the syslog stream as the authoritative feed per cluster to avoid double-counting (operational decision, see README)."
        },
        "description": "Pipeline purpose and operational notes"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "Parse the JSON audit-message record"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "_time",
              "value": "Date.parse(__e['timestamp'])/1000"
            },
            {
              "name": "observer.hostname",
              "value": "__e['node'] && __e['node'].name ? __e['node'].name : undefined"
            },
            {
              "name": "observer.name",
              "value": "__e['node'] && __e['node'].name ? __e['node'].name : undefined"
            },
            {
              "name": "event.sequence",
              "value": "__e['index']"
            },
            {
              "name": "netapp.ontap.audit.application",
              "value": "__e['application']"
            },
            {
              "name": "network.protocol",
              "value": "['ssh','http','rsh','telnet'].indexOf(__e['application']) >= 0 ? __e['application'] : undefined"
            },
            {
              "name": "netapp.ontap.audit.input",
              "value": "__e['input']"
            },
            {
              "name": "event.action",
              "value": "__e['input'] ? __e['input'].trim().split(/\\s+/)[0] : undefined"
            },
            {
              "name": "event.outcome",
              "value": "__e['state']==='success'?'success':__e['state']==='error'?'failure':'unknown'"
            },
            {
              "name": "netapp.ontap.audit.scope",
              "value": "__e['scope']"
            },
            {
              "name": "user.name",
              "value": "__e['user']"
            },
            {
              "name": "source.address",
              "value": "__e['location']"
            },
            {
              "name": "source.ip",
              "value": "/^(\\d{1,3}\\.){3}\\d{1,3}$/.test(__e['location']) || /^[0-9a-fA-F:]+:[0-9a-fA-F:]+$/.test(__e['location']) ? __e['location'] : undefined"
            },
            {
              "name": "netapp.ontap.audit.session_id",
              "value": "__e['session_id']"
            },
            {
              "name": "netapp.ontap.audit.command_id",
              "value": "__e['command_id']"
            },
            {
              "name": "error.message",
              "value": "__e['state']==='error' && __e['message'] ? __e['message'] : undefined"
            },
            {
              "name": "netapp.ontap.svm",
              "value": "__e['svm'] && __e['svm'].name ? __e['svm'].name : undefined"
            },
            {
              "name": "event.dataset",
              "value": "'netapp_ontap.management_audit'"
            }
          ],
          "remove": [
            "node",
            "svm",
            "index",
            "application",
            "input",
            "state",
            "scope",
            "user",
            "location",
            "session_id",
            "command_id",
            "message",
            "timestamp"
          ]
        },
        "description": "Map JSON keys to ECS and custom fields"
      },
      {
        "id": "mask",
        "filter": "true",
        "conf": {
          "rules": [
            {
              "matchRegex": "/(-password)\\s+\\S+/gi",
              "replaceExpr": "`${g1} <REDACTED>`"
            },
            {
              "matchRegex": "/(-passphrase)\\s+\\S+/gi",
              "replaceExpr": "`${g1} <REDACTED>`"
            },
            {
              "matchRegex": "/security\\s+login\\s+password[\\s\\S]*/gi",
              "replaceExpr": "'security login password <REDACTED>'"
            },
            {
              "matchRegex": "/security\\s+certificate\\s+install[\\s\\S]*/gi",
              "replaceExpr": "'security certificate install <REDACTED>'"
            }
          ],
          "fields": [
            "_raw",
            "netapp.ontap.audit.input"
          ]
        },
        "description": "Mask credential-bearing command text regardless of boundary, per recommendations.direct.cribl"
      }
    ]
  }
}
