{
  "id": "dm_netapp_ontap_ems_api_pull",
  "conf": {
    "output": "default",
    "description": "NetApp ONTAP EMS event notifications, api-pull (REST Collector JSON from GET /api/support/ems/events): map JSON keys to ECS, keeping the structured parameters array bounded as a nested field rather than promoting keys to the top level.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "NetApp ONTAP EMS, api-pull. No framing detection needed - message name/severity/node/parameters arrive as typed JSON. Shares the logs-netapp_ontap.ems data stream with the syslog-kv and webhook forms. Scope the poll by message-name prefix at the API per recommendations.direct.cribl (Collector/API config, not pipeline logic - see README)."
        },
        "description": "Pipeline purpose and operational notes"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "Parse the JSON EMS event record"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "_time",
              "value": "Date.parse(__e['time'])/1000"
            },
            {
              "name": "event.sequence",
              "value": "__e['index']"
            },
            {
              "name": "observer.hostname",
              "value": "__e['node'] && __e['node'].name ? __e['node'].name : undefined"
            },
            {
              "name": "observer.name",
              "value": "__e['node'] && __e['node'].name ? __e['node'].name : undefined"
            },
            {
              "name": "netapp.ontap.node_uuid",
              "value": "__e['node'] && __e['node'].uuid ? __e['node'].uuid : undefined"
            },
            {
              "name": "event.code",
              "value": "__e['message'] && __e['message'].name ? __e['message'].name : undefined"
            },
            {
              "name": "log.level",
              "value": "__e['message'] && __e['message'].severity ? __e['message'].severity.toUpperCase() : undefined"
            },
            {
              "name": "event.severity",
              "value": "__e['message'].severity==='emergency'?0:__e['message'].severity==='alert'?1:__e['message'].severity==='critical'?2:__e['message'].severity==='error'?3:__e['message'].severity==='warning'?4:__e['message'].severity==='notice'?5:__e['message'].severity==='informational'?6:__e['message'].severity==='debug'?7:undefined"
            },
            {
              "name": "message",
              "value": "__e['log_message']"
            },
            {
              "name": "netapp.ontap.ems.source",
              "value": "__e['source']"
            },
            {
              "name": "netapp.ontap.ems.parameters",
              "value": "__e['parameters']"
            },
            {
              "name": "event.dataset",
              "value": "'netapp_ontap.ems'"
            }
          ],
          "remove": [
            "index",
            "node",
            "log_message",
            "source",
            "time"
          ]
        },
        "description": "Map JSON keys to ECS and custom fields; keep parameters as a nested array"
      }
    ]
  }
}
