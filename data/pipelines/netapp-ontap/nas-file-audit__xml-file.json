{
  "id": "dm_netapp_ontap_nas_file_audit_xml_file",
  "conf": {
    "output": "default",
    "description": "NetApp ONTAP SVM NAS file access audit, xml-file (vserver audit create -format xml): extract <System>/<EventData><Data Name=...> values via regex and map to ECS; shares ECS shape with the windows-event format.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "NetApp ONTAP NAS file audit, xml-file (vserver audit create -format xml). Same NetApp-Security-Auditing content as the windows-event format, now parsed from XML text via regex/XPath-style extraction instead of a binary EVTX decode. Each Data element is extracted independently (order-agnostic, tolerant of fields that are legitimately absent, e.g. HandleId on a create). AccessMask/AccessList decoding deferred - no lookup table supplied."
        },
        "description": "Pipeline purpose and documented assumptions/gaps"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/<Provider\\s+Name=\"(?<event_provider>[^\"]*)\"[\\s\\S]*?<EventID[^>]*>(?<event_code>\\d+)<\\/EventID>[\\s\\S]*?<TimeCreated\\s+SystemTime=\"(?<time_created>[^\"]*)\"[\\s\\S]*?<Computer>(?<computer>[^<]*)<\\/Computer>/",
          "source": "_raw"
        },
        "description": "Extract the fixed-order <System> block fields (Provider, EventID, TimeCreated, Computer)"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/<Data Name=\"ComputerUUID\">(?<computer_uuid>[^<]*)<\\/Data>/",
          "source": "_raw"
        },
        "description": "Extract ComputerUUID from <EventData><Data Name=\"ComputerUUID\">"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/<Data Name=\"EventName\">(?<event_name>[^<]*)<\\/Data>/",
          "source": "_raw"
        },
        "description": "Extract EventName from <EventData><Data Name=\"EventName\">"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/<Data Name=\"Source\">(?<source_proto>[^<]*)<\\/Data>/",
          "source": "_raw"
        },
        "description": "Extract Source from <EventData><Data Name=\"Source\">"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/<Data Name=\"Result\">(?<result_val>[^<]*)<\\/Data>/",
          "source": "_raw"
        },
        "description": "Extract Result from <EventData><Data Name=\"Result\">"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/<Data Name=\"SubjectIP\">(?<subject_ip>[^<]*)<\\/Data>/",
          "source": "_raw"
        },
        "description": "Extract SubjectIP from <EventData><Data Name=\"SubjectIP\">"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/<Data Name=\"SubjectUserName\">(?<subject_user_name>[^<]*)<\\/Data>/",
          "source": "_raw"
        },
        "description": "Extract SubjectUserName from <EventData><Data Name=\"SubjectUserName\">"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/<Data Name=\"SubjectDomainName\">(?<subject_domain_name>[^<]*)<\\/Data>/",
          "source": "_raw"
        },
        "description": "Extract SubjectDomainName from <EventData><Data Name=\"SubjectDomainName\">"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/<Data Name=\"SubjectUserSid\">(?<subject_user_sid>[^<]*)<\\/Data>/",
          "source": "_raw"
        },
        "description": "Extract SubjectUserSid from <EventData><Data Name=\"SubjectUserSid\">"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/<Data Name=\"SubjectUnix\">(?<subject_unix>[^<]*)<\\/Data>/",
          "source": "_raw"
        },
        "description": "Extract SubjectUnix from <EventData><Data Name=\"SubjectUnix\">"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/<Data Name=\"ObjectName\">(?<object_name>[^<]*)<\\/Data>/",
          "source": "_raw"
        },
        "description": "Extract ObjectName from <EventData><Data Name=\"ObjectName\">"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/<Data Name=\"ObjectType\">(?<object_type>[^<]*)<\\/Data>/",
          "source": "_raw"
        },
        "description": "Extract ObjectType from <EventData><Data Name=\"ObjectType\">"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/<Data Name=\"HandleId\">(?<handle_id>[^<]*)<\\/Data>/",
          "source": "_raw"
        },
        "description": "Extract HandleId from <EventData><Data Name=\"HandleId\">"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/<Data Name=\"AccessMask\">(?<access_mask>[^<]*)<\\/Data>/",
          "source": "_raw"
        },
        "description": "Extract AccessMask from <EventData><Data Name=\"AccessMask\">"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/<Data Name=\"AccessList\">(?<access_list>[^<]*)<\\/Data>/",
          "source": "_raw"
        },
        "description": "Extract AccessList from <EventData><Data Name=\"AccessList\">"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/<Data Name=\"LogonType\">(?<logon_type>[^<]*)<\\/Data>/",
          "source": "_raw"
        },
        "description": "Extract LogonType from <EventData><Data Name=\"LogonType\">"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "__dm_time",
              "value": "Date.parse(__e['time_created'])/1000"
            },
            {
              "name": "_time",
              "value": "__e['__dm_time'] !== undefined && __e['__dm_time'] !== null && __e['__dm_time'] === __e['__dm_time'] ? __e['__dm_time'] : __e['_time']"
            },
            {
              "name": "'event.code'",
              "value": "__e['event_code']"
            },
            {
              "name": "'event.action'",
              "value": "__e['event_name']"
            },
            {
              "name": "'network.protocol'",
              "value": "__e['source_proto']==='SMB/CIFS'?'smb':(__e['source_proto']==='NFSv3'||__e['source_proto']==='NFSv4')?'nfs':undefined"
            },
            {
              "name": "'netapp.ontap.audit.nfs_version'",
              "value": "__e['source_proto']==='NFSv3'?'v3':__e['source_proto']==='NFSv4'?'v4':undefined"
            },
            {
              "name": "'event.outcome'",
              "value": "__e['result_val']==='Audit Success'?'success':__e['result_val']==='Audit Failure'?'failure':'unknown'"
            },
            {
              "name": "'observer.hostname'",
              "value": "__e['computer'] ? __e['computer'].split('/')[0] : undefined"
            },
            {
              "name": "'observer.name'",
              "value": "__e['computer'] ? __e['computer'].split('/')[0] : undefined"
            },
            {
              "name": "'netapp.ontap.svm'",
              "value": "__e['computer'] && __e['computer'].indexOf('/')>=0 ? __e['computer'].split('/')[1] : undefined"
            },
            {
              "name": "'netapp.ontap.audit.computer_uuid'",
              "value": "__e['computer_uuid']"
            },
            {
              "name": "'event.provider'",
              "value": "__e['event_provider']"
            },
            {
              "name": "'source.ip'",
              "value": "__e['subject_ip']"
            },
            {
              "name": "'user.name'",
              "value": "__e['subject_user_name']"
            },
            {
              "name": "'user.domain'",
              "value": "__e['subject_domain_name']"
            },
            {
              "name": "'user.id'",
              "value": "__e['subject_user_sid']"
            },
            {
              "name": "'netapp.ontap.audit.subject_unix'",
              "value": "__e['subject_unix']"
            },
            {
              "name": "'netapp.ontap.volume'",
              "value": "__e['object_name'] && /^\\(([^)]*)\\)/.test(__e['object_name']) ? __e['object_name'].match(/^\\(([^)]*)\\)/)[1] : undefined"
            },
            {
              "name": "'file.path'",
              "value": "__e['object_name'] ? __e['object_name'].replace(/^\\([^)]*\\);?/, '') : undefined"
            },
            {
              "name": "'file.type'",
              "value": "__e['object_type']==='File'?'file':__e['object_type']==='Directory'?'dir':__e['object_type']==='Symbolic Link'?'symlink':undefined"
            },
            {
              "name": "'netapp.ontap.audit.object_type'",
              "value": "__e['object_type']"
            },
            {
              "name": "'netapp.ontap.audit.handle_id'",
              "value": "__e['handle_id']"
            },
            {
              "name": "'netapp.ontap.audit.access_mask'",
              "value": "__e['access_mask']"
            },
            {
              "name": "'netapp.ontap.audit.access_list'",
              "value": "__e['access_list']"
            },
            {
              "name": "'netapp.ontap.audit.logon_type'",
              "value": "__e['logon_type']"
            },
            {
              "name": "'event.dataset'",
              "value": "'netapp_ontap.nas_file_audit'"
            }
          ],
          "remove": [
            "event_provider",
            "event_code",
            "time_created",
            "computer",
            "computer_uuid",
            "event_name",
            "source_proto",
            "result_val",
            "subject_ip",
            "subject_user_name",
            "subject_domain_name",
            "subject_user_sid",
            "subject_unix",
            "object_name",
            "object_type",
            "handle_id",
            "access_mask",
            "access_list",
            "logon_type"
          ]
        },
        "description": "Map extracted XML values to ECS and custom fields"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
