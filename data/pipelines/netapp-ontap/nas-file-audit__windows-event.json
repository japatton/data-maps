{
  "id": "dm_netapp_ontap_nas_file_audit_windows_event",
  "conf": {
    "output": "default",
    "description": "NetApp ONTAP SVM NAS file access audit, windows-event: map the NetApp-Security-Auditing provider's decoded EVTX record (Microsoft event IDs + ONTAP-specific EventData) to ECS; the stock Windows security pipeline does not apply.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "NetApp ONTAP NAS file audit, windows-event. Assumes the upstream collector hands one JSON object per event with keys matching the work order's documented field labels (including 'Event Name'/'TimeCreated SystemTime'/'Provider Name' with embedded spaces, read via __e[\"...\"] bracket notation). This wire-level assumption is NOT verified against a captured sample - see README gaps. The eval 'remove' list cannot target a space-containing path (HTTP 500 on 'Event Name', same accessor-parser class as the @ constraint), so those 3 original fields are left as harmless residual duplicates alongside their ECS/custom copies. AccessMask/AccessList bit and %%NNNN code decoding is deferred (no lookup table supplied)."
        },
        "description": "Pipeline purpose and documented assumptions/gaps"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "Parse the decoded Windows-event-shaped JSON record"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "_time",
              "value": "Date.parse(__e[\"TimeCreated SystemTime\"])/1000"
            },
            {
              "name": "'event.code'",
              "value": "__e['EventID'] !== undefined ? String(__e['EventID']) : undefined"
            },
            {
              "name": "'event.action'",
              "value": "__e[\"Event Name\"]"
            },
            {
              "name": "'network.protocol'",
              "value": "__e['Source']==='SMB/CIFS'?'smb':(__e['Source']==='NFSv3'||__e['Source']==='NFSv4')?'nfs':undefined"
            },
            {
              "name": "'netapp.ontap.audit.nfs_version'",
              "value": "__e['Source']==='NFSv3'?'v3':__e['Source']==='NFSv4'?'v4':undefined"
            },
            {
              "name": "'event.outcome'",
              "value": "__e['Result']==='Audit Success'?'success':__e['Result']==='Audit Failure'?'failure':'unknown'"
            },
            {
              "name": "'observer.hostname'",
              "value": "__e['Computer'] ? __e['Computer'].split('/')[0] : undefined"
            },
            {
              "name": "'observer.name'",
              "value": "__e['Computer'] ? __e['Computer'].split('/')[0] : undefined"
            },
            {
              "name": "'netapp.ontap.svm'",
              "value": "__e['Computer'] && __e['Computer'].indexOf('/')>=0 ? __e['Computer'].split('/')[1] : undefined"
            },
            {
              "name": "'netapp.ontap.audit.computer_uuid'",
              "value": "__e['ComputerUUID']"
            },
            {
              "name": "'event.provider'",
              "value": "__e[\"Provider Name\"]"
            },
            {
              "name": "'source.ip'",
              "value": "__e['SubjectIP']"
            },
            {
              "name": "'source.domain'",
              "value": "__e['SubjectHostName']"
            },
            {
              "name": "'user.name'",
              "value": "__e['SubjectUserName']"
            },
            {
              "name": "'user.domain'",
              "value": "__e['SubjectDomainName']"
            },
            {
              "name": "'user.id'",
              "value": "__e['SubjectUserSid']"
            },
            {
              "name": "'netapp.ontap.audit.subject_unix'",
              "value": "__e['SubjectUnix']"
            },
            {
              "name": "'netapp.ontap.volume'",
              "value": "__e['ObjectName'] && /^\\(([^)]*)\\)/.test(__e['ObjectName']) ? __e['ObjectName'].match(/^\\(([^)]*)\\)/)[1] : undefined"
            },
            {
              "name": "'file.path'",
              "value": "__e['ObjectName'] ? __e['ObjectName'].replace(/^\\([^)]*\\);?/, '') : undefined"
            },
            {
              "name": "'file.type'",
              "value": "__e['ObjectType']==='File'?'file':__e['ObjectType']==='Directory'?'dir':__e['ObjectType']==='Symbolic Link'?'symlink':undefined"
            },
            {
              "name": "'netapp.ontap.audit.object_type'",
              "value": "__e['ObjectType']"
            },
            {
              "name": "'netapp.ontap.audit.handle_id'",
              "value": "__e['HandleId']"
            },
            {
              "name": "'netapp.ontap.audit.access_mask'",
              "value": "__e['AccessMask']"
            },
            {
              "name": "'netapp.ontap.audit.access_list'",
              "value": "__e['AccessList']"
            },
            {
              "name": "'netapp.ontap.audit.logon_type'",
              "value": "__e['LogonType']"
            },
            {
              "name": "'event.dataset'",
              "value": "'netapp_ontap.nas_file_audit'"
            }
          ],
          "remove": [
            "EventID",
            "Source",
            "Result",
            "Computer",
            "ComputerUUID",
            "SubjectIP",
            "SubjectHostName",
            "SubjectUserName",
            "SubjectDomainName",
            "SubjectUserSid",
            "SubjectUnix",
            "ObjectName",
            "ObjectType",
            "HandleId",
            "AccessMask",
            "AccessList",
            "LogonType"
          ]
        },
        "description": "Map decoded Windows-event fields to ECS and custom fields"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
