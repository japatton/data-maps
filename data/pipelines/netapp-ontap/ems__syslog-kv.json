{
  "id": "dm_netapp_ontap_ems_syslog_kv",
  "conf": {
    "output": "default",
    "description": "NetApp ONTAP EMS event notifications, syslog-kv: detect legacy-netapp vs RFC-5424 framing, extract the message name/severity/node and the trailing key=\"value\" parameter text, map to ECS.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "NetApp ONTAP EMS, syslog-kv. Two framings per destination config. Event-severity for RFC-5424 (no bracket tag) is derived from PRIVAL mod 8, which maps 1:1 onto EMS's 8-word severity scale. The per-message parameter bag is kept as one raw string (not decomposed to top-level keys) because the key set is unbounded across thousands of EMS message definitions and no allowlist was supplied - decomposing without one risks a mapping explosion. 'index' and 'vserver' have no documented position in this wire form and are left unmapped here; see README gaps."
        },
        "description": "Pipeline purpose and documented gaps"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "_framing",
              "value": "/^<\\d+>\\d+\\s/.test(_raw) ? 'rfc5424' : 'legacy'"
            }
          ]
        },
        "description": "Detect syslog framing variant"
      },
      {
        "id": "regex_extract",
        "filter": "_framing==='legacy'",
        "conf": {
          "regex": "/^<(?<prival>\\d+)>(?<time>\\w{3}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2})\\s+\\[(?<node>[^:]+):(?<event_name>[^:]+):(?<event_severity>[^\\]]+)\\]:\\s*(?<msg>[\\s\\S]*)$/",
          "source": "_raw"
        },
        "description": "Extract header and MSG from legacy-netapp framing"
      },
      {
        "id": "regex_extract",
        "filter": "_framing==='rfc5424'",
        "conf": {
          "regex": "/^<(?<prival>\\d+)>\\d+\\s+(?<time>\\S+)\\s+(?<node>\\S+)\\s+(?<event_source>\\S+)\\s+-\\s+(?<event_name>\\S+)\\s+-\\s+(?<msg>[\\s\\S]*)$/",
          "source": "_raw"
        },
        "description": "Extract header and MSG from RFC-5424 framing"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/(?<param_str>(?:\\s*[A-Za-z0-9_]+=\"[^\"]*\")+)\\s*$/",
          "source": "msg"
        },
        "description": "Pull the trailing key=\"value\" parameter text off the end of MSG, when present"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "_time",
              "value": "Date.parse(__e['time'])/1000"
            },
            {
              "name": "'event.code'",
              "value": "__e['event_name']"
            },
            {
              "name": "_fac_num",
              "value": "Math.floor(Number(__e['prival'])/8)"
            },
            {
              "name": "_sev_num",
              "value": "Math.floor(Number(__e['prival'])%8)"
            },
            {
              "name": "'log.syslog.facility.name'",
              "value": "(_fac_num===0?'kern':_fac_num===1?'user':_fac_num===2?'mail':_fac_num===3?'daemon':_fac_num===4?'auth':_fac_num===5?'syslog':_fac_num===6?'lpr':_fac_num===7?'news':_fac_num===8?'uucp':_fac_num===9?'cron':_fac_num===10?'authpriv':_fac_num===11?'ftp':_fac_num===12?'ntp':_fac_num===13?'security':_fac_num===14?'console':_fac_num===15?'solaris-cron':_fac_num===16?'local0':_fac_num===17?'local1':_fac_num===18?'local2':_fac_num===19?'local3':_fac_num===20?'local4':_fac_num===21?'local5':_fac_num===22?'local6':_fac_num===23?'local7':'unknown')"
            },
            {
              "name": "'log.level'",
              "value": "__e['event_severity'] ? __e['event_severity'] : (_sev_num===0?'EMERGENCY':_sev_num===1?'ALERT':_sev_num===2?'CRITICAL':_sev_num===3?'ERROR':_sev_num===4?'WARNING':_sev_num===5?'NOTICE':_sev_num===6?'INFORMATIONAL':_sev_num===7?'DEBUG':'UNKNOWN')"
            },
            {
              "name": "'event.severity'",
              "value": "__e['event_severity']==='EMERGENCY'?0:__e['event_severity']==='ALERT'?1:__e['event_severity']==='CRITICAL'?2:__e['event_severity']==='ERROR'?3:__e['event_severity']==='WARNING'?4:__e['event_severity']==='NOTICE'?5:__e['event_severity']==='INFORMATIONAL'?6:__e['event_severity']==='DEBUG'?7:_sev_num"
            },
            {
              "name": "message",
              "value": "__e['msg']"
            },
            {
              "name": "'netapp.ontap.ems.parameters'",
              "value": "__e['param_str'] ? __e['param_str'].trim() : undefined"
            },
            {
              "name": "'netapp.ontap.ems.source'",
              "value": "__e['event_source']"
            },
            {
              "name": "'observer.hostname'",
              "value": "__e['node']"
            },
            {
              "name": "'observer.name'",
              "value": "__e['node']"
            },
            {
              "name": "'event.dataset'",
              "value": "'netapp_ontap.ems'"
            }
          ],
          "remove": [
            "prival",
            "time",
            "event_severity",
            "msg",
            "param_str",
            "event_source",
            "_framing",
            "_sev_num",
            "_fac_num",
            "node",
            "event_name"
          ]
        },
        "description": "Map extracted header/MSG values to ECS and custom fields"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
