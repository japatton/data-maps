{
  "id": "dm_netapp_ontap_management_audit_syslog_raw",
  "conf": {
    "output": "default",
    "description": "NetApp ONTAP management audit log (audit.log), syslog-raw: detect legacy-netapp vs RFC-5424 framing, split the ' :: '-delimited kern_audit entry, map to ECS, mask credential-bearing command text.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "NetApp ONTAP audit.log (management-audit), syslog-raw. Handles legacy-netapp and RFC-5424 framings per cluster log-forwarding config. Per recommendations.direct.cribl, Pending records are NOT joined to their terminal Success/Error record here: that join needs stateful cross-event correlation on session-id+command-id via a function conf (e.g. join/aggregation) this build could not verify against the live instance without guessing a key name. Pending is instead carried as event.outcome=unknown, the fallback the field spec itself permits. See README decisions/gaps."
        },
        "description": "Pipeline purpose and known deviation from the join recommendation"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "_framing",
              "value": "/^<\\d+>1\\s/.test(_raw) ? 'rfc5424' : 'legacy'"
            }
          ]
        },
        "description": "Detect syslog framing variant from the PRI/VERSION header"
      },
      {
        "id": "regex_extract",
        "filter": "_framing==='rfc5424'",
        "conf": {
          "regex": "/^<(?<pri>\\d+)>1\\s+\\S+\\s+\\S+\\s+\\S+\\s+\\S+\\s+\\S+\\s+(?:-|\\[.*?\\])\\s+(?<entry>[\\s\\S]*)$/",
          "source": "_raw"
        },
        "description": "Extract PRI and kern_audit entry from RFC-5424 framing"
      },
      {
        "id": "regex_extract",
        "filter": "_framing==='legacy'",
        "conf": {
          "regex": "/^<(?<pri>\\d+)>\\w{3}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2}\\s+\\S+:\\s*(?<entry>[\\s\\S]*)$/",
          "source": "_raw"
        },
        "description": "Extract PRI and kern_audit entry from legacy-netapp RFC-3164 framing"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/^(?<timestamp>\\w{3}\\s+\\w{3}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2}\\s+\\d{4})\\s+\\[kern_audit:[^\\]]*\\]:\\s*(?<node>[^:]+):\\s*(?<vserver>[^:]*?)\\s*::\\s*(?<scope>[^:]*?)\\s*::\\s*(?<application>[^:]*?)\\s*::\\s*(?<location>[^:]*?)\\s*::\\s*(?<username>[^:]*?)\\s*::\\s*(?<role>[^:]*?)\\s*::\\s*(?<input>[\\s\\S]*?)\\s*::\\s*(?<state>[^:]*?)\\s*::\\s*(?<message>[\\s\\S]*?)\\s*::\\s*(?<session_id>[^:]*?)\\s*::\\s*(?<command_id>[\\s\\S]*)$/",
          "source": "entry"
        },
        "description": "Split the kern_audit entry into its ' :: '-delimited columns (order per the work order's documented field list; not verified against a captured sample)"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "_time",
              "value": "Date.parse(__e['timestamp'])/1000"
            },
            {
              "name": "_fac_num",
              "value": "Math.floor(Number(__e['pri'])/8)"
            },
            {
              "name": "'log.syslog.facility.name'",
              "value": "(_fac_num===0?'kern':_fac_num===1?'user':_fac_num===2?'mail':_fac_num===3?'daemon':_fac_num===4?'auth':_fac_num===5?'syslog':_fac_num===6?'lpr':_fac_num===7?'news':_fac_num===8?'uucp':_fac_num===9?'cron':_fac_num===10?'authpriv':_fac_num===11?'ftp':_fac_num===12?'ntp':_fac_num===13?'security':_fac_num===14?'console':_fac_num===15?'solaris-cron':_fac_num===16?'local0':_fac_num===17?'local1':_fac_num===18?'local2':_fac_num===19?'local3':_fac_num===20?'local4':_fac_num===21?'local5':_fac_num===22?'local6':_fac_num===23?'local7':'unknown')"
            },
            {
              "name": "'event.outcome'",
              "value": "__e['state']==='Success'?'success':__e['state']==='Error'?'failure':'unknown'"
            },
            {
              "name": "'user.roles'",
              "value": "__e['role'] ? [__e['role']] : undefined"
            },
            {
              "name": "'source.ip'",
              "value": "/^(\\d{1,3}\\.){3}\\d{1,3}$/.test(__e['location']) || /^[0-9a-fA-F:]+:[0-9a-fA-F:]+$/.test(__e['location']) ? __e['location'] : undefined"
            },
            {
              "name": "'event.action'",
              "value": "__e['input'] ? __e['input'].trim().split(/\\s+/)[0] : undefined"
            },
            {
              "name": "'netapp.ontap.svm'",
              "value": "__e['vserver']"
            },
            {
              "name": "'netapp.ontap.audit.scope'",
              "value": "__e['scope']"
            },
            {
              "name": "'netapp.ontap.audit.application'",
              "value": "__e['application']"
            },
            {
              "name": "'network.protocol'",
              "value": "['ssh','http','snmp','telnet','rsh'].indexOf(__e['application']) >= 0 ? __e['application'] : undefined"
            },
            {
              "name": "'netapp.ontap.audit.input'",
              "value": "__e['input']"
            },
            {
              "name": "'netapp.ontap.audit.session_id'",
              "value": "__e['session_id']"
            },
            {
              "name": "'netapp.ontap.audit.command_id'",
              "value": "__e['command_id']"
            },
            {
              "name": "'error.message'",
              "value": "__e['state']==='Error' && __e['message']!=='-' ? __e['message'] : undefined"
            },
            {
              "name": "'event.dataset'",
              "value": "'netapp_ontap.management_audit'"
            }
          ]
        },
        "description": "Derive ECS and custom fields from the extracted kern_audit columns"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "node",
              "newName": "'observer.hostname'"
            },
            {
              "currentName": "location",
              "newName": "'source.address'"
            },
            {
              "currentName": "username",
              "newName": "'user.name'"
            },
            {
              "currentName": "entry",
              "newName": "'event.original'"
            }
          ]
        },
        "description": "Batch rename mapped fields to ECS"
      },
      {
        "id": "mask",
        "filter": "true",
        "conf": {
          "rules": [
            {
              "matchRegex": "/(-password)\\s+\\S+/gi",
              "replaceExpr": "`${g1} <REDACTED>`"
            },
            {
              "matchRegex": "/(-passphrase)\\s+\\S+/gi",
              "replaceExpr": "`${g1} <REDACTED>`"
            },
            {
              "matchRegex": "/security\\s+login\\s+password[\\s\\S]*/gi",
              "replaceExpr": "'security login password <REDACTED>'"
            },
            {
              "matchRegex": "/security\\s+certificate\\s+install[\\s\\S]*/gi",
              "replaceExpr": "'security certificate install <REDACTED>'"
            }
          ],
          "fields": [
            "_raw",
            "event.original",
            "netapp.ontap.audit.input"
          ]
        },
        "description": "Mask credential-bearing command text per recommendations.direct.cribl, on every field the parser materialized"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'observer.name'",
              "value": "__e['observer.hostname']"
            }
          ],
          "remove": [
            "role",
            "state",
            "message",
            "timestamp",
            "vserver",
            "scope",
            "application",
            "input",
            "session_id",
            "command_id",
            "pri",
            "_framing",
            "_fac_num"
          ]
        },
        "description": "Copy observer.name and drop intermediate scratch fields"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
