{
  "id": "dm_veritas_netbackup_audit_syslog_raw",
  "conf": {
    "output": "default",
    "description": "Veritas NetBackup audit, syslog-raw (native text), direct route. Hand-built parse per recommendations.direct.cribl: user split, action lowercase, outcome derived from DESCRIPTION for LOGIN/DATAACCESS, _time from TIMESTAMP; delimiter grammar and masking are documented assumptions/gaps (see README)",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "NetBackup nbaudit native-text audit events, direct route. ASSUMED pipe-delimited TIMESTAMP|USER|CATEGORY|ACTION|DESCRIPTION|REASON|DETAILS|OLD VALUE|NEW VALUE body (no live sample provided in the work order; verify against a real primary before deploy). Converges on the same target schema as the OCSF and api-pull audit pipelines."
        },
        "description": "Pipeline purpose, format and delimiter assumption"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/^(?:nbaudit(?:\\[\\d+\\])?:\\s*)?(?<ts>[^|]*)\\|(?<user>[^|]*)\\|(?<category>[^|]*)\\|(?<action>[^|]*)\\|(?<description>[^|]*)\\|(?<reason>[^|]*)\\|(?<details>[^|]*)\\|(?<old_value>[^|]*)\\|(?<new_value>[^|]*)$/",
          "source": "_raw"
        },
        "description": "Positional extract of the pipe-delimited audit body, tolerating an optional leading nbaudit syslog tag"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "host",
              "newName": "observer.name"
            },
            {
              "currentName": "description",
              "newName": "message"
            },
            {
              "currentName": "reason",
              "newName": "event.reason"
            }
          ]
        },
        "description": "Batch rename of directly-mapped fields with no transform (host assumed populated by the Cribl Syslog Source)"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "process.name",
              "value": "'nbaudit'"
            },
            {
              "name": "user.name",
              "value": "__e['user'] ? (__e['user'].lastIndexOf('@')!==-1 ? __e['user'].slice(0, __e['user'].lastIndexOf('@')) : __e['user']) : null"
            },
            {
              "name": "user.domain",
              "value": "(__e['user'] && __e['user'].lastIndexOf('@')!==-1) ? __e['user'].slice(__e['user'].lastIndexOf('@')+1) : null"
            },
            {
              "name": "event.action",
              "value": "__e['action'] ? __e['action'].toLowerCase() : null"
            },
            {
              "name": "netbackup.audit.category",
              "value": "__e['category'] ? __e['category'] : null"
            },
            {
              "name": "netbackup.audit.details",
              "value": "__e['details'] ? __e['details'] : null"
            },
            {
              "name": "netbackup.audit.old_value",
              "value": "__e['old_value'] ? __e['old_value'] : null"
            },
            {
              "name": "netbackup.audit.new_value",
              "value": "__e['new_value'] ? __e['new_value'] : null"
            }
          ]
        },
        "description": "process.name constant, USER split on final '@', ACTION lowercased, CATEGORY/DETAILS/OLD VALUE/NEW VALUE to custom namespace"
      },
      {
        "id": "eval",
        "filter": "__e['category']==='LOGIN' || __e['category']==='DATAACCESS'",
        "conf": {
          "add": [
            {
              "name": "event.outcome",
              "value": "/fail/i.test(__e['description']||'') ? 'failure' : (/success/i.test(__e['description']||'') ? 'success' : 'unknown')"
            }
          ]
        },
        "description": "Best-effort event.outcome for LOGIN/DATAACCESS by substring match on DESCRIPTION prose (no confirmed phrasing sample; see README gap)"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "_time",
              "value": "__e['ts'] && !isNaN(Number(__e['ts'])) ? Number(__e['ts']) : null"
            }
          ]
        },
        "description": "Event time from TIMESTAMP (assumed epoch seconds UTC) into _time, not @timestamp (platform constraint)"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "event.dataset",
              "value": "'veritas_netbackup.audit'"
            }
          ]
        },
        "description": "Set event.dataset (no hyphen, platform constraint)"
      }
    ]
  }
}