{
  "id": "dm_veritas_netbackup_jobs_csv_file",
  "conf": {
    "output": "default",
    "description": "Veritas NetBackup jobs bpdbjobs -all_columns CSV export, direct route. Full shaping per recommendations.direct.cribl at the core worker group, sharing the REST jobs pipeline's ECS/custom target schema; column order is a documented assumption (Veritas: order is release-dependent) and jobid+try/ended dedup is a documented gap (no verified distinct conf shape)",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "NetBackup bpdbjobs -all_columns CSV export (fixed column order per this work order's field list; pin to the primary's NetBackup version -- Veritas documents the column set can change across releases). pathlastwritten captured greedily so an embedded comma in the path does not misalign the fixed trailing columns. Trailing per-try columns after trycount are release-dependent and intentionally left unmatched."
        },
        "description": "Pipeline purpose, column-order assumption, and comma hazard handling"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/^(?<jobid>[^,]*),(?<jobtype>[^,]*),(?<state>[^,]*),(?<status>[^,]*),(?<class>[^,]*),(?<schedule>[^,]*),(?<client>[^,]*),(?<server>[^,]*),(?<started>[^,]*),(?<elapsed>[^,]*),(?<ended>[^,]*),(?<stunit>[^,]*),(?<try>[^,]*),(?<operation>[^,]*),(?<kbytes>[^,]*),(?<files>[^,]*),(?<pathlastwritten>.*),(?<jobpid>[^,]*),(?<owner>[^,]*),(?<subtype>[^,]*),(?<priority>[^,]*),(?<group>[^,]*),(?<masterserver>[^,]*),(?<retentionperiod>[^,]*),(?<retentionunits>[^,]*),(?<compression>[^,]*),(?<trycount>[^,]*)/",
          "source": "_raw"
        },
        "description": "Positional extract of the 27 documented bpdbjobs columns"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "class",
              "newName": "rule.name"
            },
            {
              "currentName": "client",
              "newName": "host.name"
            },
            {
              "currentName": "server",
              "newName": "observer.name"
            }
          ]
        },
        "description": "Batch rename of directly-mapped columns with no transform"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "event.action",
              "value": "__e['jobtype'] ? __e['jobtype'].toLowerCase() : null"
            },
            {
              "name": "event.code",
              "value": "__e['status']!==undefined && __e['status']!=='' ? Number(__e['status']) : null"
            },
            {
              "name": "event.outcome",
              "value": "Number(__e['status'])===0 ? 'success' : (Number(__e['status'])===1 ? 'unknown' : 'failure')"
            },
            {
              "name": "event.start",
              "value": "__e['started'] ? new Date(Number(__e['started'])*1000).toISOString() : null"
            },
            {
              "name": "event.end",
              "value": "__e['ended'] ? new Date(Number(__e['ended'])*1000).toISOString() : null"
            },
            {
              "name": "event.duration",
              "value": "__e['elapsed'] ? Number(__e['elapsed'])*1e9 : null"
            },
            {
              "name": "netbackup.job.id",
              "value": "__e['jobid'] ? Number(__e['jobid']) : null"
            },
            {
              "name": "netbackup.job.state",
              "value": "__e['state'] !== undefined ? __e['state'] : null"
            },
            {
              "name": "netbackup.job.schedule_name",
              "value": "__e['schedule'] || null"
            },
            {
              "name": "netbackup.job.storage_unit",
              "value": "__e['stunit'] || null"
            },
            {
              "name": "netbackup.job.try",
              "value": "__e['try'] ? Number(__e['try']) : null"
            },
            {
              "name": "netbackup.job.operation",
              "value": "__e['operation'] || null"
            },
            {
              "name": "netbackup.job.kilobytes_transferred",
              "value": "__e['kbytes'] ? Number(__e['kbytes']) : null"
            },
            {
              "name": "netbackup.job.file_count",
              "value": "__e['files'] ? Number(__e['files']) : null"
            },
            {
              "name": "netbackup.job.path_last_written",
              "value": "__e['pathlastwritten'] || null"
            },
            {
              "name": "netbackup.job.pid",
              "value": "__e['jobpid'] ? Number(__e['jobpid']) : null"
            },
            {
              "name": "netbackup.job.owner",
              "value": "__e['owner'] || null"
            },
            {
              "name": "netbackup.job.subtype",
              "value": "__e['subtype'] || null"
            },
            {
              "name": "netbackup.job.priority",
              "value": "__e['priority'] ? Number(__e['priority']) : null"
            },
            {
              "name": "netbackup.job.group",
              "value": "__e['group'] || null"
            },
            {
              "name": "netbackup.job.master_server",
              "value": "__e['masterserver'] || null"
            },
            {
              "name": "netbackup.job.retention_period",
              "value": "__e['retentionperiod'] ? Number(__e['retentionperiod']) : null"
            },
            {
              "name": "netbackup.job.retention_units",
              "value": "__e['retentionunits'] || null"
            },
            {
              "name": "netbackup.job.compression",
              "value": "__e['compression'] ? Number(__e['compression']) : null"
            },
            {
              "name": "netbackup.job.try_count",
              "value": "__e['trycount'] ? Number(__e['trycount']) : null"
            }
          ]
        },
        "description": "jobtype lowercased; status to event.code/event.outcome (partial never folded into success); started/elapsed/ended converted; all unmapped columns to custom namespace"
      },
      {
        "id": "eval",
        "filter": "__e['ended']",
        "conf": {
          "add": [
            {
              "name": "_time",
              "value": "!isNaN(Number(__e['ended'])) ? Number(__e['ended']) : null"
            }
          ]
        },
        "description": "Event time from ended (epoch seconds, completed jobs only) into _time, not @timestamp (platform constraint)"
      },
      {
        "id": "drop",
        "filter": "Number(__e['state'])!==3 && Math.random()>=0.1",
        "conf": {},
        "description": "Emit only state 3 (DONE) job transitions to the detection index; sample roughly 1-in-10 in-flight (0 queued/1 active/2 requeued) states, matching the REST jobs pipeline"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "event.dataset",
              "value": "'veritas_netbackup.jobs'"
            }
          ]
        },
        "description": "Set event.dataset (no hyphen, platform constraint) -- shared with the REST jobs pipeline"
      }
    ]
  }
}