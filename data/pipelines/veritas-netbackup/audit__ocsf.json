{
  "id": "dm_veritas_netbackup_audit_ocsf",
  "conf": {
    "output": "default",
    "description": "Veritas NetBackup audit, OCSF v1.0.0 JSON rendering, direct route. Per recommendations.direct.cribl: shape the OCSF object at the core worker group into the same schema as the native-text branch (status_id outcome lookup, actor.user split, _time from epoch-ms time); CATEGORY/ACTION lift out of the mapper-driven unmapped object is a documented gap since key names there are site-configurable",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "NetBackup audit events, OCSF v1.0.0 JSON rendering (SYSLOG_AUDIT_USE_OCSF_FORMAT=1), direct route. Converges on the same target schema as the native-text audit pipeline. NetBackup CATEGORY/ACTION are NOT lifted out of the mapper-driven `unmapped` object here (site-configurable key names -- see README gap); the whole object is carried in netbackup.audit.unmapped instead."
        },
        "description": "Pipeline purpose, format and known gap"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "Extract the OCSF JSON object"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "severity_id",
              "newName": "event.severity"
            },
            {
              "currentName": "metadata.product.name",
              "newName": "observer.product"
            },
            {
              "currentName": "metadata.product.vendor_name",
              "newName": "observer.vendor"
            }
          ]
        },
        "description": "Direct-carry renames: OCSF severity_id (0-6 scale, different from the anomaly feed's risk_score) and product/vendor metadata"
      },
      {
        "id": "eval",
        "filter": "__e['status_id']===0 || __e['status_id']===1 || __e['status_id']===2",
        "conf": {
          "add": [
            {
              "name": "event.outcome",
              "value": "__e['status_id']===1 ? 'success' : (__e['status_id']===2 ? 'failure' : 'unknown')"
            }
          ]
        },
        "description": "event.outcome from OCSF status_id (1 Success, 2 Failure, 0 Unknown) where the mapper populates it"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "actor_identity",
              "value": "((__e['actor']||{})['user']||{})['name'] || null"
            }
          ]
        },
        "description": "Stage the actor.user identity string (present only in classes with an actor)"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "user.name",
              "value": "__e['actor_identity'] ? (__e['actor_identity'].lastIndexOf('@')!==-1 ? __e['actor_identity'].slice(0, __e['actor_identity'].lastIndexOf('@')) : __e['actor_identity']) : null"
            },
            {
              "name": "user.domain",
              "value": "(__e['actor_identity'] && __e['actor_identity'].lastIndexOf('@')!==-1) ? __e['actor_identity'].slice(__e['actor_identity'].lastIndexOf('@')+1) : null"
            },
            {
              "name": "netbackup.audit.ocsf_class_uid",
              "value": "__e['class_uid']!==undefined ? __e['class_uid'] : null"
            },
            {
              "name": "netbackup.audit.ocsf_category_uid",
              "value": "__e['category_uid']!==undefined ? __e['category_uid'] : null"
            },
            {
              "name": "netbackup.audit.ocsf_activity_id",
              "value": "__e['activity_id']!==undefined ? __e['activity_id'] : null"
            },
            {
              "name": "netbackup.audit.ocsf_type_uid",
              "value": "__e['type_uid']!==undefined ? __e['type_uid'] : null"
            },
            {
              "name": "netbackup.audit.ocsf_schema_version",
              "value": "(__e['metadata']||{})['version'] || null"
            },
            {
              "name": "netbackup.audit.unmapped",
              "value": "__e['unmapped'] || null"
            }
          ],
          "remove": [
            "actor_identity"
          ]
        },
        "description": "Custom-namespace copies of the OCSF class/category/activity/type identifiers, schema version, and the mapper-shaped unmapped remainder (CATEGORY/ACTION not lifted out of it -- see README)"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "_time",
              "value": "__e['time']!==undefined && !isNaN(Number(__e['time'])) ? Number(__e['time'])/1000 : null"
            }
          ]
        },
        "description": "Event time from OCSF `time` (epoch milliseconds) into _time, not @timestamp (platform constraint)"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "event.dataset",
              "value": "'veritas_netbackup.audit'"
            }
          ]
        },
        "description": "Set event.dataset (no hyphen, platform constraint) -- shared with the native-text branch"
      }
    ]
  }
}