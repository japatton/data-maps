{
  "id": "dm_veritas_netbackup_jobs_api_pull",
  "conf": {
    "output": "default",
    "description": "Veritas NetBackup jobs REST (JSON:API data[].attributes envelope), direct route. Full shaping per recommendations.direct.cribl: outcome derived from status (partial never folded into success), elapsed seconds to event.duration ns, DONE-only emission with in-flight sampling; client/owner site enrichment and jobId+lastUpdateTime dedup are documented gaps",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "NetBackup jobs REST (JSON:API data[].attributes envelope), direct route. Full shaping at the core worker group per recommendations.direct.cribl. Client/owner-to-site lookup enrichment and jobId+lastUpdateTime dedup are documented gaps (no lookup table given; no verified `distinct` conf shape)."
        },
        "description": "Pipeline purpose and known gaps"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "Extract the JSON:API job record"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "attributes.status",
              "newName": "event.code"
            },
            {
              "currentName": "attributes.policyName",
              "newName": "rule.name"
            },
            {
              "currentName": "attributes.clientName",
              "newName": "host.name"
            },
            {
              "currentName": "attributes.startTime",
              "newName": "event.start"
            },
            {
              "currentName": "attributes.endTime",
              "newName": "event.end"
            },
            {
              "currentName": "attributes.auditUserName",
              "newName": "user.name"
            },
            {
              "currentName": "attributes.auditDomainName",
              "newName": "user.domain"
            }
          ]
        },
        "description": "Batch rename of directly-mapped attributes with no further logic"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "event.action",
              "value": "(__e['attributes']||{})['jobType'] ? __e['attributes']['jobType'].toLowerCase() : null"
            },
            {
              "name": "event.outcome",
              "value": "Number((__e['event']||{})['code'])===0 ? 'success' : (Number((__e['event']||{})['code'])===1 ? 'unknown' : 'failure')"
            },
            {
              "name": "event.duration",
              "value": "(__e['attributes']||{})['elapsedTime']!==undefined ? Number(__e['attributes']['elapsedTime'])*1e9 : null"
            },
            {
              "name": "netbackup.job.id",
              "value": "(__e['attributes']||{})['jobId']!==undefined ? __e['attributes']['jobId'] : null"
            },
            {
              "name": "netbackup.job.state",
              "value": "(__e['attributes']||{})['state'] || null"
            },
            {
              "name": "netbackup.job.schedule_name",
              "value": "(__e['attributes']||{})['scheduleName'] || null"
            },
            {
              "name": "netbackup.job.kilobytes_transferred",
              "value": "(__e['attributes']||{})['kilobytesTransferred']!==undefined ? __e['attributes']['kilobytesTransferred'] : null"
            },
            {
              "name": "netbackup.job.file_count",
              "value": "(__e['attributes']||{})['numberOfFiles']!==undefined ? __e['attributes']['numberOfFiles'] : null"
            },
            {
              "name": "netbackup.job.dedup_ratio",
              "value": "(__e['attributes']||{})['dedupRatio']!==undefined ? __e['attributes']['dedupRatio'] : null"
            },
            {
              "name": "netbackup.job.owner",
              "value": "(__e['attributes']||{})['jobOwner'] || null"
            }
          ]
        },
        "description": "event.action lowercased; event.outcome derived from event.code (0 success, 1 unknown/partial - not folded into success, other failure); event.duration seconds to ns; unmapped attributes to custom namespace"
      },
      {
        "id": "eval",
        "filter": "(__e['event']||{})['end']",
        "conf": {
          "add": [
            {
              "name": "_time",
              "value": "!isNaN(Date.parse(__e['event']['end'])) ? Date.parse(__e['event']['end'])/1000 : null"
            }
          ]
        },
        "description": "Event time from event.end (completed jobs only) into _time, not @timestamp (platform constraint); unset while running"
      },
      {
        "id": "drop",
        "filter": "(__e['attributes']||{})['state']!=='DONE' && Math.random()>=0.1",
        "conf": {},
        "description": "Emit only DONE job transitions to the detection index; sample roughly 1-in-10 in-flight (QUEUED/ACTIVE/REQUEUED) states per recommendations.direct.cribl"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "event.dataset",
              "value": "'veritas_netbackup.jobs'"
            }
          ],
          "remove": [
            "attributes",
            "id",
            "type"
          ]
        },
        "description": "Set event.dataset (no hyphen, platform constraint) and drop the now-redundant JSON:API envelope remnants"
      }
    ]
  }
}