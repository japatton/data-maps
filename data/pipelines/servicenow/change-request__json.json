{
  "id": "dm_servicenow_change_request_json",
  "conf": {
    "output": "default",
    "description": "ServiceNow change request (change_request), JSON file via System Export Sets: JSON extract + ECS/custom field mapping, direct route.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "ServiceNow change request (change_request) via System Export Sets JSON file. Direct route. state is an integer choice-list code; its instance-specific sys_choice label lookup is NOT implemented (no lookup table is available in this work order, see README gap) - the raw code is passed through to servicenow.change.state. type/approval are JSON-export display values (labels) per ServiceNow's default reference/choice rendering and are passed through as-is. work_start/work_end have no fallback to a planned window because no planned-window vendor field name is given in this work order (see README gap)."
        },
        "description": "pipeline purpose"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "Cribl File Source reads the exported JSON array; extract fields from _raw"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "sys_id",
              "newName": "event.id"
            },
            {
              "currentName": "short_description",
              "newName": "message"
            }
          ]
        },
        "description": "straightforward 1:1 field copies"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "servicenow.change.number",
              "value": "__e['number']"
            },
            {
              "name": "servicenow.change.state",
              "value": "__e['state']"
            },
            {
              "name": "servicenow.change.type",
              "value": "__e['type']"
            },
            {
              "name": "servicenow.change.approval",
              "value": "__e['approval']"
            },
            {
              "name": "user.name",
              "value": "__e['assigned_to']"
            },
            {
              "name": "servicenow.change.cmdb_ci",
              "value": "__e['cmdb_ci']"
            },
            {
              "name": "event.start",
              "value": "__e['work_start']"
            },
            {
              "name": "event.end",
              "value": "__e['work_end']"
            },
            {
              "name": "event.outcome",
              "value": "__e['close_code']==='successful' ? 'success' : (__e['close_code']==='unsuccessful' ? 'failure' : 'unknown')"
            },
            {
              "name": "servicenow.change.close_code_raw",
              "value": "__e['close_code']"
            },
            {
              "name": "_time",
              "value": "Date.parse(__e['sys_updated_on'].replace(' ','T')+'Z')/1000"
            },
            {
              "name": "event.dataset",
              "value": "'servicenow.change_request'"
            }
          ],
          "remove": [
            "number",
            "state",
            "type",
            "approval",
            "assigned_to",
            "cmdb_ci",
            "work_start",
            "work_end",
            "close_code",
            "sys_updated_on"
          ]
        },
        "description": "map the correlation columns to servicenow.change.*, put the display-name assigned_to on user.name (full name, not login - see README gap for user.id), derive event.outcome from close_code while retaining the raw value, set _time from the sys_updated_on watermark, tag event.dataset"
      }
    ]
  }
}
