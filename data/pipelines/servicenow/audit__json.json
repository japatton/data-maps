{
  "id": "dm_servicenow_audit_json",
  "conf": {
    "output": "default",
    "description": "ServiceNow audit (sys_audit), JSON file via System Export Sets: JSON extract + ECS/custom field mapping, direct route.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "ServiceNow audit (sys_audit) via System Export Sets JSON file. Direct route. user renders as the sys_user display full name (not the login), so it maps to user.full_name; user.id is unavailable unless the Export Definition dot-walks user.sys_id under an operator-chosen column name we cannot guess (see README gap). oldvalue/newvalue redaction and sys_id dedup are not implemented (see README gaps)."
        },
        "description": "pipeline purpose"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "Cribl File Source reads the exported JSON array; extract each row's fields from _raw"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "sys_created_by",
              "newName": "user.name"
            },
            {
              "currentName": "sys_id",
              "newName": "event.id"
            }
          ]
        },
        "description": "sys_created_by is the change actor's login name"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "servicenow.audit.table_name",
              "value": "__e['tablename']"
            },
            {
              "name": "servicenow.audit.document_key",
              "value": "__e['documentkey']"
            },
            {
              "name": "servicenow.audit.field_name",
              "value": "__e['fieldname']"
            },
            {
              "name": "servicenow.audit.old_value",
              "value": "__e['oldvalue']"
            },
            {
              "name": "servicenow.audit.new_value",
              "value": "__e['newvalue']"
            },
            {
              "name": "event.action",
              "value": "__e['fieldname']==='DELETED' ? 'deleted' : (__e['fieldname']==='RECOVERED' ? 'recovered' : 'updated')"
            },
            {
              "name": "user.full_name",
              "value": "__e['user']"
            },
            {
              "name": "_time",
              "value": "Date.parse(__e['sys_created_on'].replace(' ','T')+'Z')/1000"
            },
            {
              "name": "event.dataset",
              "value": "'servicenow.audit'"
            }
          ],
          "remove": [
            "tablename",
            "documentkey",
            "fieldname",
            "oldvalue",
            "newvalue",
            "sys_created_on",
            "user"
          ]
        },
        "description": "map the audit discriminator columns to servicenow.audit.*, put the JSON export's display-value user column on user.full_name, derive event.action from DELETED/RECOVERED, set _time from Glide sys_created_on, tag event.dataset, drop duplicated raw columns"
      }
    ]
  }
}
