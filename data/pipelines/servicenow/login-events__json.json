{
  "id": "dm_servicenow_login_events_json",
  "conf": {
    "output": "default",
    "description": "ServiceNow login/session events (sysevent), JSON file via System Export Sets: JSON extract + ECS field mapping, direct route.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "ServiceNow login/session events (sysevent) via System Export Sets JSON file. Direct route. The Export Definition is expected to condition on the login/logout/login.failed name allow-list, so the parm1/parm2 gating below is defense-in-depth. sys_id dedup across overlapping exports not implemented in-pipeline (see README gap)."
        },
        "description": "pipeline purpose"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "Cribl File Source reads the exported JSON array; extract fields from _raw"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "servicenow.sysevent.instance_sys_id",
              "value": "__e['instance']"
            },
            {
              "name": "event.outcome",
              "value": "__e['name']==='login.failed' ? 'failure' : (__e['name']==='login' || __e['name']==='logout' ? 'success' : 'unknown')"
            },
            {
              "name": "user.name",
              "value": "(__e['name']==='login'||__e['name']==='logout'||__e['name']==='login.failed') ? __e['parm1'] : undefined"
            },
            {
              "name": "source.ip",
              "value": "/^(\\d{1,3}\\.){3}\\d{1,3}$|^[0-9a-fA-F:]+$/.test(__e['parm2']) ? __e['parm2'] : undefined"
            },
            {
              "name": "_time",
              "value": "Date.parse(__e['sys_created_on'].replace(' ','T')+'Z')/1000"
            },
            {
              "name": "event.dataset",
              "value": "'servicenow.login_events'"
            }
          ],
          "remove": [
            "instance",
            "parm1",
            "parm2",
            "sys_created_on"
          ]
        },
        "description": "gate the generic parm1/parm2 parameters on the login-family event name, validate parm2 as an IP before assigning source.ip, derive event.outcome from the name (login.failed=failure, login/logout=success), map the instance reference to a custom field, set _time from Glide sys_created_on, tag event.dataset"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "name",
              "newName": "event.action"
            },
            {
              "currentName": "sys_id",
              "newName": "event.id"
            }
          ]
        },
        "description": "straightforward 1:1 field copies"
      }
    ]
  }
}
