{
  "id": "dm_servicenow_transaction_kafka_json",
  "conf": {
    "output": "default",
    "description": "ServiceNow transaction log (syslog_transaction), kafka-json via LES Kafka topic: JSON extract + ECS field mapping, direct route.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "ServiceNow transaction log (syslog_transaction) via LES Kafka topic, kafka-json. Direct route. recommendations.direct.cribl calls for the same URL normalization/drop rules as the guarded path for ingest-cost reasons; percent-decoding and the static-asset/polling-URL drop rule are NOT implemented here because no concrete pattern or allow-list is given anywhere in the work order (see README gap). sys_id dedup not implemented in-pipeline (see README gap)."
        },
        "description": "pipeline purpose"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "LES streams each transaction as a JSON record; extract fields from _raw"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "sys_created_by",
              "newName": "user.name"
            },
            {
              "currentName": "remote_ip",
              "newName": "source.ip"
            },
            {
              "currentName": "sys_id",
              "newName": "event.id"
            }
          ]
        },
        "description": "straightforward 1:1 field copies"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "url.original",
              "value": "__e['url']"
            },
            {
              "name": "url.path",
              "value": "__e['url'].indexOf('?') > -1 ? __e['url'].substring(0, __e['url'].indexOf('?')) : __e['url']"
            },
            {
              "name": "url.query",
              "value": "__e['url'].indexOf('?') > -1 ? __e['url'].substring(__e['url'].indexOf('?')+1) : undefined"
            },
            {
              "name": "event.duration",
              "value": "+__e['response_time']*1000000"
            },
            {
              "name": "http.response.body.bytes",
              "value": "+__e['output_length']"
            },
            {
              "name": "servicenow.transaction.type",
              "value": "__e['type']"
            },
            {
              "name": "servicenow.transaction.session_id",
              "value": "__e['session_id']"
            },
            {
              "name": "_time",
              "value": "Date.parse(__e['sys_created_on'].replace(' ','T')+'Z')/1000"
            },
            {
              "name": "event.dataset",
              "value": "'servicenow.transaction'"
            }
          ],
          "remove": [
            "url",
            "response_time",
            "output_length",
            "type",
            "session_id",
            "sys_created_on"
          ]
        },
        "description": "split url into path/query (url.domain is not set - the instance hostname is not present in the row and is not guessed, see README gap), convert response_time ms to event.duration ns, cast output_length to a number, map transaction origin and session id to custom fields, set _time, tag event.dataset"
      }
    ]
  }
}
