{
  "id": "dm_servicenow_change_request_csv_file",
  "conf": {
    "output": "default",
    "description": "ServiceNow change request (change_request), CSV file via System Export Sets: CSV extract + ECS/custom field mapping, direct route.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "ServiceNow change request (change_request) via System Export Sets CSV file. Direct route. state may be exported as either the numeric code or its label depending on the Export Definition's label setting; this ambiguity cannot be resolved generically, so the raw value is passed through unlookup'd to servicenow.change.state (see README gap). CSV has no value/display pairing, so assigned_to is the display full name."
        },
        "description": "pipeline purpose"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "csv",
          "srcField": "_raw"
        },
        "description": "Cribl File Source (CSV) reads the exported file; the header row names the selected columns"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "sys_id",
              "newName": "event.id"
            }
          ]
        },
        "description": "straightforward 1:1 field copy"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "servicenow.change.number",
              "value": "__e['number']"
            },
            {
              "name": "servicenow.change.state",
              "value": "__e['state']"
            },
            {
              "name": "servicenow.change.approval",
              "value": "__e['approval']"
            },
            {
              "name": "user.name",
              "value": "__e['assigned_to']"
            },
            {
              "name": "servicenow.change.cmdb_ci",
              "value": "__e['cmdb_ci']"
            },
            {
              "name": "message",
              "value": "__e['short_description'].replace(/[\\r\\n]+/g,' ')"
            },
            {
              "name": "event.outcome",
              "value": "__e['close_code']==='successful' ? 'success' : (__e['close_code']==='unsuccessful' ? 'failure' : 'unknown')"
            },
            {
              "name": "servicenow.change.close_code_raw",
              "value": "__e['close_code']"
            },
            {
              "name": "_time",
              "value": "Date.parse(__e['sys_updated_on'].replace(' ','T')+'Z')/1000"
            },
            {
              "name": "event.dataset",
              "value": "'servicenow.change_request'"
            }
          ],
          "remove": [
            "number",
            "state",
            "approval",
            "assigned_to",
            "cmdb_ci",
            "short_description",
            "close_code",
            "sys_updated_on"
          ]
        },
        "description": "map the correlation columns to servicenow.change.*, normalize embedded line breaks out of short_description before it becomes message, derive event.outcome from close_code while retaining the raw value, set _time from the sys_updated_on watermark, tag event.dataset"
      }
    ]
  }
}
