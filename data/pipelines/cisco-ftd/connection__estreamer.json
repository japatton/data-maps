{
  "id": "dm_cisco_ftd_connection_estreamer",
  "conf": {
    "output": "default",
    "description": "Cisco FTD connection event (430002/430003), eStreamer format: eNcore resolves the binary record + FMC metadata to NDJSON upstream of Cribl; this pipeline maps the resolved eNcore field names to ECS (direct route, no guard hop).",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "cisco-ftd / connection / estreamer. Input is eNcore-resolved NDJSON (eStreamer's own binary form cannot be decoded in Cribl). Per recommendations.direct.cribl, Cribl only routes/maps here - ID/UUID resolution already happened in eNcore. Assumes JSON wire format based on the dotted nested field names in the catalog (e.g. clientUrl.data)."
        },
        "description": "record scope and the JSON wire-format assumption"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "parse the eNcore NDJSON line"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "_time",
              "value": "__e['lastPacketTimestamp'] ? Number(__e['lastPacketTimestamp']) : (__e['firstPacketTimestamp'] ? Number(__e['firstPacketTimestamp']) : undefined)"
            },
            {
              "name": "'event.dataset'",
              "value": "'cisco_ftd.connection'"
            }
          ]
        },
        "description": "canonical event time (epoch seconds, already resolved by eNcore) and ECS dataset, set before rename touches the raw field names"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "initiatorIpAddress",
              "newName": "'source.ip'"
            },
            {
              "currentName": "responderIpAddress",
              "newName": "'destination.ip'"
            },
            {
              "currentName": "originalClientIpAddress",
              "newName": "'network.forwarded_ip'"
            },
            {
              "currentName": "initiatorPort",
              "newName": "'source.port'"
            },
            {
              "currentName": "responderPort",
              "newName": "'destination.port'"
            },
            {
              "currentName": "initiatorTransmittedBytes",
              "newName": "'source.bytes'"
            },
            {
              "currentName": "responderTransmittedBytes",
              "newName": "'destination.bytes'"
            },
            {
              "currentName": "initiatorTransmittedPackets",
              "newName": "'source.packets'"
            },
            {
              "currentName": "responderTransmittedPackets",
              "newName": "'destination.packets'"
            },
            {
              "currentName": "firstPacketTimestamp",
              "newName": "'event.start'"
            },
            {
              "currentName": "lastPacketTimestamp",
              "newName": "'event.end'"
            },
            {
              "currentName": "sslServerName",
              "newName": "'tls.client.server_name'"
            },
            {
              "currentName": "sslCertificateFingerprint",
              "newName": "'tls.server.hash.sha1'"
            },
            {
              "currentName": "vlanId",
              "newName": "'network.vlan.id'"
            },
            {
              "currentName": "ruleReason",
              "newName": "'event.reason'"
            },
            {
              "currentName": "policyRevision",
              "newName": "'rule.ruleset'"
            },
            {
              "currentName": "ruleId",
              "newName": "'rule.name'"
            },
            {
              "currentName": "ingressZone",
              "newName": "'observer.ingress.zone'"
            },
            {
              "currentName": "egressZone",
              "newName": "'observer.egress.zone'"
            },
            {
              "currentName": "ingressInterface",
              "newName": "'observer.ingress.interface.name'"
            },
            {
              "currentName": "egressInterface",
              "newName": "'observer.egress.interface.name'"
            },
            {
              "currentName": "applicationId",
              "newName": "'network.protocol'"
            },
            {
              "currentName": "webApplicationId",
              "newName": "'network.application'"
            },
            {
              "currentName": "clientUrl.data",
              "newName": "'url.original'"
            },
            {
              "currentName": "dnsQuery.data",
              "newName": "'dns.question.name'"
            },
            {
              "currentName": "httpResponse",
              "newName": "'http.response.status_code'"
            }
          ]
        },
        "description": "batch-rename every mapped/already-resolved field to its ECS target"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'network.iana_number'",
              "value": "__e['protocol']"
            },
            {
              "name": "'network.transport'",
              "value": "__e['protocol']==6 || __e['protocol']=='6' ? 'tcp' : (__e['protocol']==17 || __e['protocol']=='17' ? 'udp' : (__e['protocol']==1 || __e['protocol']=='1' ? 'icmp' : (__e['protocol']==58 || __e['protocol']=='58' ? 'icmp6' : 'other')))"
            },
            {
              "name": "'event.action'",
              "value": "__e['ruleAction']"
            },
            {
              "name": "'event.outcome'",
              "value": "(typeof __e['ruleAction']==='string' && __e['ruleAction'].indexOf('Block')>-1) ? 'failure' : (__e['ruleAction'] ? 'success' : undefined)"
            },
            {
              "name": "'user.name'",
              "value": "(__e['userId'] && __e['userId'].indexOf('\\\\') > -1) ? __e['userId'].substring(__e['userId'].indexOf('\\\\') + 1) : __e['userId']"
            },
            {
              "name": "'user.domain'",
              "value": "(__e['userId'] && __e['userId'].indexOf('\\\\') > -1) ? __e['userId'].substring(0, __e['userId'].indexOf('\\\\')) : undefined"
            },
            {
              "name": "'cisco.ftd.estreamer.client_application'",
              "value": "__e['clientApplicationId']"
            },
            {
              "name": "'cisco.ftd.estreamer.url_category'",
              "value": "__e['urlCategory']"
            },
            {
              "name": "'cisco.ftd.estreamer.connection_id'",
              "value": "__e['connectionCounter']"
            },
            {
              "name": "'cisco.ftd.estreamer.num_ioc'",
              "value": "__e['iocNumber']"
            },
            {
              "name": "'cisco.ftd.estreamer.security_intelligence_list'",
              "value": "__e['securityIntelligenceList1']"
            }
          ]
        },
        "description": "protocol/action/user transforms (constraint: bracket-access __e, ternary not arrow fn) and the unmapped custom fields"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
