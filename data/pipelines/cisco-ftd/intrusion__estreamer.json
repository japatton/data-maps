{
  "id": "dm_cisco_ftd_intrusion_estreamer",
  "conf": {
    "output": "default",
    "description": "Cisco FTD intrusion event (430001), eStreamer format: eNcore resolves GID/SID/classification via FMC metadata upstream; this pipeline maps the resolved field names to ECS (direct route, no guard hop, unsampled per catalog).",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "cisco-ftd / intrusion / estreamer. Input is eNcore-resolved NDJSON. rule.name (signature message) is intentionally NOT mapped: the catalog names its source as the synthetic '@computed.message' rather than a literal eNcore key, and a field path containing '@' is rejected by this platform - see README gap."
        },
        "description": "record scope and the rule.name gap"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "parse the eNcore NDJSON line"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "event.dataset",
              "value": "'cisco_ftd.intrusion'"
            }
          ]
        },
        "description": "ECS dataset tag; no _time step - the catalog lists no timestamp field for this format, see README gap"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "sourceIpAddress",
              "newName": "source.ip"
            },
            {
              "currentName": "destinationIpAddress",
              "newName": "destination.ip"
            },
            {
              "currentName": "ruleRevision",
              "newName": "rule.version"
            },
            {
              "currentName": "vlanId",
              "newName": "network.vlan.id"
            },
            {
              "currentName": "renderedId",
              "newName": "rule.id"
            },
            {
              "currentName": "sourcePortOrIcmpType",
              "newName": "source.port"
            },
            {
              "currentName": "destinationPortOrIcmpType",
              "newName": "destination.port"
            },
            {
              "currentName": "classificationId",
              "newName": "rule.category"
            },
            {
              "currentName": "policyUuid",
              "newName": "rule.ruleset"
            },
            {
              "currentName": "interfaceIngressUuid",
              "newName": "observer.ingress.interface.name"
            },
            {
              "currentName": "interfaceEgressUuid",
              "newName": "observer.egress.interface.name"
            },
            {
              "currentName": "securityZoneIngressUuid",
              "newName": "observer.ingress.zone"
            },
            {
              "currentName": "securityZoneEgressUuid",
              "newName": "observer.egress.zone"
            },
            {
              "currentName": "applicationId",
              "newName": "network.protocol"
            },
            {
              "currentName": "httpResponse",
              "newName": "http.response.status_code"
            }
          ]
        },
        "description": "batch-rename every mapped/already-resolved field to its ECS target"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "network.iana_number",
              "value": "__e['ipProtocolId']"
            },
            {
              "name": "network.transport",
              "value": "__e['ipProtocolId']==6 || __e['ipProtocolId']=='6' ? 'tcp' : (__e['ipProtocolId']==17 || __e['ipProtocolId']=='17' ? 'udp' : (__e['ipProtocolId']==1 || __e['ipProtocolId']=='1' ? 'icmp' : (__e['ipProtocolId']==58 || __e['ipProtocolId']=='58' ? 'icmp6' : 'other')))"
            },
            {
              "name": "event.severity",
              "value": "Number(__e['priorityId'])===1 ? 3 : (Number(__e['priorityId'])===2 ? 2 : (Number(__e['priorityId'])===3 ? 1 : undefined))"
            },
            {
              "name": "event.outcome",
              "value": "Number(__e['blocked'])===1 ? 'failure' : (Number(__e['blocked'])===0 ? 'success' : (Number(__e['blocked'])===2 ? 'unknown' : undefined))"
            },
            {
              "name": "cisco.ftd.estreamer.inline_result",
              "value": "__e['blocked']"
            },
            {
              "name": "user.name",
              "value": "(__e['userId'] && __e['userId'].indexOf('\\\\') > -1) ? __e['userId'].substring(__e['userId'].indexOf('\\\\') + 1) : __e['userId']"
            },
            {
              "name": "user.domain",
              "value": "(__e['userId'] && __e['userId'].indexOf('\\\\') > -1) ? __e['userId'].substring(0, __e['userId'].indexOf('\\\\')) : undefined"
            },
            {
              "name": "cisco.ftd.estreamer.gid",
              "value": "__e['generatorId']"
            },
            {
              "name": "cisco.ftd.estreamer.impact",
              "value": "__e['impact']"
            },
            {
              "name": "cisco.ftd.estreamer.impact_flags",
              "value": "__e['impactFlags']"
            },
            {
              "name": "cisco.ftd.estreamer.access_control_rule_id",
              "value": "__e['accessControlRuleId']"
            },
            {
              "name": "cisco.ftd.estreamer.connection_id",
              "value": "__e['connectionCounter']"
            },
            {
              "name": "cisco.ftd.estreamer.num_ioc",
              "value": "__e['iocNumber']"
            }
          ]
        },
        "description": "priority/blocked/protocol/user transforms - blocked==2 kept distinct from ==1 per the catalog's false-confidence warning"
      }
    ]
  }
}
