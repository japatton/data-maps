{
  "id": "dm_insider_threat_uam_console_audit_json",
  "conf": {
    "output": "default",
    "description": "insider-threat-uam, console-audit, json: parses the watch-the-watcher console operator/investigator audit record. ALL field names are work-order placeholders pending confirmation. Cardinal rule: operator stays on user.name, subject stays on user.target.name - never collapsed.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "insider-threat-uam / console-audit / json. Oversight-only feed (legal/privacy/IG), NOT for UAM analysts or the CSOC. PLACEHOLDER field names throughout. Operator (watcher) and subject (watched) MUST stay on separate ECS homes."
        },
        "description": "pipeline identity"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "parse the JSON console-audit record"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "console_name",
              "newName": "observer.name"
            },
            {
              "currentName": "operator_name",
              "newName": "user.name"
            },
            {
              "currentName": "subject_user",
              "newName": "user.target.name"
            },
            {
              "currentName": "console_action",
              "newName": "event.action"
            },
            {
              "currentName": "source_address",
              "newName": "source.ip"
            }
          ]
        },
        "description": "batch rename the documented/placeholder mapped fields; operator_name and subject_user are deliberately routed to different ECS namespaces, never merged"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "event.outcome",
              "value": "__e['action_result'] ? (String(__e['action_result']).toLowerCase()==='success' ? 'success' : (String(__e['action_result']).toLowerCase()==='denied' || String(__e['action_result']).toLowerCase()==='failure') ? 'failure' : 'unknown') : undefined"
            },
            {
              "name": "uam.operator.role",
              "value": "__e['operator_role']"
            },
            {
              "name": "uam.operator.second_approver",
              "value": "__e['second_approver']"
            },
            {
              "name": "uam.policy.object",
              "value": "__e['policy_object']"
            },
            {
              "name": "uam.export.record_count",
              "value": "__e['export_record_count']"
            },
            {
              "name": "uam.case.id",
              "value": "__e['case_id']"
            },
            {
              "name": "related.user",
              "value": "((__e['user'] && __e['user']['name']) && (__e['user'] && __e['user']['target'] && __e['user']['target']['name'])) ? [__e['user']['name'], __e['user']['target']['name']] : (__e['user'] && __e['user']['name']) ? [__e['user']['name']] : (__e['user'] && __e['user']['target'] && __e['user']['target']['name']) ? [__e['user']['target']['name']] : undefined"
            }
          ]
        },
        "description": "normalize action_result to ECS event.outcome vocabulary - the documented third state (awaiting second approval) has no ECS home and collapses to 'unknown', a modelling gap; carry every unmapped oversight field as custom, untouched, per recommendations.direct.cribl (export_record_count and second_approver are never sampled or altered); populate related.user with both operator and subject"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "remove": [
            "operator_role",
            "second_approver",
            "policy_object",
            "export_record_count",
            "case_id"
          ]
        },
        "description": "drop originals now carried under custom names"
      },
      {
        "id": "auto_timestamp",
        "filter": "true",
        "conf": {
          "srcField": "event_time",
          "dstField": "_time"
        },
        "description": "event time from the console's own event_time; never target @timestamp directly"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "event.dataset",
              "value": "'insider_threat_uam.console_audit'"
            }
          ]
        },
        "description": "set event.dataset for the logs-uam.console-insider_threat_oversight data stream"
      }
    ]
  }
}