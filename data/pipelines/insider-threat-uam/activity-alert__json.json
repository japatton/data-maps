{
  "id": "dm_insider_threat_uam_activity_alert_json",
  "conf": {
    "output": "default",
    "description": "insider-threat-uam, activity-alert, json: parses the Proofpoint ITM v2 / Everfox-class UAM activity-alert JSON record, applies ECS mapping (correcting the two mismaps in the stock proofpoint_itm ingest pipeline per recommendations.direct.cribl), drops windowTitle and _raw per the do-not-collect redaction control, and leaves severity/operationKind vocabulary normalization as a documented gap pending site policy export.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "insider-threat-uam / activity-alert / json. UAM policy-triggered activity alert (Proofpoint ITM v2 API shape, used as class exemplar). Redaction-as-control pipeline: enforces do-not-collect a second time low-side."
        },
        "description": "pipeline identity"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "parse the JSON activity-alert record"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "id",
              "newName": "event.id"
            },
            {
              "currentName": "loginName",
              "newName": "user.name"
            },
            {
              "currentName": "domainName",
              "newName": "user.domain"
            },
            {
              "currentName": "endpointName",
              "newName": "host.name"
            },
            {
              "currentName": "endpointId",
              "newName": "agent.id"
            },
            {
              "currentName": "ruleName",
              "newName": "rule.name"
            },
            {
              "currentName": "ruleCategoryName",
              "newName": "rule.category"
            },
            {
              "currentName": "operationKind",
              "newName": "event.action"
            },
            {
              "currentName": "originFileName",
              "newName": "file.name"
            },
            {
              "currentName": "accessedUrl",
              "newName": "url.full"
            },
            {
              "currentName": "processExecutable",
              "newName": "process.executable"
            },
            {
              "currentName": "remoteAddress",
              "newName": "source.ip"
            },
            {
              "currentName": "risk_score",
              "newName": "user.risk.calculated_score"
            }
          ]
        },
        "description": "batch rename every status:mapped/simple-partial field to its ECS home; domainName->user.domain and remoteAddress->source.ip deliberately do NOT copy the stock proofpoint_itm pipeline's source.domain/host.ip mistakes"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "host.os.type",
              "value": "__e['os'] ? (String(__e['os']).toLowerCase().indexOf('win')>-1 ? 'windows' : (String(__e['os']).toLowerCase().indexOf('mac')>-1 || String(__e['os']).toLowerCase().indexOf('darwin')>-1) ? 'macos' : String(__e['os']).toLowerCase().indexOf('linux')>-1 ? 'linux' : undefined) : undefined"
            },
            {
              "name": "uam.session.id",
              "value": "__e['sessionId']"
            },
            {
              "name": "uam.capture.playback_url",
              "value": "__e['playbackUrl']"
            },
            {
              "name": "uam.target.file_name",
              "value": "__e['targetFileName']"
            },
            {
              "name": "related.user",
              "value": "(__e['user'] && __e['user']['name']) ? [__e['user']['name']] : undefined"
            }
          ]
        },
        "description": "normalize os to ECS host.os.type vocabulary; carry the unmapped custom fields (session id, capture reference, exfil target file - never the capture payload); populate related.user for CNSSD 504 attribution"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "remove": [
            "os",
            "sessionId",
            "playbackUrl",
            "targetFileName",
            "windowTitle",
            "_raw"
          ]
        },
        "description": "drop originals promoted above, plus windowTitle (masked-or-drop per do-not-collect control - dropped, no concrete mask pattern given) and _raw (would otherwise leak the un-redacted window title and full record verbatim)"
      },
      {
        "id": "auto_timestamp",
        "filter": "true",
        "conf": {
          "srcField": "risingValue",
          "dstField": "_time"
        },
        "description": "event time is risingValue (collector-assigned), not observedAt/createdAt, per recommendations.direct.cribl; never target @timestamp directly"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "event.dataset",
              "value": "'insider_threat_uam.activity_alert'"
            }
          ]
        },
        "description": "set event.dataset (hyphen-free) for the logs-uam.activity-insider_threat data stream"
      }
    ]
  }
}