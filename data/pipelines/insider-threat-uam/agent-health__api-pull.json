{
  "id": "dm_insider_threat_uam_agent_health_api_pull",
  "conf": {
    "output": "default",
    "description": "insider-threat-uam, agent-health, api-pull: turns one console-API poll snapshot row into a per-agent document. ALL field names are work-order placeholders (neither vendor publishes an agent-status field reference) - confirm every name/vocabulary against the deployed console before production use. Assumes the Collector's Source parser already flattens the JSON poll response before the pipeline stage; if not, add a serde json extract first.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "insider-threat-uam / agent-health / api-pull. Sensor coverage/health snapshot, polled not streamed - absence is the signal. PLACEHOLDER field names throughout per the work order; revalidate against the live console API."
        },
        "description": "pipeline identity"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "agent_id",
              "newName": "agent.id"
            },
            {
              "currentName": "agent_version",
              "newName": "agent.version"
            },
            {
              "currentName": "endpoint_name",
              "newName": "host.name"
            },
            {
              "currentName": "agent_status",
              "newName": "service.state"
            },
            {
              "currentName": "policy_name",
              "newName": "rule.name"
            },
            {
              "currentName": "tamper_action",
              "newName": "event.action"
            }
          ]
        },
        "description": "batch rename the documented/placeholder mapped fields to ECS"
      },
      {
        "id": "auto_timestamp",
        "filter": "true",
        "conf": {
          "srcField": "poll_time",
          "dstField": "_time"
        },
        "description": "use the poll time as the event time (not the agent's own last_checkin) so an absent agent still produces a current-timestamped document, per recommendations.direct.cribl"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "event.outcome",
              "value": "(__e['service'] && __e['service']['state']) ? (String(__e['service']['state']).toLowerCase()==='running' ? 'success' : (String(__e['service']['state']).toLowerCase()==='stopped' || String(__e['service']['state']).toLowerCase()==='uninstalled') ? 'failure' : String(__e['service']['state']).toLowerCase()==='degraded' ? 'unknown' : undefined) : undefined"
            },
            {
              "name": "uam.agent.last_checkin",
              "value": "__e['last_checkin']"
            },
            {
              "name": "uam.policy.version",
              "value": "__e['policy_version']"
            },
            {
              "name": "uam.agent.channels_enabled",
              "value": "__e['channels_enabled']"
            },
            {
              "name": "uam.agent.throttle_state",
              "value": "__e['throttle_state']"
            },
            {
              "name": "uam.agent.offline_cache_depth",
              "value": "__e['offline_cache_depth']"
            },
            {
              "name": "uam.agent.reporting_gap_sec",
              "value": "(__e['last_checkin'] && __e['poll_time']) ? Math.round((Date.parse(__e['poll_time']) - Date.parse(__e['last_checkin']))/1000) : undefined"
            }
          ]
        },
        "description": "derive event.outcome from the (placeholder, illustrative) agent_status vocabulary; carry every unmapped coverage field as custom; derive the reporting gap low-side per recommendations.direct.cribl rather than leaving it to query-time date math"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "remove": [
            "last_checkin",
            "policy_version",
            "channels_enabled",
            "throttle_state",
            "offline_cache_depth",
            "poll_time"
          ]
        },
        "description": "drop originals now carried under ECS/custom names"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "event.dataset",
              "value": "'insider_threat_uam.agent_health'"
            }
          ]
        },
        "description": "set event.dataset for the logs-uam.agent-insider_threat data stream"
      }
    ]
  }
}