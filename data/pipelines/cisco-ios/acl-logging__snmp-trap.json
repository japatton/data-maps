{
  "id": "dm_cisco_ios_acl_logging_snmp_trap",
  "conf": {
    "output": "default",
    "description": "Cisco IOS/IOS-XE acl-logging / snmp-trap: no stock integration or pack parses the CISCO-SYSLOG-MIB clogHistMsgText body for this family, so this is a genuine Cribl-side reparse of the six %SEC-6-IPACCESSLOG*/%FMANFP-6-IPACCESSLOG* template variants (LOGP/LOGDP/LOGSP/LOGNP/LOGRP/LOGRL), per direct.elastic recommendation.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "cisco-ios / acl-logging / snmp-trap. Upstream SNMP trap receiver decodes the PDU and forwards varbinds as JSON in _raw. clogHistMsgText carries the whole IPACCESSLOG sentence; six template variants are dissected below by clogHistMsgName. Message grammar (list <acl> <permitted|denied> <proto>(<port info>) -> ..., N packet(s)) is reconstructed from Cisco's documented IOS ACL-logging format since the work order gives token descriptions rather than a literal sample line -- flagged unverified in the README. clogHistSeverity (1-8 MIB enum) is converted to the Cisco 0-7 digit and is still inverted vs ECS, so log.level is derived from the standard severity-name table rather than thresholded raw. The 254-byte clogHistMsgText cap is flagged via cisco.ios.snmp.truncated."
        },
        "description": "document the varbind source, the six-variant reparse, and the truncation caveat"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "extract the JSON-encoded varbind object the upstream SNMP trap receiver forwards"
      },
      {
        "id": "regex_extract",
        "filter": "clogHistMsgName === 'IPACCESSLOGP'",
        "conf": {
          "regex": "/list (?<acl_name>\\S+) (?<acl_action>permitted|denied) (?<proto_name>\\S+) (?<src_ip>[0-9A-Fa-f.:]+)\\((?<src_port>\\d+)\\) -> (?<dst_ip>[0-9A-Fa-f.:]+)\\((?<dst_port>\\d+)\\), (?<pkt_count>\\d+) packets?/",
          "source": "clogHistMsgText"
        },
        "description": "dissect the LOGP/ACCESSLOGP variant (named protocol with source/destination ports)"
      },
      {
        "id": "regex_extract",
        "filter": "clogHistMsgName === 'IPACCESSLOGDP'",
        "conf": {
          "regex": "/list (?<acl_name>\\S+) (?<acl_action>permitted|denied) icmp (?<src_ip>[0-9A-Fa-f.:]+) -> (?<dst_ip>[0-9A-Fa-f.:]+) \\((?<icmp_type>\\d+)\\/(?<icmp_code>\\d+)\\), (?<pkt_count>\\d+) packets?/",
          "source": "clogHistMsgText"
        },
        "description": "dissect the LOGDP variant (ICMP type/code pair, no ports)"
      },
      {
        "id": "regex_extract",
        "filter": "clogHistMsgName === 'IPACCESSLOGSP'",
        "conf": {
          "regex": "/list (?<acl_name>\\S+) (?<acl_action>permitted|denied) igmp (?<src_ip>[0-9A-Fa-f.:]+) -> (?<dst_ip>[0-9A-Fa-f.:]+)(?:, (?<igmp_type>[A-Za-z0-9_-]+))?, (?<pkt_count>\\d+) packets?/",
          "source": "clogHistMsgText"
        },
        "description": "dissect the LOGSP variant (IGMP type, no ports)"
      },
      {
        "id": "regex_extract",
        "filter": "clogHistMsgName === 'IPACCESSLOGNP'",
        "conf": {
          "regex": "/list (?<acl_name>\\S+) (?<acl_action>permitted|denied) (?<proto_num>\\d+) (?<src_ip>[0-9A-Fa-f.:]+) -> (?<dst_ip>[0-9A-Fa-f.:]+), (?<pkt_count>\\d+) packets?/",
          "source": "clogHistMsgText"
        },
        "description": "dissect the LOGNP variant (bare protocol number, no ports)"
      },
      {
        "id": "regex_extract",
        "filter": "clogHistMsgName === 'IPACCESSLOGRP'",
        "conf": {
          "regex": "/list (?<acl_name>\\S+) (?<acl_action>permitted|denied) (?<proto_name>\\S+) (?<src_ip>[0-9A-Fa-f.:]+) -> (?<dst_ip>[0-9A-Fa-f.:]+), (?<pkt_count>\\d+) packets?/",
          "source": "clogHistMsgText"
        },
        "description": "dissect the LOGRP variant (named protocol, no ports)"
      },
      {
        "id": "regex_extract",
        "filter": "clogHistMsgName === 'IPACCESSLOGRL'",
        "conf": {
          "regex": "/rate-limited or missed (?<rl_count>\\d+) packets?/",
          "source": "clogHistMsgText"
        },
        "description": "dissect the LOGRL rate-limiter companion record (count of matches dropped by the device's own logging rate limiter)"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'network.transport'",
              "value": "__e['proto_name'] ? __e['proto_name'].toLowerCase() : undefined"
            },
            {
              "name": "'network.iana_number'",
              "value": "__e['proto_num'] !== undefined ? Number(__e['proto_num']) : undefined"
            },
            {
              "name": "'source.ip'",
              "value": "__e['src_ip']"
            },
            {
              "name": "'destination.ip'",
              "value": "__e['dst_ip']"
            },
            {
              "name": "'source.port'",
              "value": "__e['src_port'] !== undefined && Number(__e['src_port']) !== 0 ? Number(__e['src_port']) : undefined"
            },
            {
              "name": "'destination.port'",
              "value": "__e['dst_port'] !== undefined && Number(__e['dst_port']) !== 0 ? Number(__e['dst_port']) : undefined"
            },
            {
              "name": "'rule.name'",
              "value": "__e['acl_name']"
            },
            {
              "name": "'event.action'",
              "value": "__e['acl_action'] === 'permitted' ? 'allow' : (__e['acl_action'] === 'denied' ? 'deny' : undefined)"
            },
            {
              "name": "'event.type'",
              "value": "__e['acl_action'] === 'permitted' ? ['allowed'] : (__e['acl_action'] === 'denied' ? ['denied'] : undefined)"
            },
            {
              "name": "'source.packets'",
              "value": "__e['pkt_count'] !== undefined ? Number(__e['pkt_count']) : undefined"
            },
            {
              "name": "'cisco.ios.icmp.type'",
              "value": "__e['icmp_type'] !== undefined ? Number(__e['icmp_type']) : undefined"
            },
            {
              "name": "'cisco.ios.icmp.code'",
              "value": "__e['icmp_code'] !== undefined ? Number(__e['icmp_code']) : undefined"
            },
            {
              "name": "'cisco.ios.igmp.type'",
              "value": "__e['igmp_type']"
            },
            {
              "name": "'cisco.ios.acl.rate_limited_count'",
              "value": "__e['rl_count'] !== undefined ? Number(__e['rl_count']) : undefined"
            },
            {
              "name": "'observer.type'",
              "value": "'firewall'"
            },
            {
              "name": "'event.severity'",
              "value": "__e['clogHistSeverity'] !== undefined ? Number(__e['clogHistSeverity']) - 1 : undefined"
            },
            {
              "name": "'log.level'",
              "value": "__e['clogHistSeverity'] !== undefined ? ['emergency','alert','critical','error','warning','notice','informational','debug'][Number(__e['clogHistSeverity']) - 1] : undefined"
            },
            {
              "name": "'cisco.ios.snmp.sysuptime'",
              "value": "__e['clogHistTimestamp']"
            },
            {
              "name": "'cisco.ios.snmp.history_index'",
              "value": "__e['clogHistIndex']"
            },
            {
              "name": "'cisco.ios.snmp.truncated'",
              "value": "__e['clogHistMsgText'] ? __e['clogHistMsgText'].length >= 254 : undefined"
            }
          ],
          "remove": [
            "acl_name",
            "acl_action",
            "proto_name",
            "proto_num",
            "src_ip",
            "src_port",
            "dst_ip",
            "dst_port",
            "pkt_count",
            "icmp_type",
            "icmp_code",
            "igmp_type",
            "rl_count",
            "clogHistSeverity",
            "clogHistTimestamp",
            "clogHistIndex"
          ]
        },
        "description": "per direct.elastic: derive event.action/event.type from the permitted/denied token, split protocol/ports/ICMP/IGMP tokens into ECS and custom icmp.*/igmp.* fields, sum source.packets, convert the inverted MIB severity via the shared lookup, and route the remaining unmapped varbinds to their custom targets. event.outcome is deliberately left unset (recommendation: 'leave event.outcome null')"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "clogHistMsgText",
              "newName": "'event.original'"
            },
            {
              "currentName": "clogHistMsgName",
              "newName": "'event.code'"
            },
            {
              "currentName": "clogHistFacility",
              "newName": "'cisco.ios.facility'"
            }
          ]
        },
        "description": "map the straight 1:1 CISCO-SYSLOG-MIB varbinds onto their ECS/custom targets (event.original was already reparsed above)"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'event.dataset'",
              "value": "'cisco_ios.acl_logging'"
            }
          ]
        },
        "description": "tag the event with its dataset"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
