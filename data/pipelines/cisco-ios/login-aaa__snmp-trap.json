{
  "id": "dm_cisco_ios_login_aaa_snmp_trap",
  "conf": {
    "output": "default",
    "description": "Cisco IOS/IOS-XE login-aaa / snmp-trap: no stock branch parses LOGIN_FAILED, QUIET_MODE_ON, SSH2_USERAUTH, PRIV_AUTH_PASS/_FAIL or the AAA/RADIUS/TACACS family, so this is a genuine Cribl-side reparse of clogHistMsgText for the bracketed [user:]/[Source:]/[localport:]/[Reason:] tokens the map itself calls out, per direct.elastic recommendation.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "cisco-ios / login-aaa / snmp-trap. Upstream SNMP trap receiver decodes the PDU and forwards varbinds as JSON in _raw. Reparses the bracketed [user:]/[Source:]/[localport:]/[Reason:] tokens (LOGIN_SUCCESS/LOGIN_FAILED/QUIET_MODE_ON), the LOGOUT tty-session grammar, and the SSH2_USERAUTH cipher/hmac/result grammar the work order names explicitly. RADIUS/TACACS server-state bodies are NOT reparsed -- no literal body text is given for them anywhere in the map, only the mnemonic family name, so extracting fields from them would be guessing (documented gap in README). event.outcome is derived from event.code by lookup per recommendation, since eventSeverity/facility carry no outcome signal on their own."
        },
        "description": "document the varbind source, which mnemonic bodies are reparsed, and the RADIUS/TACACS gap"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "extract the JSON-encoded varbind object the upstream SNMP trap receiver forwards"
      },
      {
        "id": "regex_extract",
        "filter": "clogHistMsgName === 'LOGIN_SUCCESS'",
        "conf": {
          "regex": "/\\[user:\\s*(?<aaa_user>[^\\]]+)\\]\\s*\\[Source:\\s*(?<aaa_src>[^\\]]+)\\]\\s*\\[localport:\\s*(?<aaa_port>[^\\]]+)\\]/",
          "source": "clogHistMsgText"
        },
        "description": "dissect the LOGIN_SUCCESS bracketed tokens"
      },
      {
        "id": "regex_extract",
        "filter": "clogHistMsgName === 'LOGIN_FAILED'",
        "conf": {
          "regex": "/\\[user:\\s*(?<aaa_user>[^\\]]+)\\]\\s*\\[Source:\\s*(?<aaa_src>[^\\]]+)\\]\\s*\\[localport:\\s*(?<aaa_port>[^\\]]+)\\]\\s*\\[Reason:\\s*(?<aaa_reason>[^\\]]+)\\]/",
          "source": "clogHistMsgText"
        },
        "description": "dissect the LOGIN_FAILED bracketed tokens, including the failure reason"
      },
      {
        "id": "regex_extract",
        "filter": "clogHistMsgName === 'QUIET_MODE_ON'",
        "conf": {
          "regex": "/\\[user:\\s*(?<aaa_user>[^\\]]+)\\]\\s*\\[Source:\\s*(?<aaa_src>[^\\]]+)\\]\\s*\\[localport:\\s*(?<aaa_port>[^\\]]+)\\]\\s*\\[Reason:\\s*(?<aaa_reason>[^\\]]+)\\]/",
          "source": "clogHistMsgText"
        },
        "description": "dissect the QUIET_MODE_ON bracketed tokens (the login-block trip that references the last offending attempt)"
      },
      {
        "id": "regex_extract",
        "filter": "clogHistMsgName === 'QUIET_MODE_ON'",
        "conf": {
          "regex": "/Login failure count:\\s*(?<aaa_failcount>\\d+)/",
          "source": "clogHistMsgText"
        },
        "description": "dissect the QUIET_MODE_ON failure-count tail, when present"
      },
      {
        "id": "regex_extract",
        "filter": "clogHistMsgName === 'LOGOUT'",
        "conf": {
          "regex": "/User\\s+(?<aaa_user>\\S+)\\s+has exited tty session\\s+(?<aaa_tty>\\d+)\\((?<aaa_src>[^)]+)\\)/",
          "source": "clogHistMsgText"
        },
        "description": "dissect the LOGOUT tty-session teardown"
      },
      {
        "id": "regex_extract",
        "filter": "clogHistMsgName === 'SSH2_USERAUTH'",
        "conf": {
          "regex": "/User\\s+'(?<aaa_user>[^']+)'\\s+authentication for SSH2 Session from\\s+(?<aaa_src>\\S+)\\s+\\(tty = (?<aaa_tty>\\d+)\\)\\s+using crypto cipher\\s+'(?<ssh_cipher>[^']+)',\\s*hmac\\s+'(?<ssh_hmac>[^']+)'\\s+(?<ssh_result>Succeeded|Failed)/",
          "source": "clogHistMsgText"
        },
        "description": "dissect the SSH2_USERAUTH cipher/hmac/result grammar the work order names explicitly"
      },
      {
        "id": "regex_extract",
        "filter": "clogHistMsgName === 'PRIV_AUTH_PASS'",
        "conf": {
          "regex": "/Successful authentication to a privileged level by\\s+(?<aaa_user>\\S+)\\s+on line\\s+(?<aaa_line>\\S+)/",
          "source": "clogHistMsgText"
        },
        "description": "dissect the enable-mode escalation success"
      },
      {
        "id": "regex_extract",
        "filter": "clogHistMsgName === 'PRIV_AUTH_FAIL'",
        "conf": {
          "regex": "/Authentication to a privileged level failed by\\s+(?<aaa_user>\\S+)\\s+on line\\s+(?<aaa_line>\\S+)/",
          "source": "clogHistMsgText"
        },
        "description": "dissect the enable-mode escalation failure"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'user.name'",
              "value": "__e['aaa_user']"
            },
            {
              "name": "'source.ip'",
              "value": "__e['aaa_src']"
            },
            {
              "name": "'destination.port'",
              "value": "__e['aaa_port'] !== undefined ? Number(__e['aaa_port']) : undefined"
            },
            {
              "name": "'cisco.ios.aaa.reason'",
              "value": "__e['aaa_reason']"
            },
            {
              "name": "'cisco.ios.aaa.failure_count'",
              "value": "__e['aaa_failcount'] !== undefined ? Number(__e['aaa_failcount']) : undefined"
            },
            {
              "name": "'cisco.ios.session.tty'",
              "value": "__e['aaa_tty'] !== undefined ? Number(__e['aaa_tty']) : undefined"
            },
            {
              "name": "'cisco.ios.aaa.line'",
              "value": "__e['aaa_line']"
            },
            {
              "name": "'cisco.ios.ssh.cipher'",
              "value": "__e['ssh_cipher']"
            },
            {
              "name": "'cisco.ios.ssh.hmac'",
              "value": "__e['ssh_hmac']"
            },
            {
              "name": "'event.outcome'",
              "value": "(__e['clogHistMsgName'] === 'LOGIN_SUCCESS' || __e['clogHistMsgName'] === 'PRIV_AUTH_PASS') ? 'success' : ((__e['clogHistMsgName'] === 'LOGIN_FAILED' || __e['clogHistMsgName'] === 'QUIET_MODE_ON' || __e['clogHistMsgName'] === 'PRIV_AUTH_FAIL') ? 'failure' : (__e['clogHistMsgName'] === 'SSH2_USERAUTH' ? (__e['ssh_result'] === 'Succeeded' ? 'success' : (__e['ssh_result'] === 'Failed' ? 'failure' : undefined)) : undefined))"
            },
            {
              "name": "'event.severity'",
              "value": "__e['clogHistSeverity'] !== undefined ? Number(__e['clogHistSeverity']) - 1 : undefined"
            },
            {
              "name": "'log.level'",
              "value": "__e['clogHistSeverity'] !== undefined ? ['emergency','alert','critical','error','warning','notice','informational','debug'][Number(__e['clogHistSeverity']) - 1] : undefined"
            },
            {
              "name": "'cisco.ios.snmp.sysuptime'",
              "value": "__e['clogHistTimestamp']"
            },
            {
              "name": "'cisco.ios.snmp.history_index'",
              "value": "__e['clogHistIndex']"
            },
            {
              "name": "'cisco.ios.snmp.truncated'",
              "value": "__e['clogHistMsgText'] ? __e['clogHistMsgText'].length >= 254 : undefined"
            }
          ],
          "remove": [
            "aaa_user",
            "aaa_src",
            "aaa_port",
            "aaa_reason",
            "aaa_failcount",
            "aaa_tty",
            "aaa_line",
            "ssh_cipher",
            "ssh_hmac",
            "ssh_result",
            "clogHistSeverity",
            "clogHistTimestamp",
            "clogHistIndex"
          ]
        },
        "description": "per direct.elastic: derive event.outcome from event.code by lookup (this family carries no result phrase to parse for the unparsed mnemonics), populate user.name/source.ip for identity pivots, convert the inverted MIB severity via the shared lookup, and route the remaining unmapped varbinds to their custom targets"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "clogHistMsgText",
              "newName": "'event.original'"
            },
            {
              "currentName": "clogHistMsgName",
              "newName": "'event.code'"
            },
            {
              "currentName": "clogHistFacility",
              "newName": "'cisco.ios.facility'"
            }
          ]
        },
        "description": "map the straight 1:1 CISCO-SYSLOG-MIB varbinds onto their ECS/custom targets (event.original was already reparsed above)"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'event.dataset'",
              "value": "'cisco_ios.login_aaa'"
            }
          ]
        },
        "description": "tag the event with its dataset"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
