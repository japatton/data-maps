{
  "id": "dm_vms_cctv_operator_audit_events_api_pull",
  "conf": {
    "output": "default",
    "description": "VMS operator audit (Milestone XProtect Audit log + Genetec Activity/Audit trails), api-pull via SDK poll; normalizes both vendor shapes into one schema, parses Genetec's documented config-change Description grammar, converts Local/Modification time to _time. Milestone Message-text verb/entity/filename extraction and the export placeholders are left unmapped (undocumented grammar) -- see README.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "vms-cctv operator-audit-events, api-pull (Milestone SDK LogClient poll / Genetec ActivityTrailsQuery+AuditTrailQuery poll). See README for gaps."
        },
        "description": "Identify pipeline scope"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "User",
              "newName": "'user.name'"
            }
          ]
        },
        "description": "Batch rename of the one clean, status:mapped source name (Milestone User)"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/^Entity created: (?<vms_cfg_entity_created>.+)\\.$/",
          "source": "Description"
        },
        "description": "Genetec Audit trails (config-change) documented grammar: entity-created sentence form"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/^The (?<vms_cfg_property>.+) value changed from (?<vms_cfg_old_value>.+) to (?<vms_cfg_new_value>.+)\\.$/",
          "source": "Description"
        },
        "description": "Genetec Audit trails (config-change) documented grammar: property-changed sentence form"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "message",
              "value": "__e['Message text'] ? __e['Message text'] : (__e['Description'] ? __e['Description'] : __e['message'])"
            },
            {
              "name": "'observer.name'",
              "value": "__e['Source name']"
            },
            {
              "name": "'vms.log.source_type'",
              "value": "__e['Source type']"
            },
            {
              "name": "'vms.log.category'",
              "value": "__e['Category']"
            },
            {
              "name": "'event.outcome'",
              "value": "__e['Permission'] ? (/grant|allow/i.test(__e['Permission']) ? 'success' : (/den|refus|reject/i.test(__e['Permission']) ? 'failure' : __e['Permission'])) : __e['event.outcome']"
            },
            {
              "name": "'source.ip'",
              "value": "(__e['User location'] && /^\\d{1,3}(\\.\\d{1,3}){3}$/.test(__e['User location'])) ? __e['User location'] : __e['source.ip']"
            },
            {
              "name": "'source.address'",
              "value": "(__e['User location'] && !/^\\d{1,3}(\\.\\d{1,3}){3}$/.test(__e['User location'])) ? __e['User location'] : __e['Initiator machine']"
            },
            {
              "name": "'event.action'",
              "value": "__e['Activity name'] ? __e['Activity name'].toLowerCase().replace(/ /g,'_') : (__e['vms_cfg_property'] ? 'configuration_changed' : (__e['vms_cfg_entity_created'] ? 'entity_created' : __e['event.action']))"
            },
            {
              "name": "'user.name'",
              "value": "__e['user.name'] ? __e['user.name'] : __e['Initiator']"
            },
            {
              "name": "'vms.actor.type'",
              "value": "__e['Initiator type']"
            },
            {
              "name": "'vms.entity.name'",
              "value": "__e['Impacted entity'] ? __e['Impacted entity'] : __e['vms_cfg_entity_created']"
            },
            {
              "name": "'vms.entity.type'",
              "value": "__e['Impacted entity type']"
            },
            {
              "name": "'vms.client.application'",
              "value": "__e['Initiator application']"
            },
            {
              "name": "'vms.actor.original_initiator'",
              "value": "__e['Original initiator']"
            },
            {
              "name": "'vms.config.property'",
              "value": "__e['vms_cfg_property']"
            },
            {
              "name": "'vms.config.old_value'",
              "value": "__e['vms_cfg_old_value']"
            },
            {
              "name": "'vms.config.new_value'",
              "value": "__e['vms_cfg_new_value']"
            },
            {
              "name": "__dm_time",
              "value": "__e['Local time'] ? Date.parse(__e['Local time'])/1000 : (__e['Modification time'] ? Date.parse(__e['Modification time'])/1000 : __e['_time'])"
            },
            {
              "name": "_time",
              "value": "__e['__dm_time'] !== undefined && __e['__dm_time'] !== null && __e['__dm_time'] === __e['__dm_time'] ? __e['__dm_time'] : __e['_time']"
            },
            {
              "name": "'event.dataset'",
              "value": "'vms_cctv.operator_audit_events'"
            }
          ]
        },
        "description": "Awkward (space-containing) source names via bracket access; value transforms; unmapped->custom routing; _time; event.dataset"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
