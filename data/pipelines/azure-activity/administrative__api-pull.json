{
  "id": "dm_azure_activity_administrative_api_pull",
  "conf": {
    "output": "default",
    "description": "Azure Activity Logs (Government) administrative / api-pull: REST Collector against the Log Analytics Query API delivers one event per AzureActivity row with columns already parsed; this pipeline renames the clean columns, folds awkward/dynamic ones via eval, and tags event.dataset. Direct route, no guard hop.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "azure-activity / administrative / api-pull. Source: Cribl REST Collector polling the Gov Log Analytics Query API (AzureActivity table, CategoryValue==Administrative), which already returns one event per row with column names as top-level fields - no serde/json-extract step needed here. This step renames the AzureActivity columns to the resource-log/ECS field names the stock azure.activitylogs pipeline expects, per recommendations.direct.cribl. Direct route only."
        },
        "description": "record dataset, format, and parsing approach"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "EventSubmissionTimestamp",
              "newName": "'event.ingested'"
            },
            {
              "currentName": "EventDataId",
              "newName": "'event.id'"
            },
            {
              "currentName": "OperationNameValue",
              "newName": "'event.action'"
            },
            {
              "currentName": "CallerIpAddress",
              "newName": "'source.ip'"
            },
            {
              "currentName": "ResourceProviderValue",
              "newName": "'event.provider'"
            },
            {
              "currentName": "SubscriptionId",
              "newName": "'cloud.account.id'"
            }
          ]
        },
        "description": "batch rename every cleanly-mapped column to its ECS target"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "_time",
              "value": "Date.parse(__e['TimeGenerated'])/1000"
            },
            {
              "name": "'event.outcome'",
              "value": "__e['ActivityStatusValue']==='Succeeded' ? 'success' : (__e['ActivityStatusValue']==='Failed' ? 'failure' : 'unknown')"
            },
            {
              "name": "'event.severity'",
              "value": "__e['Level']==='Critical' ? 1 : (__e['Level']==='Error' ? 3 : (__e['Level']==='Warning' ? 4 : (__e['Level']==='Informational' ? 6 : (__e['Level']==='Verbose' ? 7 : 5))))"
            },
            {
              "name": "'user.name'",
              "value": "__e['Claims_d'] && __e['Claims_d']['http://schemas.xmlsoap.org/ws/2005/05/identity/claims/upn'] ? __e['Claims_d']['http://schemas.xmlsoap.org/ws/2005/05/identity/claims/upn'] : (__e['Caller'] && __e['Caller'].indexOf('@') !== -1 ? __e['Caller'] : undefined)"
            },
            {
              "name": "'user.id'",
              "value": "__e['Claims_d'] && __e['Claims_d']['http://schemas.microsoft.com/identity/claims/objectidentifier'] ? __e['Claims_d']['http://schemas.microsoft.com/identity/claims/objectidentifier'] : (__e['Caller'] && __e['Caller'].indexOf('@') === -1 ? __e['Caller'] : undefined)"
            },
            {
              "name": "'user.roles'",
              "value": "__e['Authorization_d'] && __e['Authorization_d'].evidence && __e['Authorization_d'].evidence.role ? [__e['Authorization_d'].evidence.role] : undefined"
            },
            {
              "name": "'azure.activitylogs.category'",
              "value": "__e['CategoryValue']"
            },
            {
              "name": "'azure.activitylogs.identity.authorization'",
              "value": "__e['Authorization_d']"
            },
            {
              "name": "'azure.activitylogs.identity.claims'",
              "value": "__e['Claims_d']"
            },
            {
              "name": "'azure.resource_group'",
              "value": "__e['ResourceGroup']"
            },
            {
              "name": "'azure.resource.id'",
              "value": "__e['ResourceId']"
            },
            {
              "name": "'azure.activitylogs.correlation_id'",
              "value": "__e['CorrelationId']"
            },
            {
              "name": "'azure.activitylogs.http_request'",
              "value": "__e['HTTPRequest']"
            },
            {
              "name": "'http.request.method'",
              "value": "__e['HTTPRequest'] ? __e['HTTPRequest'].method : undefined"
            },
            {
              "name": "'azure.activitylogs.hierarchy'",
              "value": "__e['Hierarchy']"
            },
            {
              "name": "'azure.activitylogs.properties'",
              "value": "__e['Properties_d']"
            },
            {
              "name": "'azure.activitylogs.properties.status_code'",
              "value": "__e['Properties_d'] ? __e['Properties_d'].statusCode : undefined"
            },
            {
              "name": "'azure.activitylogs.properties.event_name'",
              "value": "__e['Properties_d'] ? __e['Properties_d'].eventName : undefined"
            },
            {
              "name": "'azure.activitylogs.workspace_id'",
              "value": "__e['TenantId']"
            },
            {
              "name": "'azure.activitylogs.result_signature'",
              "value": "__e['ActivitySubstatusValue']"
            },
            {
              "name": "'event.dataset'",
              "value": "'azure_activity.administrative'"
            }
          ],
          "remove": [
            "TimeGenerated",
            "ActivityStatusValue",
            "Level",
            "Caller",
            "CategoryValue",
            "Authorization_d",
            "Claims_d",
            "ResourceGroup",
            "ResourceId",
            "CorrelationId",
            "HTTPRequest",
            "Hierarchy",
            "Properties_d",
            "TenantId",
            "ActivitySubstatusValue"
          ]
        },
        "description": "set _time, derive outcome/severity/user identity, lift dynamic Authorization_d/Claims_d/HTTPRequest/Properties_d blobs to their custom namespaces plus specific promoted sub-keys, tag event.dataset, and drop the now-superseded vendor columns"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
