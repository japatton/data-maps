{
  "id": "dm_vtc_systems_device_admin_auth_syslog_kv",
  "conf": {
    "output": "default",
    "description": "VTC Systems, device-admin-auth, syslog-kv: parses the same Expressway/VCS tvcs event log (admin-session, authorization, config-change, registration branch) into ECS. source.ip merges the admin-session 'ipaddr' and registration 'Src-ip' elements; event.outcome derives from the Accepted/Rejected/Failure/Removed sense of Event.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "Expressway/VCS admin/registration branch of the same tvcs event log as call-signaling; split from it by Event value. Hyphenated vendor names (Src-ip, Src-alias, Response-code) are read via bracket-notation in eval and removed with code, since rename/eval.remove reject hyphenated property paths on this platform. System Configuration Changed's Detail payload (setting name + new value) is NOT split here - no documented delimiter for that text exists in the work order, so it stays a single message string; declared gap."
        }
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "kvp",
          "srcField": "_raw"
        },
        "description": "Extract the tvcs name=value pairs from _raw"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "User",
              "newName": "user.name"
            },
            {
              "currentName": "Reason",
              "newName": "event.reason"
            },
            {
              "currentName": "Level",
              "newName": "log.level"
            },
            {
              "currentName": "Detail",
              "newName": "message"
            }
          ]
        },
        "description": "Batch-rename the plain-identifier mapped fields"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "source.ip",
              "value": "__e['ipaddr'] != null ? __e['ipaddr'] : __e['Src-ip']"
            },
            {
              "name": "event.action",
              "value": "__e['Event'] ? __e['Event'].toLowerCase().replace(/ /g,'_') : __e['Event']"
            },
            {
              "name": "event.outcome",
              "value": "__e['Event'] && __e['Event'].indexOf('Accepted')>-1 ? 'success' : (__e['Event'] && (__e['Event'].indexOf('Rejected')>-1 || __e['Event'].indexOf('Failure')>-1) ? 'failure' : (__e['Event'] && __e['Event'].indexOf('Removed')>-1 ? 'unknown' : (__e['Auth'] ? (__e['Auth']==='yes' ? 'success' : 'failure') : null)))"
            },
            {
              "name": "network.protocol",
              "value": "__e['Service'] ? __e['Service'].toLowerCase() : __e['Service']"
            },
            {
              "name": "vtc.registration.alias",
              "value": "__e['Src-alias']"
            },
            {
              "name": "vtc.sip.aor",
              "value": "__e['AOR']"
            },
            {
              "name": "vtc.sip.contact",
              "value": "__e['Contact']"
            },
            {
              "name": "vtc.registration.expiry_seconds",
              "value": "__e['Duration'] != null ? Number(__e['Duration']) : null"
            },
            {
              "name": "vtc.sip.response_code",
              "value": "__e['Response-code'] != null ? Number(__e['Response-code']) : null"
            },
            {
              "name": "vtc.sip.method",
              "value": "__e['Method']"
            },
            {
              "name": "event.dataset",
              "value": "'vtc_systems.device_admin_auth'"
            }
          ],
          "remove": [
            "Event",
            "Auth",
            "Service",
            "AOR",
            "Contact",
            "Duration",
            "Method"
          ]
        },
        "description": "Derive ECS/custom fields (bracket-read hyphenated vendor names); remove plain-identifier originals"
      },
      {
        "id": "code",
        "filter": "true",
        "conf": {
          "code": "delete __e['ipaddr']; delete __e['Src-ip']; delete __e['Src-alias']; delete __e['Response-code'];"
        },
        "description": "Remove hyphenated vendor originals - rename/eval.remove reject hyphenated property paths"
      }
    ]
  }
}
