{
  "id": "dm_vtc_systems_call_signaling_syslog_kv",
  "conf": {
    "output": "default",
    "description": "VTC Systems, call-signaling, syslog-kv: parses the Expressway/VCS tvcs name=value event log into ECS. event.outcome derived from Event/Response-code/Auth; SIP/H.323 aliases split into user+domain; TLS normalized to transport=tcp plus a separate encrypted flag; call-correlation keys kept custom (ECS has no call id).",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "Expressway/VCS call-signaling event log (tvcs). No integration or pack exists for this format; hand-built against the documented name=value elements. KVP field names are vendor-hyphenated (Src-ip, Response-code, ...) which the platform's rename/remove property-accessor builder rejects, so those are read via bracket-notation in eval and cleaned up with code, not rename/remove. Detail is kept as the sole 'message' source per the recommendation (do not also duplicate it from _raw)."
        }
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "kvp",
          "srcField": "_raw"
        },
        "description": "Extract the tvcs name=value pairs from _raw"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "Reason",
              "newName": "event.reason"
            },
            {
              "currentName": "Level",
              "newName": "log.level"
            },
            {
              "currentName": "Detail",
              "newName": "message"
            }
          ]
        },
        "description": "Batch-rename the plain-identifier mapped fields"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "source.ip",
              "value": "__e['Src-ip']"
            },
            {
              "name": "source.port",
              "value": "__e['Src-port'] != null ? Number(__e['Src-port']) : null"
            },
            {
              "name": "destination.ip",
              "value": "__e['Dst-ip']"
            },
            {
              "name": "destination.port",
              "value": "__e['Dst-port'] != null ? Number(__e['Dst-port']) : null"
            },
            {
              "name": "event.action",
              "value": "__e['Event'] ? __e['Event'].toLowerCase().replace(/ /g,'_') : __e['Event']"
            },
            {
              "name": "event.outcome",
              "value": "__e['Auth'] ? (__e['Auth']==='yes' ? 'success' : 'failure') : (__e['Response-code'] ? (Number(__e['Response-code'])<300 ? 'success' : 'failure') : (__e['Event'] && /Rejected|Failed/i.test(__e['Event']) ? 'failure' : 'success'))"
            },
            {
              "name": "network.protocol",
              "value": "__e['Service'] ? __e['Service'].toLowerCase() : __e['Service']"
            },
            {
              "name": "network.transport",
              "value": "__e['Protocol']==='TLS' ? 'tcp' : (__e['Protocol'] ? __e['Protocol'].toLowerCase() : __e['Protocol'])"
            },
            {
              "name": "vtc.network.encrypted",
              "value": "__e['Protocol']==='TLS'"
            },
            {
              "name": "source.user.name",
              "value": "__e['Src-alias'] ? __e['Src-alias'].replace(/^(sip|h323|tel):/i,'').split('@')[0] : __e['Src-alias']"
            },
            {
              "name": "source.domain",
              "value": "__e['Src-alias'] && __e['Src-alias'].replace(/^(sip|h323|tel):/i,'').indexOf('@')>-1 ? __e['Src-alias'].replace(/^(sip|h323|tel):/i,'').split('@')[1] : null"
            },
            {
              "name": "destination.user.name",
              "value": "__e['Dst-alias'] ? __e['Dst-alias'].replace(/^(sip|h323|tel):/i,'').split('@')[0] : __e['Dst-alias']"
            },
            {
              "name": "destination.domain",
              "value": "__e['Dst-alias'] && __e['Dst-alias'].replace(/^(sip|h323|tel):/i,'').indexOf('@')>-1 ? __e['Dst-alias'].replace(/^(sip|h323|tel):/i,'').split('@')[1] : null"
            },
            {
              "name": "vtc.call.serial_number",
              "value": "__e['Call-serial-number']"
            },
            {
              "name": "vtc.call.tag",
              "value": "__e['Tag']"
            },
            {
              "name": "vtc.sip.call_id",
              "value": "__e['Call-id']"
            },
            {
              "name": "vtc.sip.method",
              "value": "__e['Method']"
            },
            {
              "name": "vtc.sip.response_code",
              "value": "__e['Response-code'] != null ? Number(__e['Response-code']) : null"
            },
            {
              "name": "vtc.message.bytes",
              "value": "__e['Num-bytes'] != null ? Number(__e['Num-bytes']) : null"
            },
            {
              "name": "event.dataset",
              "value": "'vtc_systems.call_signaling'"
            }
          ],
          "remove": [
            "Event",
            "Auth",
            "Service",
            "Protocol",
            "Tag",
            "Method"
          ]
        },
        "description": "Derive ECS/custom fields (bracket-read hyphenated vendor names); remove plain-identifier originals"
      },
      {
        "id": "code",
        "filter": "true",
        "conf": {
          "code": "delete __e['Src-ip']; delete __e['Src-port']; delete __e['Dst-ip']; delete __e['Dst-port']; delete __e['Src-alias']; delete __e['Dst-alias']; delete __e['Call-serial-number']; delete __e['Call-id']; delete __e['Response-code']; delete __e['Num-bytes'];"
        },
        "description": "Remove hyphenated vendor originals - rename/eval.remove reject hyphenated property paths"
      }
    ]
  }
}
