{
  "id": "dm_vtc_systems_cms_cdr_other",
  "conf": {
    "output": "default",
    "description": "VTC Systems, cms-cdr, other (XML CDR push): flattens Cisco Meeting Server <record> XML into ECS, dedups on (session, correlatorIndex) since the Call Bridge resends unacknowledged batches, and resolves the polymorphic id element into call/call-leg/recording-specific custom fields via the flatten dot-path instead of one overloaded field.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "CMS Call Bridge CDR push, XML flattened via xml_unroll+flatten. Only the record's own 'type' attribute is XML-attribute-shaped (@type per the work order's own notation) and the platform rejects '@'-prefixed property paths in rename/eval.remove, so it is read via bracket-notation and removed with code. Nesting of call/callLeg/recording-level elements (call.id, callLeg.direction, etc.) is inferred from the CDR guide tag references in the work order description, not from a captured sample - verify before production use. participant ipAddress/deviceType nesting is genuinely uncertain; read with a 3-way fallback."
        }
      },
      {
        "id": "xml_unroll",
        "filter": "true",
        "conf": {
          "unroll": "records.record"
        },
        "description": "One event per <record> element"
      },
      {
        "id": "flatten",
        "filter": "true",
        "conf": {
          "fields": [
            "call",
            "callLeg",
            "recording",
            "participant"
          ],
          "depth": 5,
          "type": "flatten",
          "delimiter": "."
        },
        "description": "Flatten the call/callLeg/recording/participant sub-objects to dot-path keys"
      },
      {
        "id": "distinct",
        "filter": "true",
        "conf": {
          "groupBy": [
            "session",
            "correlatorIndex"
          ]
        },
        "description": "Drop resent duplicates - Call Bridge resends any batch it did not see acknowledged"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'event.action'",
              "value": "__e['@type']"
            },
            {
              "name": "'vtc.cms.session_guid'",
              "value": "__e['session']"
            },
            {
              "name": "'vtc.cms.correlator_index'",
              "value": "__e['correlatorIndex'] != null ? Number(__e['correlatorIndex']) : null"
            },
            {
              "name": "'vtc.cms.call_id'",
              "value": "__e['call.id']"
            },
            {
              "name": "'vtc.cms.call_leg_id'",
              "value": "__e['callLeg.id']"
            },
            {
              "name": "'vtc.cms.recording_id'",
              "value": "__e['recording.id']"
            },
            {
              "name": "'vtc.cms.call_correlator'",
              "value": "__e['callCorrelator'] || __e['call.callCorrelator']"
            },
            {
              "name": "'network.direction'",
              "value": "__e['callLeg.direction'] ? (__e['callLeg.direction'].toLowerCase()==='incoming' ? 'inbound' : (__e['callLeg.direction'].toLowerCase()==='outgoing' ? 'outbound' : null)) : null"
            },
            {
              "name": "'vtc.cms.call_leg_type'",
              "value": "__e['callLeg.type']"
            },
            {
              "name": "'vtc.call.remote_party'",
              "value": "__e['callLeg.remoteParty']"
            },
            {
              "name": "'source.user.name'",
              "value": "__e['callLeg.direction'] && __e['callLeg.direction'].toLowerCase()==='incoming' ? (__e['callLeg.remoteAddress'] ? __e['callLeg.remoteAddress'].split('@')[0] : null) : (__e['callLeg.localAddress'] ? __e['callLeg.localAddress'].split('@')[0] : null)"
            },
            {
              "name": "'source.domain'",
              "value": "__e['callLeg.direction'] && __e['callLeg.direction'].toLowerCase()==='incoming' ? (__e['callLeg.remoteAddress'] && __e['callLeg.remoteAddress'].indexOf('@')>-1 ? __e['callLeg.remoteAddress'].split('@')[1] : null) : (__e['callLeg.localAddress'] && __e['callLeg.localAddress'].indexOf('@')>-1 ? __e['callLeg.localAddress'].split('@')[1] : null)"
            },
            {
              "name": "'destination.user.name'",
              "value": "__e['callLeg.direction'] && __e['callLeg.direction'].toLowerCase()==='incoming' ? (__e['callLeg.localAddress'] ? __e['callLeg.localAddress'].split('@')[0] : null) : (__e['callLeg.remoteAddress'] ? __e['callLeg.remoteAddress'].split('@')[0] : null)"
            },
            {
              "name": "'destination.domain'",
              "value": "__e['callLeg.direction'] && __e['callLeg.direction'].toLowerCase()==='incoming' ? (__e['callLeg.localAddress'] && __e['callLeg.localAddress'].indexOf('@')>-1 ? __e['callLeg.localAddress'].split('@')[1] : null) : (__e['callLeg.remoteAddress'] && __e['callLeg.remoteAddress'].indexOf('@')>-1 ? __e['callLeg.remoteAddress'].split('@')[1] : null)"
            },
            {
              "name": "'user.full_name'",
              "value": "__e['callLeg.displayName']"
            },
            {
              "name": "'vtc.sip.call_id'",
              "value": "__e['callLeg.sipCallId']"
            },
            {
              "name": "'event.duration'",
              "value": "__e['callLeg.durationSeconds'] != null ? Number(__e['callLeg.durationSeconds']) * 1e9 : null"
            },
            {
              "name": "'event.reason'",
              "value": "__e['callLeg.reason']"
            },
            {
              "name": "'vtc.cms.remote_teardown'",
              "value": "__e['callLeg.remoteTeardown']"
            },
            {
              "name": "'vtc.media.encrypted'",
              "value": "__e['callLeg.encryptedMedia'] != null ? __e['callLeg.encryptedMedia'] : null"
            },
            {
              "name": "'source.ip'",
              "value": "__e['callLeg.ipAddress'] || __e['participant.ipAddress'] || __e['ipAddress']"
            },
            {
              "name": "'vtc.endpoint.device_type'",
              "value": "__e['callLeg.deviceType'] || __e['participant.deviceType'] || __e['deviceType']"
            },
            {
              "name": "'organization.id'",
              "value": "__e['tenant'] || __e['call.tenant']"
            },
            {
              "name": "'event.dataset'",
              "value": "'vtc_systems.cms_cdr'"
            }
          ],
          "remove": [
            "'call.id'",
            "'call.callCorrelator'",
            "'call.tenant'",
            "'callLeg.id'",
            "'callLeg.direction'",
            "'callLeg.type'",
            "'callLeg.remoteParty'",
            "'callLeg.remoteAddress'",
            "'callLeg.localAddress'",
            "'callLeg.displayName'",
            "'callLeg.sipCallId'",
            "'callLeg.durationSeconds'",
            "'callLeg.reason'",
            "'callLeg.remoteTeardown'",
            "'callLeg.encryptedMedia'",
            "'callLeg.ipAddress'",
            "'callLeg.deviceType'",
            "'recording.id'",
            "session",
            "correlatorIndex",
            "callCorrelator",
            "tenant",
            "ipAddress",
            "deviceType",
            "'participant.ipAddress'",
            "'participant.deviceType'"
          ]
        },
        "description": "Resolve polymorphic id per enclosing tag, derive direction-dependent source/destination, convert duration to ns"
      },
      {
        "id": "code",
        "filter": "true",
        "conf": {
          "code": "delete __e['@type'];"
        },
        "description": "Remove the record type attribute - '@'-prefixed property paths are rejected by rename/eval.remove"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
