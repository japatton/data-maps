{
  "id": "dm_vtc_systems_endpoint_syslog_webhook",
  "conf": {
    "output": "default",
    "description": "VTC Systems, endpoint-syslog, webhook: parses Cisco RoomOS xAPI HttpFeedback JSON (Status/Call and Event/CallDisconnect trees) into ECS - the real call attempt/connect/disconnect substance the syslog body cannot carry. CallDisconnect is treated as the authoritative source when both a Call-status transition and a disconnect are present.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "RoomOS xAPI HttpFeedback POST, JSON preferred per xCommand HttpFeedback Register Format. Field names are from the public xAPI schema (cisco-ce/roomos.cisco.com). The exact flattened key shape for the Status.Call array (assumed 'Status.Call.0.<Field>' after flatten) is inferred, not confirmed against a captured POST - verify on-site. Status.Call.0.* originals are left in the event rather than removed: the platform's remove/rename property-accessor builder rejects numeric-indexed dot segments (same class of failure as '@' and hyphenated names). Poly VideoOS has no equivalent structured push and stays on the syslog-raw route."
        }
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "Extract the HttpFeedback JSON POST body"
      },
      {
        "id": "flatten",
        "filter": "true",
        "conf": {
          "fields": [
            "Status",
            "Event",
            "Identification"
          ],
          "depth": 6,
          "type": "flatten",
          "delimiter": "."
        },
        "description": "Flatten Status.Call[]/Event.CallDisconnect/Identification to dot-path keys"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "'Identification.SystemName'",
              "newName": "'host.name'"
            },
            {
              "currentName": "'Identification.MACAddress'",
              "newName": "'host.mac'"
            },
            {
              "currentName": "'Identification.IPAddress'",
              "newName": "'host.ip'"
            },
            {
              "currentName": "'Identification.SerialNumber'",
              "newName": "'observer.serial_number'"
            }
          ]
        },
        "description": "Batch-rename the Identification envelope fields"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'event.action'",
              "value": "__e['Event.CallDisconnect.CallId'] != null ? 'call_disconnected' : (__e['Status.Call.0.Status']==='Dialling' ? 'call_attempted' : (__e['Status.Call.0.Status']==='Ringing' ? 'call_ringing' : (__e['Status.Call.0.Status']==='Connected' ? 'call_connected' : (__e['Status.Call.0.Status']==='Disconnecting' ? 'call_disconnecting' : (__e['Status.Call.0.Status'] ? __e['Status.Call.0.Status'].toLowerCase() : null)))))"
            },
            {
              "name": "'vtc.endpoint.event'",
              "value": "__e['Status.Call.0.Status']"
            },
            {
              "name": "'network.direction'",
              "value": "(__e['Status.Call.0.Direction']==='Incoming' || __e['Event.CallDisconnect.OrigCallDirection']==='Incoming') ? 'inbound' : ((__e['Status.Call.0.Direction']==='Outgoing' || __e['Event.CallDisconnect.OrigCallDirection']==='Outgoing') ? 'outbound' : null)"
            },
            {
              "name": "'network.protocol'",
              "value": "(__e['Status.Call.0.Protocol'] || __e['Event.CallDisconnect.Protocol']) ? (__e['Status.Call.0.Protocol'] || __e['Event.CallDisconnect.Protocol']).toLowerCase() : null"
            },
            {
              "name": "'vtc.call.media_type'",
              "value": "__e['Status.Call.0.CallType']"
            },
            {
              "name": "'vtc.call.remote_party'",
              "value": "__e['Status.Call.0.RemoteNumber'] || __e['Event.CallDisconnect.RemoteURI']"
            },
            {
              "name": "'vtc.call.callback_number'",
              "value": "__e['Status.Call.0.CallbackNumber']"
            },
            {
              "name": "'user.full_name'",
              "value": "__e['Status.Call.0.DisplayName'] || __e['Event.CallDisconnect.DisplayName']"
            },
            {
              "name": "'vtc.call.answer_state'",
              "value": "__e['Status.Call.0.AnswerState']"
            },
            {
              "name": "'vtc.media.encryption'",
              "value": "__e['Status.Call.0.Encryption.Type'] || __e['Event.CallDisconnect.Encryption']"
            },
            {
              "name": "'event.duration'",
              "value": "__e['Event.CallDisconnect.Duration'] != null ? Number(__e['Event.CallDisconnect.Duration'])*1e9 : (__e['Status.Call.0.Duration'] != null ? Number(__e['Status.Call.0.Duration'])*1e9 : null)"
            },
            {
              "name": "'vtc.endpoint.call_id'",
              "value": "__e['Event.CallDisconnect.CallId']"
            },
            {
              "name": "'vtc.call.disconnect_cause_type'",
              "value": "__e['Event.CallDisconnect.CauseType']"
            },
            {
              "name": "'event.reason'",
              "value": "__e['Event.CallDisconnect.CauseString']"
            },
            {
              "name": "'vtc.call.disconnect_cause_code'",
              "value": "__e['Event.CallDisconnect.CauseCode'] != null ? Number(__e['Event.CallDisconnect.CauseCode']) : null"
            },
            {
              "name": "'vtc.call.disconnect_cause_origin'",
              "value": "__e['Event.CallDisconnect.CauseOrigin']"
            },
            {
              "name": "'vtc.call.requested_uri'",
              "value": "__e['Event.CallDisconnect.RequestedURI']"
            },
            {
              "name": "'event.dataset'",
              "value": "'vtc_systems.endpoint_syslog'"
            }
          ],
          "remove": [
            "'Event.CallDisconnect.CallId'",
            "'Event.CallDisconnect.CauseType'",
            "'Event.CallDisconnect.CauseString'",
            "'Event.CallDisconnect.CauseCode'",
            "'Event.CallDisconnect.CauseOrigin'",
            "'Event.CallDisconnect.OrigCallDirection'",
            "'Event.CallDisconnect.Protocol'",
            "'Event.CallDisconnect.Duration'",
            "'Event.CallDisconnect.RemoteURI'",
            "'Event.CallDisconnect.RequestedURI'",
            "'Event.CallDisconnect.DisplayName'",
            "'Event.CallDisconnect.Encryption'"
          ]
        },
        "description": "Merge Status/Call and Event/CallDisconnect into ECS, preferring CallDisconnect as authoritative"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
