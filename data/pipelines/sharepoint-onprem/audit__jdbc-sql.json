{
  "id": "dm_sharepoint_onprem_audit_jdbc_sql",
  "conf": {
    "output": "default",
    "description": "sharepoint-onprem audit, format jdbc-sql: Database Collector high-water read of dbo.AuditData (READ UNCOMMITTED, read-only), columns arrive already typed so no delimited parse is needed; dedupe by (SiteId, Occurred, Event, UserId, ItemId), same rename-to-ECS as the api-pull format.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "sharepoint-onprem/audit/jdbc-sql. Database Collector reads dbo.AuditData directly (read-only, READ UNCOMMITTED, high-water mark on Occurred) -- columns arrive already typed, so no delimited/JSON parse step runs here. Same Event enum / UserId->login gaps as the api-pull format: no full enum table and no UserInfo lookup data are supplied by the work order, so neither is resolved."
        },
        "description": "document source shape and enum/lookup gaps"
      },
      {
        "id": "distinct",
        "filter": "true",
        "conf": {
          "groupBy": [
            "SiteId",
            "Occurred",
            "Event",
            "UserId",
            "ItemId"
          ]
        },
        "description": "pipeline-side defense against an overlapping poll re-ingesting rows; complements, does not replace, the Collector's own Occurred checkpoint"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "_time",
              "value": "__e['Occurred'] ? Math.floor(Date.parse(__e['Occurred'])/1000) : undefined"
            },
            {
              "name": "event.outcome",
              "value": "'success'"
            },
            {
              "name": "file.path",
              "value": "__e['DocLocation']"
            },
            {
              "name": "url.path",
              "value": "__e['DocLocation']"
            },
            {
              "name": "sharepoint.audit.event_data",
              "value": "__e['EventData'] !== undefined ? (String(__e['EventData']).length>4096 ? String(__e['EventData']).substring(0,4096) : __e['EventData']) : undefined"
            },
            {
              "name": "event.dataset",
              "value": "'sharepoint_onprem.audit'"
            }
          ],
          "remove": [
            "Occurred",
            "DocLocation",
            "EventData",
            "_raw"
          ]
        },
        "description": "compute from ORIGINAL vendor names before rename: _time from Occurred, constant event.outcome=success, DocLocation copied to file.path and url.path, EventData length-capped into its custom field, event.dataset constant; drop consumed originals and _raw"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "MachineIp",
              "newName": "source.ip"
            },
            {
              "currentName": "MachineName",
              "newName": "source.address"
            },
            {
              "currentName": "UserId",
              "newName": "user.id"
            },
            {
              "currentName": "Event",
              "newName": "event.code"
            },
            {
              "currentName": "EventName",
              "newName": "event.action"
            },
            {
              "currentName": "ItemType",
              "newName": "sharepoint.audit.item_type"
            },
            {
              "currentName": "ItemId",
              "newName": "sharepoint.audit.item_id"
            },
            {
              "currentName": "LocationType",
              "newName": "sharepoint.audit.location_type"
            },
            {
              "currentName": "SiteId",
              "newName": "sharepoint.audit.site_id"
            },
            {
              "currentName": "EventSource",
              "newName": "sharepoint.audit.event_source"
            },
            {
              "currentName": "SourceName",
              "newName": "sharepoint.audit.source_name"
            },
            {
              "currentName": "AppPrincipalId",
              "newName": "sharepoint.audit.app_principal_id"
            }
          ]
        },
        "description": "batch rename every straightforward mapped/custom field"
      }
    ]
  }
}