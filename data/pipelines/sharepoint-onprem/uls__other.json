{
  "id": "dm_sharepoint_onprem_uls_other",
  "conf": {
    "output": "default",
    "description": "sharepoint-onprem uls, format other: hand-built tab-delimited ULS trace parse, header-line drop, host.name stamped from the collected filename, no cross-line continuation reassembly (join needs an unsupported stageId; Correlation/trace.id carried for downstream reassembly instead).",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "sharepoint-onprem/uls/other. Tab-delimited ULS trace file (Timestamp/Process/TID/Area/Category/EventID/Level/Message/Correlation), repeated per-file header dropped. host.name read from the standard Cribl __path source-file metadata field -- if the Source/Collector uses a different metadata field name, adjust the regex target. Continuation-line reassembly NOT attempted: stateful join needs a pre-existing stageId this instance does not have, per the brief; Correlation (trace.id) is carried through so Elastic can reassemble."
        },
        "description": "document format, host.name source assumption, and the continuation-reassembly gap"
      },
      {
        "id": "drop",
        "filter": "_raw !== undefined && String(_raw).indexOf('Timestamp\\tProcess\\tTID\\tArea\\tCategory\\tEventID\\tLevel\\tMessage\\tCorrelation') === 0",
        "conf": {},
        "description": "drop the repeated per-file column-header line before it is parsed as data"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "delim",
          "srcField": "_raw",
          "delimiter": "\t",
          "fields": [
            "Timestamp",
            "Process",
            "TID",
            "Area",
            "Category",
            "EventID",
            "Level",
            "Message",
            "Correlation"
          ]
        },
        "description": "split the fixed tab-delimited column set"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "host.name",
              "value": "/([^\\/\\\\]+)-\\d{8}-\\d{4}\\.log$/.exec(__e['__path']) ? /([^\\/\\\\]+)-\\d{8}-\\d{4}\\.log$/.exec(__e['__path'])[1] : undefined"
            },
            {
              "name": "log.logger",
              "value": "(__e['Area'] !== undefined || __e['Category'] !== undefined) ? (String(__e['Area']||'') + (__e['Area'] && __e['Category'] ? '/' : '') + String(__e['Category']||'')) : undefined"
            },
            {
              "name": "process.name",
              "value": "__e['Process'] !== undefined ? String(__e['Process']).replace(/\\s*\\(0x[0-9A-Fa-f]+\\)\\s*$/,'') : undefined"
            },
            {
              "name": "process.pid",
              "value": "__e['Process'] !== undefined && /\\(0x([0-9A-Fa-f]+)\\)/.exec(__e['Process']) ? parseInt(/\\(0x([0-9A-Fa-f]+)\\)/.exec(__e['Process'])[1],16) : undefined"
            },
            {
              "name": "process.thread.id",
              "value": "__e['TID'] !== undefined ? parseInt(String(__e['TID']).replace(/^0x/i,''),16) : undefined"
            },
            {
              "name": "sharepoint.uls.continuation",
              "value": "(__e['Timestamp'] === '' || __e['Timestamp'] === undefined) ? true : false"
            },
            {
              "name": "_time",
              "value": "__e['Timestamp'] ? Math.floor(Date.parse(__e['Timestamp'])/1000) : undefined"
            },
            {
              "name": "event.dataset",
              "value": "'sharepoint_onprem.uls'"
            }
          ],
          "remove": [
            "Timestamp",
            "Category",
            "Process",
            "TID",
            "_raw"
          ]
        },
        "description": "compute from ORIGINAL vendor names before rename: host.name from filename, log.logger from Area+Category, process.name/pid split from the composite Process value, TID hex->int, Continuation inferred from a blank Timestamp, _time from Timestamp, event.dataset constant; drop consumed originals and _raw"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "Area",
              "newName": "sharepoint.uls.area"
            },
            {
              "currentName": "EventID",
              "newName": "event.code"
            },
            {
              "currentName": "Level",
              "newName": "log.level"
            },
            {
              "currentName": "Message",
              "newName": "message"
            },
            {
              "currentName": "Correlation",
              "newName": "trace.id"
            }
          ]
        },
        "description": "batch rename remaining straightforward fields"
      }
    ]
  }
}