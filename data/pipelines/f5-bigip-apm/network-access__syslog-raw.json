{
  "id": "dm_f5_bigip_apm_network_access_syslog_raw",
  "conf": {
    "output": "default",
    "description": "F5 BIG-IP APM network-access (VPN tunnel) log, syslog-raw: per-message-id extractors for PPP assignment, client info and teardown statistics",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "F5 BIG-IP APM network-access (VPN tunnel) log, syslog-raw. Same BSD header/profile:partition:session triple as access-policy. Per-message-id extractors for 01490549 (PPP address assignment - static/dynamic x with/without '- Reconnect', 4 text shapes), 01490544 (received client info) and 01490521 (closing session statistics), plus the session.assigned.leasepool session variable (Informational/Debug only). Session-id-to-username enrichment named in recommendations.direct.cribl is NOT implemented - no lookup data exists on this instance and creating one is a config-object change beyond pipelines-only scope; recorded as a gap."
        },
        "description": "why this pipeline is shaped this way"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/^(?:<\\d+>)?(?<mon>\\w{3})\\s+(?<day>\\d{1,2})\\s(?<time>\\d{2}:\\d{2}:\\d{2})\\s(?<hostname>\\S+)\\s\\S+\\[\\d+\\]:\\s(?<message_id>\\d{8}):\\d:\\s(?<access_profile>\\/[^:]+):[^:]+:(?<session_id>[0-9a-fA-F]+):\\s(?<message>.*)$/",
          "source": "_raw"
        },
        "description": "parse the stable BSD header + profile:partition:sessionid triple (daemon/pid/severity are not in this dataset's field list, matched but not captured)"
      },
      {
        "id": "regex_extract",
        "filter": "__e['message_id']==='01490549'",
        "conf": {
          "regex": "/Assigned PPP (?<assignment_type>Static|Dynamic) IPv(?<ip_version>4|6):\\s*(?<assigned_ip>\\S+)/",
          "source": "message"
        },
        "description": "01490549: lease-pool/static address and IP version assigned to the tunnel; assignment type captured separately instead of writing four fixed regexes"
      },
      {
        "id": "regex_extract",
        "filter": "__e['message_id']==='01490549'",
        "conf": {
          "regex": "/Client IP:\\s*(?<client_ip>\\S+)/",
          "source": "message"
        },
        "description": "01490549: public address the VPN client connected from"
      },
      {
        "id": "regex_extract",
        "filter": "__e['message_id']==='01490549'",
        "conf": {
          "regex": "/\\bID:\\s*(?<tunnel_id>\\S+)/",
          "source": "message"
        },
        "description": "01490549: tunnel identifier assigned to the PPP connection"
      },
      {
        "id": "regex_extract",
        "filter": "__e['message_id']==='01490549'",
        "conf": {
          "regex": "/Tunnel Type:\\s*(?<tunnel_type_raw>\\S+)/",
          "source": "message"
        },
        "description": "01490549: transport the tunnel was established over (VPN_TUNNELTYPE_TLS/DTLS)"
      },
      {
        "id": "regex_extract",
        "filter": "__e['message_id']==='01490549'",
        "conf": {
          "regex": "/NA Resource:\\s*(?<na_resource>\\S+)/",
          "source": "message"
        },
        "description": "01490549: full path of the Network Access resource that provisioned the tunnel"
      },
      {
        "id": "regex_extract",
        "filter": "__e['message_id']==='01490544'",
        "conf": {
          "regex": "/Type:\\s*(?<client_type>.+?)\\s*(?=,?\\s*(?:Platform:|UI Mode:|$))/",
          "source": "message"
        },
        "description": "01490544: client type APM detected (Mozilla/Standalone/activesync/unknown) - label-anchored, exact delimiter between labels is unverified"
      },
      {
        "id": "regex_extract",
        "filter": "__e['message_id']==='01490544'",
        "conf": {
          "regex": "/Platform:\\s*(?<client_platform>.+?)\\s*(?=,?\\s*(?:UI Mode:|$))/",
          "source": "message"
        },
        "description": "01490544: client operating platform reported in the client info record"
      },
      {
        "id": "regex_extract",
        "filter": "__e['message_id']==='01490544'",
        "conf": {
          "regex": "/UI Mode:\\s*(?<client_ui_mode>.+)$/",
          "source": "message"
        },
        "description": "01490544: interface mode of the client session"
      },
      {
        "id": "regex_extract",
        "filter": "__e['message_id']==='01490521'",
        "conf": {
          "regex": "/Session statistics - bytes in:\\s*(?<bytes_in>\\d+),\\s*bytes out:\\s*(?<bytes_out>\\d+)/",
          "source": "message"
        },
        "description": "01490521: closing session byte counters, a session total emitted once at teardown"
      },
      {
        "id": "regex_extract",
        "filter": "__e['message_id']==='01490113' || __e['message_id']==='01490115'",
        "conf": {
          "regex": "/^Session variable (?<session_var_name>\\S+) set to (?<session_var_value>\\S+)$/",
          "source": "message"
        },
        "description": "session variable set, Informational/Debug only - matches session.assigned.leasepool here"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'source.nat.ip'",
              "value": "__e['assigned_ip']"
            },
            {
              "name": "'f5_bigip.apm.tunnel.assignment_type'",
              "value": "__e['assignment_type'] ? __e['assignment_type'].toLowerCase() : undefined"
            },
            {
              "name": "'f5_bigip.apm.tunnel.ip_version'",
              "value": "__e['ip_version'] ? Number(__e['ip_version']) : undefined"
            },
            {
              "name": "'f5_bigip.apm.tunnel.reconnect'",
              "value": "__e['message_id']==='01490549' ? /Reconnect/.test(__e['message']||'') : undefined"
            },
            {
              "name": "'f5_bigip.apm.client.type'",
              "value": "__e['client_type'] ? __e['client_type'].replace(/[,\\s]+$/, '').trim() : undefined"
            },
            {
              "name": "'f5_bigip.apm.client.platform'",
              "value": "__e['client_platform'] ? __e['client_platform'].replace(/[,\\s]+$/, '').trim() : undefined"
            },
            {
              "name": "'f5_bigip.apm.client.ui_mode'",
              "value": "__e['client_ui_mode'] ? __e['client_ui_mode'].trim() : undefined"
            },
            {
              "name": "'source.bytes'",
              "value": "__e['bytes_in']!==undefined ? Number(__e['bytes_in']) : undefined"
            },
            {
              "name": "'destination.bytes'",
              "value": "__e['bytes_out']!==undefined ? Number(__e['bytes_out']) : undefined"
            },
            {
              "name": "'f5_bigip.apm.lease_pool'",
              "value": "(__e['session_var_name']==='session.assigned.leasepool') ? __e['session_var_value'] : undefined"
            }
          ],
          "remove": [
            "assignment_type",
            "ip_version",
            "assigned_ip",
            "client_type",
            "client_platform",
            "client_ui_mode",
            "bytes_in",
            "bytes_out",
            "session_var_name",
            "session_var_value",
            "message"
          ]
        },
        "description": "source.nat.ip is the closest true ECS statement for a VPN lease address (documented borrowed home, not a real NAT event); reconnect explicitly set true/false only on the assignment record; client info trimmed of trailing label punctuation; byte counters cast to number; lease pool pulled from the session variable"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "message_id",
              "newName": "'event.code'"
            },
            {
              "currentName": "hostname",
              "newName": "'observer.hostname'"
            },
            {
              "currentName": "access_profile",
              "newName": "'rule.ruleset'"
            },
            {
              "currentName": "client_ip",
              "newName": "'source.ip'"
            },
            {
              "currentName": "tunnel_id",
              "newName": "'f5_bigip.apm.tunnel.id'"
            },
            {
              "currentName": "na_resource",
              "newName": "'f5_bigip.apm.network_access.resource'"
            },
            {
              "currentName": "session_id",
              "newName": "'f5_bigip.apm.session.id'"
            },
            {
              "currentName": "tunnel_type_raw",
              "newName": "'f5_bigip.apm.tunnel.type'"
            }
          ]
        },
        "description": "batch rename every status:mapped/unmapped field that needs no casting or conditional logic"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "_time",
              "value": "Date.parse(__e['mon'] + ' ' + __e['day'] + ', ' + (new Date()).getFullYear() + ' ' + __e['time'] + ' UTC')/1000"
            }
          ],
          "remove": [
            "mon",
            "day",
            "time"
          ]
        },
        "description": "BSD header carries no year or timezone; best-effort current-year/UTC parse into _time per platform constraint 1 - same unresolved per-device-tz gap as access-policy"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'event.dataset'",
              "value": "'f5_bigip_apm.network_access'"
            }
          ]
        },
        "description": "tag the dataset, hyphen-free per platform constraint 5"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
