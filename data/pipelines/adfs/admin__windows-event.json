{
  "id": "dm_adfs_admin_windows_event",
  "conf": {
    "output": "default",
    "description": "AD FS/Admin operational channel (lockout family 512/515/516, service-health 342/364, smart-lockout node errors 557/562/563): per-event-id positional-insertion-string regex per catalog recommendations.direct.cribl",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "AD FS/Admin operational channel (342/364/512/515/516/557/562/563), provider 'AD FS' (distinct from the Security channel's 'AD FS Auditing'). Classic template events with positional insertion strings - 512/516 carry 5 values, 515 only 3, so they are extracted with separate id-scoped regexes per catalog recommendations.direct.cribl."
        },
        "description": "pipeline purpose"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "Parse the winlog envelope JSON (EventID, ProviderName, Computer, Level, Message)"
      },
      {
        "id": "drop",
        "filter": "__e['ProviderName'] !== 'AD FS'",
        "conf": {},
        "description": "Distinct provider from the Security-channel 'AD FS Auditing' datasets; qualify explicitly",
        "final": true
      },
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "512/516 (5 insertion strings) vs 515 (3) are extracted with separate patterns so positions are never mis-assigned; the remaining labels are extracted independently since they are unambiguous single-purpose labels that simply won't match on event ids that don't carry them"
        },
        "description": "extraction approach"
      },
      {
        "id": "regex_extract",
        "filter": "__e['EventID']=='512' || __e['EventID']=='516'",
        "conf": {
          "regex": "/Activity ID:\\s*(?<ActivityId>\\S+)\\s+User:\\s*(?<User>[^\\r\\n]+?)\\s+Client IP:\\s*(?<ClientIP>\\S+)\\s+Bad Password Count:\\s*(?<BadPasswordCount>\\d+)\\s+Last Bad Password Attempt:\\s*(?<LastBadPasswordAttempt>[^\\r\\n]+)/",
          "source": "Message"
        },
        "description": "512/516 5-value positional template (Microsoft-documented order)"
      },
      {
        "id": "regex_extract",
        "filter": "__e['EventID']=='515'",
        "conf": {
          "regex": "/Activity ID:\\s*(?<ActivityId>\\S+)\\s+User:\\s*(?<User>[^\\r\\n]+?)\\s+Client IP:\\s*(?<ClientIP>\\S+)/",
          "source": "Message"
        },
        "description": "515 3-value positional template - a correct password on a locked-out account, no bad-password counters"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/Relying Party:\\s*(?<RelyingParty>[^\\r\\n]+)/",
          "source": "Message"
        },
        "description": "342/364 additional data: relying party trust"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/Protocol Name:\\s*(?<ProtocolName>[^\\r\\n]+)/",
          "source": "Message"
        },
        "description": "342/364 additional data: federation protocol"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/Account store server name:\\s*(?<AccountStoreServer>[^\\r\\n]+)/",
          "source": "Message"
        },
        "description": "557/562/563: farm node whose user-activity role could not be reached"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/Exception Message:\\s*(?<ExceptionMessage>[\\s\\S]+)/",
          "source": "Message"
        },
        "description": "342/364/562: .NET exception text explaining the failure"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'adfs.lockout.bad_password_count'",
              "value": "__e['BadPasswordCount'] !== undefined ? parseInt(__e['BadPasswordCount'], 10) : undefined"
            },
            {
              "name": "'adfs.lockout.last_bad_password_attempt'",
              "value": "__e['LastBadPasswordAttempt'] ? new Date(__e['LastBadPasswordAttempt']).toISOString() : undefined"
            },
            {
              "name": "'event.severity'",
              "value": "__e['Level']==='Critical'?2:(__e['Level']==='Error'?3:(__e['Level']==='Warning'?4:(__e['Level']==='Information'?6:undefined)))"
            },
            {
              "name": "'adfs.admin.data_quality_signal'",
              "value": "(__e['EventID']=='557'||__e['EventID']=='562'||__e['EventID']=='563') ? true : undefined"
            },
            {
              "name": "'adfs.lockout.priority_candidate'",
              "value": "__e['EventID']=='515' ? true : undefined"
            },
            {
              "name": "'user.name'",
              "value": "(__e['User'] && __e['User'].indexOf('\\\\') > -1) ? __e['User'].split('\\\\')[1] : __e['User']"
            }
          ],
          "remove": [
            "Level",
            "User",
            "BadPasswordCount",
            "LastBadPasswordAttempt"
          ]
        },
        "description": "Bad Password Count cast to integer, Last Bad Password Attempt parsed to ISO timestamp (best-effort Date() locale parse - see README gap), Level mapped to ECS numeric severity, 557/562/563 tagged as a data-quality signal, 515 tagged for priority handling (actual priority routing needs a Route/Destination change, out of pipeline scope - see README gap), User DOMAIN\\\\user form normalized"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "EventID",
              "newName": "'event.code'"
            },
            {
              "currentName": "ProviderName",
              "newName": "'event.provider'"
            },
            {
              "currentName": "Computer",
              "newName": "'host.name'"
            },
            {
              "currentName": "ClientIP",
              "newName": "'source.ip'"
            },
            {
              "currentName": "RelyingParty",
              "newName": "'service.target.name'"
            },
            {
              "currentName": "ActivityId",
              "newName": "'adfs.admin.activity_id'"
            },
            {
              "currentName": "ProtocolName",
              "newName": "'adfs.admin.protocol_name'"
            },
            {
              "currentName": "AccountStoreServer",
              "newName": "'adfs.admin.account_store_server'"
            },
            {
              "currentName": "ExceptionMessage",
              "newName": "'error.message'"
            },
            {
              "currentName": "Message",
              "newName": "message"
            }
          ]
        },
        "description": "Batch rename: ECS-mapped/notes-only-partial fields plus straight unmapped-to-custom copies"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'event.dataset'",
              "value": "'adfs.admin'"
            }
          ]
        },
        "description": "ECS data-stream dataset component"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
