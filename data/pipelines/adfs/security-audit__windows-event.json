{
  "id": "dm_adfs_security_audit_windows_event",
  "conf": {
    "output": "default",
    "description": "AD FS security-audit (1200-1210) windows-event: cribl-pack mechanism - custom AuditBase XML explode added alongside the (uninstalled here) Cribl Windows Events pack, per catalog recommendations.direct.cribl",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "AD FS security-audit (Security channel, provider 'AD FS Auditing') windows-event. cribl-pack recommendation: envelope normalized by the Cribl Windows Events pack (not installed on this instance - packs list empty; envelope fields assumed produced upstream), this pipeline is the pack's custom explode stage: unescape param2's AuditBase XML and hoist detection fields. The whitelisted 'pack' function packs/unpacks flat fields (unpackedFields) and is unrelated to the AuditBase explode, so it is not used here."
        },
        "description": "pipeline purpose and cribl-pack scoping note"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "Parse the winlog envelope JSON (EventID, ProviderName, Computer, Keywords, param1=Activity ID, param2=AuditBase XML) - stand-in for the pack's envelope normalization, unverified against a live sample"
      },
      {
        "id": "drop",
        "filter": "__e['ProviderName'] !== 'AD FS Auditing'",
        "conf": {},
        "description": "AD FS reuses Security-channel event ids owned by other publishers; qualify on provider before anything else",
        "final": true
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "AuditXml",
              "value": "__e['param2'] ? __e['param2'].replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&quot;/g,'\"').replace(/&apos;/g,\"'\").replace(/&amp;/g,'&') : undefined"
            }
          ]
        },
        "description": "Unescape the XML-escaped AuditBase document carried in param2 (2nd unnamed EventData element)"
      },
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "Hoist AuditBase elements via tag-scoped regex (order independent, works regardless of exact nesting depth). AuditType/AuditResult/FailureType/ErrorCode are confirmed top-level AuditBase elements per the catalog notes; the remaining leaf tag names are assumed equal to the catalog's mnemonic field names and are NOT verified against a live 1200/1203/1210 sample - see README gap."
        },
        "description": "explode approach and assumption disclosure"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/<AuditType>(?<AuditType>[^<]*)<\\/AuditType>/",
          "source": "AuditXml"
        },
        "description": "Extract AuditBase element <AuditType>"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/<AuditResult>(?<AuditResult>[^<]*)<\\/AuditResult>/",
          "source": "AuditXml"
        },
        "description": "Extract AuditBase element <AuditResult>"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/<FailureType>(?<FailureType>[^<]*)<\\/FailureType>/",
          "source": "AuditXml"
        },
        "description": "Extract AuditBase element <FailureType>"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/<ErrorCode>(?<ErrorCode>[^<]*)<\\/ErrorCode>/",
          "source": "AuditXml"
        },
        "description": "Extract AuditBase element <ErrorCode>"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/<UserId>(?<UserId>[^<]*)<\\/UserId>/",
          "source": "AuditXml"
        },
        "description": "Extract AuditBase element <UserId>"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/<PrimaryAuth>(?<PrimaryAuth>[^<]*)<\\/PrimaryAuth>/",
          "source": "AuditXml"
        },
        "description": "Extract AuditBase element <PrimaryAuth>"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/<MfaPerformed>(?<MfaPerformed>[^<]*)<\\/MfaPerformed>/",
          "source": "AuditXml"
        },
        "description": "Extract AuditBase element <MfaPerformed>"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/<DeviceId>(?<DeviceId>[^<]*)<\\/DeviceId>/",
          "source": "AuditXml"
        },
        "description": "Extract AuditBase element <DeviceId>"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/<AuthProtocol>(?<AuthProtocol>[^<]*)<\\/AuthProtocol>/",
          "source": "AuditXml"
        },
        "description": "Extract AuditBase element <AuthProtocol>"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/<NetworkLocation>(?<NetworkLocation>[^<]*)<\\/NetworkLocation>/",
          "source": "AuditXml"
        },
        "description": "Extract AuditBase element <NetworkLocation>"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/<UserAgentString>(?<UserAgentString>[^<]*)<\\/UserAgentString>/",
          "source": "AuditXml"
        },
        "description": "Extract AuditBase element <UserAgentString>"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/<Endpoint>(?<Endpoint>[^<]*)<\\/Endpoint>/",
          "source": "AuditXml"
        },
        "description": "Extract AuditBase element <Endpoint>"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/<RelyingParty(?:Id)?>(?<RelyingParty>[^<]*)<\\/RelyingParty(?:Id)?>/",
          "source": "AuditXml"
        },
        "description": "Extract AuditBase relying-party trust identifier (tag name may be RelyingParty or RelyingPartyId)"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/<IpAddress>(?<IpAddressRaw>[^<]*)<\\/IpAddress>/",
          "source": "AuditXml"
        },
        "description": "Extract the raw (possibly delimited) IpAddress list element"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'related.ip'",
              "value": "__e['IpAddressRaw'] ? __e['IpAddressRaw'].trim().replace(/\\s*,\\s*/g, ',').split(',') : undefined"
            },
            {
              "name": "'source.ip'",
              "value": "__e['IpAddressRaw'] ? __e['IpAddressRaw'].trim().replace(/\\s*,\\s*/g, ',').split(',')[0] : undefined"
            }
          ]
        },
        "description": "Microsoft documents IpAddress as the ordered x-ms-forwarded-client-ip, x-forwarded-for, x-ms-proxy-client-ip chain: split it, keep every element in related.ip, promote only the first (claimed originating) element to source.ip"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'event.outcome'",
              "value": "__e['AuditResult'] ? __e['AuditResult'].toLowerCase() : undefined"
            },
            {
              "name": "'adfs.audit.envelope_outcome_keywords'",
              "value": "__e['Keywords']"
            },
            {
              "name": "'event.reason'",
              "value": "(__e['FailureType'] && __e['FailureType'] !== 'None') ? __e['FailureType'] : undefined"
            },
            {
              "name": "'error.code'",
              "value": "(__e['ErrorCode'] && __e['ErrorCode'] !== 'N/A') ? __e['ErrorCode'] : undefined"
            },
            {
              "name": "'adfs.audit.mfa_performed'",
              "value": "__e['MfaPerformed'] === 'true' ? true : (__e['MfaPerformed'] === 'false' ? false : undefined)"
            },
            {
              "name": "'user.name'",
              "value": "(__e['UserId'] && __e['UserId'].indexOf('\\\\') > -1) ? __e['UserId'].split('\\\\')[1] : __e['UserId']"
            }
          ]
        },
        "description": "event.outcome from AuditResult (post-explode value; envelope Keywords kept separately for reconciliation per catalog note, not dual-mapped); None/N/A sentinels nulled; MfaPerformed cast to boolean; UserId DOMAIN\\\\user form normalized to bare account name"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "EventID",
              "newName": "'event.code'"
            },
            {
              "currentName": "ProviderName",
              "newName": "'event.provider'"
            },
            {
              "currentName": "Computer",
              "newName": "'host.name'"
            },
            {
              "currentName": "DeviceId",
              "newName": "'device.id'"
            },
            {
              "currentName": "UserAgentString",
              "newName": "'user_agent.original'"
            },
            {
              "currentName": "Endpoint",
              "newName": "'url.path'"
            }
          ]
        },
        "description": "Batch rename of straight ECS-mapped fields"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'adfs.audit.audit_xml'",
              "value": "__e['AuditXml']"
            },
            {
              "name": "'adfs.audit.activity_id'",
              "value": "__e['param1']"
            },
            {
              "name": "'event.action'",
              "value": "__e['AuditType']"
            },
            {
              "name": "'service.target.name'",
              "value": "__e['RelyingParty']"
            },
            {
              "name": "'adfs.audit.primary_auth_method'",
              "value": "__e['PrimaryAuth']"
            },
            {
              "name": "'adfs.audit.auth_protocol'",
              "value": "__e['AuthProtocol']"
            },
            {
              "name": "'adfs.audit.network_location'",
              "value": "__e['NetworkLocation']"
            }
          ],
          "remove": [
            "param1",
            "param2",
            "AuditXml",
            "AuditType",
            "AuditResult",
            "FailureType",
            "ErrorCode",
            "RelyingParty",
            "UserId",
            "PrimaryAuth",
            "MfaPerformed",
            "AuthProtocol",
            "NetworkLocation",
            "IpAddressRaw",
            "Keywords",
            "Message"
          ]
        },
        "description": "Route remaining unmapped/partial rows to their adfs.audit.* custom targets (event.action from raw AuditType enum - the recommended AuditType+AuditResult label lookup is not implemented, see README gap); drop the rendered Message per the pack recommendation and every intermediate field once copied"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'event.dataset'",
              "value": "'adfs.security_audit'"
            }
          ]
        },
        "description": "ECS data-stream dataset component (no hyphen)"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
