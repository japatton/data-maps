{
  "id": "dm_carbon_black_edr_enforcement_audit_json",
  "conf": {
    "output": "default",
    "description": "Carbon Black EDR enforcement events (processblock, tamper), JSON via cb-event-forwarder - recommended path; the server audit log has no JSON form (see the syslog-raw pipeline for that).",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "type and tamper_type both target event.action; tamper_type wins on tamper records since type is always the constant ingress.event.tamper there."
        },
        "description": "provenance note"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "parse the NDJSON enforcement event"
      },
      {
        "id": "auto_timestamp",
        "filter": "true",
        "conf": {
          "srcField": "timestamp",
          "dstField": "_time"
        },
        "description": "sensor-observed time becomes Cribl's canonical _time"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'event.action'",
              "value": "__e['type']==='ingress.event.tamper' ? __e['tamper_type'] : __e['type']"
            },
            {
              "name": "'event.outcome'",
              "value": "__e['blocked_result'] ? (/success/i.test(__e['blocked_result']) ? 'success' : (/fail/i.test(__e['blocked_result']) ? 'failure' : undefined)) : undefined"
            },
            {
              "name": "'user.domain'",
              "value": "__e['username'] && __e['username'].indexOf(String.fromCharCode(92))!==-1 ? __e['username'].split(String.fromCharCode(92))[0] : undefined"
            },
            {
              "name": "'user.name'",
              "value": "__e['username'] ? (__e['username'].indexOf(String.fromCharCode(92))!==-1 ? __e['username'].split(String.fromCharCode(92))[1] : __e['username']) : undefined"
            },
            {
              "name": "'carbon_black.sensor.id'",
              "value": "__e['sensor_id'] !== undefined ? String(__e['sensor_id']) : undefined"
            },
            {
              "name": "'event.dataset'",
              "value": "'carbon_black_edr.enforcement_audit'"
            }
          ],
          "remove": [
            "type",
            "tamper_type",
            "blocked_result",
            "username",
            "sensor_id",
            "timestamp",
            "_raw"
          ]
        },
        "description": "resolve event.action from type/tamper_type, map blocked_result to ECS event.outcome, split DOMAIN\\user, cast sensor id, set event.dataset"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "blocked_reason",
              "newName": "'rule.description'"
            },
            {
              "currentName": "blocked_event",
              "newName": "'event.type'"
            },
            {
              "currentName": "command_line",
              "newName": "'process.command_line'"
            },
            {
              "currentName": "path",
              "newName": "'process.executable'"
            },
            {
              "currentName": "md5",
              "newName": "'process.hash.md5'"
            },
            {
              "currentName": "uid",
              "newName": "'user.id'"
            },
            {
              "currentName": "computer_name",
              "newName": "'host.hostname'"
            },
            {
              "currentName": "cb_server",
              "newName": "'observer.name'"
            }
          ]
        },
        "description": "batch rename of the clean-name mapped fields"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
