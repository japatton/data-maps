{
  "id": "dm_carbon_black_edr_watchlist_hit_json",
  "conf": {
    "output": "default",
    "description": "Carbon Black EDR watchlist/feed hit, JSON via cb-event-forwarder (recommended path per catalog - CEF loses fields to a catch-all msg per Broadcom's own integration guide).",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "Recommended format: JSON carries every field as its own key; the syslog-cef alternative is documented lossy."
        },
        "description": "provenance note"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "parse the NDJSON hit record"
      },
      {
        "id": "auto_timestamp",
        "filter": "true",
        "conf": {
          "srcField": "event_timestamp",
          "dstField": "_time"
        },
        "description": "server hit time (epoch seconds with fraction) becomes Cribl's canonical _time"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'rule.id'",
              "value": "__e['watchlist_id'] !== undefined ? String(__e['watchlist_id']) : undefined"
            },
            {
              "name": "'carbon_black.feed.id'",
              "value": "__e['feed_id'] !== undefined ? String(__e['feed_id']) : undefined"
            },
            {
              "name": "'carbon_black.feed.name'",
              "value": "__e['feed_name']"
            },
            {
              "name": "'carbon_black.sensor.id'",
              "value": "__e['sensor_id'] !== undefined ? String(__e['sensor_id']) : undefined"
            },
            {
              "name": "'carbon_black.segment.id'",
              "value": "__e['segment_id'] !== undefined ? String(__e['segment_id']) : undefined"
            },
            {
              "name": "'threat.indicator.type'",
              "value": "__e['ioc_type']==='md5' ? 'file' : (__e['ioc_type']==='ipv4' ? 'ipv4-addr' : (__e['ioc_type']==='dns' ? 'domain-name' : undefined))"
            },
            {
              "name": "'threat.indicator.name'",
              "value": "__e['ioc_value']"
            },
            {
              "name": "'threat.indicator.file.hash.md5'",
              "value": "__e['ioc_type']==='md5' ? __e['ioc_value'] : undefined"
            },
            {
              "name": "'threat.indicator.ip'",
              "value": "__e['ioc_type']==='ipv4' ? __e['ioc_value'] : undefined"
            },
            {
              "name": "'carbon_black.ioc.type_raw'",
              "value": "__e['ioc_type']"
            },
            {
              "name": "'process.entity_id'",
              "value": "__e['process_id'] ? __e['process_id'] : (__e['docs'] && __e['docs'][0] ? __e['docs'][0].process_guid : undefined)"
            },
            {
              "name": "'process.executable'",
              "value": "__e['docs'] && __e['docs'][0] ? __e['docs'][0].path : undefined"
            },
            {
              "name": "'process.command_line'",
              "value": "__e['docs'] && __e['docs'][0] ? __e['docs'][0].command_line : undefined"
            },
            {
              "name": "'process.hash.md5'",
              "value": "__e['docs'] && __e['docs'][0] ? __e['docs'][0].md5 : undefined"
            },
            {
              "name": "'process.pid'",
              "value": "__e['docs'] && __e['docs'][0] ? __e['docs'][0].pid : undefined"
            },
            {
              "name": "'carbon_black.docs'",
              "value": "__e['docs']"
            },
            {
              "name": "'event.category'",
              "value": "__e['type'] && __e['type'].indexOf('binary')!==-1 ? ['malware','file'] : ['malware','process']"
            },
            {
              "name": "'event.type'",
              "value": "['indicator']"
            },
            {
              "name": "'event.dataset'",
              "value": "'carbon_black_edr.watchlist_hit'"
            }
          ],
          "remove": [
            "watchlist_id",
            "feed_id",
            "feed_name",
            "ioc_type",
            "ioc_value",
            "sensor_id",
            "segment_id",
            "process_id",
            "docs",
            "event_timestamp",
            "_raw"
          ]
        },
        "description": "cast ids to string, type the indicator, promote docs[0] process fields, derive category/type, set event.dataset, drop consumed originals"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "type",
              "newName": "'event.action'"
            },
            {
              "currentName": "watchlist_name",
              "newName": "'rule.name'"
            },
            {
              "currentName": "hostname",
              "newName": "'host.hostname'"
            },
            {
              "currentName": "md5",
              "newName": "'file.hash.md5'"
            },
            {
              "currentName": "cb_version",
              "newName": "'observer.version'"
            },
            {
              "currentName": "server_name",
              "newName": "'observer.name'"
            },
            {
              "currentName": "report_id",
              "newName": "'carbon_black.report.id'"
            },
            {
              "currentName": "ioc_attr",
              "newName": "'carbon_black.ioc.attributes'"
            }
          ]
        },
        "description": "batch rename of clean-name mapped fields"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
