{
  "id": "dm_carbon_black_edr_file_registry_events_json",
  "conf": {
    "output": "default",
    "description": "Carbon Black EDR filemod/regmod/moduleload telemetry, JSON via cb-event-forwarder - one envelope, three object kinds disambiguated by type.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "type controls whether path becomes file.path, registry.path or dll.path - the single most important routing decision in this dataset."
        },
        "description": "provenance note"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "parse the NDJSON filemod/regmod/moduleload event"
      },
      {
        "id": "auto_timestamp",
        "filter": "true",
        "conf": {
          "srcField": "timestamp",
          "dstField": "_time"
        },
        "description": "sensor-observed time becomes Cribl's canonical _time"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'file.path'",
              "value": "__e['type']==='ingress.event.filemod' ? __e['path'] : undefined"
            },
            {
              "name": "'registry.path'",
              "value": "__e['type']==='ingress.event.regmod' ? __e['path'] : undefined"
            },
            {
              "name": "'dll.path'",
              "value": "__e['type']==='ingress.event.moduleload' ? __e['path'] : undefined"
            },
            {
              "name": "'event.type'",
              "value": "__e['action']==='created' ? ['creation'] : (__e['action']==='deleted' ? ['deletion'] : ((__e['action']==='first-wrote' || __e['action']==='last-wrote') ? ['change'] : undefined))"
            },
            {
              "name": "'file.hash.md5'",
              "value": "__e['type']!=='ingress.event.moduleload' ? __e['md5'] : undefined"
            },
            {
              "name": "'dll.hash.md5'",
              "value": "__e['type']==='ingress.event.moduleload' ? __e['md5'] : undefined"
            },
            {
              "name": "'carbon_black.sensor.id'",
              "value": "__e['sensor_id'] !== undefined ? String(__e['sensor_id']) : undefined"
            },
            {
              "name": "'event.dataset'",
              "value": "'carbon_black_edr.file_registry_events'"
            }
          ],
          "remove": [
            "path",
            "action",
            "md5",
            "sensor_id",
            "timestamp",
            "_raw"
          ]
        },
        "description": "route path/md5 by object type, map action vocabulary to ECS event.type, cast sensor id, set event.dataset"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "type",
              "newName": "'event.action'"
            },
            {
              "currentName": "actiontype",
              "newName": "'carbon_black.action.code'"
            },
            {
              "currentName": "filetype",
              "newName": "'carbon_black.file.type_code'"
            },
            {
              "currentName": "filetype_name",
              "newName": "'carbon_black.file.type'"
            },
            {
              "currentName": "process_guid",
              "newName": "'process.entity_id'"
            },
            {
              "currentName": "pid",
              "newName": "'process.pid'"
            },
            {
              "currentName": "computer_name",
              "newName": "'host.hostname'"
            },
            {
              "currentName": "cb_server",
              "newName": "'observer.name'"
            }
          ]
        },
        "description": "batch rename of the clean-name mapped/custom fields"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
