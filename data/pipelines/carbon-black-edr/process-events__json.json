{
  "id": "dm_carbon_black_edr_process_events_json",
  "conf": {
    "output": "default",
    "description": "Carbon Black EDR process telemetry (procstart, childproc), JSON via cb-event-forwarder - the only transport for this dataset.",
    "functions": [
      { "id": "comment", "filter": "true", "conf": { "comment": "High-volume process-start telemetry; no CEF path exists for ingress.event.* streams." }, "description": "provenance note" },
      { "id": "serde", "filter": "true", "conf": { "mode": "extract", "type": "json", "srcField": "_raw" }, "description": "parse the NDJSON process event" },
      { "id": "auto_timestamp", "filter": "true", "conf": { "srcField": "timestamp", "dstField": "_time" }, "description": "sensor-observed time becomes Cribl's canonical _time" },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            { "name": "user.domain", "value": "__e['username'] && __e['username'].indexOf(String.fromCharCode(92))!==-1 ? __e['username'].split(String.fromCharCode(92))[0] : undefined" },
            { "name": "user.name", "value": "__e['username'] ? (__e['username'].indexOf(String.fromCharCode(92))!==-1 ? __e['username'].split(String.fromCharCode(92))[1] : __e['username']) : undefined" },
            { "name": "carbon_black.logon.type", "value": "__e['logon_type']===2 ? 'Interactive' : (__e['logon_type']===3 ? 'Network' : (__e['logon_type']===4 ? 'Batch' : (__e['logon_type']===5 ? 'Service' : (__e['logon_type']===7 ? 'Unlock' : (__e['logon_type']===8 ? 'NetworkCleartext' : (__e['logon_type']===9 ? 'NewCredentials' : (__e['logon_type']===10 ? 'RemoteInteractive' : (__e['logon_type']===11 ? 'CachedInteractive' : undefined))))))))" },
            { "name": "carbon_black.logon.type_code", "value": "__e['logon_type'] !== undefined ? String(__e['logon_type']) : undefined" },
            { "name": "carbon_black.sensor.id", "value": "__e['sensor_id'] !== undefined ? String(__e['sensor_id']) : undefined" },
            { "name": "event.dataset", "value": "'carbon_black_edr.process_events'" }
          ],
          "remove": ["username","logon_type","sensor_id","timestamp","_raw"]
        },
        "description": "split DOMAIN\\user (via String.fromCharCode to avoid backslash-escaping the delimiter), decode Windows logon type, cast sensor id, set event.dataset"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            { "currentName": "type", "newName": "event.action" },
            { "currentName": "command_line", "newName": "process.command_line" },
            { "currentName": "path", "newName": "process.executable" },
            { "currentName": "pid", "newName": "process.pid" },
            { "currentName": "process_guid", "newName": "process.entity_id" },
            { "currentName": "md5", "newName": "process.hash.md5" },
            { "currentName": "parent_path", "newName": "process.parent.executable" },
            { "currentName": "parent_md5", "newName": "process.parent.hash.md5" },
            { "currentName": "parent_process_guid", "newName": "process.parent.entity_id" },
            { "currentName": "parent_create_time", "newName": "process.parent.start" },
            { "currentName": "child_process_guid", "newName": "carbon_black.child.entity_id" },
            { "currentName": "created", "newName": "carbon_black.child.created" },
            { "currentName": "computer_name", "newName": "host.hostname" },
            { "currentName": "cb_server", "newName": "observer.name" },
            { "currentName": "event_type", "newName": "carbon_black.event.family" },
            { "currentName": "expect_followon_w_md5", "newName": "carbon_black.expect_followon" },
            { "currentName": "link_process", "newName": "event.reference" },
            { "currentName": "link_sensor", "newName": "carbon_black.link.sensor" },
            { "currentName": "link_parent", "newName": "carbon_black.link.parent" }
          ]
        },
        "description": "batch rename of the clean-name mapped/custom fields"
      }
    ]
  }
}
