{
  "id": "dm_carbon_black_edr_network_events_json",
  "conf": {
    "output": "default",
    "description": "Carbon Black EDR network connection telemetry (netconn), JSON via cb-event-forwarder - process-attributed connections.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "local/remote are sensor-relative; direction controls the swap into ECS source/destination, which are initiator-relative."
        },
        "description": "provenance note"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "parse the NDJSON netconn event"
      },
      {
        "id": "auto_timestamp",
        "filter": "true",
        "conf": {
          "srcField": "timestamp",
          "dstField": "_time"
        },
        "description": "sensor-observed time becomes Cribl's canonical _time"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'source.ip'",
              "value": "__e['direction'] && __e['direction'].toLowerCase()==='inbound' ? __e['remote_ip'] : __e['local_ip']"
            },
            {
              "name": "'source.port'",
              "value": "__e['direction'] && __e['direction'].toLowerCase()==='inbound' ? __e['remote_port'] : __e['local_port']"
            },
            {
              "name": "'destination.ip'",
              "value": "__e['direction'] && __e['direction'].toLowerCase()==='inbound' ? __e['local_ip'] : __e['remote_ip']"
            },
            {
              "name": "'destination.port'",
              "value": "__e['direction'] && __e['direction'].toLowerCase()==='inbound' ? __e['local_port'] : __e['remote_port']"
            },
            {
              "name": "'network.direction'",
              "value": "__e['direction'] ? __e['direction'].toLowerCase() : undefined"
            },
            {
              "name": "'network.iana_number'",
              "value": "__e['protocol'] !== undefined ? String(__e['protocol']) : undefined"
            },
            {
              "name": "'network.transport'",
              "value": "__e['protocol']===6 ? 'tcp' : (__e['protocol']===17 ? 'udp' : undefined)"
            },
            {
              "name": "'carbon_black.sensor.id'",
              "value": "__e['sensor_id'] !== undefined ? String(__e['sensor_id']) : undefined"
            },
            {
              "name": "'event.dataset'",
              "value": "'carbon_black_edr.network_events'"
            }
          ],
          "remove": [
            "local_ip",
            "local_port",
            "remote_ip",
            "remote_port",
            "direction",
            "protocol",
            "sensor_id",
            "timestamp",
            "_raw"
          ]
        },
        "description": "swap local/remote into ECS source/destination by direction, decode protocol number to tcp/udp, cast sensor id, set event.dataset"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "domain",
              "newName": "'destination.domain'"
            },
            {
              "currentName": "ipv4",
              "newName": "'carbon_black.netconn.ipv4'"
            },
            {
              "currentName": "port",
              "newName": "'carbon_black.netconn.port'"
            },
            {
              "currentName": "proxy",
              "newName": "'carbon_black.proxy.used'"
            },
            {
              "currentName": "proxy_ip",
              "newName": "'network.forwarded_ip'"
            },
            {
              "currentName": "proxy_port",
              "newName": "'carbon_black.proxy.port'"
            },
            {
              "currentName": "proxy_domain",
              "newName": "'carbon_black.proxy.domain'"
            },
            {
              "currentName": "process_guid",
              "newName": "'process.entity_id'"
            },
            {
              "currentName": "pid",
              "newName": "'process.pid'"
            },
            {
              "currentName": "md5",
              "newName": "'process.hash.md5'"
            },
            {
              "currentName": "computer_name",
              "newName": "'host.hostname'"
            },
            {
              "currentName": "cb_server",
              "newName": "'observer.name'"
            }
          ]
        },
        "description": "batch rename of the clean-name mapped/custom fields"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
