{
  "id": "dm_trellix_epo_dlp_endpoint_jdbc_sql",
  "conf": {
    "output": "default",
    "description": "Trellix ePO DLP Endpoint incident, jdbc-sql: Database Collector on dbo.DLP_EventView delivers one flat-column event per row already, so this normalizes to ECS per direct.cribl (own the whole parse, no boundary redaction).",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": { "comment": "DLP incident columns from dbo.DLP_EventView (joined to DLP_EventInfo/DLP_EvidenceTypeAndValue upstream). No deserialize step: the Database Collector already emits one field per column." },
        "description": "document the source and why there is no parse step"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            { "name": "_time", "value": "Date.parse(__e['ViolationUTCTime'])/1000" },
            { "name": "event.code", "value": "String(__e['IncidentType'])" },
            { "name": "trellix.epo.dlp_endpoint.severity_label", "value": "__e['Severity']===0?'Info':(__e['Severity']===1?'Warning':(__e['Severity']===2?'Minor':(__e['Severity']===3?'Major':(__e['Severity']===4?'Critical':undefined))))" },
            { "name": "event.action", "value": "__e['ActualAction']===1?'block':(__e['ActualAction']===0?'none':undefined)" },
            { "name": "user.domain", "value": "__e['Username_NTLM'] && __e['Username_NTLM'].indexOf('\\\\') > -1 ? __e['Username_NTLM'].split('\\\\')[0] : undefined" },
            { "name": "user.name", "value": "__e['Username_NTLM'] ? (__e['Username_NTLM'].indexOf('\\\\') > -1 ? __e['Username_NTLM'].split('\\\\')[1] : __e['Username_NTLM']) : undefined" },
            { "name": "rule.name", "value": "__e['RulesToDisplay'] ? __e['RulesToDisplay'].split(/;\\s*/) : undefined" },
            { "name": "email.to.address", "value": "__e['Recipients'] ? __e['Recipients'].split(/;\\s*/) : undefined" },
            { "name": "network.transport", "value": "isNaN(Number(__e['NetworkProtocol'])) ? (__e['NetworkProtocol'] ? __e['NetworkProtocol'].toLowerCase() : undefined) : (Number(__e['NetworkProtocol'])===6 ? 'tcp' : (Number(__e['NetworkProtocol'])===17 ? 'udp' : (Number(__e['NetworkProtocol'])===1 ? 'icmp' : String(__e['NetworkProtocol']))))" },
            { "name": "network.direction", "value": "__e['ConnectionDirection']===0 ? 'ingress' : (__e['ConnectionDirection']===1 ? 'egress' : undefined)" },
            { "name": "file.extension", "value": "__e['FileName'] && __e['FileName'].lastIndexOf('.') > -1 ? __e['FileName'].substring(__e['FileName'].lastIndexOf('.')+1) : undefined" },
            { "name": "trellix.epo.dlp_endpoint.collection_transport", "value": "'database'" }
          ],
          "remove": ["ViolationUTCTime", "IncidentType", "ActualAction", "Username_NTLM", "RulesToDisplay", "Recipients", "NetworkProtocol", "ConnectionDirection"]
        },
        "description": "compute every derived/looked-up field from the ORIGINAL column names before rename nests them, per the compute-before-rename order; drop the raw columns consumed here"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            { "currentName": "IncidentId", "newName": "event.id" },
            { "currentName": "Name", "newName": "host.name" },
            { "currentName": "SID", "newName": "user.id" },
            { "currentName": "ApplicationFileName", "newName": "process.name" },
            { "currentName": "ProcessId", "newName": "process.pid" },
            { "currentName": "FilePath", "newName": "file.path" },
            { "currentName": "FileName", "newName": "file.name" },
            { "currentName": "FileSize", "newName": "file.size" },
            { "currentName": "SHA1", "newName": "file.hash.sha1" },
            { "currentName": "DestinationURL", "newName": "url.original" },
            { "currentName": "Sender", "newName": "email.from.address" },
            { "currentName": "Subject", "newName": "email.subject" },
            { "currentName": "DestIP", "newName": "destination.ip" },
            { "currentName": "DestPort", "newName": "destination.port" },
            { "currentName": "SourcePort", "newName": "source.port" },
            { "currentName": "FailureReason", "newName": "event.reason" },
            { "currentName": "InsertionTime", "newName": "event.created" },
            { "currentName": "IP", "newName": "host.ip" },
            { "currentName": "FQDN", "newName": "host.hostname" },
            { "currentName": "Severity", "newName": "event.severity" },
            { "currentName": "ActualActionOther", "newName": "trellix.epo.dlp_endpoint.action_other" },
            { "currentName": "PolicyRevision", "newName": "trellix.epo.dlp_endpoint.policy_revision" },
            { "currentName": "EvidenceCount", "newName": "trellix.epo.dlp_endpoint.evidence_count" },
            { "currentName": "TotalContentSize", "newName": "trellix.epo.dlp_endpoint.content_size" },
            { "currentName": "ItemType", "newName": "trellix.epo.dlp_endpoint.item_type" },
            { "currentName": "UserGroups", "newName": "trellix.epo.dlp_endpoint.user_groups" },
            { "currentName": "FileType", "newName": "trellix.epo.dlp_endpoint.file_type" },
            { "currentName": "DestinationPath", "newName": "trellix.epo.dlp_endpoint.destination_path" },
            { "currentName": "PrinterName", "newName": "trellix.epo.dlp_endpoint.printer_name" },
            { "currentName": "CloudService", "newName": "trellix.epo.dlp_endpoint.cloud_service" },
            { "currentName": "VisibleApplications", "newName": "trellix.epo.dlp_endpoint.visible_applications" },
            { "currentName": "DlpAgentVersion", "newName": "trellix.epo.dlp_endpoint.agent_version" }
          ]
        },
        "description": "batch every clean-identifier column into its ECS or vendor-namespace target in one rename"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": { "add": [ { "name": "event.dataset", "value": "'trellix_epo.dlp_endpoint'" } ] },
        "description": "tag the Elastic data-stream dataset component (hyphens replaced with underscores)"
      }
    ]
  }
}
