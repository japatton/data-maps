{
  "id": "dm_trellix_epo_ens_threat_api_pull",
  "conf": {
    "output": "default",
    "description": "Trellix ePO, ens-threat, api-pull: REST Collector against core.executeQuery returns flat rows whose keys are literally table-qualified column names (e.g. \"EPOEvents.ThreatName\"); every field is read via eval __e['EPOEvents.X'] bracket access, never rename, because the literal dot in the source key would otherwise be parsed as a nested property path.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "trellix-epo/ens-threat/api-pull. REST Collector polls core.executeQuery; the work order's own notes say the unwrapped JSON rows carry the EPOEvents query-table columns verbatim, i.e. flat keys like \"EPOEvents.ThreatName\" containing a literal dot. rename/eval.add.name/auto_timestamp path-based keys would parse that dot as nested-property access, so every field below is read with eval bracket access (__e['EPOEvents.X']) instead - no rename function is used in this pipeline. Array-to-NDJSON unwrap of the raw core.executeQuery result set is a REST Collector config concern, out of pipeline scope."
        },
        "description": "identify technology, dataset, format, and parsing approach; flag the dotted-key trap"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "event.id",
              "value": "__e['EPOEvents.AutoID'] !== undefined ? String(__e['EPOEvents.AutoID']) : undefined"
            },
            {
              "name": "event.created",
              "value": "__e['EPOEvents.ReceivedUTC']"
            },
            {
              "name": "event.code",
              "value": "__e['EPOEvents.ThreatEventID'] !== undefined ? String(__e['EPOEvents.ThreatEventID']) : undefined"
            },
            {
              "name": "trellix.epo.threat.name",
              "value": "__e['EPOEvents.ThreatName']"
            },
            {
              "name": "trellix.epo.threat.type",
              "value": "__e['EPOEvents.ThreatType']"
            },
            {
              "name": "trellix.epo.threat.category",
              "value": "__e['EPOEvents.ThreatCategory']"
            },
            {
              "name": "event.severity",
              "value": "__e['EPOEvents.ThreatSeverity'] !== undefined ? 7 - Number(__e['EPOEvents.ThreatSeverity']) : undefined"
            },
            {
              "name": "event.action",
              "value": "__e['EPOEvents.ThreatActionTaken'] === 'IDS_ALERT_ACT_TAK_DEL' ? 'deleted' : (__e['EPOEvents.ThreatActionTaken'] === 'IDS_ALERT_ACT_TAK_CLE' ? 'cleaned' : __e['EPOEvents.ThreatActionTaken'])"
            },
            {
              "name": "event.outcome",
              "value": "__e['EPOEvents.ThreatHandled'] === 'true' || __e['EPOEvents.ThreatHandled'] === true ? 'success' : (__e['EPOEvents.ThreatHandled'] === 'false' || __e['EPOEvents.ThreatHandled'] === false ? 'failure' : undefined)"
            },
            {
              "name": "observer.product",
              "value": "__e['EPOEvents.AnalyzerName']"
            },
            {
              "name": "trellix.epo.analyzer.detection_method",
              "value": "__e['EPOEvents.AnalyzerDetectionMethod']"
            },
            {
              "name": "trellix.epo.analyzer.dat_version",
              "value": "__e['EPOEvents.AnalyzerDATVersion']"
            },
            {
              "name": "source.ip",
              "value": "__e['EPOEvents.SourceIPV4']"
            },
            {
              "name": "process.executable",
              "value": "__e['EPOEvents.SourceProcessName']"
            },
            {
              "name": "source.user.name",
              "value": "__e['EPOEvents.SourceUserName']"
            },
            {
              "name": "host.name",
              "value": "__e['EPOEvents.TargetHostName']"
            },
            {
              "name": "host.ip",
              "value": "__e['EPOEvents.TargetIPV4']"
            },
            {
              "name": "user.domain",
              "value": "__e['EPOEvents.TargetUserName'] ? (__e['EPOEvents.TargetUserName'].indexOf('\\\\') > -1 ? __e['EPOEvents.TargetUserName'].split('\\\\')[0] : undefined) : undefined"
            },
            {
              "name": "user.name",
              "value": "__e['EPOEvents.TargetUserName'] ? (__e['EPOEvents.TargetUserName'].indexOf('\\\\') > -1 ? __e['EPOEvents.TargetUserName'].split('\\\\')[1] : __e['EPOEvents.TargetUserName']) : undefined"
            },
            {
              "name": "file.path",
              "value": "__e['EPOEvents.TargetFileName']"
            },
            {
              "name": "file.hash.md5",
              "value": "__e['EPOEvents.TargetHash']"
            },
            {
              "name": "_time",
              "value": "__e['EPOEvents.DetectedUTC'] !== undefined ? Date.parse(__e['EPOEvents.DetectedUTC'])/1000 : undefined"
            },
            {
              "name": "event.dataset",
              "value": "'trellix_epo.ens_threat'"
            }
          ]
        },
        "description": "read every EPOEvents.* dotted-key column via bracket access and assign it to its ECS or trellix.epo.* target, decode the partial/unmapped columns identically to the jdbc-sql path (no int-to-IP conversion needed here since the JSON output already renders dotted quads), set _time from EPOEvents.DetectedUTC, tag event.dataset"
      }
    ]
  }
}
