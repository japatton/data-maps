{
  "id": "dm_trellix_epo_device_control_jdbc_sql",
  "conf": {
    "output": "default",
    "description": "Trellix ePO, device-control, jdbc-sql: Database Collector against dbo.DLP_EventView delivers structured rows (no deserialize step); DLP's own 0-4 severity kept unscaled (never the CEF branch's inverted 0-7 lookup), ActualAction 0/1 enum decode, serial normalization, DOMAIN\\user split, per recommendations.direct.cribl.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "trellix-epo/device-control/jdbc-sql. Cribl Database Collector reads dbo.DLP_EventView (+ DLP_EventInfo/DLP_EvidenceTypeAndValue) filtered server-side to the removable-storage IncidentTypes (10000, 40102); rows arrive structured, nothing to deserialize. This is the feed the dataset exists for - it alone carries the USB/volume device identity the syslog-cef branch cannot. FileSystemAccess is a numeric access-mode code with no enum table supplied by this map, so volume.writable is left unset rather than guessed; the raw code is kept custom (README gap). Serials normalized (trim+uppercase) per recommendations.direct.cribl so week-over-week correlation on a physical stick doesn't fail on case/whitespace drift. Tags collection_transport=jdbc-sql so this document is recognized as the richer record of the same decision the CEF branch also reports."
        },
        "description": "identify technology, dataset, format, and parsing approach"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'event.created'",
              "value": "__e['InsertionTime']"
            },
            {
              "name": "'event.id'",
              "value": "__e['IncidentId'] !== undefined ? String(__e['IncidentId']) : undefined"
            },
            {
              "name": "'event.code'",
              "value": "__e['IncidentType'] !== undefined ? String(__e['IncidentType']) : undefined"
            },
            {
              "name": "'event.severity'",
              "value": "__e['Severity'] !== undefined ? Number(__e['Severity']) : undefined"
            },
            {
              "name": "'event.action'",
              "value": "__e['ActualAction'] === 0 || __e['ActualAction'] === '0' ? 'none' : (__e['ActualAction'] === 1 || __e['ActualAction'] === '1' ? 'blocked' : (__e['ActualAction'] !== undefined ? String(__e['ActualAction']) : undefined))"
            },
            {
              "name": "'trellix.epo.device_control.violation_local_time'",
              "value": "__e['ViolationLocalTime']"
            },
            {
              "name": "'trellix.epo.device_control.policy_revision'",
              "value": "__e['PolicyRevision']"
            },
            {
              "name": "'user.domain'",
              "value": "__e['Username_NTLM'] ? (__e['Username_NTLM'].indexOf('\\\\') > -1 ? __e['Username_NTLM'].split('\\\\')[0] : undefined) : undefined"
            },
            {
              "name": "'user.name'",
              "value": "__e['Username_NTLM'] ? (__e['Username_NTLM'].indexOf('\\\\') > -1 ? __e['Username_NTLM'].split('\\\\')[1] : __e['Username_NTLM']) : undefined"
            },
            {
              "name": "'trellix.epo.device_control.file_type'",
              "value": "__e['FileType']"
            },
            {
              "name": "'file.extension'",
              "value": "__e['FileName'] && __e['FileName'].lastIndexOf('.') > -1 ? __e['FileName'].substring(__e['FileName'].lastIndexOf('.')+1) : undefined"
            },
            {
              "name": "'trellix.epo.device_control.evidence_count'",
              "value": "__e['EvidenceCount'] !== undefined ? Number(__e['EvidenceCount']) : undefined"
            },
            {
              "name": "'trellix.epo.device_control.media_serial'",
              "value": "__e['USBSerialNumber'] ? __e['USBSerialNumber'].trim().toUpperCase() : undefined"
            },
            {
              "name": "'volume.serial_number'",
              "value": "__e['VolumeSerialNumber'] ? __e['VolumeSerialNumber'].trim().toUpperCase() : undefined"
            },
            {
              "name": "'trellix.epo.device_control.volume_label'",
              "value": "__e['VolumeLabel']"
            },
            {
              "name": "'trellix.epo.device_control.device_class_guid'",
              "value": "__e['DeviceClassGUID']"
            },
            {
              "name": "'trellix.epo.device_control.device_instance_id'",
              "value": "__e['DeviceInstanceID']"
            },
            {
              "name": "'trellix.epo.device_control.device_compatible_id'",
              "value": "__e['DeviceCompatibleID']"
            },
            {
              "name": "'trellix.epo.device_control.file_system_access_code'",
              "value": "__e['FileSystemAccess']"
            },
            {
              "name": "'trellix.epo.device_control.plugged_in_time'",
              "value": "__e['PluginLocalTime']"
            },
            {
              "name": "'trellix.epo.device_control.unplugged_time'",
              "value": "__e['UnpluggedLocalTime']"
            },
            {
              "name": "'trellix.epo.device_control.agent_version'",
              "value": "__e['DlpAgentVersion']"
            },
            {
              "name": "'trellix.epo.device_control.collection_transport'",
              "value": "'jdbc-sql'"
            },
            {
              "name": "__dm_time",
              "value": "typeof __e['ViolationUTCTime'] === 'number' ? (__e['ViolationUTCTime'] > 1e12 ? __e['ViolationUTCTime']/1000 : __e['ViolationUTCTime']) : (__e['ViolationUTCTime'] !== undefined ? Date.parse(__e['ViolationUTCTime'])/1000 : undefined)"
            },
            {
              "name": "_time",
              "value": "__e['__dm_time'] !== undefined && __e['__dm_time'] !== null && __e['__dm_time'] === __e['__dm_time'] ? __e['__dm_time'] : __e['_time']"
            },
            {
              "name": "'event.dataset'",
              "value": "'trellix_epo.device_control'"
            }
          ]
        },
        "description": "map partial/unmapped columns to ECS or trellix.epo.device_control.* custom fields reading the ORIGINAL column names before rename: rescale-free severity pass-through (own 0-4 DLP ladder), ActualAction 0/1 decode, serial normalization, DOMAIN\\user split, file.extension derivation, set _time from ViolationUTCTime, tag event.dataset and collection_transport"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "RulesToDisplay",
              "newName": "'rule.name'"
            },
            {
              "currentName": "Name",
              "newName": "'host.name'"
            },
            {
              "currentName": "IP",
              "newName": "'host.ip'"
            },
            {
              "currentName": "FQDN",
              "newName": "'host.hostname'"
            },
            {
              "currentName": "SID",
              "newName": "'user.id'"
            },
            {
              "currentName": "ApplicationFileName",
              "newName": "'process.name'"
            },
            {
              "currentName": "FilePath",
              "newName": "'file.path'"
            },
            {
              "currentName": "FileName",
              "newName": "'file.name'"
            },
            {
              "currentName": "FileSize",
              "newName": "'file.size'"
            },
            {
              "currentName": "FailureReason",
              "newName": "'event.reason'"
            },
            {
              "currentName": "DeviceName",
              "newName": "'volume.device_name'"
            },
            {
              "currentName": "DeviceDescription",
