{
  "id": "dm_cisco_nxos_config_accounting_snmp_trap",
  "conf": {
    "output": "default",
    "description": "Cisco NX-OS config-accounting / snmp-trap: reparse of clogHistMsgText for the two change-control shapes -- AAA_ACCOUNTING_MESSAGE's colon-delimited command record and VSHD_SYSLOG_CONFIG_I's session notice -- per direct.elastic; event.action falls back to a clogHistMsgName lookup for CFGWRITE_STARTED/PFM_SYSTEM_RESET, which carry no action token in the body.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "cisco-nxos / config-accounting / snmp-trap. Trap receiver forwards varbinds as JSON. Dissects AAA_ACCOUNTING_MESSAGE's 'type:ip@tty:user:command (RESULT)' shape into user.name, source.ip, process.command_line (+ a semicolon-split custom commands array) and event.outcome, and VSHD_SYSLOG_CONFIG_I's 'Configured from X by user on Y' shape (Y may be ip@tty, console0 or vsh.bin) into user.name/source.ip. CFGWRITE_STARTED and PFM_SYSTEM_RESET carry no body grammar in the catalog, so event.action for those two is a clogHistMsgName lookup, not a body dissect."
        },
        "description": "document the AAA_ACCOUNTING/VSHD dissect and the mnemonic-lookup fallback"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "extract the JSON-encoded varbind object the upstream SNMP trap receiver forwards"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "clogHistMsgText",
              "newName": "event.original"
            },
            {
              "currentName": "clogHistMsgName",
              "newName": "event.code"
            },
            {
              "currentName": "clogHistFacility",
              "newName": "cisco_nexus.log.facility"
            }
          ]
        },
        "description": "map the straight 1:1 CISCO-SYSLOG-MIB varbinds onto their targets (event.original is reparsed further below)"
      },
      {
        "id": "regex_extract",
        "filter": "event.code === 'AAA_ACCOUNTING_MESSAGE'",
        "conf": {
          "regex": "/(?<acct_type>\\w+):(?<acct_ip>[^@]+)@(?<acct_tty>[^:]+):(?<acct_user>[^:]+):(?<acct_cmd>.+?)\\s*\\((?<acct_result>SUCCESS|FAILURE)\\)\\s*$/",
          "source": "event.original"
        },
        "description": "dissect the AAA_ACCOUNTING_MESSAGE colon-delimited command-accounting record"
      },
      {
        "id": "regex_extract",
        "filter": "event.code === 'VSHD_SYSLOG_CONFIG_I'",
        "conf": {
          "regex": "/Configured from (?<vshd_source>\\S+) by (?<vshd_user>\\S+) on (?<vshd_where>\\S+)/",
          "source": "event.original"
        },
        "description": "dissect the VSHD_SYSLOG_CONFIG_I session-change notice (vty/console0/vsh.bin variants)"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "user.name",
              "value": "__e['acct_user'] !== undefined ? __e['acct_user'] : (__e['vshd_user'] !== undefined ? __e['vshd_user'] : undefined)"
            },
            {
              "name": "source.ip",
              "value": "__e['acct_ip'] !== undefined ? __e['acct_ip'] : (__e['vshd_where'] !== undefined && __e['vshd_where'].indexOf('@') > -1 ? __e['vshd_where'].split('@')[0] : undefined)"
            },
            {
              "name": "process.command_line",
              "value": "__e['acct_cmd'] !== undefined ? __e['acct_cmd'] : undefined"
            },
            {
              "name": "cisco_nexus.log.aaa.commands",
              "value": "__e['acct_cmd'] !== undefined ? __e['acct_cmd'].split(' ; ') : undefined"
            },
            {
              "name": "cisco_nexus.log.aaa.tty",
              "value": "__e['acct_tty']"
            },
            {
              "name": "cisco_nexus.log.config.session",
              "value": "__e['vshd_where']"
            },
            {
              "name": "event.outcome",
              "value": "__e['acct_result'] === 'SUCCESS' ? 'success' : (__e['acct_result'] === 'FAILURE' ? 'failure' : undefined)"
            },
            {
              "name": "event.action",
              "value": "event.code === 'AAA_ACCOUNTING_MESSAGE' ? (__e['acct_type'] === 'start' ? 'session_start' : __e['acct_type'] === 'stop' ? 'session_stop' : 'command_execution') : (event.code === 'VSHD_SYSLOG_CONFIG_I' ? 'configuration_change' : (event.code === 'CFGWRITE_STARTED' ? 'config_save' : (event.code === 'PFM_SYSTEM_RESET' ? 'system_reset' : undefined)))"
            },
            {
              "name": "event.severity",
              "value": "__e['clogHistSeverity'] !== undefined ? Number(__e['clogHistSeverity']) - 1 : undefined"
            },
            {
              "name": "log.level",
              "value": "__e['clogHistSeverity'] !== undefined ? ['emergency','alert','critical','error','warning','notice','informational','debug'][Number(__e['clogHistSeverity']) - 1] : undefined"
            },
            {
              "name": "cisco_nexus.log.snmp.sysuptime",
              "value": "__e['clogHistTimestamp']"
            },
            {
              "name": "cisco_nexus.log.snmp.history_index",
              "value": "__e['clogHistIndex']"
            }
          ],
          "remove": [
            "acct_type",
            "acct_ip",
            "acct_tty",
            "acct_user",
            "acct_cmd",
            "acct_result",
            "vshd_source",
            "vshd_user",
            "vshd_where",
            "clogHistSeverity",
            "clogHistTimestamp",
            "clogHistIndex"
          ]
        },
        "description": "derive user/source/command/outcome from whichever branch matched, event.action from the branch or (for CFGWRITE_STARTED/PFM_SYSTEM_RESET) from clogHistMsgName, recover inverted severity, drop temps"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "event.dataset",
              "value": "'cisco_nxos.config_accounting'"
            }
          ]
        },
        "description": "tag the event with its dataset"
      }
    ]
  }
}
