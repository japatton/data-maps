{
  "id": "dm_cisco_nxos_config_accounting_api_pull",
  "conf": {
    "output": "default",
    "description": "Cisco NX-OS config-accounting / api-pull: reparse pipeline behind the REST Collector against /ins, running the identical AAA_ACCOUNTING_MESSAGE/VSHD dissect as the snmp-trap format directly on branch-content match (no header/mnemonic needed since both shapes are self-identifying), plus the embedded sequence number.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "cisco-nxos / config-accounting / api-pull. event.original arrives already populated by the REST Collector's TABLE_*/ROW_* walk. Branches purely on content (the '(SUCCESS)'/'(FAILURE)' trailer identifies AAA_ACCOUNTING_MESSAGE, 'Configured from' identifies VSHD_SYSLOG_CONFIG_I) since the api-pull field table gives no mnemonic row; CFGWRITE_STARTED/PFM_SYSTEM_RESET are out of scope here for the same reason -- documented as a gap."
        },
        "description": "document the content-branched AAA_ACCOUNTING/VSHD dissect and the CFGWRITE/PFM scope limit"
      },
      {
        "id": "regex_extract",
        "filter": "event.original && (event.original.indexOf('(SUCCESS)') > -1 || event.original.indexOf('(FAILURE)') > -1)",
        "conf": {
          "regex": "/(?<acct_type>\\w+):(?<acct_ip>[^@]+)@(?<acct_tty>[^:]+):(?<acct_user>[^:]+):(?<acct_cmd>.+?)\\s*\\((?<acct_result>SUCCESS|FAILURE)\\)\\s*$/",
          "source": "event.original"
        },
        "description": "dissect the AAA_ACCOUNTING_MESSAGE colon-delimited command-accounting record"
      },
      {
        "id": "regex_extract",
        "filter": "event.original && event.original.indexOf('Configured from') > -1",
        "conf": {
          "regex": "/Configured from (?<vshd_source>\\S+) by (?<vshd_user>\\S+) on (?<vshd_where>\\S+)/",
          "source": "event.original"
        },
        "description": "dissect the VSHD_SYSLOG_CONFIG_I session-change notice (vty/console0/vsh.bin variants)"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/^(?<seq>\\d+):\\s*/",
          "source": "event.original"
        },
        "description": "recover the embedded per-device sequence number when configured"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "user.name",
              "value": "__e['acct_user'] !== undefined ? __e['acct_user'] : (__e['vshd_user'] !== undefined ? __e['vshd_user'] : undefined)"
            },
            {
              "name": "source.ip",
              "value": "__e['acct_ip'] !== undefined ? __e['acct_ip'] : (__e['vshd_where'] !== undefined && __e['vshd_where'].indexOf('@') > -1 ? __e['vshd_where'].split('@')[0] : undefined)"
            },
            {
              "name": "process.command_line",
              "value": "__e['acct_cmd'] !== undefined ? __e['acct_cmd'] : undefined"
            },
            {
              "name": "cisco_nexus.log.aaa.commands",
              "value": "__e['acct_cmd'] !== undefined ? __e['acct_cmd'].split(' ; ') : undefined"
            },
            {
              "name": "cisco_nexus.log.aaa.tty",
              "value": "__e['acct_tty']"
            },
            {
              "name": "cisco_nexus.log.config.session",
              "value": "__e['vshd_where']"
            },
            {
              "name": "event.outcome",
              "value": "__e['acct_result'] === 'SUCCESS' ? 'success' : (__e['acct_result'] === 'FAILURE' ? 'failure' : undefined)"
            },
            {
              "name": "event.action",
              "value": "__e['acct_type'] !== undefined ? (__e['acct_type'] === 'start' ? 'session_start' : __e['acct_type'] === 'stop' ? 'session_stop' : 'command_execution') : (__e['vshd_user'] !== undefined ? 'configuration_change' : undefined)"
            },
            {
              "name": "event.sequence",
              "value": "__e['seq'] !== undefined ? Number(__e['seq']) : undefined"
            }
          ],
          "remove": [
            "acct_type",
            "acct_ip",
            "acct_tty",
            "acct_user",
            "acct_cmd",
            "acct_result",
            "vshd_source",
            "vshd_user",
            "vshd_where",
            "seq"
          ]
        },
        "description": "derive user/source/command/outcome/action from whichever branch matched, map the sequence number, drop temps"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "event.dataset",
              "value": "'cisco_nxos.config_accounting'"
            }
          ]
        },
        "description": "tag the event with its dataset"
      }
    ]
  }
}
