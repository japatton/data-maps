{
  "id": "dm_cisco_nxos_login_aaa_snmp_trap",
  "conf": {
    "output": "default",
    "description": "Cisco NX-OS login-aaa / snmp-trap: reparse of the CISCO-SYSLOG-MIB clogHistMsgText body for the three verbatim PAM/SYSTEM_MSG shapes in the catalog (pam_aaa sshd failure, pam_unix key=value failure, illegal-user dcos_sshd failure), per direct.elastic. LOGIN_SUCCESS/LOGOUT/RADIUS-TACACS body text was not given a sample grammar so only mnemonic-level outcome/action is derived for those -- see README gap.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "cisco-nxos / login-aaa / snmp-trap. Trap receiver forwards varbinds as JSON. clogHistMsgText holds one of three verbatim PAM/SYSTEM_MSG sentences (pam_aaa sshd failure / pam_unix key=value tail / illegal-user dcos_sshd failure) dissected below into user.name, source.ip, process.name(daemon), process.pid and the pam_unix tail as custom keywords -- per direct.elastic this repairs the daemon-into-process.name and localport-into-destination.port mis-mappings rather than mapping the daemon into network.protocol. LOGIN_SUCCESS/LOGOUT/RADIUS-TACACS records are handled at the mnemonic+facility level only; no verbatim body grammar was given for those in the work order."
        },
        "description": "document the three dissected PAM shapes and the LOGIN_SUCCESS/LOGOUT scope limit"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "extract the JSON-encoded varbind object the upstream SNMP trap receiver forwards"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "clogHistMsgText",
              "newName": "event.original"
            },
            {
              "currentName": "clogHistMsgName",
              "newName": "event.code"
            },
            {
              "currentName": "clogHistFacility",
              "newName": "cisco_nexus.log.facility"
            }
          ]
        },
        "description": "map the straight 1:1 CISCO-SYSLOG-MIB varbinds onto their targets (event.original is reparsed further below)"
      },
      {
        "id": "regex_extract",
        "filter": "event.original && event.original.indexOf('pam_aaa:Authentication failed') > -1",
        "conf": {
          "regex": "/pam_aaa:Authentication failed for user (?<s1_user>\\S+) from (?<s1_ip>\\S+) - (?<s1_daemon>\\S+)\\[(?<s1_pid>\\d+)\\]/",
          "source": "event.original"
        },
        "description": "dissect the pam_aaa sshd-sourced authentication failure"
      },
      {
        "id": "regex_extract",
        "filter": "event.original && event.original.indexOf('pam_unix(') > -1",
        "conf": {
          "regex": "/pam_unix\\([^)]*\\):\\s*authentication failure;\\s*logname=(?<s2_logname>\\S*)\\s*uid=(?<s2_uid>\\S*)\\s*euid=(?<s2_euid>\\S*)\\s*tty=(?<s2_tty>\\S*)\\s*ruser=(?<s2_ruser>\\S*)\\s*rhost=(?<s2_rhost>\\S*)\\s*-\\s*(?<s2_daemon>\\S+)/",
          "source": "event.original"
        },
        "description": "dissect the pam_unix key=value authentication failure tail"
      },
      {
        "id": "regex_extract",
        "filter": "event.original && event.original.indexOf('illegal user') > -1",
        "conf": {
          "regex": "/error: PAM: Authentication failure for illegal user (?<s3_user>\\S+) from (?<s3_ip>\\S+) - (?<s3_daemon>\\S+)\\[(?<s3_pid>\\d+)\\]/",
          "source": "event.original"
        },
        "description": "dissect the illegal-user dcos_sshd authentication failure"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "user.name",
              "value": "__e['s1_user'] !== undefined ? __e['s1_user'] : (__e['s3_user'] !== undefined ? __e['s3_user'] : undefined)"
            },
            {
              "name": "related.user",
              "value": "(__e['s1_user'] !== undefined || __e['s3_user'] !== undefined) ? [__e['s1_user'] !== undefined ? __e['s1_user'] : __e['s3_user']] : undefined"
            },
            {
              "name": "source.ip",
              "value": "__e['s1_ip'] !== undefined ? __e['s1_ip'] : (__e['s3_ip'] !== undefined ? __e['s3_ip'] : undefined)"
            },
            {
              "name": "process.name",
              "value": "__e['s1_daemon'] !== undefined ? __e['s1_daemon'] : (__e['s3_daemon'] !== undefined ? __e['s3_daemon'] : (__e['s2_daemon'] !== undefined ? __e['s2_daemon'] : undefined))"
            },
            {
              "name": "process.pid",
              "value": "__e['s1_pid'] !== undefined ? Number(__e['s1_pid']) : (__e['s3_pid'] !== undefined ? Number(__e['s3_pid']) : undefined)"
            },
            {
              "name": "cisco_nexus.log.login.illegal_user",
              "value": "__e['s3_user'] !== undefined"
            },
            {
              "name": "cisco_nexus.log.pam.logname",
              "value": "__e['s2_logname']"
            },
            {
              "name": "cisco_nexus.log.pam.uid",
              "value": "__e['s2_uid'] !== undefined && __e['s2_uid'] !== '' ? Number(__e['s2_uid']) : undefined"
            },
            {
              "name": "cisco_nexus.log.pam.euid",
              "value": "__e['s2_euid'] !== undefined && __e['s2_euid'] !== '' ? Number(__e['s2_euid']) : undefined"
            },
            {
              "name": "cisco_nexus.log.pam.tty",
              "value": "__e['s2_tty']"
            },
            {
              "name": "cisco_nexus.log.pam.ruser",
              "value": "__e['s2_ruser']"
            },
            {
              "name": "cisco_nexus.log.pam.rhost",
              "value": "__e['s2_rhost']"
            },
            {
              "name": "event.outcome",
              "value": "(__e['s1_user'] !== undefined || __e['s2_daemon'] !== undefined || __e['s3_user'] !== undefined) ? 'failure' : (event.code === 'LOGIN_SUCCESS' ? 'success' : undefined)"
            },
            {
              "name": "event.action",
              "value": "event.code === 'LOGIN_SUCCESS' ? 'user_login' : (event.code === 'LOGOUT' ? 'user_logout' : ((__e['s1_user'] !== undefined || __e['s2_daemon'] !== undefined || __e['s3_user'] !== undefined) ? 'user_login' : undefined))"
            },
            {
              "name": "event.severity",
              "value": "__e['clogHistSeverity'] !== undefined ? Number(__e['clogHistSeverity']) - 1 : undefined"
            },
            {
              "name": "log.level",
              "value": "__e['clogHistSeverity'] !== undefined ? ['emergency','alert','critical','error','warning','notice','informational','debug'][Number(__e['clogHistSeverity']) - 1] : undefined"
            },
            {
              "name": "cisco_nexus.log.snmp.sysuptime",
              "value": "__e['clogHistTimestamp']"
            },
            {
              "name": "cisco_nexus.log.snmp.history_index",
              "value": "__e['clogHistIndex']"
            }
          ],
          "remove": [
            "s1_user",
            "s1_ip",
            "s1_daemon",
            "s1_pid",
            "s2_logname",
            "s2_uid",
            "s2_euid",
            "s2_tty",
            "s2_ruser",
            "s2_rhost",
            "s2_daemon",
            "s3_user",
            "s3_ip",
            "s3_daemon",
            "s3_pid",
            "clogHistSeverity",
            "clogHistTimestamp",
            "clogHistIndex"
          ]
        },
        "description": "derive user/process/outcome/action from whichever PAM shape matched (or from LOGIN_SUCCESS/LOGOUT mnemonics), recover the inverted severity, route the pam_unix tail to custom keywords, drop temps"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "event.dataset",
              "value": "'cisco_nxos.login_aaa'"
            }
          ]
        },
        "description": "tag the event with its dataset"
      }
    ]
  }
}
