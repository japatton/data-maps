{
  "id": "dm_cisco_nxos_login_aaa_api_pull",
  "conf": {
    "output": "default",
    "description": "Cisco NX-OS login-aaa / api-pull: reparse pipeline behind the REST Collector against /ins, running the identical PAM-shape dissect as the snmp-trap format on the Collector-supplied event.original, plus the standard Cisco header for facility (used per direct.elastic to derive outcome/action rather than the shared SYSTEM_MSG event.code) and the embedded sequence number.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "cisco-nxos / login-aaa / api-pull. event.original arrives already populated by the REST Collector's TABLE_*/ROW_* walk. Recovers the %FACILITY-SEV-MNEMONIC: header for facility (SYSTEM_MSG is shared across AUTHPRIV/DAEMON/USER so facility, not the mnemonic, drives outcome/action per direct.elastic) and the leading sequence number, then dissects the same three verbatim PAM shapes as the snmp-trap format. observer.name/switch_name is NOT extracted -- no header timestamp grammar was given; documented as a gap, poll-target-based observer.name is the recommended alternative."
        },
        "description": "document header/sequence recovery plus the shared three-shape PAM dissect"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/%(?<hdr_facility>[A-Za-z0-9_]+)-(?<hdr_severity>\\d+)-(?<hdr_mnemonic>[A-Za-z0-9_]+):/",
          "source": "event.original"
        },
        "description": "recover the standard Cisco %FACILITY-SEV-MNEMONIC: header for facility"
      },
      {
        "id": "regex_extract",
        "filter": "event.original && event.original.indexOf('pam_aaa:Authentication failed') > -1",
        "conf": {
          "regex": "/pam_aaa:Authentication failed for user (?<s1_user>\\S+) from (?<s1_ip>\\S+) - (?<s1_daemon>\\S+)\\[(?<s1_pid>\\d+)\\]/",
          "source": "event.original"
        },
        "description": "dissect the pam_aaa sshd-sourced authentication failure"
      },
      {
        "id": "regex_extract",
        "filter": "event.original && event.original.indexOf('pam_unix(') > -1",
        "conf": {
          "regex": "/pam_unix\\([^)]*\\):\\s*authentication failure;\\s*logname=(?<s2_logname>\\S*)\\s*uid=(?<s2_uid>\\S*)\\s*euid=(?<s2_euid>\\S*)\\s*tty=(?<s2_tty>\\S*)\\s*ruser=(?<s2_ruser>\\S*)\\s*rhost=(?<s2_rhost>\\S*)\\s*-\\s*(?<s2_daemon>\\S+)/",
          "source": "event.original"
        },
        "description": "dissect the pam_unix key=value authentication failure tail"
      },
      {
        "id": "regex_extract",
        "filter": "event.original && event.original.indexOf('illegal user') > -1",
        "conf": {
          "regex": "/error: PAM: Authentication failure for illegal user (?<s3_user>\\S+) from (?<s3_ip>\\S+) - (?<s3_daemon>\\S+)\\[(?<s3_pid>\\d+)\\]/",
          "source": "event.original"
        },
        "description": "dissect the illegal-user dcos_sshd authentication failure"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/^(?<seq>\\d+):\\s*/",
          "source": "event.original"
        },
        "description": "recover the embedded per-device sequence number when configured"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "user.name",
              "value": "__e['s1_user'] !== undefined ? __e['s1_user'] : (__e['s3_user'] !== undefined ? __e['s3_user'] : undefined)"
            },
            {
              "name": "related.user",
              "value": "(__e['s1_user'] !== undefined || __e['s3_user'] !== undefined) ? [__e['s1_user'] !== undefined ? __e['s1_user'] : __e['s3_user']] : undefined"
            },
            {
              "name": "source.ip",
              "value": "__e['s1_ip'] !== undefined ? __e['s1_ip'] : (__e['s3_ip'] !== undefined ? __e['s3_ip'] : undefined)"
            },
            {
              "name": "process.name",
              "value": "__e['s1_daemon'] !== undefined ? __e['s1_daemon'] : (__e['s3_daemon'] !== undefined ? __e['s3_daemon'] : (__e['s2_daemon'] !== undefined ? __e['s2_daemon'] : undefined))"
            },
            {
              "name": "process.pid",
              "value": "__e['s1_pid'] !== undefined ? Number(__e['s1_pid']) : (__e['s3_pid'] !== undefined ? Number(__e['s3_pid']) : undefined)"
            },
            {
              "name": "cisco_nexus.log.login.illegal_user",
              "value": "__e['s3_user'] !== undefined"
            },
            {
              "name": "cisco_nexus.log.pam.logname",
              "value": "__e['s2_logname']"
            },
            {
              "name": "cisco_nexus.log.pam.uid",
              "value": "__e['s2_uid'] !== undefined && __e['s2_uid'] !== '' ? Number(__e['s2_uid']) : undefined"
            },
            {
              "name": "cisco_nexus.log.pam.euid",
              "value": "__e['s2_euid'] !== undefined && __e['s2_euid'] !== '' ? Number(__e['s2_euid']) : undefined"
            },
            {
              "name": "cisco_nexus.log.pam.tty",
              "value": "__e['s2_tty']"
            },
            {
              "name": "cisco_nexus.log.pam.ruser",
              "value": "__e['s2_ruser']"
            },
            {
              "name": "cisco_nexus.log.pam.rhost",
              "value": "__e['s2_rhost']"
            },
            {
              "name": "cisco_nexus.log.facility",
              "value": "__e['hdr_facility']"
            },
            {
              "name": "event.outcome",
              "value": "(__e['s1_user'] !== undefined || __e['s2_daemon'] !== undefined || __e['s3_user'] !== undefined) ? 'failure' : (__e['hdr_mnemonic'] === 'LOGIN_SUCCESS' ? 'success' : undefined)"
            },
            {
              "name": "event.action",
              "value": "__e['hdr_mnemonic'] === 'LOGIN_SUCCESS' ? 'user_login' : (__e['hdr_mnemonic'] === 'LOGOUT' ? 'user_logout' : ((__e['s1_user'] !== undefined || __e['s2_daemon'] !== undefined || __e['s3_user'] !== undefined) ? 'user_login' : undefined))"
            },
            {
              "name": "event.sequence",
              "value": "__e['seq'] !== undefined ? Number(__e['seq']) : undefined"
            }
          ],
          "remove": [
            "s1_user",
            "s1_ip",
            "s1_daemon",
            "s1_pid",
            "s2_logname",
            "s2_uid",
            "s2_euid",
            "s2_tty",
            "s2_ruser",
            "s2_rhost",
            "s2_daemon",
            "s3_user",
            "s3_ip",
            "s3_daemon",
            "s3_pid",
            "hdr_facility",
            "hdr_severity",
            "hdr_mnemonic",
            "seq"
          ]
        },
        "description": "derive user/process/outcome/action from whichever PAM shape matched (or from LOGIN_SUCCESS/LOGOUT mnemonic via the recovered header), map the sequence number, route the pam_unix tail to custom keywords, drop temps"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "event.dataset",
              "value": "'cisco_nxos.login_aaa'"
            }
          ]
        },
        "description": "tag the event with its dataset"
      }
    ]
  }
}
