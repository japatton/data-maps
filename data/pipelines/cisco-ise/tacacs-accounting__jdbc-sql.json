{
  "id": "dm_cisco_ise_tacacs_accounting_jdbc_sql",
  "conf": {
    "output": "default",
    "description": "Cisco ISE, tacacs-accounting, jdbc-sql: Data Connect TACACS_ACCOUNTING view shaped to cisco_ise.log/ECS per recommendations.direct; COMMAND/COMMAND_ARGS arrive pre-unwrapped, unlike syslog's CmdAV wrapper.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "cisco-ise/tacacs-accounting/jdbc-sql. TACACS_ACCOUNTING view (2-day retention, poll fast). COMMAND/COMMAND_ARGS already unwrapped; ATTRIBUTES kept as an opaque custom blob (no documented delimiter to re-split). event.action prefers ACCOUNTING_TYPE (start/stop) and falls back to MESSAGE_TEXT's leading token, reconciling both field-row transforms onto one target."
        },
        "description": "identify technology, dataset, format, and parsing approach"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "MESSAGE_CODE",
              "newName": "'event.code'"
            },
            {
              "currentName": "USERNAME",
              "newName": "'user.name'"
            },
            {
              "currentName": "DEVICE_IP",
              "newName": "'client.ip'"
            },
            {
              "currentName": "ISE_NODE",
              "newName": "'host.hostname'"
            }
          ]
        },
        "description": "batch-rename every status:mapped Data Connect column to its ECS target"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'cisco_ise.log.logged_time'",
              "value": "__e['LOGGED_TIME']"
            },
            {
              "name": "'cisco_ise.log.record.id'",
              "value": "__e['ID']"
            },
            {
              "name": "'event.action'",
              "value": "__e['ACCOUNTING_TYPE'] ? __e['ACCOUNTING_TYPE'].toLowerCase() : (__e['MESSAGE_TEXT'] ? __e['MESSAGE_TEXT'].split(':')[0] : undefined)"
            },
            {
              "name": "'cisco_ise.log.acct.request.flags'",
              "value": "__e['ACCOUNTING_TYPE']"
            },
            {
              "name": "'cisco_ise.log.cmdset'",
              "value": "__e['COMMAND']"
            },
            {
              "name": "'cisco_ise.log.command_args'",
              "value": "__e['COMMAND_ARGS']"
            },
            {
              "name": "'host.target.name'",
              "value": "__e['DEVICE_NAME']"
            },
            {
              "name": "'cisco_ise.log.network.device.name'",
              "value": "__e['DEVICE_NAME']"
            },
            {
              "name": "'host.target.ip'",
              "value": "__e['DEVICE_IP']"
            },
            {
              "name": "'cisco_ise.log.network.device.ipv6'",
              "value": "__e['DEVICE_IPV6']"
            },
            {
              "name": "'cisco_ise.log.port'",
              "value": "__e['DEVICE_PORT']"
            },
            {
              "name": "'cisco_ise.log.network.device.groups'",
              "value": "__e['DEVICE_GROUPS']"
            },
            {
              "name": "'cisco_ise.log.network.device.type'",
              "value": "__e['DEVICE_TYPE']"
            },
            {
              "name": "'cisco_ise.log.network.device.location'",
              "value": "__e['LOCATION']"
            },
            {
              "name": "'destination.address'",
              "value": "__e['REMOTE_ADDRESS']"
            },
            {
              "name": "'cisco_ise.log.privilege.level'",
              "value": "__e['AUTHENTICATION_PRIVILEGE_LEVEL']"
            },
            {
              "name": "'cisco_ise.log.authen_method'",
              "value": "__e['AUTHENTICATION_METHOD']"
            },
            {
              "name": "'cisco_ise.log.service.name'",
              "value": "__e['AUTHENTICATION_SERVICE']"
            },
            {
              "name": "'cisco_ise.log.type'",
              "value": "__e['AUTHENTICATION_TYPE']"
            },
            {
              "name": "'event.outcome'",
              "value": "__e['STATUS'] ? (/success/i.test(__e['STATUS']) ? 'success' : (/fail/i.test(__e['STATUS']) ? 'failure' : undefined)) : undefined"
            },
            {
              "name": "'event.reason'",
              "value": "__e['FAILURE_REASON']"
            },
            {
              "name": "'cisco_ise.log.avpair'",
              "value": "__e['ATTRIBUTES']"
            },
            {
              "name": "'cisco_ise.log.step'",
              "value": "__e['EXECUTION_STEPS']"
            },
            {
              "name": "'cisco_ise.log.acs.session.id'",
              "value": "__e['SESSION_KEY']"
            },
            {
              "name": "'cisco_ise.log.identity.group'",
              "value": "__e['IDENTITY_GROUP']"
            },
            {
              "name": "'cisco_ise.log.event'",
              "value": "__e['EVENT']"
            },
            {
              "name": "'cisco_ise.log.epoch_time'",
              "value": "__e['EPOCH_TIME']"
            },
            {
              "name": "__dm_time",
              "value": "typeof __e['GENERATED_TIME'] === 'number' ? (__e['GENERATED_TIME'] > 1e12 ? __e['GENERATED_TIME']/1000 : __e['GENERATED_TIME']) : Date.parse(__e['GENERATED_TIME'])/1000"
            },
            {
              "name": "_time",
              "value": "__e['__dm_time'] !== undefined && __e['__dm_time'] !== null && __e['__dm_time'] === __e['__dm_time'] ? __e['__dm_time'] : __e['_time']"
            },
            {
              "name": "'event.dataset'",
              "value": "'cisco_ise.tacacs_accounting'"
            }
          ]
        },
        "description": "map partial/unmapped columns to ECS or cisco_ise.log.* custom fields, set _time from the row's own timestamp column, and tag event.dataset"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
