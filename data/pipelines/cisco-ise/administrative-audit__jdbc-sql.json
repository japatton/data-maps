{
  "id": "dm_cisco_ise_administrative_audit_jdbc_sql",
  "conf": {
    "output": "default",
    "description": "Cisco ISE, administrative-audit, jdbc-sql: unions Data Connect ADMINISTRATOR_LOGINS and CHANGE_CONFIGURATION_AUDIT views, shaped to cisco_ise.log/ECS per recommendations.direct; low-volume, sampling-exempt.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "cisco-ise/administrative-audit/jdbc-sql. Collector unions ADMINISTRATOR_LOGINS (login events, no MESSAGE_CODE) and CHANGE_CONFIGURATION_AUDIT (config events, has MESSAGE_CODE) rows. EVENT/MESSAGE_CODE/etc. are shared or view-specific columns; absent columns simply evaluate to undefined per row. event.outcome only derives from FAILURE_FLAG (config rows); login-row outcome from EVENT_DETAILS free text is not attempted."
        },
        "description": "identify technology, dataset, format, and parsing approach"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "ISE_NODE",
              "newName": "'host.hostname'"
            },
            {
              "currentName": "MESSAGE_CODE",
              "newName": "'event.code'"
            }
          ]
        },
        "description": "batch-rename every status:mapped Data Connect column to its ECS target"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'user.name'",
              "value": "__e['ADMIN_NAME'] ? (__e['ADMIN_NAME'].indexOf('@') > -1 ? __e['ADMIN_NAME'].split('@')[0] : __e['ADMIN_NAME']) : undefined"
            },
            {
              "name": "'user.domain'",
              "value": "__e['ADMIN_NAME'] && __e['ADMIN_NAME'].indexOf('@') > -1 ? __e['ADMIN_NAME'].split('@')[1] : undefined"
            },
            {
              "name": "'client.ip'",
              "value": "__e['IP_ADDRESS']"
            },
            {
              "name": "'source.ip'",
              "value": "__e['IP_ADDRESS']"
            },
            {
              "name": "'cisco_ise.log.admin.ipv6'",
              "value": "__e['IPV6_ADDRESS']"
            },
            {
              "name": "'cisco_ise.log.admin.interface'",
              "value": "__e['INTERFACE']"
            },
            {
              "name": "'cisco_ise.log.admin.session'",
              "value": "__e['ADMIN_SESSION']"
            },
            {
              "name": "'event.action'",
              "value": "__e['EVENT']"
            },
            {
              "name": "'cisco_ise.log.event.details'",
              "value": "__e['EVENT_DETAILS']"
            },
            {
              "name": "'cisco_ise.log.requested_operation'",
              "value": "__e['REQUESTED_OPERATION']"
            },
            {
              "name": "'cisco_ise.log.object.type'",
              "value": "__e['OBJECT_TYPE']"
            },
            {
              "name": "'cisco_ise.log.object.name'",
              "value": "__e['OBJECT_NAME']"
            },
            {
              "name": "'cisco_ise.log.object.internal.id'",
              "value": "__e['OBJECT_ID']"
            },
            {
              "name": "'cisco_ise.log.config_change.data'",
              "value": "__e['MODIFIED_PROPERTIES']"
            },
            {
              "name": "message",
              "value": "__e['OPERATION_MESSAGE_TEXT']"
            },
            {
              "name": "'event.outcome'",
              "value": "__e['FAILURE_FLAG'] !== undefined ? (__e['FAILURE_FLAG'] ? 'failure' : 'success') : undefined"
            },
            {
              "name": "'cisco_ise.log.message_class'",
              "value": "__e['MESSAGE_CLASS']"
            },
            {
              "name": "'cisco_ise.log.request_response_type'",
              "value": "__e['REQUEST_RESPONSE_TYPE']"
            },
            {
              "name": "'cisco_ise.log.details'",
              "value": "__e['DETAILS']"
            },
            {
              "name": "'cisco_ise.log.host_id'",
              "value": "__e['HOST_ID']"
            },
            {
              "name": "'cisco_ise.log.admin.nas.ip'",
              "value": "__e['NAS_IP_ADDRESS']"
            },
            {
              "name": "'related.ip'",
              "value": "__e['NAS_IP_ADDRESS'] ? [__e['NAS_IP_ADDRESS']] : undefined"
            },
            {
              "name": "'cisco_ise.log.applied_to_instance'",
              "value": "__e['APPLIED_TO_ACS_INSTANCE']"
            },
            {
              "name": "'cisco_ise.log.local_mode'",
              "value": "__e['LOCAL_MODE']"
            },
            {
              "name": "'cisco_ise.log.record.id'",
              "value": "__e['ID']"
            },
            {
              "name": "__dm_time",
              "value": "__e['TIMESTAMP_TIMEZONE'] ? Date.parse(__e['TIMESTAMP_TIMEZONE'])/1000 : (typeof __e['TIMESTAMP'] === 'number' ? (__e['TIMESTAMP'] > 1e12 ? __e['TIMESTAMP']/1000 : __e['TIMESTAMP']) : Date.parse(__e['TIMESTAMP'])/1000)"
            },
            {
              "name": "_time",
              "value": "__e['__dm_time'] !== undefined && __e['__dm_time'] !== null && __e['__dm_time'] === __e['__dm_time'] ? __e['__dm_time'] : __e['_time']"
            },
            {
              "name": "'event.dataset'",
              "value": "'cisco_ise.administrative_audit'"
            }
          ]
        },
        "description": "map partial/unmapped columns to ECS or cisco_ise.log.* custom fields, set _time from the row's own timestamp column, and tag event.dataset"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
