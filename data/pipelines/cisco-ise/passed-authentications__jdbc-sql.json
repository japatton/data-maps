{
  "id": "dm_cisco_ise_passed_authentications_jdbc_sql",
  "conf": {
    "output": "default",
    "description": "Cisco ISE, passed-authentications, jdbc-sql: Data Connect RADIUS_AUTHENTICATIONS (PASSED=1) row shaping to cisco_ise.log/ECS per recommendations.direct (low-side, no guard hop, direct route).",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "cisco-ise/passed-authentications/jdbc-sql. Rows come from a custom Database Collector against RADIUS_AUTHENTICATIONS (PASSED=1); fields already arrive as structured columns, so no deserialize step. Direct route, low-side parse per recommendations.direct.cribl."
        },
        "description": "identify technology, dataset, format, and parsing approach"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "ISE_NODE",
              "newName": "'host.hostname'"
            },
            {
              "currentName": "SYSLOG_MESSAGE_CODE",
              "newName": "'event.code'"
            },
            {
              "currentName": "USERNAME",
              "newName": "'user.name'"
            },
            {
              "currentName": "NAS_IP_ADDRESS",
              "newName": "'client.ip'"
            }
          ]
        },
        "description": "batch-rename every status:mapped Data Connect column to its ECS target"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'cisco_ise.log.record.id'",
              "value": "__e['ID']"
            },
            {
              "name": "'cisco_ise.log.user.type'",
              "value": "__e['USER_TYPE']"
            },
            {
              "name": "'source.mac'",
              "value": "/^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$/.test(__e['CALLING_STATION_ID']) ? __e['CALLING_STATION_ID'] : undefined"
            },
            {
              "name": "'source.ip'",
              "value": "__e['CALLING_STATION_ID'] && !/^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$/.test(__e['CALLING_STATION_ID']) ? __e['CALLING_STATION_ID'] : undefined"
            },
            {
              "name": "'cisco_ise.log.calling_station.id'",
              "value": "__e['CALLING_STATION_ID']"
            },
            {
              "name": "'cisco_ise.log.orig_calling_station.id'",
              "value": "__e['ORIG_CALLING_STATION_ID']"
            },
            {
              "name": "'related.ip'",
              "value": "__e['FRAMED_IP_ADDRESS'] ? [__e['FRAMED_IP_ADDRESS']] : undefined"
            },
            {
              "name": "'cisco_ise.log.framed.ip'",
              "value": "__e['FRAMED_IP_ADDRESS']"
            },
            {
              "name": "'cisco_ise.log.nas.port_id'",
              "value": "__e['NAS_PORT_ID']"
            },
            {
              "name": "'cisco_ise.log.nas.port_type'",
              "value": "__e['NAS_PORT_TYPE']"
            },
            {
              "name": "'cisco_ise.log.nas.ipv6'",
              "value": "__e['NAS_IPV6_ADDRESS']"
            },
            {
              "name": "'cisco_ise.log.framed.ipv6'",
              "value": "__e['FRAMED_IPV6_ADDRESS']"
            },
            {
              "name": "'cisco_ise.log.authentication.identity_store'",
              "value": "__e['IDENTITY_STORE']"
            },
            {
              "name": "'cisco_ise.log.identity.group'",
              "value": "__e['IDENTITY_GROUP']"
            },
            {
              "name": "'cisco_ise.log.audit_session.id'",
              "value": "__e['AUDIT_SESSION_ID']"
            },
            {
              "name": "'cisco_ise.log.authentication.method'",
              "value": "__e['AUTHENTICATION_METHOD']"
            },
            {
              "name": "'cisco_ise.log.authentication.protocol'",
              "value": "__e['AUTHENTICATION_PROTOCOL']"
            },
            {
              "name": "'cisco_ise.log.service_type'",
              "value": "__e['SERVICE_TYPE']"
            },
            {
              "name": "'cisco_ise.log.access_service'",
              "value": "__e['ACCESS_SERVICE']"
            },
            {
              "name": "'cisco_ise.log.network.device.name'",
              "value": "__e['DEVICE_NAME']"
            },
            {
              "name": "'cisco_ise.log.network.device.type'",
              "value": "__e['DEVICE_TYPE']"
            },
            {
              "name": "'cisco_ise.log.network.device.location'",
              "value": "__e['LOCATION']"
            },
            {
              "name": "'cisco_ise.log.selected.authorization.profiles'",
              "value": "__e['AUTHORIZATION_PROFILES']"
            },
            {
              "name": "'rule.name'",
              "value": "__e['AUTHORIZATION_RULE']"
            },
            {
              "name": "'cisco_ise.log.policy_set.name'",
              "value": "__e['POLICY_SET_NAME']"
            },
            {
              "name": "'cisco_ise.log.posture.assessment.status'",
              "value": "__e['POSTURE_STATUS']"
            },
            {
              "name": "'cisco_ise.log.security_group'",
              "value": "__e['SECURITY_GROUP']"
            },
            {
              "name": "'cisco_ise.log.endpoint.profile'",
              "value": "__e['ENDPOINT_PROFILE']"
            },
            {
              "name": "'cisco_ise.log.mdm.server.name'",
              "value": "__e['MDM_SERVER_NAME']"
            },
            {
              "name": "'cisco_ise.log.credential_check'",
              "value": "__e['CREDENTIAL_CHECK']"
            },
            {
              "name": "'event.reason'",
              "value": "__e['FAILURE_REASON']"
            },
            {
              "name": "'event.duration'",
              "value": "__e['RESPONSE_TIME'] !== undefined ? __e['RESPONSE_TIME'] * 1000000 : undefined"
            },
            {
              "name": "'event.outcome'",
              "value": "__e['PASSED'] === undefined ? undefined : (__e['PASSED'] ? 'success' : 'failure')"
            },
            {
              "name": "'cisco_ise.log.failed_flag'",
              "value": "__e['FAILED']"
            },
            {
              "name": "'cisco_ise.log.step'",
              "value": "__e['EXECUTION_STEPS']"
            },
            {
              "name": "'cisco_ise.log.checksum'",
              "value": "__e['CHECKSUM']"
            },
            {
              "name": "_time",
              "value": "__e['TIMESTAMP_TIMEZONE'] ? Date.parse(__e['TIMESTAMP_TIMEZONE'])/1000 : (typeof __e['TIMESTAMP'] === 'number' ? (__e['TIMESTAMP'] > 1e12 ? __e['TIMESTAMP']/1000 : __e['TIMESTAMP']) : Date.parse(__e['TIMESTAMP'])/1000)"
            },
            {
              "name": "'event.dataset'",
              "value": "'cisco_ise.passed_authentications'"
            }
          ]
        },
        "description": "map partial/unmapped columns to ECS or cisco_ise.log.* custom fields, set _time from the row's own timestamp column, and tag event.dataset"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
