{
  "id": "dm_forescout_counteract_host_property_api_pull",
  "conf": {
    "output": "default",
    "description": "Forescout eyeExtend Connect Web API host-inventory pull (host-property, api-pull): hal+json response shaping - the Elastic Forescout package ships no collector or pipeline for this feed.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "host-property/api-pull: shapes the JSON object a Cribl REST Collector receives per endpoint from GET /api/hosts (the Collector itself is a Source/Collector object, out of scope for this pipeline). hostname is preferred over nbthost for host.name per the documented multi-source ambiguity. mac normalized colon->dash uppercase. No timestamp field is documented for this feed, so no _time step is added (defaults to receipt time)."
        },
        "description": "why this is JSON reshaping rather than text parsing"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "Extract the hal+json host record"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "ip",
              "newName": "host.ip"
            },
            {
              "currentName": "user",
              "newName": "user.name"
            },
            {
              "currentName": "vendor_classification",
              "newName": "device.manufacturer"
            },
            {
              "currentName": "os_classification",
              "newName": "host.os.full"
            },
            {
              "currentName": "prim_classification",
              "newName": "forescout.host.prim_classification"
            },
            {
              "currentName": "onsite",
              "newName": "forescout.host.onsite"
            },
            {
              "currentName": "online",
              "newName": "forescout.host.online"
            },
            {
              "currentName": "access_ip",
              "newName": "forescout.host.access_ip"
            },
            {
              "currentName": "agent_version",
              "newName": "forescout.host.agent_version"
            },
            {
              "currentName": "fingerprint",
              "newName": "forescout.host.fingerprint"
            },
            {
              "currentName": "open_port",
              "newName": "forescout.host.openports"
            }
          ]
        },
        "description": "batch every status:mapped/custom field that needed no further transform"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "host.mac",
              "value": "typeof __e['mac'] !== 'undefined' ? __e['mac'].split(':').join('-').toUpperCase() : undefined"
            },
            {
              "name": "host.name",
              "value": "typeof __e['hostname'] !== 'undefined' ? __e['hostname'] : (typeof __e['nbthost'] !== 'undefined' ? __e['nbthost'] : undefined)"
            },
            {
              "name": "event.dataset",
              "value": "'forescout_counteract.host_property_pull'"
            }
          ],
          "remove": [
            "mac",
            "hostname",
            "nbthost"
          ]
        },
        "description": "mac normalization, hostname/nbthost precedence into host.name, event.dataset, cleanup"
      }
    ]
  }
}
