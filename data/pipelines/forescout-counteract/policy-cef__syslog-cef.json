{
  "id": "dm_forescout_counteract_policy_cef_syslog_cef",
  "conf": {
    "output": "default",
    "description": "Forescout eyeSight/CounterACT CEF Plugin compliance feed (policy-cef, syslog-cef): fixed-slot compliance CEF decode - no Elastic/Cribl-pack parser exists for Forescout CEF.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "policy-cef/syslog-cef: Send Compliant/Not Compliant/Customized CEF Message compliance record. Splits the 8 pipe-delimited CEF header segments, extracts cs1-cs4 (policy name/sub-rule/compliance verdict/trigger) and cs1Label-cs4Label plus the fixed dst/dmac/dhost/dntdom/duser/dvc/dvchost/rt dictionary keys. cs3 yes/no maps to event.outcome (posture verdict, not enforcement result). Priority is passed through as-is: the vendor's own docs disagree with its own samples (3/5 vs 1), so no corrected numeric lookup is invented (README gap)."
        },
        "description": "why compliance CEF gets fixed-slot extraction unlike the per-policy NAC/host CEF forms"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/CEF:(?<cef_version>\\d+)\\|(?<cef_vendor>[^|]*)\\|(?<cef_product>[^|]*)\\|(?<cef_device_version>[^|]*)\\|(?<cef_sig_id>[^|]*)\\|(?<cef_name>[^|]*)\\|(?<cef_priority>[^|]*)\\|(?<cef_ext>.*)$/",
          "source": "_raw"
        },
        "description": "Split the 8 pipe-delimited CEF header segments"
      },
      {
        "id": "regex_extract",
        "filter": "typeof cef_ext !== 'undefined'",
        "conf": {
          "regex": "/cs1=(?<cef_cs1>.*?)(?=\\s+\\w+=|$)/",
          "source": "cef_ext"
        },
        "description": "Extract CEF extension key cs1 (Compliancy Policy Name)"
      },
      {
        "id": "regex_extract",
        "filter": "typeof cef_ext !== 'undefined'",
        "conf": {
          "regex": "/cs2=(?<cef_cs2>.*?)(?=\\s+\\w+=|$)/",
          "source": "cef_ext"
        },
        "description": "Extract CEF extension key cs2 (Compliancy Policy Sub-rule Name)"
      },
      {
        "id": "regex_extract",
        "filter": "typeof cef_ext !== 'undefined'",
        "conf": {
          "regex": "/cs3=(?<cef_cs3>.*?)(?=\\s+\\w+=|$)/",
          "source": "cef_ext"
        },
        "description": "Extract CEF extension key cs3 (Host Compliancy Status yes/no)"
      },
      {
        "id": "regex_extract",
        "filter": "typeof cef_ext !== 'undefined'",
        "conf": {
          "regex": "/cs4=(?<cef_cs4>.*?)(?=\\s+\\w+=|$)/",
          "source": "cef_ext"
        },
        "description": "Extract CEF extension key cs4 (Compliancy Event Trigger)"
      },
      {
        "id": "regex_extract",
        "filter": "typeof cef_ext !== 'undefined'",
        "conf": {
          "regex": "/cs1Label=(?<cef_cs1_label>.*?)(?=\\s+\\w+=|$)/",
          "source": "cef_ext"
        },
        "description": "Extract CEF extension key cs1Label"
      },
      {
        "id": "regex_extract",
        "filter": "typeof cef_ext !== 'undefined'",
        "conf": {
          "regex": "/cs2Label=(?<cef_cs2_label>.*?)(?=\\s+\\w+=|$)/",
          "source": "cef_ext"
        },
        "description": "Extract CEF extension key cs2Label"
      },
      {
        "id": "regex_extract",
        "filter": "typeof cef_ext !== 'undefined'",
        "conf": {
          "regex": "/cs3Label=(?<cef_cs3_label>.*?)(?=\\s+\\w+=|$)/",
          "source": "cef_ext"
        },
        "description": "Extract CEF extension key cs3Label"
      },
      {
        "id": "regex_extract",
        "filter": "typeof cef_ext !== 'undefined'",
        "conf": {
          "regex": "/cs4Label=(?<cef_cs4_label>.*?)(?=\\s+\\w+=|$)/",
          "source": "cef_ext"
        },
        "description": "Extract CEF extension key cs4Label"
      },
      {
        "id": "regex_extract",
        "filter": "typeof cef_ext !== 'undefined'",
        "conf": {
          "regex": "/dst=(?<cef_dst>.*?)(?=\\s+\\w+=|$)/",
          "source": "cef_ext"
        },
        "description": "Extract CEF extension key dst (endpoint IP)"
      },
      {
        "id": "regex_extract",
        "filter": "typeof cef_ext !== 'undefined'",
        "conf": {
          "regex": "/dmac=(?<cef_dmac>.*?)(?=\\s+\\w+=|$)/",
          "source": "cef_ext"
        },
        "description": "Extract CEF extension key dmac (endpoint MAC)"
      },
      {
        "id": "regex_extract",
        "filter": "typeof cef_ext !== 'undefined'",
        "conf": {
          "regex": "/dhost=(?<cef_dhost>.*?)(?=\\s+\\w+=|$)/",
          "source": "cef_ext"
        },
        "description": "Extract CEF extension key dhost (endpoint host name)"
      },
      {
        "id": "regex_extract",
        "filter": "typeof cef_ext !== 'undefined'",
        "conf": {
          "regex": "/dntdom=(?<cef_dntdom>.*?)(?=\\s+\\w+=|$)/",
          "source": "cef_ext"
        },
        "description": "Extract CEF extension key dntdom (endpoint NT domain)"
      },
      {
        "id": "regex_extract",
        "filter": "typeof cef_ext !== 'undefined'",
        "conf": {
          "regex": "/duser=(?<cef_duser>.*?)(?=\\s+\\w+=|$)/",
          "source": "cef_ext"
        },
        "description": "Extract CEF extension key duser (logged-on user, may carry a scope suffix)"
      },
      {
        "id": "regex_extract",
        "filter": "typeof cef_ext !== 'undefined'",
        "conf": {
          "regex": "/dvc=(?<cef_dvc>.*?)(?=\\s+\\w+=|$)/",
          "source": "cef_ext"
        },
        "description": "Extract CEF extension key dvc (CounterACT device IP)"
      },
      {
        "id": "regex_extract",
        "filter": "typeof cef_ext !== 'undefined'",
        "conf": {
          "regex": "/dvchost=(?<cef_dvchost>.*?)(?=\\s+\\w+=|$)/",
          "source": "cef_ext"
        },
        "description": "Extract CEF extension key dvchost (CounterACT device host name)"
      },
      {
        "id": "regex_extract",
        "filter": "typeof cef_ext !== 'undefined'",
        "conf": {
          "regex": "/rt=(?<cef_rt>.*?)(?=\\s+\\w+=|$)/",
          "source": "cef_ext"
        },
        "description": "Extract CEF extension key rt (event detection time, epoch ms)"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "cef_vendor",
              "newName": "'observer.vendor'"
            },
            {
              "currentName": "cef_product",
              "newName": "'observer.product'"
            },
            {
              "currentName": "cef_device_version",
              "newName": "'observer.version'"
            },
            {
              "currentName": "cef_sig_id",
              "newName": "'event.code'"
            },
            {
              "currentName": "cef_name",
              "newName": "'event.action'"
            },
            {
              "currentName": "cef_cs1",
              "newName": "'rule.name'"
            },
            {
              "currentName": "cef_dst",
              "newName": "'host.ip'"
            },
            {
              "currentName": "cef_dhost",
              "newName": "'host.name'"
            },
            {
              "currentName": "cef_dntdom",
              "newName": "'host.domain'"
            },
            {
              "currentName": "cef_dvc",
              "newName": "'observer.ip'"
            },
            {
              "currentName": "cef_dvchost",
              "newName": "'observer.name'"
            }
          ]
        },
        "description": "batch every status:mapped field that needed no further transform"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'host.mac'",
              "value": "typeof __e['cef_dmac'] !== 'undefined' ? __e['cef_dmac'].split(':').join('-').toUpperCase() : undefined"
            },
            {
              "name": "_time",
              "value": "typeof __e['cef_rt'] !== 'undefined' ? Number(__e['cef_rt'])/1000 : undefined"
            },
            {
              "name": "'event.severity'",
              "value": "typeof __e['cef_priority'] !== 'undefined' ? Number(__e['cef_priority']) : undefined"
            },
            {
              "name": "'event.outcome'",
              "value": "__e['cef_cs3']==='yes'?'success':__e['cef_cs3']==='no'?'failure':undefined"
            },
            {
              "name": "'user.name'",
              "value": "typeof __e['cef_duser'] !== 'undefined' ? __e['cef_duser'].replace(/\\s*\\([^)]*\\)\\s*$/, '') : undefined"
            },
            {
              "name": "'forescout.policy.subrule'",
              "value": "__e['cef_cs2']"
            },
            {
              "name": "'forescout.policy.event_trigger'",
              "value": "__e['cef_cs4']"
            },
            {
              "name": "'forescout.policy.cef_labels'",
              "value": "[__e['cef_cs1_label'],__e['cef_cs2_label'],__e['cef_cs3_label'],__e['cef_cs4_label']].join('|')"
            },
            {
              "name": "'event.dataset'",
              "value": "'forescout_counteract.policy_cef'"
            }
          ],
          "remove": [
            "cef_ext",
            "cef_dmac",
            "cef_rt",
            "cef_priority",
            "cef_cs2",
            "cef_cs3",
            "cef_cs4",
            "cef_cs1_label",
            "cef_cs2_label",
            "cef_cs3_label",
            "cef_cs4_label",
            "cef_duser",
            "cef_version"
          ]
        },
        "description": "dmac normalization, rt conversion, cs3 verdict->event.outcome, duser scope-suffix strip, sub-rule/trigger/label custom fields, Priority passthrough (vendor docs self-contradict - README gap), event.dataset, cleanup"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
