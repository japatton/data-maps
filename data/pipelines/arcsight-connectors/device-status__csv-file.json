{
  "id": "dm_arcsight_connectors_device_status_csv_file",
  "conf": {
    "output": "default",
    "description": "ArcSight Connectors device-status (agent:043), csv-file: drop the header line, CSV-extract against the full documented column schema, coerce text-typed numeric/date columns, batch-rename to ECS/arcsight.connector.*, tag event.dataset.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "ArcSight Connectors device-status (agent:043) / csv-file: rotating CSV, case-sensitive header. A File source delivers each line standalone with no cross-event header memory, so this cannot key on the live header row. Drops the literal header line (_raw starting with 'deviceEventClassId'), then serde-CSV-extracts against an explicit fields list matching the FULL documented column schema -- assumes the destination selected all these columns in this order; a deployment selecting a different subset/order will misalign (needs Source-level header handling, out of scope here). eval coerces text-typed numeric/date columns and computes _time from deviceReceiptTime BEFORE the batched rename, then renames to ECS/arcsight.connector.* and tags event.dataset. event.severity is a direct copy of agentSeverity: no 0-10-to-platform-numeric lookup exists here, so that conversion is a documented gap. Direct route, no guard hop."
        },
        "description": "technology/dataset/format and parsing approach"
      },
      {
        "id": "drop",
        "filter": "_raw && _raw.indexOf('deviceEventClassId') === 0",
        "conf": {},
        "description": "discard the literal CSV header line, which otherwise would be mis-parsed as a data row"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "csv",
          "srcField": "_raw",
          "fields": [
            "deviceEventClassId",
            "name",
            "sourceAddress",
            "sourceHostName",
            "sourceZoneURI",
            "deviceCustomNumber1",
            "deviceCustomNumber1Label",
            "deviceCustomNumber2",
            "deviceCustomNumber2Label",
            "deviceCustomDate1",
            "deviceCustomDate1Label",
            "deviceCustomString1",
            "deviceCustomString1Label",
            "agentHostName",
            "agentAddress",
            "agentId",
            "agentType",
            "agentVersion",
            "deviceReceiptTime",
            "agentSeverity",
            "baseEventCount"
          ]
        },
        "description": "extract the CSV row positionally against the full documented column schema"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "deviceCustomNumber1",
              "value": "__e['deviceCustomNumber1'] !== undefined ? Number(__e['deviceCustomNumber1']) : undefined"
            },
            {
              "name": "deviceCustomNumber2",
              "value": "__e['deviceCustomNumber2'] !== undefined ? Number(__e['deviceCustomNumber2']) : undefined"
            },
            {
              "name": "baseEventCount",
              "value": "__e['baseEventCount'] !== undefined ? Number(__e['baseEventCount']) : undefined"
            },
            {
              "name": "agentSeverity",
              "value": "__e['agentSeverity'] !== undefined ? Number(__e['agentSeverity']) : undefined"
            },
            {
              "name": "deviceCustomDate1",
              "value": "__e['deviceCustomDate1'] !== undefined ? new Date(__e['deviceCustomDate1']).getTime() : undefined"
            },
            {
              "name": "_time",
              "value": "__e['deviceReceiptTime'] !== undefined ? new Date(__e['deviceReceiptTime']).getTime()/1000 : __e['_time']"
            }
          ]
        },
        "description": "coerce text-typed CSV numeric/date columns and compute _time, before renaming"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "deviceEventClassId",
              "newName": "'event.code'"
            },
            {
              "currentName": "name",
              "newName": "'event.action'"
            },
            {
              "currentName": "sourceAddress",
              "newName": "'source.ip'"
            },
            {
              "currentName": "sourceHostName",
              "newName": "'arcsight.connector.device.host'"
            },
            {
              "currentName": "sourceZoneURI",
              "newName": "'arcsight.connector.device.zone_uri'"
            },
            {
              "currentName": "deviceCustomNumber1",
              "newName": "'arcsight.connector.device.event_count_total'"
            },
            {
              "currentName": "deviceCustomNumber2",
              "newName": "'arcsight.connector.device.event_count_interval'"
            },
            {
              "currentName": "deviceCustomDate1",
              "newName": "'arcsight.connector.device.last_event_time'"
            },
            {
              "currentName": "deviceCustomString1",
              "newName": "'arcsight.connector.device.custom_string'"
            },
            {
              "currentName": "agentHostName",
              "newName": "'observer.hostname'"
            },
            {
              "currentName": "agentAddress",
              "newName": "'observer.ip'"
            },
            {
              "currentName": "agentId",
              "newName": "'arcsight.connector.agent_id'"
            },
            {
              "currentName": "agentType",
              "newName": "'observer.type'"
            },
            {
              "currentName": "agentVersion",
              "newName": "'observer.version'"
            },
            {
              "currentName": "agentSeverity",
              "newName": "'event.severity'"
            },
            {
              "currentName": "baseEventCount",
              "newName": "'arcsight.connector.device.base_event_count'"
            }
          ]
        },
        "description": "batch rename canonical ArcSight field names (mapped + partial rows) to ECS/arcsight.connector.* custom targets"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'event.dataset'",
              "value": "'arcsight_connectors.device_status'"
            }
          ]
        },
        "description": "tag event.dataset (underscored, no hyphen)"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
