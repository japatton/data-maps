{
  "id": "dm_paloalto_ngfw_userid_syslog_cef",
  "conf": {
    "output": "default",
    "description": "Palo Alto NGFW User-ID log (syslog-cef, PAN-OS 10.2/11.1), direct route: CEF header+extension parse to the same ECS/custom shape as the CSV route; cat=eventid (not category) and end=factor-completion-time (not event.end) traps overridden per the work order",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "Palo Alto NGFW User-ID log, syslog-cef, PAN-OS 10.2/11.1, direct route. Two envelope traps overridden here: cat carries $eventid on THIS log type (not $action_source as on Traffic) so it maps to event.code, not category; and end carries $factorcompletiontime (MFA), not an interval end, so it stays custom and is never routed to event.end. Header slot 5 (Device Event Class ID) carries $subtype -> event.action; slot 6 (Name) carries the constant $type and is dropped, mirroring the CSV route's handling of its 'type' column."
        },
        "description": "Pipeline purpose and the cat/end envelope traps"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/CEF:(?<cef_version>[^|]*)\\|(?<device_vendor>[^|]*)\\|(?<device_product>[^|]*)\\|(?<device_version>[^|]*)\\|(?<device_event_class_id>[^|]*)\\|(?<cef_name>[^|]*)\\|(?<severity>[^|]*)\\|(?<extensions>.*)$/",
          "source": "_raw",
          "overwrite": true
        },
        "description": "Split the 7 pipe-delimited CEF header slots from the extensions blob"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "kvp",
          "srcField": "extensions"
        },
        "description": "Extract the CEF key=value extensions into top-level fields"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "device_event_class_id",
              "newName": "'event.action'"
            },
            {
              "currentName": "deviceExternalId",
              "newName": "'observer.serial_number'"
            },
            {
              "currentName": "dvchost",
              "newName": "'observer.name'"
            },
            {
              "currentName": "cat",
              "newName": "'event.code'"
            },
            {
              "currentName": "externalId",
              "newName": "'event.sequence'"
            },
            {
              "currentName": "dntdom",
              "newName": "'user.domain'"
            },
            {
              "currentName": "src",
              "newName": "'source.ip'"
            },
            {
              "currentName": "duid",
              "newName": "'user.id'"
            }
          ]
        },
        "description": "Batch rename of directly-mapped header/extension fields with no extra transform logic; cat is $eventid here, not a category"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "__dm_time",
              "value": "__e['PanOSTimeGeneratedHighResolution'] ? Date.parse(__e['PanOSTimeGeneratedHighResolution'])/1000 : (__e['start'] ? Date.parse(__e['start'] + ' UTC')/1000 : undefined)"
            },
            {
              "name": "_time",
              "value": "__e['__dm_time'] !== undefined && __e['__dm_time'] !== null && __e['__dm_time'] === __e['__dm_time'] ? __e['__dm_time'] : __e['_time']"
            },
            {
              "name": "'event.outcome'",
              "value": "'success'"
            },
            {
              "name": "'event.dataset'",
              "value": "'paloalto_ngfw.userid'"
            },
            {
              "name": "'related.ip'",
              "value": "__e['source.ip'] ? [__e['source.ip']] : undefined"
            },
            {
              "name": "'user.name'",
              "value": "__e['user.domain'] ? __e['duser'] : (__e['duser'] ? (__e['duser'].indexOf('\\\\') > -1 ? __e['duser'].slice(__e['duser'].indexOf('\\\\') + 1) : (__e['duser'].indexOf('@') > -1 ? __e['duser'].slice(0, __e['duser'].indexOf('@')) : __e['duser'])) : undefined)"
            },
            {
              "name": "'panw.panos.userid.user_raw'",
              "value": "__e['duser']"
            },
            {
              "name": "'event.sequence'",
              "value": "__e['event.sequence'] !== undefined && __e['event.sequence'] !== '' ? +__e['event.sequence'] : undefined"
            }
          ]
        },
        "description": "Event time (high-res-timestamp preferred, start UTC-assumed fallback), event.outcome/event.dataset constants, user.name (Cortex pre-split vs on-box qualifier split), related.ip, numeric event.sequence"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'related.user'",
              "value": "__e['user.name'] ? [__e['user.name']] : undefined"
            },
            {
              "name": "'panw.panos.userid.factor_completion_time'",
              "value": "__e['end']"
            },
            {
              "name": "'panw.panos.userid.factor_number'",
              "value": "__e['cn1'] !== undefined && __e['cn1'] !== '' ? +__e['cn1'] : undefined"
            },
            {
              "name": "'panw.panos.userid.repeat_count'",
              "value": "__e['cnt'] !== undefined && __e['cnt'] !== '' ? +__e['cnt'] : undefined"
            },
            {
              "name": "'panw.panos.userid.begin_port'",
              "value": "__e['spt'] !== undefined && __e['spt'] !== '' ? +__e['spt'] : undefined"
            },
            {
              "name": "'panw.panos.userid.end_port'",
              "value": "__e['dpt'] !== undefined && __e['dpt'] !== '' ? +__e['dpt'] : undefined"
            },
            {
              "name": "'panw.panos.device_group_hierarchy'",
              "value": "[__e['PanOSDGHierarchyLevel1'] !== undefined && __e['PanOSDGHierarchyLevel1'] !== '' ? +__e['PanOSDGHierarchyLevel1'] : undefined, __e['PanOSDGHierarchyLevel2'] !== undefined && __e['PanOSDGHierarchyLevel2'] !== '' ? +__e['PanOSDGHierarchyLevel2'] : undefined, __e['PanOSDGHierarchyLevel3'] !== undefined && __e['PanOSDGHierarchyLevel3'] !== '' ? +__e['PanOSDGHierarchyLevel3'] : undefined, __e['PanOSDGHierarchyLevel4'] !== undefined && __e['PanOSDGHierarchyLevel4'] !== '' ? +__e['PanOSDGHierarchyLevel4'] : undefined]"
            },
            {
              "name": "'panw.panos.receive_time'",
              "value": "__e['rt']"
            },
            {
              "name": "'panw.panos.userid.datasource'",
              "value": "__e['cs5']"
            },
            {
              "name": "'panw.panos.userid.datasource_name'",
              "value": "__e['cs4']"
            },
            {
              "name": "'panw.panos.userid.datasource_type'",
              "value": "__e['cs6']"
            },
            {
              "name": "'panw.panos.userid.timeout'",
              "value": "__e['cn3'] !== undefined && __e['cn3'] !== '' ? +__e['cn3'] : undefined"
            },
            {
              "name": "'panw.panos.userid.factor_type'",
              "value": "__e['cs1']"
            },
            {
              "name": "'panw.panos.userid.tag_name'",
              "value": "__e['PanOSTag']"
            },
            {
              "name": "'panw.panos.high_res_timestamp'",
              "value": "__e['PanOSTimeGeneratedHighResolution']"
            },
            {
              "name": "'panw.panos.userid.ug_flags'",
              "value": "__e['PanOSUGFlags']"
            },
            {
              "name": "'panw.panos.userid.user_group_found'",
              "value": "__e['PanOSUserGroupFound']"
            },
            {
              "name": "'panw.panos.userid.duplicate_user'",
              "value": "__e['PanOSIsDuplicateUser']"
            },
            {
              "name": "'panw.panos.userid.user_by_source'",
              "value": "__e['PanOSUserIdentifiedBySource']"
            },
            {
              "name": "'panw.panos.vsys'",
              "value": "__e['cs3']"
            },
            {
              "name": "'panw.panos.vsys_id'",
              "value": "__e['cn2'] !== undefined && __e['cn2'] !== '' ? +__e['cn2'] : undefined"
            },
            {
              "name": "'panw.panos.vsys_name'",
              "value": "__e['PanOSVirtualSystemName']"
            }
          ],
          "remove": [
            "cef_name",
            "severity",
            "cef_version",
            "device_vendor",
            "device_product",
            "device_version",
            "extensions",
            "end",
            "cn1",
            "duser",
            "cnt",
            "spt",
            "dpt",
            "PanOSDGHierarchyLevel1",
            "PanOSDGHierarchyLevel2",
            "PanOSDGHierarchyLevel3",
            "PanOSDGHierarchyLevel4",
            "rt",
            "cs5",
            "cs4",
            "cs6",
            "cn3",
            "cs1",
            "start",
            "PanOSTag",
            "PanOSTimeGeneratedHighResolution",
            "PanOSUGFlags",
            "PanOSUserGroupFound",
            "PanOSIsDuplicateUser",
            "PanOSUserIdentifiedBySource",
            "cs3",
            "cn2",
            "PanOSVirtualSystemName"
          ]
        },
        "description": "panw.panos.userid.* / panw.panos.* provenance and chassis customs; drop routing-only slots and now-copied parse artifacts"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
