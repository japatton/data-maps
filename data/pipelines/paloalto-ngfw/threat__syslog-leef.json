{
  "id": "dm_paloalto_ngfw_threat_syslog_leef",
  "conf": {
    "output": "default",
    "description": "Palo Alto NGFW Threat log (syslog-leef, PAN-OS 10.2/11.1), direct route: LEEF header/attribute parse (regex_extract + serde kvp) to ECS + panw.panos.threat.* customs, header EventID + ThreatName synthesized into the combined identifier, severity vocabulary lookup, url.domain/file.name gated by ThreatCategory, keep _raw. No event-time field is present in this format's inventory.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "Palo Alto NGFW Threat log, syslog-leef, direct route. LEEF pre-splits the threat identity (EventID=numeric id, ThreatName=description, ThreatCategory=threat class), unlike CSV/CEF's single combined column, so no regex split is needed - only a synthesized combined string for the cross-reference pipelines that expect the CSV/CEF 'Name(id)' shape. Severity is a discrete word attribute here (critical/high/medium/low/informational), not a header slot as in CEF. No field row in this format's inventory carries an event timestamp, so _time is NOT set here - a documented gap, not an omission - and defaults to Cribl's ingest-time behavior, matching this same directory's traffic__syslog-leef.json."
        },
        "description": "Pipeline purpose and the missing-timestamp gap"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/^LEEF:(?<leefVersion>[^|]*)\\|(?<leefVendor>[^|]*)\\|(?<leefProduct>[^|]*)\\|(?<leefProductVersion>[^|]*)\\|(?<EventID>[^|]*)\\|(?<extension>.*)$/",
          "source": "_raw"
        },
        "description": "Split the 5 pipe-delimited LEEF header slots (incl. EventID, the numeric threat id) from the attribute body"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "kvp",
          "srcField": "extension"
        },
        "description": "Explode the LEEF attribute key=value pairs into top-level fields (default kvp delimiter handling is unverified against a live sample - see README gap)"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "panw.panos.threat.combined",
              "value": "(__e['ThreatName'] || '') + '(' + (__e['EventID'] || '') + ')'"
            },
            {
              "name": "event.severity",
              "value": "__e['Severity']=='critical' ? 5 : __e['Severity']=='high' ? 4 : __e['Severity']=='medium' ? 3 : __e['Severity']=='low' ? 2 : __e['Severity']=='informational' ? 1 : undefined"
            },
            {
              "name": "event.outcome",
              "value": "__e['Action']=='alert' || __e['Action']=='allow' ? 'success' : (__e['Action']=='deny' || __e['Action']=='drop' || __e['Action']=='reset-client' || __e['Action']=='reset-server' || __e['Action']=='reset-both' || __e['Action']=='block-url' || __e['Action']=='sinkhole' ? 'failure' : 'unknown')"
            },
            {
              "name": "network.direction",
              "value": "__e['DirectionOfAttack']=='server-to-client' ? 'outbound' : (__e['DirectionOfAttack']=='client-to-server' ? 'inbound' : undefined)"
            },
            {
              "name": "url.domain",
              "value": "__e['ThreatCategory'] && /url/i.test(__e['ThreatCategory']) ? __e['URLDomain'] : undefined"
            },
            {
              "name": "file.name",
              "value": "__e['ThreatCategory'] && /file|wildfire/i.test(__e['ThreatCategory']) ? __e['FileName'] : undefined"
            }
          ]
        },
        "description": "Synthesize the CSV/CEF-shaped combined threat identifier, map severity vocabulary, derive event.outcome/network.direction from the wider threat vocabulary, and gate URLDomain/FileName by ThreatCategory - all BEFORE rename"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "src",
              "newName": "source.ip"
            },
            {
              "currentName": "dst",
              "newName": "destination.ip"
            },
            {
              "currentName": "srcPort",
              "newName": "source.port"
            },
            {
              "currentName": "dstPort",
              "newName": "destination.port"
            },
            {
              "currentName": "proto",
              "newName": "network.transport"
            },
            {
              "currentName": "Action",
              "newName": "event.action"
            },
            {
              "currentName": "Rule",
              "newName": "rule.name"
            },
            {
              "currentName": "usrName",
              "newName": "source.user.name"
            },
            {
              "currentName": "Application",
              "newName": "network.application"
            },
            {
              "currentName": "EventID",
              "newName": "panw.panos.threat.id"
            },
            {
              "currentName": "ThreatName",
              "newName": "panw.panos.threat.name"
            },
            {
              "currentName": "ThreatCategory",
              "newName": "panw.panos.threat.type"
            },
            {
              "currentName": "FileHash",
              "newName": "file.hash.sha256"
            },
            {
              "currentName": "Verdict",
              "newName": "panw.panos.threat.verdict"
            },
            {
              "currentName": "DeviceName",
              "newName": "observer.name"
            },
            {
              "currentName": "DeviceSN",
              "newName": "observer.serial_number"
            },
            {
              "currentName": "RuleUUID",
              "newName": "rule.uuid"
            },
            {
              "currentName": "SessionID",
              "newName": "panw.panos.session_id"
            }
          ]
        },
        "description": "Batch rename of every mapped/custom LEEF attribute; Severity/DirectionOfAttack/URLDomain/FileName excluded (already consumed above)"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "event.dataset",
              "value": "'paloalto_ngfw.threat'"
            }
          ],
          "remove": [
            "leefVersion",
            "leefVendor",
            "leefProduct",
            "leefProductVersion",
            "extension",
            "Severity",
            "DirectionOfAttack",
            "URLDomain",
            "FileName"
          ]
        },
        "description": "Tag event.dataset; drop now-consumed parse scratch and LEEF header metadata. _raw is deliberately kept."
      }
    ]
  }
}
