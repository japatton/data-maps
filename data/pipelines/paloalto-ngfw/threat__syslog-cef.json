{
  "id": "dm_paloalto_ngfw_threat_syslog_cef",
  "conf": {
    "output": "default",
    "description": "Palo Alto NGFW Threat log (syslog-cef, PAN-OS 10.2/11.1), direct route: CEF header/extension parse (regex_extract + serde kvp, not the cef function which is a serializer) to ECS + panw.panos.threat.* customs, header-severity lift, threatid split, action-driven event.outcome, url.original gated by threat category, keep _raw",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "Palo Alto NGFW Threat log, syslog-cef, direct route. cat=$threatid carries the composite id (also header slot 5, but the field row sources it from the extension key, so that is what is split/preserved). event.severity comes ONLY from the CEF header severity slot (already numeric 1-5, no vocabulary lookup needed) - not from any extension key. deviceExternalId/deviceExternalID spelling varies by PAN-OS schema version, so both are checked. request=$misc is gated into url.original only when PanOSThreatCategory looks like a url subtype, per recommendations.direct.cribl."
        },
        "description": "Pipeline purpose and the cat/severity/spelling traps"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/^CEF:(?<cefVersion>[^|]*)\\|(?<deviceVendor>[^|]*)\\|(?<deviceProduct>[^|]*)\\|(?<deviceVersion>[^|]*)\\|(?<signatureId>[^|]*)\\|(?<name>[^|]*)\\|(?<severity>[^|]*)\\|(?<extension>.*)$/",
          "source": "_raw"
        },
        "description": "Split the 7 pipe-delimited CEF header slots from the extension blob"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "kvp",
          "srcField": "extension"
        },
        "description": "Explode the CEF extension's space-separated key=value pairs into top-level fields"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "panw.panos.threat.id",
              "value": "(__e['cat'] || '').match(/\\(([0-9]+)\\)$/) ? __e['cat'].match(/\\(([0-9]+)\\)$/)[1] : __e['cat']"
            },
            {
              "name": "panw.panos.threat.name",
              "value": "(__e['cat'] || '').match(/^(.*)\\([0-9]+\\)$/) ? __e['cat'].match(/^(.*)\\([0-9]+\\)$/)[1] : ''"
            },
            {
              "name": "event.severity",
              "value": "__e['severity'] !== undefined && __e['severity'] !== '' ? Number(__e['severity']) : undefined"
            },
            {
              "name": "event.outcome",
              "value": "__e['act']=='alert' || __e['act']=='allow' ? 'success' : (__e['act']=='deny' || __e['act']=='drop' || __e['act']=='reset-client' || __e['act']=='reset-server' || __e['act']=='reset-both' || __e['act']=='block-url' || __e['act']=='sinkhole' ? 'failure' : 'unknown')"
            },
            {
              "name": "network.direction",
              "value": "__e['flexString2']=='1' || __e['flexString2']=='server-to-client' ? 'outbound' : (__e['flexString2']=='0' || __e['flexString2']=='client-to-server' ? 'inbound' : undefined)"
            },
            {
              "name": "url.original",
              "value": "__e['PanOSThreatCategory'] && /url/i.test(__e['PanOSThreatCategory']) ? __e['request'] : undefined"
            },
            {
              "name": "observer.serial_number",
              "value": "__e['deviceExternalId'] !== undefined ? __e['deviceExternalId'] : __e['deviceExternalID']"
            }
          ]
        },
        "description": "Split cat into threat id/name, lift header severity, derive event.outcome/network.direction from the wider threat vocabulary, gate request into url.original by threat category, and resolve the deviceExternalId/ID spelling - all BEFORE rename"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "src",
              "newName": "source.ip"
            },
            {
              "currentName": "dst",
              "newName": "destination.ip"
            },
            {
              "currentName": "spt",
              "newName": "source.port"
            },
            {
              "currentName": "dpt",
              "newName": "destination.port"
            },
            {
              "currentName": "proto",
              "newName": "network.transport"
            },
            {
              "currentName": "act",
              "newName": "event.action"
            },
            {
              "currentName": "cs1",
              "newName": "rule.name"
            },
            {
              "currentName": "suser",
              "newName": "source.user.name"
            },
            {
              "currentName": "duser",
              "newName": "destination.user.name"
            },
            {
              "currentName": "app",
              "newName": "network.application"
            },
            {
              "currentName": "deviceInboundInterface",
              "newName": "observer.ingress.interface.name"
            },
            {
              "currentName": "deviceOutboundInterface",
              "newName": "observer.egress.interface.name"
            },
            {
              "currentName": "dvchost",
              "newName": "observer.name"
            },
            {
              "currentName": "PanOSRuleUUID",
              "newName": "rule.uuid"
            },
            {
              "currentName": "cs2",
              "newName": "panw.panos.threat.category"
            },
            {
              "currentName": "PanOSThreatCategory",
              "newName": "panw.panos.threat.type"
            },
            {
              "currentName": "fileId",
              "newName": "panw.panos.threat.pcap_id"
            },
            {
              "currentName": "cn1",
              "newName": "panw.panos.session_id"
            },
            {
              "currentName": "cs4",
              "newName": "panw.panos.source_zone"
            },
            {
              "currentName": "cs5",
              "newName": "panw.panos.destination_zone"
            }
          ]
        },
        "description": "Batch rename of every mapped/custom CEF extension key; cat deliberately excluded so its combined raw value survives, and deviceExternalId/ID/flexString2/severity/request excluded (already consumed above)"
      },
      {
        "id": "auto_timestamp",
        "filter": "true",
        "conf": {
          "srcField": "rt",
          "dstField": "_time"
        },
        "description": "Set _time from the CEF extension's rt key (the vendor's own enable-template shows rt=$cef-formatted-receive_time as the first extension field)"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "event.dataset",
              "value": "'paloalto_ngfw.threat'"
            }
          ],
          "remove": [
            "flexString2",
            "severity",
            "deviceExternalId",
            "deviceExternalID",
            "request",
            "cefVersion",
            "deviceVendor",
            "deviceProduct",
            "deviceVersion",
            "signatureId",
            "name",
            "extension",
            "rt"
          ]
        },
        "description": "Tag event.dataset; drop now-consumed parse scratch and CEF header metadata. _raw and cat are deliberately kept."
      }
    ]
  }
}
