{
  "id": "dm_paloalto_ngfw_globalprotect_syslog_cef",
  "conf": {
    "output": "default",
    "description": "Palo Alto NGFW GlobalProtect syslog-cef direct route: CEF header+extension parse to the same ECS shape as the CSV route (path a from the catalog's cribl-pack note), event.action lifted from Device Event Class ID not Name",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "Palo Alto NGFW GlobalProtect syslog-cef (PAN-OS 10.2/11.1), direct route. Header slot 5 (Device Event Class ID), NOT slot 6 (Name, a constant), carries the event id on this on-box template; cs3 carries the vsys NAME on this log type, not $vsys."
        },
        "description": "Pipeline purpose and CEF header trap"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/^CEF:(?<cef_version>[^|]*)\\|(?<device_vendor>[^|]*)\\|(?<device_product>[^|]*)\\|(?<device_version>[^|]*)\\|(?<device_event_class_id>[^|]*)\\|(?<cef_name>[^|]*)\\|(?<severity>[^|]*)\\|(?<extensions>.*)$/",
          "source": "_raw"
        },
        "description": "Split the CEF header slots from the space-separated extensions blob"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "kvp",
          "srcField": "extensions"
        },
        "description": "Extract the CEF key=value extensions into top-level fields"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "sntdom",
              "newName": "user.domain"
            },
            {
              "currentName": "susername",
              "newName": "source.user.name"
            },
            {
              "currentName": "suid",
              "newName": "user.id"
            },
            {
              "currentName": "PanOSHostID",
              "newName": "host.id"
            },
            {
              "currentName": "PanOSEndpointOSVersion",
              "newName": "host.os.full"
            },
            {
              "currentName": "PanOSEndpointOSType",
              "newName": "host.os.family"
            },
            {
              "currentName": "PanOSGlobalProtectGatewayLocation",
              "newName": "observer.geo.name"
            },
            {
              "currentName": "PanOSConnectionError",
              "newName": "event.reason"
            },
            {
              "currentName": "PanOSDescription",
              "newName": "message"
            },
            {
              "currentName": "PanOSSequenceNo",
              "newName": "event.sequence"
            },
            {
              "currentName": "deviceExternalID",
              "newName": "observer.serial_number"
            },
            {
              "currentName": "deviceExternalId",
              "newName": "observer.serial_number"
            },
            {
              "currentName": "dvchost",
              "newName": "observer.name"
            },
            {
              "currentName": "PanOSSourceRegion",
              "newName": "source.geo.name"
            }
          ]
        },
        "description": "Batch rename of directly-mapped CEF extensions with no transform; both deviceExternalID/Id spellings covered"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "panw.panos.globalprotect.endpoint_serial_number",
              "value": "__e['PanOSEndpointSN']"
            },
            {
              "name": "panw.panos.globalprotect.client_version",
              "value": "__e['PanOSGlobalProtectClientVersion']"
            },
            {
              "name": "panw.panos.globalprotect.stage",
              "value": "__e['PanOSStage']"
            },
            {
              "name": "panw.panos.globalprotect.auth_method",
              "value": "__e['PanOSAuthMethod']"
            },
            {
              "name": "panw.panos.globalprotect.tunnel_type",
              "value": "__e['PanOSTunnelType']"
            },
            {
              "name": "panw.panos.globalprotect.connect_method",
              "value": "__e['PanOSConnectionMethod']"
            },
            {
              "name": "panw.panos.globalprotect.selection_type",
              "value": "__e['PanOSGatewaySelectionType']"
            },
            {
              "name": "panw.panos.globalprotect.portal",
              "value": "__e['PanOSPortal']"
            },
            {
              "name": "panw.panos.globalprotect.gateway",
              "value": "__e['PanOSGateway']"
            },
            {
              "name": "panw.panos.globalprotect.gateway_priority",
              "value": "__e['PanOSGatewayPriority']"
            },
            {
              "name": "panw.panos.globalprotect.attempted_gateways",
              "value": "__e['PanOSAttemptedGateways']"
            },
            {
              "name": "panw.panos.globalprotect.ssl_response_time",
              "value": "__e['PanOSSSLResponseTime']"
            },
            {
              "name": "panw.panos.globalprotect.error_code",
              "value": "__e['PanOSConnectionErrorID']"
            },
            {
              "name": "panw.panos.globalprotect.quarantine_reason",
              "value": "__e['PanOSQuarantineReason']"
            },
            {
              "name": "panw.panos.receive_time",
              "value": "__e['rt']"
            },
            {
              "name": "panw.panos.high_res_timestamp",
              "value": "__e['PanOSTimeGeneratedHighResolution']"
            },
            {
              "name": "panw.panos.vsys_name",
              "value": "__e['cs3']"
            },
            {
              "name": "panw.panos.vsys",
              "value": "__e['PanOSVirtualSystem']"
            },
            {
              "name": "panw.panos.vsys_id",
              "value": "__e['PanOSVirtualSystemID']"
            },
            {
              "name": "panw.panos.globalprotect.subtype",
              "value": "__e['PanOSLogSubtype']"
            },
            {
              "name": "panw.panos.device_group_hierarchy",
              "value": "{\"level1\":__e['PanOSDGHierarchyLevel1'],\"level2\":PanOSDGHierarchyLevel2,\"level3\":PanOSDGHierarchyLevel3,\"level4\":PanOSDGHierarchyLevel4}"
            },
            {
              "name": "panw.panos.action_flags",
              "value": "__e['PanOSLogForwarded']"
            },
            {
              "name": "event.code",
              "value": "__e['device_event_class_id']"
            },
            {
              "name": "event.action",
              "value": "__e['device_event_class_id'].toLowerCase()"
            },
            {
              "name": "user.name",
              "value": "__e['suser'].indexOf('\\\\')!==-1 ? __e['suser'].slice(__e['suser'].indexOf('\\\\')+1) : (__e['suser'].indexOf('@')!==-1 ? __e['suser'].slice(0,__e['suser'].indexOf('@')) : __e['suser'])"
            },
            {
              "name": "related.user",
              "value": "[__e['suser'].indexOf('\\\\')!==-1 ? __e['suser'].slice(__e['suser'].indexOf('\\\\')+1) : (__e['suser'].indexOf('@')!==-1 ? __e['suser'].slice(0,__e['suser'].indexOf('@')) : __e['suser'])]"
            },
            {
              "name": "source.ip",
              "value": "(__e['src'] && __e['src']!=='0.0.0.0') ? __e['src'] : ((__e['c6a2'] && __e['c6a2']!=='0.0.0.0' && /^[0-9a-fA-F:]+$/.test(__e['c6a2']) && __e['c6a2'].indexOf(':')!==-1) ? __e['c6a2'] : __e['src'])"
            },
            {
              "name": "client.nat.ip",
              "value": "(__e['PanOSPrivateIPv4'] && __e['PanOSPrivateIPv4']!=='0.0.0.0') ? __e['PanOSPrivateIPv4'] : ((__e['PanOSPrivateIPv6'] && __e['PanOSPrivateIPv6']!=='0.0.0.0' && /^[0-9a-fA-F:]+$/.test(__e['PanOSPrivateIPv6']) && __e['PanOSPrivateIPv6'].indexOf(':')!==-1) ? __e['PanOSPrivateIPv6'] : __e['PanOSPrivateIPv4'])"
            },
            {
              "name": "host.os.type",
              "value": "__e['PanOSEndpointOSType']==='Mac' ? 'macos' : (__e['PanOSEndpointOSType']==='Chrome' ? null : __e['PanOSEndpointOSType'].toLowerCase())"
            },
            {
              "name": "host.name",
              "value": "__e['shost'].toLowerCase()"
            },
            {
              "name": "event.outcome",
              "value": "__e['outcome'] ? __e['outcome'].toLowerCase() : 'unknown'"
            }
          ]
        },
        "description": "Vendor-namespace custom fields (incl. cs3 vsys-name trap) plus derived ECS fields: header event id (slot 5, not slot 6), user split, guarded address coalesce, os.type, outcome"
      },
      {
        "id": "eval",
        "filter": "PanOSLoginDuration !== undefined && PanOSLoginDuration !== ''",
        "conf": {
          "add": [
            {
              "name": "event.duration",
              "value": "Number(__e['PanOSLoginDuration'])*1e9"
            }
          ]
        },
        "description": "Login duration seconds to ECS nanoseconds; only present on logout/teardown records"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "_time",
              "value": "__e['PanOSTimeGeneratedHighResolution'] ? Date.parse(__e['PanOSTimeGeneratedHighResolution'])/1000 : Date.parse(__e['start'].replace(/\\//g,'-')+'Z')/1000"
            }
          ]
        },
        "description": "Event time from start=, preferring PanOSTimeGeneratedHighResolution for its explicit UTC offset; _time not @timestamp (platform constraint)"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "event.dataset",
              "value": "'paloalto_ngfw.globalprotect'"
            }
          ],
          "remove": [
            "cef_name"
          ]
        },
        "description": "Set event.dataset (no hyphen) and drop the CEF Name slot, a constant log-type literal not the event id"
      }
    ]
  }
}
