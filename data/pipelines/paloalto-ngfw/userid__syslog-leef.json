{
  "id": "dm_paloalto_ngfw_userid_syslog_leef",
  "conf": {
    "output": "default",
    "description": "Palo Alto NGFW User-ID log (syslog-leef, PAN-OS 10.2/11.1), direct route: LEEF header+attribute parse to the same ECS/custom shape as the CSV/CEF routes; usrName vs AuthenticatedUserName and cat=log-type (not event id, unlike CEF) handled explicitly",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "Palo Alto NGFW User-ID log, syslog-leef, PAN-OS 10.2/11.1, direct route. LEEF cat is the log type (USERID) here, unlike CEF cat which is the event id on this same log - dropped, not mapped, same treatment as CSV 'type'. usrName (on-box template, qualified spelling) and AuthenticatedUserName (Cortex Data Lake, pre-split) both feed user.name; never concatenated, Cortex form preferred when present. Header EventID slot carries $subtype -> event.action."
        },
        "description": "Pipeline purpose and the cat / dual-username traps"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/LEEF:(?<leef_version>[^|]*)\\|(?<vendor>[^|]*)\\|(?<product>[^|]*)\\|(?<product_version>[^|]*)\\|(?<event_id>[^|]*)\\|(?<attributes>.*)$/",
          "source": "_raw"
        },
        "description": "Split the 5 pipe-delimited LEEF header slots from the attributes blob"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "kvp",
          "srcField": "attributes"
        },
        "description": "Extract the LEEF key=value attributes into top-level fields"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "event_id",
              "newName": "'event.action'"
            },
            {
              "currentName": "AuthenticatedUserUUID",
              "newName": "'user.id'"
            },
            {
              "currentName": "EventIdName",
              "newName": "'event.code'"
            },
            {
              "currentName": "DeviceSN",
              "newName": "'observer.serial_number'"
            },
            {
              "currentName": "DeviceName",
              "newName": "'observer.name'"
            },
            {
              "currentName": "SequenceNo",
              "newName": "'event.sequence'"
            },
            {
              "currentName": "src",
              "newName": "'source.ip'"
            }
          ]
        },
        "description": "Batch rename of directly-mapped header/attribute fields with no extra transform logic"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "_time",
              "value": "__e['TimeGeneratedHighResolution'] ? Date.parse(__e['TimeGeneratedHighResolution'])/1000 : (__e['devTime'] ? Date.parse(__e['devTime'] + ' UTC')/1000 : undefined)"
            },
            {
              "name": "'event.outcome'",
              "value": "'success'"
            },
            {
              "name": "'event.dataset'",
              "value": "'paloalto_ngfw.userid'"
            },
            {
              "name": "'related.ip'",
              "value": "__e['source.ip'] ? [__e['source.ip']] : undefined"
            },
            {
              "name": "'user.domain'",
              "value": "__e['AuthenticatedUserDomain'] ? __e['AuthenticatedUserDomain'] : (__e['usrName'] ? (__e['usrName'].indexOf('\\\\') > -1 ? __e['usrName'].slice(0, __e['usrName'].indexOf('\\\\')) : (__e['usrName'].indexOf('@') > -1 ? __e['usrName'].slice(__e['usrName'].indexOf('@') + 1) : undefined)) : undefined)"
            },
            {
              "name": "'user.name'",
              "value": "__e['AuthenticatedUserName'] ? __e['AuthenticatedUserName'] : (__e['usrName'] ? (__e['usrName'].indexOf('\\\\') > -1 ? __e['usrName'].slice(__e['usrName'].indexOf('\\\\') + 1) : (__e['usrName'].indexOf('@') > -1 ? __e['usrName'].slice(0, __e['usrName'].indexOf('@')) : __e['usrName'])) : undefined)"
            },
            {
              "name": "'panw.panos.userid.user_raw'",
              "value": "__e['usrName'] ? __e['usrName'] : __e['AuthenticatedUserName']"
            },
            {
              "name": "'event.sequence'",
              "value": "__e['event.sequence'] !== undefined && __e['event.sequence'] !== '' ? +__e['event.sequence'] : undefined"
            }
          ]
        },
        "description": "Event time (high-res preferred, devTime UTC-assumed fallback), event.outcome/event.dataset constants, user.name/user.domain (Cortex AuthenticatedUserName preferred over on-box usrName split), related.ip, numeric event.sequence"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'related.user'",
              "value": "__e['user.name'] ? [__e['user.name']] : undefined"
            },
            {
              "name": "'panw.panos.userid.factor_completion_time'",
              "value": "__e['AuthCompletionTime']"
            },
            {
              "name": "'panw.panos.userid.factor_number'",
              "value": "__e['AuthFactorNo'] !== undefined && __e['AuthFactorNo'] !== '' ? +__e['AuthFactorNo'] : undefined"
            },
            {
              "name": "'panw.panos.userid.repeat_count'",
              "value": "__e['CountofRepeats'] !== undefined && __e['CountofRepeats'] !== '' ? +__e['CountofRepeats'] : undefined"
            },
            {
              "name": "'panw.panos.userid.begin_port'",
              "value": "__e['srcPort'] !== undefined && __e['srcPort'] !== '' ? +__e['srcPort'] : undefined"
            },
            {
              "name": "'panw.panos.userid.end_port'",
              "value": "__e['dstPort'] !== undefined && __e['dstPort'] !== '' ? +__e['dstPort'] : undefined"
            },
            {
              "name": "'panw.panos.device_group_hierarchy'",
              "value": "[__e['DGHierarchyLevel1'] !== undefined && __e['DGHierarchyLevel1'] !== '' ? +__e['DGHierarchyLevel1'] : undefined, __e['DGHierarchyLevel2'] !== undefined && __e['DGHierarchyLevel2'] !== '' ? +__e['DGHierarchyLevel2'] : undefined, __e['DGHierarchyLevel3'] !== undefined && __e['DGHierarchyLevel3'] !== '' ? +__e['DGHierarchyLevel3'] : undefined, __e['DGHierarchyLevel4'] !== undefined && __e['DGHierarchyLevel4'] !== '' ? +__e['DGHierarchyLevel4'] : undefined]"
            },
            {
              "name": "'panw.panos.userid.duplicate_user'",
              "value": "__e['IsDuplicateUser']"
            },
            {
              "name": "'panw.panos.receive_time'",
              "value": "__e['TimeReceived']"
            },
            {
              "name": "'panw.panos.userid.datasource'",
              "value": "__e['MappingDataSource']"
            },
            {
              "name": "'panw.panos.userid.datasource_name'",
              "value": "__e['MappingDataSourceName']"
            },
            {
              "name": "'panw.panos.userid.datasource_type'",
              "value": "__e['MappingDataSourceType']"
            },
            {
              "name": "'panw.panos.userid.timeout'",
              "value": "__e['MappingTimeout'] !== undefined && __e['MappingTimeout'] !== '' ? +__e['MappingTimeout'] : undefined"
            },
            {
              "name": "'panw.panos.userid.factor_type'",
              "value": "__e['MFAFactorType']"
            },
            {
              "name": "'panw.panos.userid.tag_name'",
              "value": "__e['Tag']"
            },
            {
              "name": "'panw.panos.high_res_timestamp'",
              "value": "__e['TimeGeneratedHighResolution']"
            },
            {
              "name": "'panw.panos.userid.ug_flags'",
              "value": "__e['UGFlags']"
            },
            {
              "name": "'panw.panos.userid.user_group_found'",
              "value": "__e['UserGroupFound']"
            },
            {
              "name": "'panw.panos.userid.user_by_source'",
              "value": "__e['UserIdentifiedBySource']"
            },
            {
              "name": "'panw.panos.vsys'",
              "value": "__e['VirtualLocation']"
            },
            {
              "name": "'panw.panos.vsys_id'",
              "value": "__e['VirtualSystemID'] !== undefined && __e['VirtualSystemID'] !== '' ? +__e['VirtualSystemID'] : undefined"
            },
            {
              "name": "'panw.panos.vsys_name'",
              "value": "__e['VirtualSystemName']"
            }
          ],
          "remove": [
            "cat",
            "leef_version",
            "vendor",
            "product",
            "product_version",
            "attributes",
            "AuthCompletionTime",
            "AuthFactorNo",
            "AuthenticatedUserDomain",
            "AuthenticatedUserName",
            "CountofRepeats",
            "srcPort",
            "dstPort",
            "DGHierarchyLevel1",
            "DGHierarchyLevel2",
            "DGHierarchyLevel3",
            "DGHierarchyLevel4",
            "IsDuplicateUser",
            "TimeReceived",
            "MappingDataSource",
            "MappingDataSourceName",
            "MappingDataSourceType",
            "MappingTimeout",
            "MFAFactorType",
            "usrName",
            "Tag",
            "devTime",
            "TimeGeneratedHighResolution",
            "UGFlags",
            "UserGroupFound",
            "UserIdentifiedBySource",
            "VirtualLocation",
            "VirtualSystemID",
            "VirtualSystemName"
          ]
        },
        "description": "panw.panos.userid.* / panw.panos.* provenance and chassis customs; drop the routing-only cat slot and now-copied parse artifacts"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
