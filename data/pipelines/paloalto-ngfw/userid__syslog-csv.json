{
  "id": "dm_paloalto_ngfw_userid_syslog_csv",
  "conf": {
    "output": "default",
    "description": "Palo Alto NGFW User-ID log (syslog-csv, PAN-OS 10.2/11.1), direct route: positional CSV parse to ECS + panw.panos.userid.* customs, per recommendations.direct.cribl",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "Palo Alto NGFW User-ID log, syslog-csv, PAN-OS 10.2/11.1, direct route. Positional CSV carries 3 FUTURE_USE padding columns (pos 1, between subtype and generated time, and between origin_datasource and cluster_name) - counted explicitly so the tail does not shift. event.outcome is a documented pipeline constant (no outcome column exists on this log type); beginport/endport and userbysource are deliberately kept off source.port/destination.port/source.user.name."
        },
        "description": "Pipeline purpose and CSV padding-column trap"
      },
      {
        "id": "eval",
        "filter": "true",
        "description": "Message body: a Cribl Syslog Source leaves the full line, header included, in _raw and the body in message; anything else carries the body in _raw.",
        "conf": {
          "add": [
            {
              "name": "__body",
              "value": "__e['message'] !== undefined ? __e['message'] : __e['_raw']"
            }
          ]
        }
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/^(?<future_use_1>[^,]*),(?<receive_time>[^,]*),(?<serial>[^,]*),(?<type>[^,]*),(?<subtype>[^,]*),(?<future_use_2>[^,]*),(?<time_generated>[^,]*),(?<vsys>[^,]*),(?<ip>[^,]*),(?<user>[^,]*),(?<datasourcename>[^,]*),(?<eventid>[^,]*),(?<repeatcnt>[^,]*),(?<timeout>[^,]*),(?<beginport>[^,]*),(?<endport>[^,]*),(?<datasource>[^,]*),(?<datasourcetype>[^,]*),(?<seqno>[^,]*),(?<actionflags>[^,]*),(?<dg_hier_level_1>[^,]*),(?<dg_hier_level_2>[^,]*),(?<dg_hier_level_3>[^,]*),(?<dg_hier_level_4>[^,]*),(?<vsys_name>[^,]*),(?<device_name>[^,]*),(?<vsys_id>[^,]*),(?<factortype>[^,]*),(?<factorcompletiontime>[^,]*),(?<factorno>[^,]*),(?<ugflags>[^,]*),(?<userbysource>[^,]*),(?<tag_name>[^,]*),(?<high_res_timestamp>[^,]*),(?<origindatasource>[^,]*),(?<future_use_3>[^,]*),(?<cluster_name>.*)$/",
          "source": "__body"
        },
        "description": "Positional parse of all 37 User-ID CSV columns incl. the 3 FUTURE_USE columns"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "serial",
              "newName": "'observer.serial_number'"
            },
            {
              "currentName": "subtype",
              "newName": "'event.action'"
            },
            {
              "currentName": "eventid",
              "newName": "'event.code'"
            },
            {
              "currentName": "seqno",
              "newName": "'event.sequence'"
            },
            {
              "currentName": "device_name",
              "newName": "'observer.name'"
            },
            {
              "currentName": "ip",
              "newName": "'source.ip'"
            }
          ]
        },
        "description": "Batch rename of directly-mapped columns with no extra transform logic"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "__dm_time",
              "value": "__e['high_res_timestamp'] ? Date.parse(__e['high_res_timestamp'])/1000 : (__e['time_generated'] ? Date.parse(__e['time_generated'].replace(/\\//g,'-')+'Z')/1000 : undefined)"
            },
            {
              "name": "_time",
              "value": "__e['__dm_time'] !== undefined && __e['__dm_time'] !== null && __e['__dm_time'] === __e['__dm_time'] ? __e['__dm_time'] : __e['_time']"
            },
            {
              "name": "'event.outcome'",
              "value": "'success'"
            },
            {
              "name": "'event.dataset'",
              "value": "'paloalto_ngfw.userid'"
            },
            {
              "name": "'related.ip'",
              "value": "__e['source.ip'] ? [__e['source.ip']] : undefined"
            },
            {
              "name": "'user.domain'",
              "value": "__e['user'] ? (__e['user'].indexOf('\\\\') > -1 ? __e['user'].slice(0, __e['user'].indexOf('\\\\')) : (__e['user'].indexOf('@') > -1 ? __e['user'].slice(__e['user'].indexOf('@') + 1) : undefined)) : undefined"
            },
            {
              "name": "'user.name'",
              "value": "__e['user'] ? (__e['user'].indexOf('\\\\') > -1 ? __e['user'].slice(__e['user'].indexOf('\\\\') + 1) : (__e['user'].indexOf('@') > -1 ? __e['user'].slice(0, __e['user'].indexOf('@')) : __e['user'])) : undefined"
            },
            {
              "name": "'panw.panos.userid.user_raw'",
              "value": "__e['user']"
            },
            {
              "name": "'event.sequence'",
              "value": "__e['event.sequence'] !== undefined && __e['event.sequence'] !== '' ? +__e['event.sequence'] : undefined"
            }
          ],
          "remove": [
            "user"
          ]
        },
        "description": "Event time (high-res-timestamp preferred, time_generated UTC-assumed fallback), event.outcome/event.dataset constants, user.name/user.domain split, related.ip/related.user, numeric event.sequence"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'related.user'",
              "value": "__e['user.name'] ? [__e['user.name']] : undefined"
            },
            {
              "name": "'panw.panos.receive_time'",
              "value": "__e['receive_time']"
            },
            {
              "name": "'panw.panos.vsys'",
              "value": "__e['vsys']"
            },
            {
              "name": "'panw.panos.userid.datasource_name'",
              "value": "__e['datasourcename']"
            },
            {
              "name": "'panw.panos.userid.repeat_count'",
              "value": "__e['repeatcnt'] !== undefined && __e['repeatcnt'] !== '' ? +__e['repeatcnt'] : undefined"
            },
            {
              "name": "'panw.panos.userid.timeout'",
              "value": "__e['timeout'] !== undefined && __e['timeout'] !== '' ? +__e['timeout'] : undefined"
            },
            {
              "name": "'panw.panos.userid.begin_port'",
              "value": "__e['beginport'] !== undefined && __e['beginport'] !== '' ? +__e['beginport'] : undefined"
            },
            {
              "name": "'panw.panos.userid.end_port'",
              "value": "__e['endport'] !== undefined && __e['endport'] !== '' ? +__e['endport'] : undefined"
            },
            {
              "name": "'panw.panos.userid.datasource'",
              "value": "__e['datasource']"
            },
            {
              "name": "'panw.panos.userid.datasource_type'",
              "value": "__e['datasourcetype']"
            },
            {
              "name": "'panw.panos.action_flags'",
              "value": "__e['actionflags']"
            },
            {
              "name": "'panw.panos.device_group_hierarchy'",
              "value": "[__e['dg_hier_level_1'] !== undefined && __e['dg_hier_level_1'] !== '' ? +__e['dg_hier_level_1'] : undefined, __e['dg_hier_level_2'] !== undefined && __e['dg_hier_level_2'] !== '' ? +__e['dg_hier_level_2'] : undefined, __e['dg_hier_level_3'] !== undefined && __e['dg_hier_level_3'] !== '' ? +__e['dg_hier_level_3'] : undefined, __e['dg_hier_level_4'] !== undefined && __e['dg_hier_level_4'] !== '' ? +__e['dg_hier_level_4'] : undefined]"
            },
            {
              "name": "'panw.panos.vsys_name'",
              "value": "__e['vsys_name']"
            },
            {
              "name": "'panw.panos.vsys_id'",
              "value": "__e['vsys_id'] !== undefined && __e['vsys_id'] !== '' ? +__e['vsys_id'] : undefined"
            },
            {
              "name": "'panw.panos.userid.factor_type'",
              "value": "__e['factortype']"
            },
            {
              "name": "'panw.panos.userid.factor_completion_time'",
              "value": "__e['factorcompletiontime']"
            },
            {
              "name": "'panw.panos.userid.factor_number'",
              "value": "__e['factorno'] !== undefined && __e['factorno'] !== '' ? +__e['factorno'] : undefined"
            },
            {
              "name": "'panw.panos.userid.ug_flags'",
              "value": "__e['ugflags']"
            },
            {
              "name": "'panw.panos.userid.user_by_source'",
              "value": "__e['userbysource']"
            },
            {
              "name": "'panw.panos.userid.tag_name'",
              "value": "__e['tag_name']"
            },
            {
              "name": "'panw.panos.high_res_timestamp'",
              "value": "__e['high_res_timestamp']"
            },
            {
              "name": "'panw.panos.userid.origin_datasource'",
              "value": "__e['origindatasource']"
            },
            {
              "name": "'panw.panos.cluster_name'",
              "value": "__e['cluster_name']"
            }
          ],
          "remove": [
            "type",
            "future_use_1",
            "future_use_2",
            "future_use_3",
            "receive_time",
            "vsys",
            "datasourcename",
            "repeatcnt",
            "timeout",
            "beginport",
            "endport",
            "datasource",
            "datasourcetype",
            "actionflags",
            "dg_hier_level_1",
            "dg_hier_level_2",
            "dg_hier_level_3",
            "dg_hier_level_4",
            "vsys_name",
            "vsys_id",
            "factortype",
            "factorcompletiontime",
            "factorno",
            "ugflags",
            "userbysource",
            "tag_name",
            "high_res_timestamp",
            "origindatasource",
            "cluster_name"
          ]
        },
        "description": "panw.panos.userid.* / panw.panos.* provenance and chassis customs; drop routing-only and now-copied parse artifacts"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
