{
  "id": "dm_paloalto_ngfw_traffic_syslog_leef",
  "conf": {
    "output": "default",
    "description": "Palo Alto NGFW Traffic log (syslog-leef, PAN-OS 10.2/11.1), direct route: LEEF header/attribute parse (regex_extract + serde kvp) to ECS + panw.panos.* customs, action lifted from the header EventID slot, seconds-to-nanoseconds event.duration; no event-time field is present in this format's inventory",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "Palo Alto NGFW Traffic log, syslog-leef, direct route. LEEF puts the session action in the header EventID slot (not a tab-delimited attribute), so it is captured by the header regex, not serde. No field row in this format's work-order inventory carries an event timestamp, so _time is NOT set here - a documented gap, not an omission - and will default to Cribl's ingest-time behavior."
        },
        "description": "Pipeline purpose and the missing-timestamp gap"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/LEEF:(?<leefVersion>[^|]*)\\|(?<leefVendor>[^|]*)\\|(?<leefProduct>[^|]*)\\|(?<leefProductVersion>[^|]*)\\|(?<EventID>[^|]*)\\|(?<extension>.*)$/",
          "source": "_raw"
        },
        "description": "Split the 5 pipe-delimited LEEF header slots (incl. EventID, the action) from the tab-delimited attribute body"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "kvp",
          "srcField": "extension"
        },
        "description": "Explode the LEEF tab-delimited key=value attributes into top-level fields (default kvp delimiter handling of tabs is unverified against a live sample - see README gap)"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'event.outcome'",
              "value": "__e['EventID']=='allow' ? 'success' : (__e['EventID']=='deny' || __e['EventID']=='drop' || __e['EventID']=='reset-client' || __e['EventID']=='reset-server' || __e['EventID']=='reset-both' ? 'failure' : 'unknown')"
            },
            {
              "name": "'event.duration'",
              "value": "__e['SessionDuration'] !== undefined && __e['SessionDuration'] !== '' ? Number(__e['SessionDuration']) * 1e9 : undefined"
            }
          ]
        },
        "description": "Derive event.outcome from the header EventID (action) and event.duration from SessionDuration (seconds->nanoseconds) BEFORE rename"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "src",
              "newName": "'source.ip'"
            },
            {
              "currentName": "dst",
              "newName": "'destination.ip'"
            },
            {
              "currentName": "srcPort",
              "newName": "'source.port'"
            },
            {
              "currentName": "dstPort",
              "newName": "'destination.port'"
            },
            {
              "currentName": "srcPostNAT",
              "newName": "'source.nat.ip'"
            },
            {
              "currentName": "dstPostNAT",
              "newName": "'destination.nat.ip'"
            },
            {
              "currentName": "srcPostNATPort",
              "newName": "'source.nat.port'"
            },
            {
              "currentName": "dstPostNATPort",
              "newName": "'destination.nat.port'"
            },
            {
              "currentName": "proto",
              "newName": "'network.transport'"
            },
            {
              "currentName": "EventID",
              "newName": "'event.action'"
            },
            {
              "currentName": "Rule",
              "newName": "'rule.name'"
            },
            {
              "currentName": "usrName",
              "newName": "'source.user.name'"
            },
            {
              "currentName": "DestinationUser",
              "newName": "'destination.user.name'"
            },
            {
              "currentName": "Application",
              "newName": "'network.application'"
            },
            {
              "currentName": "srcBytes",
              "newName": "'source.bytes'"
            },
            {
              "currentName": "dstBytes",
              "newName": "'destination.bytes'"
            },
            {
              "currentName": "Bytes",
              "newName": "'network.bytes'"
            },
            {
              "currentName": "totalPackets",
              "newName": "'network.packets'"
            },
            {
              "currentName": "srcPackets",
              "newName": "'source.packets'"
            },
            {
              "currentName": "dstPackets",
              "newName": "'destination.packets'"
            },
            {
              "currentName": "InboundInterface",
              "newName": "'observer.ingress.interface.name'"
            },
            {
              "currentName": "OutboundInterface",
              "newName": "'observer.egress.interface.name'"
            },
            {
              "currentName": "DeviceName",
              "newName": "'observer.name'"
            },
            {
              "currentName": "DeviceSN",
              "newName": "'observer.serial_number'"
            },
            {
              "currentName": "RuleUUID",
              "newName": "'rule.uuid'"
            },
            {
              "currentName": "SessionID",
              "newName": "'panw.panos.session_id'"
            },
            {
              "currentName": "VirtualLocation",
              "newName": "'panw.panos.vsys'"
            },
            {
              "currentName": "FromZone",
              "newName": "'panw.panos.source_zone'"
            },
            {
              "currentName": "ToZone",
              "newName": "'panw.panos.destination_zone'"
            },
            {
              "currentName": "SessionEndReason",
              "newName": "'panw.panos.session_end_reason'"
            }
          ]
        },
        "description": "Batch rename of every mapped/custom LEEF attribute; SessionDuration excluded (already consumed by the derived eval above)"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'event.dataset'",
              "value": "'paloalto_ngfw.traffic'"
            }
          ],
          "remove": [
            "SessionDuration",
            "leefVersion",
            "leefVendor",
            "leefProduct",
            "leefProductVersion",
            "extension",
            "_raw"
          ]
        },
        "description": "Tag event.dataset; drop now-consumed parse artifacts and LEEF header metadata not requested by the work order, and drop _raw since every field row in this format's full inventory was captured (discretionary)"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
