{
  "id": "dm_paloalto_ngfw_globalprotect_syslog_csv",
  "conf": {
    "output": "default",
    "description": "Palo Alto NGFW GlobalProtect syslog-csv direct route: positional CSV to ECS, address split kept non-inverted vs Elastic panw integration, error mapped to event.reason not quarantine reason",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "Palo Alto NGFW GlobalProtect syslog-csv (PAN-OS 10.2/11.1), direct route. Positional CSV parse to ECS per data-map recommendations.direct.cribl; FUTURE_USE cols 1 and 6 consumed and discarded; trailing cluster_name (11.1+) captured only when present."
        },
        "description": "Pipeline purpose and format"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/^[^,]*,(?<receive_time>[^,]*),(?<serial>[^,]*),(?<type>[^,]*),(?<subtype>[^,]*),[^,]*,(?<time_generated>[^,]*),(?<vsys>[^,]*),(?<eventid>[^,]*),(?<stage>[^,]*),(?<auth_method>[^,]*),(?<tunnel_type>[^,]*),(?<srcuser>[^,]*),(?<srcregion>[^,]*),(?<machinename>[^,]*),(?<public_ip>[^,]*),(?<public_ipv6>[^,]*),(?<private_ip>[^,]*),(?<private_ipv6>[^,]*),(?<hostid>[^,]*),(?<serialnumber>[^,]*),(?<client_ver>[^,]*),(?<client_os>[^,]*),(?<client_os_ver>[^,]*),(?<repeatcnt>[^,]*),(?<reason>[^,]*),(?<error>[^,]*),(?<opaque>[^,]*),(?<status>[^,]*),(?<location>[^,]*),(?<login_duration>[^,]*),(?<connect_method>[^,]*),(?<error_code>[^,]*),(?<portal>[^,]*),(?<seqno>[^,]*),(?<actionflags>[^,]*),(?<high_res_timestamp>[^,]*),(?<selection_type>[^,]*),(?<response_time>[^,]*),(?<priority>[^,]*),(?<attempted_gateways>[^,]*),(?<gateway>[^,]*),(?<dg1>[^,]*),(?<dg2>[^,]*),(?<dg3>[^,]*),(?<dg4>[^,]*),(?<vsys_name>[^,]*),(?<device_name>[^,]*),(?<vsys_id>[^,]*)(?:,(?<cluster_name>[^,]*))?$/",
          "source": "_raw"
        },
        "description": "Positional extract of the GlobalProtect CSV columns; two FUTURE_USE slots consumed and not captured"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "serial",
              "newName": "'observer.serial_number'"
            },
            {
              "currentName": "hostid",
              "newName": "'host.id'"
            },
            {
              "currentName": "device_name",
              "newName": "'observer.name'"
            },
            {
              "currentName": "location",
              "newName": "'observer.geo.name'"
            },
            {
              "currentName": "seqno",
              "newName": "'event.sequence'"
            },
            {
              "currentName": "client_os_ver",
              "newName": "'host.os.full'"
            },
            {
              "currentName": "error",
              "newName": "'event.reason'"
            },
            {
              "currentName": "opaque",
              "newName": "message"
            },
            {
              "currentName": "client_os",
              "newName": "'host.os.family'"
            },
            {
              "currentName": "srcregion",
              "newName": "'source.geo.name'"
            }
          ]
        },
        "description": "Batch rename of directly-mapped columns with no transform"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'panw.panos.receive_time'",
              "value": "__e['receive_time']"
            },
            {
              "name": "'panw.panos.globalprotect.subtype'",
              "value": "__e['subtype']"
            },
            {
              "name": "'panw.panos.vsys'",
              "value": "__e['vsys']"
            },
            {
              "name": "'panw.panos.globalprotect.stage'",
              "value": "__e['stage']"
            },
            {
              "name": "'panw.panos.globalprotect.auth_method'",
              "value": "__e['auth_method']"
            },
            {
              "name": "'panw.panos.globalprotect.tunnel_type'",
              "value": "__e['tunnel_type']"
            },
            {
              "name": "'panw.panos.globalprotect.endpoint_serial_number'",
              "value": "__e['serialnumber']"
            },
            {
              "name": "'panw.panos.globalprotect.client_version'",
              "value": "__e['client_ver']"
            },
            {
              "name": "'panw.panos.globalprotect.repeat_count'",
              "value": "__e['repeatcnt']"
            },
            {
              "name": "'panw.panos.globalprotect.quarantine_reason'",
              "value": "__e['reason']"
            },
            {
              "name": "'panw.panos.globalprotect.connect_method'",
              "value": "__e['connect_method']"
            },
            {
              "name": "'panw.panos.globalprotect.error_code'",
              "value": "__e['error_code']"
            },
            {
              "name": "'panw.panos.globalprotect.portal'",
              "value": "__e['portal']"
            },
            {
              "name": "'panw.panos.action_flags'",
              "value": "__e['actionflags']"
            },
            {
              "name": "'panw.panos.high_res_timestamp'",
              "value": "__e['high_res_timestamp']"
            },
            {
              "name": "'panw.panos.globalprotect.selection_type'",
              "value": "__e['selection_type']"
            },
            {
              "name": "'panw.panos.globalprotect.ssl_response_time'",
              "value": "__e['response_time']"
            },
            {
              "name": "'panw.panos.globalprotect.gateway_priority'",
              "value": "__e['priority']"
            },
            {
              "name": "'panw.panos.globalprotect.attempted_gateways'",
              "value": "__e['attempted_gateways']"
            },
            {
              "name": "'panw.panos.globalprotect.gateway'",
              "value": "__e['gateway']"
            },
            {
              "name": "'panw.panos.device_group_hierarchy'",
              "value": "{\"level1\":__e['dg1'],\"level2\":__e['dg2'],\"level3\":__e['dg3'],\"level4\":__e['dg4']}"
            },
            {
              "name": "'panw.panos.vsys_name'",
              "value": "__e['vsys_name']"
            },
            {
              "name": "'panw.panos.vsys_id'",
              "value": "__e['vsys_id']"
            },
            {
              "name": "'panw.panos.cluster_name'",
              "value": "__e['cluster_name']"
            },
            {
              "name": "'event.code'",
              "value": "__e['eventid']"
            },
            {
              "name": "'event.action'",
              "value": "__e['eventid'].toLowerCase()"
            },
            {
              "name": "'user.name'",
              "value": "__e['srcuser'].indexOf('\\\\')!==-1 ? __e['srcuser'].slice(__e['srcuser'].indexOf('\\\\')+1) : (__e['srcuser'].indexOf('@')!==-1 ? __e['srcuser'].slice(0,__e['srcuser'].indexOf('@')) : __e['srcuser'])"
            },
            {
              "name": "'source.user.name'",
              "value": "__e['srcuser'].indexOf('\\\\')!==-1 ? __e['srcuser'].slice(__e['srcuser'].indexOf('\\\\')+1) : (__e['srcuser'].indexOf('@')!==-1 ? __e['srcuser'].slice(0,__e['srcuser'].indexOf('@')) : __e['srcuser'])"
            },
            {
              "name": "'related.user'",
              "value": "[__e['srcuser'].indexOf('\\\\')!==-1 ? __e['srcuser'].slice(__e['srcuser'].indexOf('\\\\')+1) : (__e['srcuser'].indexOf('@')!==-1 ? __e['srcuser'].slice(0,__e['srcuser'].indexOf('@')) : __e['srcuser'])]"
            },
            {
              "name": "'user.domain'",
              "value": "__e['srcuser'].indexOf('\\\\')!==-1 ? __e['srcuser'].slice(0,__e['srcuser'].indexOf('\\\\')) : (__e['srcuser'].indexOf('@')!==-1 ? __e['srcuser'].slice(__e['srcuser'].indexOf('@')+1) : null)"
            },
            {
              "name": "'source.ip'",
              "value": "(__e['public_ip'] && __e['public_ip']!=='0.0.0.0') ? __e['public_ip'] : ((__e['public_ipv6'] && __e['public_ipv6']!=='0.0.0.0' && /^[0-9a-fA-F:]+$/.test(__e['public_ipv6']) && __e['public_ipv6'].indexOf(':')!==-1) ? __e['public_ipv6'] : __e['public_ip'])"
            },
            {
              "name": "'client.nat.ip'",
              "value": "(__e['private_ip'] && __e['private_ip']!=='0.0.0.0') ? __e['private_ip'] : ((__e['private_ipv6'] && __e['private_ipv6']!=='0.0.0.0' && /^[0-9a-fA-F:]+$/.test(__e['private_ipv6']) && __e['private_ipv6'].indexOf(':')!==-1) ? __e['private_ipv6'] : __e['private_ip'])"
            },
            {
              "name": "'host.os.type'",
              "value": "__e['client_os']==='Mac' ? 'macos' : (__e['client_os']==='Chrome' ? null : __e['client_os'].toLowerCase())"
            },
            {
              "name": "'host.name'",
              "value": "__e['machinename'].toLowerCase()"
            },
            {
              "name": "'event.outcome'",
              "value": "__e['status'] ? __e['status'].toLowerCase() : 'unknown'"
            }
          ]
        },
        "description": "Vendor-namespace custom fields plus derived ECS fields (action/code, user split, guarded address coalesce, os.type, outcome)"
      },
      {
        "id": "eval",
        "filter": "login_duration !== undefined && login_duration !== ''",
        "conf": {
          "add": [
            {
              "name": "'event.duration'",
              "value": "Number(__e['login_duration'])*1e9"
            }
          ]
        },
        "description": "Login duration seconds to ECS nanoseconds; only present on logout/teardown records"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "_time",
              "value": "__e['high_res_timestamp'] ? Date.parse(__e['high_res_timestamp'])/1000 : Date.parse(__e['time_generated'].replace(/\\//g,'-')+'Z')/1000"
            }
          ]
        },
        "description": "Event time from time_generated, preferring high_res_timestamp for its explicit UTC offset; _time not @timestamp (platform constraint)"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'event.dataset'",
              "value": "'paloalto_ngfw.globalprotect'"
            }
          ],
          "remove": [
            "type"
          ]
        },
        "description": "Set event.dataset (no hyphen) and drop the routing-only type discriminator"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
