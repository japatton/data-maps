{
  "id": "dm_paloalto_ngfw_globalprotect_syslog_leef",
  "conf": {
    "output": "default",
    "description": "Palo Alto NGFW GlobalProtect syslog-leef direct route: LEEF header+attribute parse to the same ECS shape as the CSV/CEF routes, cat attribute treated as routing-only per catalog note",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "Palo Alto NGFW GlobalProtect syslog-leef (PAN-OS 10.2/11.1), direct route. Header EventID carries the event name; predefined attribute cat carries the constant log type GLOBALPROTECT and is routing-only, NOT an event category."
        },
        "description": "Pipeline purpose and LEEF header/cat trap"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/^LEEF:(?<leef_version>[^|]*)\\|(?<leef_vendor>[^|]*)\\|(?<leef_product>[^|]*)\\|(?<leef_devversion>[^|]*)\\|(?<leef_eventid>[^|]*)\\|(?<attributes>.*)$/",
          "source": "_raw"
        },
        "description": "Split the LEEF header slots from the tab/space-separated attributes blob"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "kvp",
          "srcField": "attributes"
        },
        "description": "Extract the LEEF key=value attributes into top-level fields"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "SourceUserInfoDomain",
              "newName": "user.domain"
            },
            {
              "currentName": "SourceUserInfoName",
              "newName": "source.user.name"
            },
            {
              "currentName": "SourceUserInfoUUID",
              "newName": "user.id"
            },
            {
              "currentName": "HostID",
              "newName": "host.id"
            },
            {
              "currentName": "EndpointOSVersion",
              "newName": "host.os.full"
            },
            {
              "currentName": "EndpointOSType",
              "newName": "host.os.family"
            },
            {
              "currentName": "GlobalProtectGatewayLocation",
              "newName": "observer.geo.name"
            },
            {
              "currentName": "ConnectionError",
              "newName": "event.reason"
            },
            {
              "currentName": "Description",
              "newName": "message"
            },
            {
              "currentName": "SequenceNo",
              "newName": "event.sequence"
            },
            {
              "currentName": "DeviceSN",
              "newName": "observer.serial_number"
            },
            {
              "currentName": "DeviceName",
              "newName": "observer.name"
            },
            {
              "currentName": "SourceRegion",
              "newName": "source.geo.name"
            }
          ]
        },
        "description": "Batch rename of directly-mapped LEEF attributes with no transform"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "panw.panos.globalprotect.endpoint_serial_number",
              "value": "__e['EndpointSN']"
            },
            {
              "name": "panw.panos.globalprotect.client_version",
              "value": "__e['GlobalProtectClientVersion']"
            },
            {
              "name": "panw.panos.globalprotect.stage",
              "value": "__e['Stage']"
            },
            {
              "name": "panw.panos.globalprotect.auth_method",
              "value": "__e['AuthMethod']"
            },
            {
              "name": "panw.panos.globalprotect.tunnel_type",
              "value": "__e['TunnelType']"
            },
            {
              "name": "panw.panos.globalprotect.connect_method",
              "value": "__e['ConnectionMethod']"
            },
            {
              "name": "panw.panos.globalprotect.selection_type",
              "value": "__e['GatewaySelectionType']"
            },
            {
              "name": "panw.panos.globalprotect.portal",
              "value": "__e['Portal']"
            },
            {
              "name": "panw.panos.globalprotect.gateway",
              "value": "__e['Gateway']"
            },
            {
              "name": "panw.panos.globalprotect.gateway_priority",
              "value": "__e['GatewayPriority']"
            },
            {
              "name": "panw.panos.globalprotect.attempted_gateways",
              "value": "__e['AttemptedGateways']"
            },
            {
              "name": "panw.panos.globalprotect.ssl_response_time",
              "value": "__e['SSLResponseTime']"
            },
            {
              "name": "panw.panos.globalprotect.error_code",
              "value": "__e['ConnectionErrorID']"
            },
            {
              "name": "panw.panos.globalprotect.quarantine_reason",
              "value": "__e['QuarantineReason']"
            },
            {
              "name": "panw.panos.globalprotect.repeat_count",
              "value": "__e['CountOfRepeats']"
            },
            {
              "name": "panw.panos.receive_time",
              "value": "__e['TimeReceived']"
            },
            {
              "name": "panw.panos.high_res_timestamp",
              "value": "__e['TimeGeneratedHighResolution']"
            },
            {
              "name": "panw.panos.vsys",
              "value": "__e['VirtualSystem']"
            },
            {
              "name": "panw.panos.vsys_name",
              "value": "__e['VirtualSystemName']"
            },
            {
              "name": "panw.panos.vsys_id",
              "value": "__e['VirtualSystemID']"
            },
            {
              "name": "panw.panos.globalprotect.subtype",
              "value": "__e['SubType']"
            },
            {
              "name": "panw.panos.device_group_hierarchy",
              "value": "{\"level1\":__e['DGHierarchyLevel1'],\"level2\":DGHierarchyLevel2,\"level3\":DGHierarchyLevel3,\"level4\":DGHierarchyLevel4}"
            },
            {
              "name": "panw.panos.action_flags",
              "value": "__e['LogForwarded']"
            },
            {
              "name": "event.code",
              "value": "__e['leef_eventid']"
            },
            {
              "name": "event.action",
              "value": "__e['leef_eventid'].toLowerCase()"
            },
            {
              "name": "user.name",
              "value": "__e['usrName'].indexOf('\\\\')!==-1 ? __e['usrName'].slice(__e['usrName'].indexOf('\\\\')+1) : (__e['usrName'].indexOf('@')!==-1 ? __e['usrName'].slice(0,__e['usrName'].indexOf('@')) : __e['usrName'])"
            },
            {
              "name": "related.user",
              "value": "[__e['usrName'].indexOf('\\\\')!==-1 ? __e['usrName'].slice(__e['usrName'].indexOf('\\\\')+1) : (__e['usrName'].indexOf('@')!==-1 ? __e['usrName'].slice(0,__e['usrName'].indexOf('@')) : __e['usrName'])]"
            },
            {
              "name": "source.ip",
              "value": "(__e['PublicIPv4'] && __e['PublicIPv4']!=='0.0.0.0') ? __e['PublicIPv4'] : ((__e['PublicIPv6'] && __e['PublicIPv6']!=='0.0.0.0' && /^[0-9a-fA-F:]+$/.test(__e['PublicIPv6']) && __e['PublicIPv6'].indexOf(':')!==-1) ? __e['PublicIPv6'] : __e['PublicIPv4'])"
            },
            {
              "name": "client.nat.ip",
              "value": "(__e['PrivateIPv4'] && __e['PrivateIPv4']!=='0.0.0.0') ? __e['PrivateIPv4'] : ((__e['PrivateIPv6'] && __e['PrivateIPv6']!=='0.0.0.0' && /^[0-9a-fA-F:]+$/.test(__e['PrivateIPv6']) && __e['PrivateIPv6'].indexOf(':')!==-1) ? __e['PrivateIPv6'] : __e['PrivateIPv4'])"
            },
            {
              "name": "host.os.type",
              "value": "__e['EndpointOSType']==='Mac' ? 'macos' : (__e['EndpointOSType']==='Chrome' ? null : __e['EndpointOSType'].toLowerCase())"
            },
            {
              "name": "host.name",
              "value": "__e['EndpointDeviceName'].toLowerCase()"
            },
            {
              "name": "event.outcome",
              "value": "__e['EventStatus'] ? __e['EventStatus'].toLowerCase() : 'unknown'"
            }
          ]
        },
        "description": "Vendor-namespace custom fields (VirtualSystemName has its own attribute, no cs3-style trap) plus derived ECS fields: header event id, user split, guarded address coalesce, os.type, outcome"
      },
      {
        "id": "eval",
        "filter": "LoginDuration !== undefined && LoginDuration !== ''",
        "conf": {
          "add": [
            {
              "name": "event.duration",
              "value": "Number(__e['LoginDuration'])*1e9"
            }
          ]
        },
        "description": "Login duration seconds to ECS nanoseconds; only present on logout/teardown records"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "_time",
              "value": "__e['TimeGeneratedHighResolution'] ? Date.parse(__e['TimeGeneratedHighResolution'])/1000 : Date.parse(__e['devTime'].replace(/\\//g,'-')+'Z')/1000"
            }
          ]
        },
        "description": "Event time from devTime, preferring TimeGeneratedHighResolution for its explicit UTC offset; _time not @timestamp (platform constraint)"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "event.dataset",
              "value": "'paloalto_ngfw.globalprotect'"
            }
          ],
          "remove": [
            "cat"
          ]
        },
        "description": "Set event.dataset (no hyphen) and drop the predefined cat attribute, a constant log-type literal not an event category"
      }
    ]
  }
}
