{
  "id": "dm_paloalto_ngfw_config_syslog_cef",
  "conf": {
    "output": "default",
    "description": "Palo Alto NGFW Config log (syslog-cef, PAN-OS 10.2/11.1), direct route: cribl-pack mechanism implemented natively (no Packs installed). Splits the fixed CEF header, lifts event.outcome from header slot 5 (Device Event Class ID = $result), NOT slot 6 (Name, the constant CONFIG), extracts the extension with lookahead capture for cs1/cs2 (raw XML that routinely contains spaces), then renames to ECS/custom and redacts secret-bearing XML nodes.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "paloalto-ngfw / config / syslog-cef. event.outcome comes from the CEF header's Device Event Class ID slot (position 5, $result), never from Name (position 6, the constant 'CONFIG' on this template) - a parser that reaches for Name stamps every record identically. Only Succeeded/Failed collapse to success/failure; Submitted/Unauthorized become 'unknown' with the raw value kept in panw.panos.config.result. Every extension value is lookahead-terminated at the next known key, not \\S+: rt, msg and labels carry spaces and cs1/cs2 XML carries attr= text. shost is the admin's client address and is deliberately routed to source.* to avoid colliding with ECS host.*. Order: header split -> extension extract -> eval (ORIGINAL names) -> rename -> mask (secret XML nodes)."
        },
        "description": "header-slot outcome source, the cs1/cs2 unescaped-space trap, and the shost/host.* collision"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/CEF:(?<cef_version>\\d+)\\|(?<device_vendor>[^|]*)\\|(?<device_product>[^|]*)\\|(?<device_version>[^|]*)\\|(?<signature_id>[^|]*)\\|(?<name>[^|]*)\\|(?<severity>[^|]*)\\|(?<extension>.*)$/",
          "source": "_raw",
          "overwrite": true
        },
        "description": "split the CEF:0|Palo Alto Networks|PAN-OS|$sender_sw_version|$result|$type|1| header from the extension; signature_id carries $result, name carries the constant $type=CONFIG"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/(?:^|\\s)rt=\\s*(?!(?:rt|deviceExternalId|shost|act|duser|destinationServiceName|msg|externalId|dvchost|cs\\d+(?:Label)?|cn\\d+(?:Label)?|PanOS\\w+)=)(?<rt>\\S.*?)(?=\\s+(?:rt|deviceExternalId|shost|act|duser|destinationServiceName|msg|externalId|dvchost|cs\\d+(?:Label)?|cn\\d+(?:Label)?|PanOS\\w+)=|\\s*$)/",
          "source": "extension",
          "regexList": [
            {
              "regex": "/(?:^|\\s)deviceExternalId=\\s*(?!(?:rt|deviceExternalId|shost|act|duser|destinationServiceName|msg|externalId|dvchost|cs\\d+(?:Label)?|cn\\d+(?:Label)?|PanOS\\w+)=)(?<deviceExternalId>\\S.*?)(?=\\s+(?:rt|deviceExternalId|shost|act|duser|destinationServiceName|msg|externalId|dvchost|cs\\d+(?:Label)?|cn\\d+(?:Label)?|PanOS\\w+)=|\\s*$)/"
            },
            {
              "regex": "/(?:^|\\s)shost=\\s*(?!(?:rt|deviceExternalId|shost|act|duser|destinationServiceName|msg|externalId|dvchost|cs\\d+(?:Label)?|cn\\d+(?:Label)?|PanOS\\w+)=)(?<shost>\\S.*?)(?=\\s+(?:rt|deviceExternalId|shost|act|duser|destinationServiceName|msg|externalId|dvchost|cs\\d+(?:Label)?|cn\\d+(?:Label)?|PanOS\\w+)=|\\s*$)/"
            },
            {
              "regex": "/(?:^|\\s)cs3=\\s*(?!(?:rt|deviceExternalId|shost|act|duser|destinationServiceName|msg|externalId|dvchost|cs\\d+(?:Label)?|cn\\d+(?:Label)?|PanOS\\w+)=)(?<cs3>\\S.*?)(?=\\s+(?:rt|deviceExternalId|shost|act|duser|destinationServiceName|msg|externalId|dvchost|cs\\d+(?:Label)?|cn\\d+(?:Label)?|PanOS\\w+)=|\\s*$)/"
            },
            {
              "regex": "/(?:^|\\s)act=\\s*(?!(?:rt|deviceExternalId|shost|act|duser|destinationServiceName|msg|externalId|dvchost|cs\\d+(?:Label)?|cn\\d+(?:Label)?|PanOS\\w+)=)(?<act>\\S.*?)(?=\\s+(?:rt|deviceExternalId|shost|act|duser|destinationServiceName|msg|externalId|dvchost|cs\\d+(?:Label)?|cn\\d+(?:Label)?|PanOS\\w+)=|\\s*$)/"
            },
            {
              "regex": "/(?:^|\\s)duser=\\s*(?!(?:rt|deviceExternalId|shost|act|duser|destinationServiceName|msg|externalId|dvchost|cs\\d+(?:Label)?|cn\\d+(?:Label)?|PanOS\\w+)=)(?<duser>\\S.*?)(?=\\s+(?:rt|deviceExternalId|shost|act|duser|destinationServiceName|msg|externalId|dvchost|cs\\d+(?:Label)?|cn\\d+(?:Label)?|PanOS\\w+)=|\\s*$)/"
            },
            {
              "regex": "/(?:^|\\s)destinationServiceName=\\s*(?!(?:rt|deviceExternalId|shost|act|duser|destinationServiceName|msg|externalId|dvchost|cs\\d+(?:Label)?|cn\\d+(?:Label)?|PanOS\\w+)=)(?<destinationServiceName>\\S.*?)(?=\\s+(?:rt|deviceExternalId|shost|act|duser|destinationServiceName|msg|externalId|dvchost|cs\\d+(?:Label)?|cn\\d+(?:Label)?|PanOS\\w+)=|\\s*$)/"
            },
            {
              "regex": "/(?:^|\\s)msg=\\s*(?!(?:rt|deviceExternalId|shost|act|duser|destinationServiceName|msg|externalId|dvchost|cs\\d+(?:Label)?|cn\\d+(?:Label)?|PanOS\\w+)=)(?<msg>\\S.*?)(?=\\s+(?:rt|deviceExternalId|shost|act|duser|destinationServiceName|msg|externalId|dvchost|cs\\d+(?:Label)?|cn\\d+(?:Label)?|PanOS\\w+)=|\\s*$)/"
            },
            {
              "regex": "/(?:^|\\s)externalId=\\s*(?!(?:rt|deviceExternalId|shost|act|duser|destinationServiceName|msg|externalId|dvchost|cs\\d+(?:Label)?|cn\\d+(?:Label)?|PanOS\\w+)=)(?<externalId>\\S.*?)(?=\\s+(?:rt|deviceExternalId|shost|act|duser|destinationServiceName|msg|externalId|dvchost|cs\\d+(?:Label)?|cn\\d+(?:Label)?|PanOS\\w+)=|\\s*$)/"
            },
            {
              "regex": "/(?:^|\\s)dvchost=\\s*(?!(?:rt|deviceExternalId|shost|act|duser|destinationServiceName|msg|externalId|dvchost|cs\\d+(?:Label)?|cn\\d+(?:Label)?|PanOS\\w+)=)(?<dvchost>\\S.*?)(?=\\s+(?:rt|deviceExternalId|shost|act|duser|destinationServiceName|msg|externalId|dvchost|cs\\d+(?:Label)?|cn\\d+(?:Label)?|PanOS\\w+)=|\\s*$)/"
            },
            {
              "regex": "/(?:^|\\s)cs1=\\s*(?!(?:rt|deviceExternalId|shost|act|duser|destinationServiceName|msg|externalId|dvchost|cs\\d+(?:Label)?|cn\\d+(?:Label)?|PanOS\\w+)=)(?<cs1>\\S.*?)(?=\\s+(?:rt|deviceExternalId|shost|act|duser|destinationServiceName|msg|externalId|dvchost|cs\\d+(?:Label)?|cn\\d+(?:Label)?|PanOS\\w+)=|\\s*$)/"
            },
            {
              "regex": "/(?:^|\\s)cs2=\\s*(?!(?:rt|deviceExternalId|shost|act|duser|destinationServiceName|msg|externalId|dvchost|cs\\d+(?:Label)?|cn\\d+(?:Label)?|PanOS\\w+)=)(?<cs2>\\S.*?)(?=\\s+(?:rt|deviceExternalId|shost|act|duser|destinationServiceName|msg|externalId|dvchost|cs\\d+(?:Label)?|cn\\d+(?:Label)?|PanOS\\w+)=|\\s*$)/"
            }
          ]
        },
        "description": "CEF extension: a value runs to the next key of the PAN-OS config CEF format (or any PanOS*/csN/cnN key) - values carry spaces (rt, msg, labels) and cs1/cs2 carry XML whose attr= text must not end the value; an empty value stays absent"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'event.outcome'",
              "value": "__e['signature_id']==='Succeeded' ? 'success' : (__e['signature_id']==='Failed' ? 'failure' : 'unknown')"
            },
            {
              "name": "'panw.panos.config.result'",
              "value": "__e['signature_id']"
            },
            {
              "name": "'source.ip'",
              "value": "__e['shost'] !== undefined && /^\\d{1,3}(\\.\\d{1,3}){3}$/.test(String(__e['shost'])) ? __e['shost'] : undefined"
            },
            {
              "name": "'source.domain'",
              "value": "__e['shost'] !== undefined && !/^\\d{1,3}(\\.\\d{1,3}){3}$/.test(String(__e['shost'])) ? __e['shost'] : undefined"
            },
            {
              "name": "__dm_time",
              "value": "__e['rt'] === undefined ? __e['_time'] : (!Number.isNaN(Number(__e['rt'])) ? Number(__e['rt'])/1000 : (Number.isNaN(Date.parse(__e['rt'])) ? __e['_time'] : Date.parse(__e['rt'])/1000))"
            },
            {
              "name": "_time",
              "value": "__e['__dm_time'] !== undefined && __e['__dm_time'] !== null && __e['__dm_time'] === __e['__dm_time'] ? __e['__dm_time'] : __e['_time']"
            },
            {
              "name": "'event.dataset'",
              "value": "'paloalto_ngfw.config'"
            }
          ]
        },
        "description": "lift event.outcome from the header's Device Event Class ID slot while preserving the raw vocabulary, branch shost to source.ip vs source.domain by value shape, convert rt from CEF milliseconds, tag the dataset - all from ORIGINAL field names before rename"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "duser",
              "newName": "'user.name'"
            },
            {
              "currentName": "act",
              "newName": "'event.action'"
            },
            {
              "currentName": "shost",
              "newName": "'source.address'"
            },
            {
              "currentName": "destinationServiceName",
              "newName": "'panw.panos.config.client'"
            },
            {
              "currentName": "msg",
              "newName": "'panw.panos.config.path'"
            },
            {
              "currentName": "externalId",
              "newName": "'event.sequence'"
            },
            {
              "currentName": "dvchost",
              "newName": "'observer.name'"
            },
            {
              "currentName": "deviceExternalId",
              "newName": "'observer.serial_number'"
            },
            {
              "currentName": "cs3",
              "newName": "'panw.panos.vsys'"
            },
            {
              "currentName": "cs1",
              "newName": "'panw.panos.config.before_change_detail'"
            },
            {
              "currentName": "cs2",
              "newName": "'panw.panos.config.after_change_detail'"
            }
          ]
        },
        "description": "batch rename every clean-named mapped/custom extension field; signature_id/rt are fully consumed by the eval above and left as raw duplicates"
      },
      {
        "id": "mask",
        "filter": "true",
        "conf": {
          "rules": [
            {
              "matchRegex": "/<(password|phash|hash|secret|api-key|apikey|priv-key|key)>[\\s\\S]*?<\\/\\1>/gi",
              "replaceExpr": "'<' + g1 + '>REDACTED<\\/' + g1 + '>'"
            }
          ],
          "fields": [
            "panw.panos.config.before_change_detail",
            "panw.panos.config.after_change_detail",
            "_raw"
          ]
        },
        "description": "redact password/hash/secret/api-key XML nodes in the change-detail blobs and in _raw where the same text still sits verbatim"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
