{
  "id": "dm_m365_ual_entra_signin_directory_api_pull",
  "conf": {
    "output": "default",
    "description": "M365 UAL entra-signin-directory api-pull: Graph audit-query JSON parse, RecordType map, objectId shape-branch to user.target.name/id, feed-identifier tag per direct.cribl",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "M365 UAL entra-signin-directory, api-pull format (Graph audit-query async flow; GCC-moderate only, global endpoint). This is a third collection path for the same sign-in (json feed + entra-id Event Hubs feed also exist), so per direct.cribl this pipeline tags every record with a feed identifier (o365.audit.origin) so it can be told apart downstream. Extracts the JSON record, renames straightforward common fields plus clientIp (no split needed per the map), maps auditLogRecordType to numeric RecordType (8/15/9, all documented), branches objectId by shape into user.target.name (an '@'-shaped UPN) or user.target.id (a GUID), gated on userType not being application/servicePrincipal, and routes userType/userId/administrativeUnits/auditData to custom o365.audit.* fields."
        },
        "description": "pipeline documentation"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "parse the Graph auditLogRecord JSON the REST Collector delivered in _raw"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "id",
              "newName": "event.id"
            },
            {
              "currentName": "operation",
              "newName": "event.action"
            },
            {
              "currentName": "organizationId",
              "newName": "organization.id"
            },
            {
              "currentName": "service",
              "newName": "event.provider"
            },
            {
              "currentName": "userPrincipalName",
              "newName": "user.name"
            },
            {
              "currentName": "clientIp",
              "newName": "source.ip"
            }
          ]
        },
        "description": "batch rename of straightforward mapped/partial fields to their ECS targets"
      },
      {
        "id": "auto_timestamp",
        "filter": "true",
        "conf": {
          "srcField": "createdDateTime",
          "dstField": "_time"
        },
        "description": "canonical event time in _time (never @timestamp; Elastic dest maps it)"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "event.code",
              "value": "__e['auditLogRecordType']==='azureActiveDirectory'?8:__e['auditLogRecordType']==='azureActiveDirectoryStsLogon'?15:__e['auditLogRecordType']==='azureActiveDirectoryAccountLogon'?9:-1"
            },
            {
              "name": "user.target.name",
              "value": "(__e['userType']!=='application' && __e['userType']!=='servicePrincipal' && __e['objectId'] && __e['objectId'].indexOf('@')!==-1) ? __e['objectId'] : undefined"
            },
            {
              "name": "user.target.id",
              "value": "(__e['userType']!=='application' && __e['userType']!=='servicePrincipal' && __e['objectId'] && __e['objectId'].indexOf('@')===-1) ? __e['objectId'] : undefined"
            },
            {
              "name": "o365.audit.user_type",
              "value": "__e['userType']"
            },
            {
              "name": "o365.audit.user_id",
              "value": "__e['userId']"
            },
            {
              "name": "o365.audit.administrative_units",
              "value": "__e['administrativeUnits']"
            },
            {
              "name": "o365.audit.audit_data",
              "value": "__e['auditData']"
            },
            {
              "name": "o365.audit.origin",
              "value": "'graph_audit_query'"
            },
            {
              "name": "event.dataset",
              "value": "'m365_ual.entra_signin_directory'"
            }
          ]
        },
        "description": "computed transforms, custom-field routing, and event.dataset"
      }
    ]
  }
}
