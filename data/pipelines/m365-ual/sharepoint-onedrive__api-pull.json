{
  "id": "dm_m365_ual_sharepoint_onedrive_api_pull",
  "conf": {
    "output": "default",
    "description": "M365 UAL sharepoint-onedrive api-pull: Graph audit-query JSON parse, objectId to url.original, RecordType/clientIp transforms, unmapped fields to o365.audit.*",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "M365 UAL sharepoint-onedrive, api-pull format (Graph audit-query async flow). Highest-volume content type, so per direct.cribl the FileAccessed/FilePreviewed read flood is scoped out server-side at the query, not in this pipeline. Extracts the JSON record, renames the straightforward common fields plus objectId (mapped straight to url.original per the map), maps auditLogRecordType to numeric RecordType (4/6/14 per the map; oneDrive has no documented number and falls to -1, a documented gap), splits clientIp's optional port before mapping to source.ip, and routes userType/userId/administrativeUnits/auditData to custom o365.audit.* fields."
        },
        "description": "pipeline documentation"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "parse the Graph auditLogRecord JSON the REST Collector delivered in _raw"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "id",
              "newName": "event.id"
            },
            {
              "currentName": "operation",
              "newName": "event.action"
            },
            {
              "currentName": "organizationId",
              "newName": "organization.id"
            },
            {
              "currentName": "service",
              "newName": "event.provider"
            },
            {
              "currentName": "userPrincipalName",
              "newName": "user.name"
            },
            {
              "currentName": "objectId",
              "newName": "url.original"
            }
          ]
        },
        "description": "batch rename of straightforward mapped/partial fields to their ECS targets"
      },
      {
        "id": "auto_timestamp",
        "filter": "true",
        "conf": {
          "srcField": "createdDateTime",
          "dstField": "_time"
        },
        "description": "canonical event time in _time (never @timestamp; Elastic dest maps it)"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "event.code",
              "value": "__e['auditLogRecordType']==='sharePoint'?4:__e['auditLogRecordType']==='sharePointFileOperation'?6:__e['auditLogRecordType']==='sharePointSharingOperation'?14:-1"
            },
            {
              "name": "source.ip",
              "value": "__e['clientIp'] ? (__e['clientIp'].charAt(0)==='[' ? __e['clientIp'].replace(/^\\[(.*)\\](?::\\d+)?$/, '$1') : (__e['clientIp'].split(':').length===2 ? __e['clientIp'].split(':')[0] : __e['clientIp'])) : undefined"
            },
            {
              "name": "o365.audit.user_type",
              "value": "__e['userType']"
            },
            {
              "name": "o365.audit.user_id",
              "value": "__e['userId']"
            },
            {
              "name": "o365.audit.administrative_units",
              "value": "__e['administrativeUnits']"
            },
            {
              "name": "o365.audit.audit_data",
              "value": "__e['auditData']"
            },
            {
              "name": "event.dataset",
              "value": "'m365_ual.sharepoint_onedrive'"
            }
          ]
        },
        "description": "computed transforms, custom-field routing, and event.dataset"
      }
    ]
  }
}
