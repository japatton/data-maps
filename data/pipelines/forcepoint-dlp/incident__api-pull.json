{
  "id": "dm_forcepoint_dlp_incident_api_pull",
  "conf": {
    "output": "default",
    "description": "Forcepoint DLP incident, REST API pull (Cribl REST Collector polling /dlp/rest/v1/incidents; JWT handshake and date-window paging live in the Collector config, out of pipeline scope). Parses the JSON incident object (incl. nested source.*) into the same logs-forcepoint_dlp.incident shape as the CEF and CSV feeds. Strips the size suffix from file_name, derives event.outcome from action, splits policies into rule.name (this feed's key value-add over CEF, which leaves rule.name empty), and treats event_time as the true event time vs incident_time as record-creation time - both day-first with no offset (assumed UTC; documented gap).",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "Forcepoint DLP incident, REST API pull (Cribl REST Collector polling /dlp/rest/v1/incidents; JWT handshake and date-window paging live in the Collector config, out of pipeline scope). Parses the JSON incident object (incl. nested source.*) into the same logs-forcepoint_dlp.incident shape as the CEF and CSV feeds. Strips the size suffix from file_name, derives event.outcome from action, splits policies into rule.name (this feed's key value-add over CEF, which leaves rule.name empty), and treats event_time as the true event time vs incident_time as record-creation time - both day-first with no offset (assumed UTC; documented gap)."
        },
        "description": "pipeline summary"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "Parse the REST response's JSON incident object."
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "event_id",
              "newName": "'event.id'"
            },
            {
              "currentName": "action",
              "newName": "'event.action'"
            },
            {
              "currentName": "details",
              "newName": "message"
            },
            {
              "currentName": "analyzed_by",
              "newName": "'observer.name'"
            },
            {
              "currentName": "source.ip_address",
              "newName": "'source.ip'"
            },
            {
              "currentName": "source.login_name",
              "newName": "'user.name'"
            },
            {
              "currentName": "source.email_address",
              "newName": "'source.user.email'"
            },
            {
              "currentName": "source.nt_domain",
              "newName": "'source.user.domain'"
            },
            {
              "currentName": "source.host_name",
              "newName": "'host.name'"
            },
            {
              "currentName": "endpoint_type",
              "newName": "'host.type'"
            },
            {
              "currentName": "destination",
              "newName": "'destination.address'"
            }
          ]
        },
        "description": "Batch-rename every status:mapped field (including nested source.*) to its ECS target."
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'event.outcome'",
              "value": "__e['event.action'] === undefined ? undefined : 'success'"
            },
            {
              "name": "'event.category'",
              "value": "['file', 'web']"
            },
            {
              "name": "'rule.name'",
              "value": "__e['policies'] === undefined ? undefined : __e['policies'].split(/;\\s*/)"
            },
            {
              "name": "'file.name'",
              "value": "__e['file_name'] === undefined ? undefined : __e['file_name'].replace(/\\s*-\\s*[\\d.]+\\s*\\wB$/, '')"
            },
            {
              "name": "'destination.user.name'",
              "value": "((__e['channel'] === 'EMAIL' || __e['channel'] === 'ENDPOINT_EMAIL')) ? __e['destination.address'] : undefined"
            },
            {
              "name": "'event.created'",
              "value": "__e['incident_time'] === undefined ? undefined : __e['incident_time'].replace(/^(\\d{2})\\/(\\d{2})\\/(\\d{4}) (\\d{2}):(\\d{2}):(\\d{2})$/, '$3-$2-$1T$4:$5:$6Z')"
            },
            {
              "name": "'forcepoint.dlp.incident_id'",
              "value": "__e['id']"
            },
            {
              "name": "'forcepoint.dlp.severity_type'",
              "value": "__e['severity']"
            },
            {
              "name": "'forcepoint.dlp.incident_status'",
              "value": "__e['status']"
            },
            {
              "name": "'forcepoint.dlp.tag'",
              "value": "__e['tag']"
            },
            {
              "name": "'forcepoint.dlp.assigned_to'",
              "value": "__e['assigned_to']"
            },
            {
              "name": "'forcepoint.dlp.detected_by'",
              "value": "__e['detected_by']"
            },
            {
              "name": "'forcepoint.dlp.ignored'",
              "value": "__e['ignored_incidents']"
            },
            {
              "name": "'forcepoint.dlp.released'",
              "value": "__e['released_incident']"
            },
            {
              "name": "'forcepoint.dlp.partition_index'",
              "value": "__e['partition_index']"
            },
            {
              "name": "'forcepoint.dlp.violation_triggers'",
              "value": "__e['violation_triggers'] === undefined ? undefined : Number(__e['violation_triggers'])"
            },
            {
              "name": "'forcepoint.dlp.transaction_size'",
              "value": "__e['transaction_size'] === undefined ? undefined : Number(__e['transaction_size'])"
            },
            {
              "name": "'forcepoint.dlp.max_matches'",
              "value": "__e['maximum_matches'] === undefined ? undefined : Number(__e['maximum_matches'])"
            },
            {
              "name": "'forcepoint.dlp.channel'",
              "value": "__e['channel']"
            },
            {
              "name": "'forcepoint.dlp.source.dn'",
              "value": "source !== undefined ? source.dn : undefined"
            },
            {
              "name": "'forcepoint.dlp.source.manager'",
              "value": "source !== undefined ? source.manager : undefined"
            },
            {
              "name": "'forcepoint.dlp.source.department'",
              "value": "source !== undefined ? source.department : undefined"
            },
            {
              "name": "'forcepoint.dlp.source.business_unit'",
              "value": "source !== undefined ? source.business_unit : undefined"
            },
            {
              "name": "'forcepoint.dlp.source.risk_level'",
              "value": "source !== undefined ? source.risk_level : undefined"
            }
          ],
          "remove": [
            "id",
            "severity",
            "status",
            "tag",
            "assigned_to",
            "detected_by",
            "ignored_incidents",
            "released_incident",
            "partition_index",
            "violation_triggers",
            "transaction_size",
            "maximum_matches",
            "channel",
            "policies",
            "file_name",
            "incident_time",
            "source"
          ]
        },
        "description": "Derive event.outcome/rule.name/file.name/event.created; relocate every unmapped field (including nested source.* enrichment) to forcepoint.dlp.*."
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "__dm_time",
              "value": "__e['event_time'] === undefined ? undefined : Date.parse(__e['event_time'].replace(/^(\\d{2})\\/(\\d{2})\\/(\\d{4}) (\\d{2}):(\\d{2}):(\\d{2})$/, '$3-$2-$1T$4:$5:$6Z')) / 1000"
            },
            {
              "name": "_time",
              "value": "__e['__dm_time'] !== undefined && __e['__dm_time'] !== null && __e['__dm_time'] === __e['__dm_time'] ? __e['__dm_time'] : __e['_time']"
            },
            {
              "name": "'event.dataset'",
              "value": "'forcepoint_dlp.incident'"
            }
          ],
          "remove": [
            "event_time"
          ]
        },
        "description": "Set _time from event_time (day-first, no offset; assumed UTC - see README); tag event.dataset."
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
