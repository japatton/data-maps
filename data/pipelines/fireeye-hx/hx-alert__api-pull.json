{
  "id": "dm_fireeye_hx_hx_alert_api_pull",
  "conf": {
    "output": "default",
    "description": "FireEye HX endpoint alert / REST API pull: shapes the alert record a Cribl REST Collector already delivered as a parsed JSON object (no Source/Collector created here, pipeline only) into ECS, branching the event_values flatten on event_type by key name, never position.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "fireeye-hx / hx-alert / api-pull. Assumes the REST Collector delivers the /hx/api/v3/alerts record (joined with the /hosts/<agent_id> record) as a parsed JSON object at the event top level, not as _raw text -- no serde step here. event_values keys are slash-delimited and namespaced by event_type (e.g. processEvent/processCmdLine); resolved by bracket-access key name in eval, never by position, per the map's own warning. textAtLowestOffset length-cap and md5values cardinality are documented gaps -- no concrete cap length or cardinality rule given."
        },
        "description": "record the parsed-JSON assumption and the event_values branching approach"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "_time",
              "value": "Number.isNaN(Number(__e['event_at'])) ? (Number.isNaN(Date.parse(__e['event_at'])) ? __e['_time'] : Date.parse(__e['event_at'])/1000) : Number(__e['event_at'])/1000"
            },
            {
              "name": "'event.type'",
              "value": "__e['resolution']==='ALERT' ? 'allowed' : ((__e['resolution']==='BLOCK' || __e['resolution']==='PARTIAL_BLOCK') ? 'denied' : undefined)"
            },
            {
              "name": "'event.action'",
              "value": "__e['event_type'] ? __e['event_type'].toLowerCase() : undefined"
            },
            {
              "name": "'file.hash.md5'",
              "value": "Array.isArray(__e['md5values']) ? __e['md5values'][0] : __e['md5values']"
            },
            {
              "name": "'host.os.platform'",
              "value": "__e['os'] && __e['os'].platform==='win' ? 'windows' : (__e['os'] && __e['os'].platform==='osx' ? 'macos' : (__e['os'] && __e['os'].platform==='linux' ? 'linux' : undefined))"
            },
            {
              "name": "'process.executable'",
              "value": "__e['event_values'] ? __e['event_values']['processEvent/processPath'] : undefined"
            },
            {
              "name": "'process.command_line'",
              "value": "__e['event_values'] ? __e['event_values']['processEvent/processCmdLine'] : undefined"
            },
            {
              "name": "'process.hash.md5'",
              "value": "__e['event_values'] ? __e['event_values']['processEvent/md5'] : undefined"
            },
            {
              "name": "'process.parent.pid'",
              "value": "__e['event_values'] ? __e['event_values']['processEvent/parentPid'] : undefined"
            },
            {
              "name": "'process.parent.name'",
              "value": "__e['event_values'] ? __e['event_values']['processEvent/parentProcess'] : undefined"
            },
            {
              "name": "'file.name'",
              "value": "__e['event_values'] ? __e['event_values']['fileWriteEvent/fileName'] : undefined"
            },
            {
              "name": "'file.path'",
              "value": "__e['event_values'] ? __e['event_values']['fileWriteEvent/fullPath'] : undefined"
            },
            {
              "name": "'fireeye.hx.file_text_at_lowest_offset'",
              "value": "__e['event_values'] ? __e['event_values']['fileWriteEvent/textAtLowestOffset'] : undefined"
            },
            {
              "name": "'registry.path'",
              "value": "__e['event_values'] ? __e['event_values']['regKeyEvent/path'] : undefined"
            },
            {
              "name": "'dns.question.name'",
              "value": "__e['event_values'] ? __e['event_values']['dnsLookupEvent/hostname'] : undefined"
            },
            {
              "name": "'url.original'",
              "value": "__e['event_values'] ? __e['event_values']['urlMonitorEvent/requestUrl'] : undefined"
            }
          ]
        },
        "description": "compute every derived/branched field from the ORIGINAL vendor names before renaming, including the event_values slash-key flatten via bracket access (order rule: compute before rename)"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "_id",
              "newName": "'event.id'"
            },
            {
              "currentName": "matched_at",
              "newName": "'fireeye.hx.matched_at'"
            },
            {
              "currentName": "reported_at",
              "newName": "'fireeye.hx.reported_at'"
            },
            {
              "currentName": "source",
              "newName": "'fireeye.hx.alert_source'"
            },
            {
              "currentName": "resolution",
              "newName": "'fireeye.hx.resolution_raw'"
            },
            {
              "currentName": "subtype",
              "newName": "'fireeye.hx.subtype'"
            },
            {
              "currentName": "matched_source_alerts",
              "newName": "'fireeye.hx.matched_source_alerts'"
            },
            {
              "currentName": "is_false_positive",
              "newName": "'fireeye.hx.is_false_positive'"
            },
            {
              "currentName": "url",
              "newName": "'event.reference'"
            },
            {
              "currentName": "indicator.name",
              "newName": "'rule.name'"
            },
            {
              "currentName": "condition._id",
              "newName": "'rule.id'"
            },
            {
              "currentName": "agent._id",
              "newName": "'host.id'"
            },
            {
              "currentName": "agent.containment_state",
              "newName": "'fireeye.hx.containment_state'"
            },
            {
              "currentName": "hostname",
              "newName": "'host.name'"
            },
            {
              "currentName": "domain",
              "newName": "'host.domain'"
            },
            {
              "currentName": "primary_ip_address",
              "newName": "'host.ip'"
            },
            {
              "currentName": "agent_version",
              "newName": "'agent.version'"
            },
            {
              "currentName": "os.product_name",
              "newName": "'host.os.name'"
            }
          ]
        },
        "description": "batch rename every clean 1:1 field, including the genuinely-nested indicator.name/condition._id/agent._id/agent.containment_state/os.product_name sources (real nested JSON objects from the API, not flat dotted keys, so dot-path rename resolves correctly here)"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'event.dataset'",
              "value": "'fireeye_hx.hx_alert'"
            }
          ],
          "remove": [
            "event_values"
          ]
        },
        "description": "tag event.dataset and drop the fully-consumed event_values container; remnant nested objects (agent/os/condition/indicator) are left as harmless duplicates rather than risking a bad removal path"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
