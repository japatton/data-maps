{
  "id": "dm_zeek_conn_csv_file",
  "conf": {
    "output": "default",
    "description": "Zeek / Corelight conn / csv-file (TSV ASCII writer): header-driven tab split (fixed default column order) then logs-zeek.conn@custom-equivalent ECS mapping. Direct route, no guard hop.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "Zeek conn.log (TSV/ASCII writer) -> logs-zeek.connection. Splits on tab per the Zeek 6.0/7.0 LTS default conn.log column order (fixed list below, not read from the file's own #fields header - see README gap). unset_field '-' becomes absent, empty_field '(empty)' becomes ''. Implements recommendations.direct.cribl (attach sensor identity, prefer JSON writer where available) and the logs-zeek.connection@custom enrichment: conn_state->event.outcome, duration->nanoseconds, direction from local_orig/local_resp, event.dataset=zeek.connection per the route note."
        },
        "description": "pipeline purpose and parsing approach"
      },
      {
        "id": "drop",
        "filter": "__e['_raw'] != null && __e['_raw'][0] === '#'",
        "conf": {},
        "description": "discard Zeek ASCII-writer header/meta lines (#separator, #fields, #types, #path, #open, #close, ...) - they carry no event data"
      },
      {
        "id": "code",
        "filter": "true",
        "conf": {
          "code": "(function(){var HEADER=[\"ts\", \"uid\", \"id_orig_h\", \"id_orig_p\", \"id_resp_h\", \"id_resp_p\", \"proto\", \"service\", \"duration\", \"orig_bytes\", \"resp_bytes\", \"conn_state\", \"local_orig\", \"local_resp\", \"missed_bytes\", \"history\", \"orig_pkts\", \"orig_ip_bytes\", \"resp_pkts\", \"resp_ip_bytes\", \"tunnel_parents\", \"community_id\"];var ARRAY_COLS={\"tunnel_parents\": true};var vals=__e['_raw']?__e['_raw'].split('\\t'):[];for(var i=0;i<HEADER.length;i++){var name=HEADER[i];var v=vals[i];if(v===undefined||v==='-'){continue;}if(v==='(empty)'){v='';}__e[name]=(ARRAY_COLS[name]&&v!=='')?v.split(','):v;}})();"
        },
        "description": "split the tab-delimited data line into fields named after Zeek's default conn.log column order (id.orig_h etc. renamed to id_orig_h etc. at this step to avoid a dotted raw field name ever being used as a path-based rename/eval target); tunnel_parents is a genuine Zeek set (set_separator ',') so it becomes an array here"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "uid",
              "newName": "event.id"
            },
            {
              "currentName": "id_orig_h",
              "newName": "source.ip"
            },
            {
              "currentName": "id_orig_p",
              "newName": "source.port"
            },
            {
              "currentName": "id_resp_h",
              "newName": "destination.ip"
            },
            {
              "currentName": "id_resp_p",
              "newName": "destination.port"
            },
            {
              "currentName": "orig_pkts",
              "newName": "source.packets"
            },
            {
              "currentName": "resp_pkts",
              "newName": "destination.packets"
            },
            {
              "currentName": "community_id",
              "newName": "network.community_id"
            }
          ]
        },
        "description": "batch rename of clean 1:1 mapped fields with no value transform"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "_time",
              "value": "__e['ts']!==undefined?Number(__e['ts']):undefined"
            },
            {
              "name": "network.transport",
              "value": "__e['proto']"
            },
            {
              "name": "network.iana_number",
              "value": "__e['ip_proto']!==undefined?Number(__e['ip_proto']):(__e['proto']==='tcp'?6:(__e['proto']==='udp'?17:(__e['proto']==='icmp'?1:undefined)))"
            },
            {
              "name": "network.protocol",
              "value": "__e['service']?__e['service'].split(',')[0]:undefined"
            },
            {
              "name": "source.bytes",
              "value": "__e['orig_bytes']!==undefined?Number(__e['orig_bytes']):undefined"
            },
            {
              "name": "destination.bytes",
              "value": "__e['resp_bytes']!==undefined?Number(__e['resp_bytes']):undefined"
            },
            {
              "name": "event.duration",
              "value": "__e['duration']!==undefined?Math.round(Number(__e['duration'])*1e9):undefined"
            },
            {
              "name": "event.outcome",
              "value": "['SF','S1','S2','S3'].indexOf(__e['conn_state'])>=0?'success':(['S0','REJ','RSTO','RSTR','RSTOS0','RSTRH'].indexOf(__e['conn_state'])>=0?'failure':undefined)"
            },
            {
              "name": "network.direction",
              "value": "(__e['local_orig']==='T'&&__e['local_resp']==='F')?'outbound':((__e['local_orig']==='F'&&__e['local_resp']==='T')?'inbound':((__e['local_orig']==='T'&&__e['local_resp']==='T')?'internal':((__e['local_orig']==='F'&&__e['local_resp']==='F')?'external':undefined)))"
            },
            {
              "name": "zeek.connection.missed_bytes",
              "value": "__e['missed_bytes']!==undefined?Number(__e['missed_bytes']):undefined"
            },
            {
              "name": "zeek.connection.history",
              "value": "__e['history']"
            },
            {
              "name": "zeek.connection.orig_ip_bytes",
              "value": "__e['orig_ip_bytes']!==undefined?Number(__e['orig_ip_bytes']):undefined"
            },
            {
              "name": "zeek.connection.resp_ip_bytes",
              "value": "__e['resp_ip_bytes']!==undefined?Number(__e['resp_ip_bytes']):undefined"
            },
            {
              "name": "zeek.connection.tunnel_parents",
              "value": "__e['tunnel_parents']"
            },
            {
              "name": "event.dataset",
              "value": "'zeek.connection'"
            }
          ],
          "remove": [
            "ts",
            "service",
            "duration",
            "conn_state",
            "local_orig",
            "local_resp",
            "missed_bytes",
            "history",
            "orig_ip_bytes",
            "resp_ip_bytes",
            "tunnel_parents",
            "ip_proto",
            "orig_bytes",
            "resp_bytes",
            "proto"
          ]
        },
        "description": "implement every partial/unmapped transform from the data map, set _time from ts (epoch-seconds, sub-second precision preserved by Number() not Date.parse), tag event.dataset, then remove the now-superseded raw columns"
      }
    ]
  }
}