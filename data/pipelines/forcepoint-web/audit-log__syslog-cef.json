{
  "id": "dm_forcepoint_web_audit_log_syslog_cef",
  "conf": {
    "output": "default",
    "description": "Forcepoint Security Manager audit log, CEF Custom format string with individually emitted columns: extract Date/User/Server/Role/Type/Element/Action/Previous/Current/product_version, split Server into host.target.ip/name, tag event.dataset; _raw retained (low-volume, forensically valuable) and _time left at default pending the deployment's Date format/timezone.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "Forcepoint Web Security, audit-log dataset, syslog-cef format (Custom format string with individually emitted columns per recommendations.direct.cribl - Previous/Current are not packed here). Date has no timezone offset and the Security Manager's configured zone is deployment-specific/unpublished, so _time is left at Cribl default rather than guessing a parse format - see README."
        },
        "description": "identify pipeline and note the Date/_time gap"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\bDate=(?<audit_date>.*?)(?=\\s+\\S+=|$)/",
          "source": "_raw"
        },
        "description": "Extract audit key Date"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\bUser=(?<audit_user>.*?)(?=\\s+\\S+=|$)/",
          "source": "_raw"
        },
        "description": "Extract audit key User"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\bServer=(?<audit_server>.*?)(?=\\s+\\S+=|$)/",
          "source": "_raw"
        },
        "description": "Extract audit key Server"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\bRole=(?<audit_role>.*?)(?=\\s+\\S+=|$)/",
          "source": "_raw"
        },
        "description": "Extract audit key Role"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\bType=(?<audit_type>.*?)(?=\\s+\\S+=|$)/",
          "source": "_raw"
        },
        "description": "Extract audit key Type"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\bElement=(?<audit_element>.*?)(?=\\s+\\S+=|$)/",
          "source": "_raw"
        },
        "description": "Extract audit key Element"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\bAction=(?<audit_action>.*?)(?=\\s+\\S+=|$)/",
          "source": "_raw"
        },
        "description": "Extract audit key Action"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\bPrevious=(?<audit_previous>.*?)(?=\\s+\\S+=|$)/",
          "source": "_raw"
        },
        "description": "Extract audit key Previous"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\bCurrent=(?<audit_current>.*?)(?=\\s+\\S+=|$)/",
          "source": "_raw"
        },
        "description": "Extract audit key Current"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\bproduct_version=(?<audit_product_version>.*?)(?=\\s+\\S+=|$)/",
          "source": "_raw"
        },
        "description": "Extract audit key product_version"
      },
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "Server may hold a hostname or an IP; type-test to land it in host.target.name vs host.target.ip since it names the machine acted upon, not the emitter. Role is the changed object's role, kept out of user.roles."
        },
        "description": "explain conditional Server split"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "host.target.ip",
              "value": "/^\\d{1,3}(\\.\\d{1,3}){3}$/.test(__e['audit_server']) ? __e['audit_server'] : undefined"
            },
            {
              "name": "host.target.name",
              "value": "/^\\d{1,3}(\\.\\d{1,3}){3}$/.test(__e['audit_server']) ? undefined : __e['audit_server']"
            },
            {
              "name": "forcepoint.web.audit.date_raw",
              "value": "__e['audit_date']"
            },
            {
              "name": "event.dataset",
              "value": "'forcepoint_web.audit_log'"
            }
          ],
          "remove": [
            "audit_server",
            "audit_date"
          ]
        },
        "description": "Split Server into host.target.ip/name; keep the raw Date string (timezone unknown - see README); tag event.dataset"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "audit_user",
              "newName": "user.name"
            },
            {
              "currentName": "audit_role",
              "newName": "forcepoint.web.audit.role"
            },
            {
              "currentName": "audit_type",
              "newName": "forcepoint.web.audit.element_type"
            },
            {
              "currentName": "audit_element",
              "newName": "forcepoint.web.audit.element"
            },
            {
              "currentName": "audit_action",
              "newName": "event.action"
            },
            {
              "currentName": "audit_previous",
              "newName": "forcepoint.web.audit.previous_value"
            },
            {
              "currentName": "audit_current",
              "newName": "forcepoint.web.audit.current_value"
            },
            {
              "currentName": "audit_product_version",
              "newName": "observer.version"
            }
          ]
        },
        "description": "Batch rename every status:mapped/unmapped-with-custom-target field to its ECS or custom home"
      }
    ]
  }
}