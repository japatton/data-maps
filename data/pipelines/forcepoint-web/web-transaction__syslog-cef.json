{
  "id": "dm_forcepoint_web_web_transaction_syslog_cef",
  "conf": {
    "output": "default",
    "description": "Forcepoint Web Security web-transaction CEF (legacy ArcSight predefined string): extract CEF extension key=value pairs, resolve LDAP suser, split multi-policy cs1, version-branch rt to _time, tag event.dataset; disposition/category numeric codes kept raw (lookup files out of scope).",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "Forcepoint Web Security, web-transaction dataset, syslog-cef format. Generic CEF extension key=value extraction (the built-in cef function returns a runtime error on this instance - see README), disposition/category lookups deferred (no lookup file in scope), scheme reattachment deferred to Elastic per recommendations.direct.elastic."
        },
        "description": "identify pipeline and note deviations"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/CEF:(?<cef_version>\\d+)\\|(?<deviceVendor>[^|]*)\\|(?<deviceProduct>[^|]*)\\|(?<productVersion>[^|]*)\\|(?<categoryNumber>[^|]*)\\|(?<cef_name>[^|]*)\\|(?<severity>[^|]*)\\|/",
          "source": "_raw"
        },
        "description": "Extract CEF header pipes: productVersion (Device Version) and categoryNumber (Signature_ID/header) needed for version-branch and category custom field"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\bsrc=(?<src>.*?)(?=\\s+\\S+=|$)/",
          "source": "_raw"
        },
        "description": "Extract CEF extension key src"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\bspt=(?<spt>.*?)(?=\\s+\\S+=|$)/",
          "source": "_raw"
        },
        "description": "Extract CEF extension key spt"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\bdst=(?<dst>.*?)(?=\\s+\\S+=|$)/",
          "source": "_raw"
        },
        "description": "Extract CEF extension key dst"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\bdpt=(?<dpt>.*?)(?=\\s+\\S+=|$)/",
          "source": "_raw"
        },
        "description": "Extract CEF extension key dpt"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\bdhost=(?<dhost>.*?)(?=\\s+\\S+=|$)/",
          "source": "_raw"
        },
        "description": "Extract CEF extension key dhost"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\brequest=(?<request>.*?)(?=\\s+\\S+=|$)/",
          "source": "_raw"
        },
        "description": "Extract CEF extension key request"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\brequestMethod=(?<requestMethod>.*?)(?=\\s+\\S+=|$)/",
          "source": "_raw"
        },
        "description": "Extract CEF extension key requestMethod"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\brequestClientApplication=(?<requestClientApplication>.*?)(?=\\s+\\S+=|$)/",
          "source": "_raw"
        },
        "description": "Extract CEF extension key requestClientApplication"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\bsuser=(?<suser>.*?)(?=\\s+\\S+=|$)/",
          "source": "_raw"
        },
        "description": "Extract CEF extension key suser"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\bloginID=(?<loginID>.*?)(?=\\s+\\S+=|$)/",
          "source": "_raw"
        },
        "description": "Extract CEF extension key loginID"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\bact=(?<act>.*?)(?=\\s+\\S+=|$)/",
          "source": "_raw"
        },
        "description": "Extract CEF extension key act"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\bcn1=(?<cn1>.*?)(?=\\s+\\S+=|$)/",
          "source": "_raw"
        },
        "description": "Extract CEF extension key cn1"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\bapp=(?<app>.*?)(?=\\s+\\S+=|$)/",
          "source": "_raw"
        },
        "description": "Extract CEF extension key app"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\bcs2=(?<cs2>.*?)(?=\\s+\\S+=|$)/",
          "source": "_raw"
        },
        "description": "Extract CEF extension key cs2"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\breason=(?<reason>.*?)(?=\\s+\\S+=|$)/",
          "source": "_raw"
        },
        "description": "Extract CEF extension key reason"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\bcs1=(?<cs1>.*?)(?=\\s+\\S+=|$)/",
          "source": "_raw"
        },
        "description": "Extract CEF extension key cs1"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\bin=(?<in_bytes>.*?)(?=\\s+\\S+=|$)/",
          "source": "_raw"
        },
        "description": "Extract CEF extension key in"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\bout=(?<out_bytes>.*?)(?=\\s+\\S+=|$)/",
          "source": "_raw"
        },
        "description": "Extract CEF extension key out"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\brt=(?<rt>.*?)(?=\\s+\\S+=|$)/",
          "source": "_raw"
        },
        "description": "Extract CEF extension key rt"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/LDAP:\\/\\/\\S+ CN\\\\=[^,]+,DC\\\\=(?<suser_dc1>[^,\\/]+)(?:,DC\\\\=(?<suser_dc2>[^,\\/]+))?\\/(?<suser_account>[^\\/]+)$/",
          "source": "suser"
        },
        "description": "Unescape/split the LDAP suser path per the vendor's documented example (LDAP://host CN=Users,DC=x,DC=y/account)"
      },
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "event.outcome is always success per recommendations.direct.cribl - a block is a successful policy enforcement, never a failure. Derive user.name/user.domain from the LDAP split, rule.name from the ** policy split, event.code/category raw only (no lookup file - out of scope, Pipelines only guardrail). Time: rt is epoch seconds on 8.5 and epoch ms from 8.5.3+, branch on productVersion (CEF header Device Version)."
        },
        "description": "explain eval block"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'event.outcome'",
              "value": "__e['act'] ? 'success' : undefined"
            },
            {
              "name": "'user.name'",
              "value": "__e['suser_account']"
            },
            {
              "name": "'user.domain'",
              "value": "__e['suser_dc2'] ? (__e['suser_dc1'] + '.' + __e['suser_dc2']) : __e['suser_dc1']"
            },
            {
              "name": "'rule.name'",
              "value": "__e['cs1'] ? __e['cs1'].split('**') : undefined"
            },
            {
              "name": "_time",
              "value": "(__e['productVersion']==='8.5.3'||__e['productVersion']==='8.5.4'||__e['productVersion']==='8.5.5') ? (+__e['rt'])/1000 : +__e['rt']"
            },
            {
              "name": "'event.dataset'",
              "value": "'forcepoint_web.web_transaction'"
            }
          ],
          "remove": [
            "suser",
            "suser_dc1",
            "suser_dc2",
            "suser_account",
            "cs1",
            "productVersion",
            "cef_version",
            "deviceVendor",
            "deviceProduct",
            "cef_name",
            "rt"
          ]
        },
        "description": "Compute outcome, user.name/domain, rule.name array, _time (version-branched), event.dataset; drop working fields"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "src",
              "newName": "'source.ip'"
            },
            {
              "currentName": "spt",
              "newName": "'source.port'"
            },
            {
              "currentName": "dst",
              "newName": "'destination.ip'"
            },
            {
              "currentName": "dpt",
              "newName": "'destination.port'"
            },
            {
              "currentName": "dhost",
              "newName": "'url.domain'"
            },
            {
              "currentName": "request",
              "newName": "'url.original'"
            },
            {
              "currentName": "requestMethod",
              "newName": "'http.request.method'"
            },
            {
              "currentName": "requestClientApplication",
              "newName": "'user_agent.original'"
            },
            {
              "currentName": "loginID",
              "newName": "'user.id'"
            },
            {
              "currentName": "act",
              "newName": "'event.action'"
            },
            {
              "currentName": "cn1",
              "newName": "'event.code'"
            },
            {
              "currentName": "severity",
              "newName": "'event.severity'"
            },
            {
              "currentName": "app",
              "newName": "'network.protocol'"
            },
            {
              "currentName": "categoryNumber",
              "newName": "'forcepoint.web.category_number'"
            },
            {
              "currentName": "cs2",
              "newName": "'forcepoint.web.dynamic_category'"
            },
            {
              "currentName": "reason",
              "newName": "'forcepoint.web.scan_reason'"
            },
            {
              "currentName": "in_bytes",
              "newName": "'destination.bytes'"
            },
            {
              "currentName": "out_bytes",
              "newName": "'source.bytes'"
            }
          ]
        },
        "description": "Batch rename every status:mapped/unmapped-with-custom-target field to its ECS or custom home"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "remove": [
            "_raw"
          ]
        },
        "description": "Drop _raw per recommendations.direct.cribl - highest-volume, lowest-forensic-value stream"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
