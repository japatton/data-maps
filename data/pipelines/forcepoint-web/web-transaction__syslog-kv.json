{
  "id": "dm_forcepoint_web_web_transaction_syslog_kv",
  "conf": {
    "output": "default",
    "description": "Forcepoint Web Security web-transaction key-value SIEM feed: kvp-deserialize, resolve LDAP userPath, split multi-policy policyNames, map networkDirection, version-branch time to _time, tag event.dataset; disposition/category numeric codes kept raw (lookup files out of scope).",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "Forcepoint Web Security, web-transaction dataset, syslog-kv format. Self-describing key=value string (no CEF slot indirection) parsed with the generic kvp deserializer. Same disposition/category lookup and scheme-reattachment deferrals as the CEF sibling pipeline - see README."
        },
        "description": "identify pipeline and note deviations"
      },
      {
        "id": "eval",
        "filter": "true",
        "description": "Message body: a Cribl Syslog Source leaves the full line, header included, in _raw and the body in message; anything else carries the body in _raw.",
        "conf": {
          "add": [
            {
              "name": "__body",
              "value": "__e['message'] !== undefined ? __e['message'] : __e['_raw']"
            }
          ]
        }
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "kvp",
          "srcField": "__body"
        },
        "description": "Deserialize the self-describing key=value SIEM Integration string"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/LDAP:\\/\\/\\S+ CN\\\\=[^,]+,DC\\\\=(?<userPath_dc1>[^,\\/]+)(?:,DC\\\\=(?<userPath_dc2>[^,\\/]+))?\\/(?<userPath_account>[^\\/]+)$/",
          "source": "userPath"
        },
        "description": "Unescape/split the LDAP userPath per the vendor's documented example"
      },
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "event.outcome always success (block = successful enforcement). user.name/domain from LDAP split; rule.name from ** policy split; network.direction from 0/1; _time version-branched on productVersion (epoch seconds on 8.5, ms from 8.5.3+); event.code/category codes kept raw, no lookup file in scope."
        },
        "description": "explain eval block"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'event.outcome'",
              "value": "__e['dispositionString'] ? 'success' : undefined"
            },
            {
              "name": "'user.name'",
              "value": "__e['userPath_account']"
            },
            {
              "name": "'user.domain'",
              "value": "__e['userPath_dc2'] ? (__e['userPath_dc1'] + '.' + __e['userPath_dc2']) : __e['userPath_dc1']"
            },
            {
              "name": "'rule.name'",
              "value": "__e['policyNames'] ? __e['policyNames'].split('**') : undefined"
            },
            {
              "name": "'network.direction'",
              "value": "__e['networkDirection']==='1' ? 'outbound' : (__e['networkDirection']==='0' ? 'inbound' : undefined)"
            },
            {
              "name": "_time",
              "value": "(__e['productVersion']==='8.5.3'||__e['productVersion']==='8.5.4'||__e['productVersion']==='8.5.5') ? (+__e['time'])/1000 : +__e['time']"
            },
            {
              "name": "'event.dataset'",
              "value": "'forcepoint_web.web_transaction'"
            }
          ],
          "remove": [
            "userPath",
            "userPath_dc1",
            "userPath_dc2",
            "userPath_account",
            "policyNames",
            "networkDirection",
            "time",
            "vendor",
            "product"
          ]
        },
        "description": "Compute outcome, user.name/domain, rule.name array, network.direction, _time, event.dataset; drop working/constant fields"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "source",
              "newName": "'source.ip'"
            },
            {
              "currentName": "clientSourcePort",
              "newName": "'source.port'"
            },
            {
              "currentName": "destination",
              "newName": "'destination.ip'"
            },
            {
              "currentName": "port",
              "newName": "'destination.port'"
            },
            {
              "currentName": "urlHost",
              "newName": "'url.domain'"
            },
            {
              "currentName": "url",
              "newName": "'url.original'"
            },
            {
              "currentName": "method",
              "newName": "'http.request.method'"
            },
            {
              "currentName": "protocolVersion",
              "newName": "'http.version'"
            },
            {
              "currentName": "userAgent",
              "newName": "'user_agent.original'"
            },
            {
              "currentName": "loginID",
              "newName": "'user.id'"
            },
            {
              "currentName": "dispositionString",
              "newName": "'event.action'"
            },
            {
              "currentName": "dispositionNumber",
              "newName": "'event.code'"
            },
            {
              "currentName": "severity",
              "newName": "'event.severity'"
            },
            {
              "currentName": "protocol",
              "newName": "'network.protocol'"
            },
            {
              "currentName": "proxyStatusCode",
              "newName": "'http.response.status_code'"
            },
            {
              "currentName": "serverStatusCode",
              "newName": "'forcepoint.web.server_status_code'"
            },
            {
              "currentName": "contentType",
              "newName": "'http.request.mime_type'"
            },
            {
              "currentName": "refererUrl",
              "newName": "'http.request.referrer'"
            },
            {
              "currentName": "fileName",
              "newName": "'file.name'"
            },
            {
              "currentName": "fileTypeCode",
              "newName": "'forcepoint.web.file_type_code'"
            },
            {
              "currentName": "categoryNumber",
              "newName": "'forcepoint.web.category_number'"
            },
            {
              "currentName": "categoryReasonCode",
              "newName": "'forcepoint.web.category_reason_code'"
            },
            {
              "currentName": "dynamicCategory",
              "newName": "'forcepoint.web.dynamic_category'"
            },
            {
              "currentName": "scanReasonString",
              "newName": "'forcepoint.web.scan_reason'"
            },
            {
              "currentName": "keyword",
              "newName": "'forcepoint.web.keyword'"
            },
            {
              "currentName": "cloudAppName",
              "newName": "'forcepoint.web.cloud_app_name'"
            },
            {
              "currentName": "proxySourceAddress",
              "newName": "'forcepoint.web.proxy_source_address'"
            },
            {
              "currentName": "logRecordSource",
              "newName": "'forcepoint.web.log_record_source'"
            },
            {
              "currentName": "bytesReceived",
              "newName": "'destination.bytes'"
            },
            {
              "currentName": "bytesSent",
              "newName": "'source.bytes'"
            },
            {
              "currentName": "productVersion",
              "newName": "'observer.version'"
            }
          ]
        },
        "description": "Batch rename every status:mapped/unmapped-with-custom-target field to its ECS or custom home"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "remove": [
            "_raw"
          ]
        },
        "description": "Drop _raw per recommendations.direct.cribl - highest-volume, lowest-forensic-value stream"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
