{
  "id": "dm_forcepoint_web_web_transaction_csv_file",
  "conf": {
    "output": "default",
    "description": "Forcepoint Content Gateway squid.log (10 fixed positional space-delimited fields): split fields, derive _time and event.duration, split packed cache-result/HTTP-status and treat '-' username as null; Squid URL unescaping and hierarchy/server split deferred as documented gaps.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "Forcepoint Web Security, web-transaction dataset, csv-file (Content Gateway squid.log) format. Fixed space-delimited positional line, 10 fields, standard Squid layout. Canonical scheme-included URL, no policy/category/disposition columns on this feed. Squid URL unescaping and Hierarchy/Server splitting are deferred (see README); full url.original retained per recommendations.direct.cribl."
        },
        "description": "identify pipeline and note deferred normalizations"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/^(?<sq_timestamp>\\S+)\\s+(?<sq_elapsed>\\S+)\\s+(?<sq_client_ip>\\S+)\\s+(?<sq_cache_http>\\S+)\\s+(?<sq_response_size>\\S+)\\s+(?<sq_method>\\S+)\\s+(?<sq_url>\\S+)\\s+(?<sq_username>\\S+)\\s+(?<sq_hierarchy>\\S+)\\s+(?<sq_content_type>\\S+)/",
          "source": "_raw"
        },
        "description": "Split the 10 fixed positional Squid fields"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "_time",
              "value": "+__e['sq_timestamp']"
            },
            {
              "name": "event.duration",
              "value": "+__e['sq_elapsed'] * 1000000"
            },
            {
              "name": "http.response.status_code",
              "value": "__e['sq_cache_http'] ? +(__e['sq_cache_http'].split('/')[1]) : undefined"
            },
            {
              "name": "forcepoint.web.cache_result_code",
              "value": "__e['sq_cache_http'] ? __e['sq_cache_http'].split('/')[0] : undefined"
            },
            {
              "name": "http.response.bytes",
              "value": "+__e['sq_response_size']"
            },
            {
              "name": "user.name",
              "value": "__e['sq_username']==='-' ? undefined : __e['sq_username']"
            },
            {
              "name": "event.dataset",
              "value": "'forcepoint_web.web_transaction'"
            }
          ],
          "remove": [
            "sq_timestamp",
            "sq_elapsed",
            "sq_cache_http",
            "sq_response_size",
            "sq_username"
          ]
        },
        "description": "Derive _time, event.duration (ns), split packed cache/HTTP-status field, treat literal '-' username as null, tag event.dataset"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "sq_client_ip",
              "newName": "source.ip"
            },
            {
              "currentName": "sq_method",
              "newName": "http.request.method"
            },
            {
              "currentName": "sq_url",
              "newName": "url.original"
            },
            {
              "currentName": "sq_hierarchy",
              "newName": "forcepoint.web.proxy_hierarchy"
            },
            {
              "currentName": "sq_content_type",
              "newName": "http.response.mime_type"
            }
          ]
        },
        "description": "Batch rename remaining mapped/custom fields"
      }
    ]
  }
}