{
  "id": "dm_tanium_discover_syslog_leef",
  "conf": {
    "output": "default",
    "description": "Tanium discover, LEEF: split header + KVP the attribute body into tanium_fields, map asset columns to host.*, tag event.dataset.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "Tanium discover / syslog-leef: Connect emits a LEEF header followed by tab-delimited key=value attributes. Split the header with regex_extract, then serde-KVP into tanium_fields, map HostName/IpAddress/MacAddress/Managed/Ports (the columns named in the format's enable text) to host.hostname/host.ip/host.mac and custom booleans/array, set _time from UpdatedAt (named only in recommendation prose) with a fallback, tag event.dataset. Per-run dedupe on row id + UpdatedAt is recommended but NOT implemented: no confidently-attested 'row id' column name exists in this work order, and guessing one risks a silently-wrong distinct group. Direct route, no guard hop."
        },
        "description": "technology/dataset/format and parsing approach"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/^LEEF:(?<leef_version>[^|]*)\\|(?<leef_vendor>[^|]*)\\|(?<leef_product>[^|]*)\\|(?<leef_product_version>[^|]*)\\|(?<leef_event_id>[^|]*)\\|(?<leef_attrs>.*)$/",
          "source": "_raw"
        },
        "description": "split the LEEF header (LEEF:ver|Tanium|product|ver|event id|) from the tab-delimited attribute body"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "kvp",
          "srcField": "leef_attrs",
          "dstField": "tanium_fields"
        },
        "description": "extract the tab/space-delimited key=value attributes into a nested tanium_fields object"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "host.hostname",
              "value": "__e['tanium_fields'] && __e['tanium_fields']['HostName'] !== undefined ? __e['tanium_fields']['HostName'] : undefined"
            },
            {
              "name": "host.ip",
              "value": "__e['tanium_fields'] && __e['tanium_fields']['IpAddress'] !== undefined ? __e['tanium_fields']['IpAddress'] : undefined"
            },
            {
              "name": "host.mac",
              "value": "__e['tanium_fields'] && __e['tanium_fields']['MacAddress'] !== undefined ? __e['tanium_fields']['MacAddress'] : undefined"
            },
            {
              "name": "tanium.discover.managed",
              "value": "__e['tanium_fields'] && (__e['tanium_fields']['Managed'] === '1' || __e['tanium_fields']['Managed'] === 'true') ? true : (__e['tanium_fields'] && (__e['tanium_fields']['Managed'] === '0' || __e['tanium_fields']['Managed'] === 'false') ? false : undefined)"
            },
            {
              "name": "tanium.discover.ports",
              "value": "__e['tanium_fields'] && __e['tanium_fields']['Ports'] !== undefined ? __e['tanium_fields']['Ports'].split(',') : undefined"
            },
            {
              "name": "_time",
              "value": "__e['tanium_fields'] && __e['tanium_fields']['UpdatedAt'] !== undefined ? Date.parse(__e['tanium_fields']['UpdatedAt'])/1000 : __e['_time']"
            },
            {
              "name": "event.dataset",
              "value": "'tanium.discover'"
            }
          ]
        },
        "description": "map HostName/IpAddress/MacAddress/Managed/Ports, set _time, tag event.dataset"
      }
    ]
  }
}