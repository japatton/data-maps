{
  "id": "dm_tenable_nessus_scan_result_api_pull",
  "conf": {
    "output": "default",
    "description": "Tenable Security Center scanResult REST pull: per-scan-run coverage records. No Elastic tenable_sc data stream exists for this, so this is a hand-built JSON parse and ECS map, landing a custom logs-tenable_sc.scan_result shape. Direct route, no guard hop.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "tenable-nessus / scan-result / api-pull. GET /rest/scanResult JSON, hand-mapped since the Elastic tenable_sc integration ships no scan-result data stream."
        },
        "description": "record why a custom pipeline is needed"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        }
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "id",
              "newName": "'event.id'"
            },
            {
              "currentName": "initiator.username",
              "newName": "'user.name'"
            },
            {
              "currentName": "errorDetails",
              "newName": "'error.message'"
            },
            {
              "currentName": "name",
              "newName": "'tenable_sc.scan_result.name'"
            },
            {
              "currentName": "owner.username",
              "newName": "'tenable_sc.scan_result.owner'"
            },
            {
              "currentName": "totalIPs",
              "newName": "'tenable_sc.scan_result.total_ips'"
            },
            {
              "currentName": "scannedIPs",
              "newName": "'tenable_sc.scan_result.scanned_ips'"
            },
            {
              "currentName": "repository.name",
              "newName": "'tenable_sc.scan_result.repository_name'"
            },
            {
              "currentName": "importStatus",
              "newName": "'tenable_sc.scan_result.import_status'"
            }
          ]
        }
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'event.start'",
              "value": "(__e['startTime'] !== undefined && __e['startTime'] !== '') ? Number(__e['startTime']) : undefined"
            },
            {
              "name": "'event.end'",
              "value": "(__e['finishTime'] !== undefined && __e['finishTime'] !== '') ? Number(__e['finishTime']) : undefined"
            },
            {
              "name": "__dm_time",
              "value": "(__e['finishTime'] !== undefined && __e['finishTime'] !== '') ? Number(__e['finishTime']) : Date.now()/1000"
            },
            {
              "name": "_time",
              "value": "__e['__dm_time'] !== undefined && __e['__dm_time'] !== null && __e['__dm_time'] === __e['__dm_time'] ? __e['__dm_time'] : __e['_time']"
            },
            {
              "name": "'event.duration'",
              "value": "__e['scanDuration'] !== undefined ? Number(__e['scanDuration']) * 1e9 : undefined"
            },
            {
              "name": "'event.outcome'",
              "value": "__e['status']==='Completed' ? 'success' : (__e['status']==='Error' ? 'failure' : (['Running','Partial','Paused'].indexOf(__e['status']) > -1 ? 'unknown' : undefined))"
            },
            {
              "name": "'event.dataset'",
              "value": "'tenable_nessus.scan_result'"
            }
          ],
          "remove": [
            "startTime",
            "finishTime",
            "scanDuration",
            "status"
          ]
        },
        "description": "epoch seconds -> event.start/end/_time, scanDuration seconds -> event.duration nanoseconds, 5-value status collapsed to event.outcome with Partial landing on unknown per the work order's explicit instruction"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
