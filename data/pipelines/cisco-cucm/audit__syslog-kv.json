{
  "id": "dm_cisco_cucm_audit_syslog_kv",
  "conf": {
    "output": "default",
    "description": "Cisco CUCM AuditApp log (dataset=audit, format=syslog-kv): parse the CiscoLog %UC_AUDITLOG tag and bracketed key=value payload with per-key tolerant regex extraction, fold EventStatus into event.outcome, cap AuditDetails length, map to ECS + cisco.cucm.audit.* custom fields.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "CUCM AuditApp log (dataset=audit, format=syslog-kv). No Elastic integration/Cribl pack for %UC_AUDITLOG. CiscoLog tag + bracketed key=value payload with inconsistent key spacing (' UserID =x' vs 'ResourceAccessed=y', spaced 'App ID'/'Cluster ID'/'Node ID'). Each field pulled independently with a tolerant regex rather than a stock kv parser."
        }
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/(?<audit_tag>%UC_AUDITLOG-\\d+-[A-Za-z0-9_]+)/",
          "source": "_raw"
        },
        "description": "Extract the CiscoLog message tag, e.g. %UC_AUDITLOG-5-AdministrativeEvent"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*UserID\\s*=\\s*(?<UserID>[^\\]]*)\\]/",
          "source": "_raw"
        },
        "description": "Extract UserID, tolerant of the leading/trailing whitespace CUCM emits around the '=' on this key"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*ClientAddress\\s*=\\s*(?<ClientAddress>[^\\]]*)\\]/",
          "source": "_raw"
        },
        "description": "Extract ClientAddress"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*Severity\\s*=\\s*(?<Severity>[^\\]]*)\\]/",
          "source": "_raw"
        },
        "description": "Extract Severity"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*EventType\\s*=\\s*(?<EventType>[^\\]]*)\\]/",
          "source": "_raw"
        },
        "description": "Extract EventType"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*EventStatus\\s*=\\s*(?<EventStatus>[^\\]]*)\\]/",
          "source": "_raw"
        },
        "description": "Extract EventStatus"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*ResourceAccessed\\s*=\\s*(?<ResourceAccessed>[^\\]]*)\\]/",
          "source": "_raw"
        },
        "description": "Extract ResourceAccessed"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*AuditCategory\\s*=\\s*(?<AuditCategory>[^\\]]*)\\]/",
          "source": "_raw"
        },
        "description": "Extract AuditCategory"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*CompulsoryEvent\\s*=\\s*(?<CompulsoryEvent>[^\\]]*)\\]/",
          "source": "_raw"
        },
        "description": "Extract CompulsoryEvent (Yes/No string)"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*ComponentID\\s*=\\s*(?<ComponentID>[^\\]]*)\\]/",
          "source": "_raw"
        },
        "description": "Extract ComponentID"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*AuditDetails\\s*=\\s*(?<AuditDetails>[^\\]]*)\\]/",
          "source": "_raw"
        },
        "description": "Extract AuditDetails free-text change description"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*App\\s*ID\\s*=\\s*(?<AppID>[^\\]]*)\\]/i",
          "source": "_raw"
        },
        "description": "Extract the App ID key, accepting both the compact and spaced spelling"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*Cluster\\s*ID\\s*=\\s*(?<ClusterID>[^\\]]*)\\]/i",
          "source": "_raw"
        },
        "description": "Extract the Cluster ID key, accepting both the compact and spaced spelling"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*Node\\s*ID\\s*=\\s*(?<NodeID>[^\\]]*)\\]/i",
          "source": "_raw"
        },
        "description": "Extract the Node ID key, accepting both the compact and spaced spelling"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "audit_tag",
              "newName": "'event.code'"
            },
            {
              "currentName": "UserID",
              "newName": "'user.name'"
            },
            {
              "currentName": "ClientAddress",
              "newName": "'source.ip'"
            },
            {
              "currentName": "Severity",
              "newName": "'event.severity'"
            },
            {
              "currentName": "EventType",
              "newName": "'event.action'"
            },
            {
              "currentName": "ComponentID",
              "newName": "'service.name'"
            },
            {
              "currentName": "NodeID",
              "newName": "'observer.hostname'"
            }
          ]
        },
        "description": "Straight-copy the mapped ECS fields that need no value transform"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'event.outcome'",
              "value": "(__e['EventStatus']||'').toLowerCase()=='success'?'success':(__e['EventStatus']||'').toLowerCase()=='failure'?'failure':'unknown'"
            },
            {
              "name": "message",
              "value": "__e['AuditDetails'] && __e['AuditDetails'].length>2048 ? __e['AuditDetails'].substring(0,2048)+'...TRUNCATED' : __e['AuditDetails']"
            },
            {
              "name": "'cisco.cucm.audit.resource_accessed'",
              "value": "__e['ResourceAccessed']"
            },
            {
              "name": "'cisco.cucm.audit.category'",
              "value": "__e['AuditCategory']"
            },
            {
              "name": "'cisco.cucm.audit.compulsory_event'",
              "value": "__e['CompulsoryEvent']=='Yes'?true:__e['CompulsoryEvent']=='No'?false:null"
            },
            {
              "name": "'cisco.cucm.audit.app_id'",
              "value": "__e['AppID']"
            },
            {
              "name": "'cisco.cucm.cluster_id'",
              "value": "(__e['ClusterID'] && __e['ClusterID']!=='') ? __e['ClusterID'] : null"
            },
            {
              "name": "'event.dataset'",
              "value": "'cisco_cucm.audit'"
            }
          ],
          "remove": [
            "EventStatus",
            "AuditDetails",
            "ResourceAccessed",
            "AuditCategory",
            "CompulsoryEvent",
            "AppID",
            "ClusterID"
          ]
        },
        "description": "Fold EventStatus into event.outcome, cap AuditDetails length into message, map unmapped columns to cisco.cucm.audit.* custom fields, set event.dataset"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
