{
  "id": "dm_cisco_cucm_app_alarms_syslog_kv",
  "conf": {
    "output": "default",
    "description": "Cisco CUCM CallManager application alarms (dataset=app-alarms, format=syslog-kv): strip the RFC3164 envelope, parse the CiscoLog header and bracketed payload with per-key tolerant regex, resolve Reason against the mnemonic-selected Q.850-style cause-code space, reformat MACAddress, map to ECS + cisco.cucm.app_alarms.* custom fields.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "CUCM CallManager application alarms (dataset=app-alarms, format=syslog-kv). No Elastic integration/Cribl pack for %UC_CALLMANAGER. Two stacked envelopes: RFC3164 header (discarded, no year) then CiscoLog '<SEQNUM>: <HOST>: <TIMESTAMP>: %APPNAME-SEV-MSG:' (authoritative per work order) in front of a bracketed payload with release-dependent key spelling and UNKNOWN_PARAMNAME: prefixes."
        }
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/(?<SEQNUM>\\d+):\\s*(?<HOST>\\S+):\\s*(?<CISCO_TS>.*?):\\s*%UC_CALLMANAGER-(?<SEVERITY>\\d+)-(?<MSGNAME>[A-Za-z0-9_]+):/",
          "source": "_raw"
        },
        "description": "Extract the CiscoLog header (SEQNUM, HOST, timestamp, severity, mnemonic); the leading RFC3164 header is ignored since it carries no year"
      },
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "Payload key normalization: every bracket pattern below tolerates the compact/spaced key spelling, IPv6Address/IPV6Address casing, and an optional UNKNOWN_PARAMNAME: prefix, rather than dead-lettering malformed keys."
        }
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*(?:UNKNOWN_PARAMNAME:\\s*)?Connecting\\s*Port\\s*=\\s*(?<ConnectingPort>[^\\]]*)\\]/i",
          "source": "_raw"
        },
        "description": "Extract ConnectingPort / Connecting Port"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*(?:UNKNOWN_PARAMNAME:\\s*)?Device\\s*Name\\s*=\\s*(?<DeviceName>[^\\]]*)\\]/i",
          "source": "_raw"
        },
        "description": "Extract DeviceName / Device name (may be empty on rogue/unnamed connections - that is signal, not a parse gap)"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*(?:UNKNOWN_PARAMNAME:\\s*)?MACAddress\\s*=\\s*(?<MACAddress>[^\\]]*)\\]/i",
          "source": "_raw"
        },
        "description": "Extract MACAddress (bare hex)"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*(?:UNKNOWN_PARAMNAME:\\s*)?IP\\s*Address\\s*=\\s*(?<IPAddress>[^\\]]*)\\]/i",
          "source": "_raw"
        },
        "description": "Extract IPAddress"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*(?:UNKNOWN_PARAMNAME:\\s*)?IPv6Address\\s*=\\s*(?<IPv6Address>[^\\]]*)\\]/i",
          "source": "_raw"
        },
        "description": "Extract IPv6Address / IPV6Address"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*(?:UNKNOWN_PARAMNAME:\\s*)?IPAddrAttributes\\s*=\\s*(?<IPAddrAttributes>[^\\]]*)\\]/i",
          "source": "_raw"
        },
        "description": "Extract the undocumented IPAddrAttributes bitfield as-is"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*(?:UNKNOWN_PARAMNAME:\\s*)?Protocol\\s*=\\s*(?<Protocol>[^\\]]*)\\]/i",
          "source": "_raw"
        },
        "description": "Extract Protocol (SIP/SCCP)"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*(?:UNKNOWN_PARAMNAME:\\s*)?Device\\s*Type\\s*=\\s*(?<DeviceType>[^\\]]*)\\]/i",
          "source": "_raw"
        },
        "description": "Extract DeviceType model code"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*(?:UNKNOWN_PARAMNAME:\\s*)?Description\\s*=\\s*(?<Description>[^\\]]*)\\]/i",
          "source": "_raw"
        },
        "description": "Extract the administrator-set Description free text"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*(?:UNKNOWN_PARAMNAME:\\s*)?Reason(?:\\s*Code)?\\s*=\\s*(?<Reason>[^\\]]*)\\]/i",
          "source": "_raw"
        },
        "description": "Extract Reason / Reason Code"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*(?:UNKNOWN_PARAMNAME:\\s*)?Registering\\s*SIP\\s*User\\s*=\\s*(?<RegisteringSIPUser>[^\\]]*)\\]/i",
          "source": "_raw"
        },
        "description": "Extract Registering SIP User (failure-side identity)"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*(?:UNKNOWN_PARAMNAME:\\s*)?User\\s*ID\\s*=\\s*(?<UserID_alarm>[^\\]]*)\\]/i",
          "source": "_raw"
        },
        "description": "Extract User ID (success-side identity)"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*(?:UNKNOWN_PARAMNAME:\\s*)?PerfMonObjType\\s*=\\s*(?<PerfMonObjType>[^\\]]*)\\]/i",
          "source": "_raw"
        },
        "description": "Extract PerfMonObjType"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*(?:UNKNOWN_PARAMNAME:\\s*)?LoadID\\s*=\\s*(?<LoadID>[^\\]]*)\\]/i",
          "source": "_raw"
        },
        "description": "Extract LoadID firmware string"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*(?:UNKNOWN_PARAMNAME:\\s*)?ActiveLoadId\\s*=\\s*(?<ActiveLoadId>[^\\]]*)\\]/i",
          "source": "_raw"
        },
        "description": "Extract ActiveLoadId firmware string"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*(?:UNKNOWN_PARAMNAME:\\s*)?AssociatedDNs\\s*=\\s*(?<AssociatedDNs>[^\\]]*)\\]/i",
          "source": "_raw"
        },
        "description": "Extract AssociatedDNs comma-separated directory numbers"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*(?:UNKNOWN_PARAMNAME:\\s*)?LastSignalReceived\\s*=\\s*(?<LastSignalReceived>[^\\]]*)\\]/i",
          "source": "_raw"
        },
        "description": "Extract LastSignalReceived, stripping a leading UNKNOWN_PARAMNAME: prefix where present"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*(?:UNKNOWN_PARAMNAME:\\s*)?StationState\\s*=\\s*(?<StationState>[^\\]]*)\\]/i",
          "source": "_raw"
        },
        "description": "Extract StationState"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*(?:UNKNOWN_PARAMNAME:\\s*)?CallState\\s*=\\s*(?<CallState>[^\\]]*)\\]/i",
          "source": "_raw"
        },
        "description": "Extract CallState"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*(?:UNKNOWN_PARAMNAME:\\s*)?App\\s*ID\\s*=\\s*(?<AppID>[^\\]]*)\\]/i",
          "source": "_raw"
        },
        "description": "Extract AppID (compact spelling on this feed, spaced tolerated)"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*(?:UNKNOWN_PARAMNAME:\\s*)?Cluster\\s*ID\\s*=\\s*(?<ClusterID>[^\\]]*)\\]/i",
          "source": "_raw"
        },
        "description": "Extract ClusterID (compact spelling on this feed, spaced tolerated)"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\[\\s*(?:UNKNOWN_PARAMNAME:\\s*)?Node\\s*ID\\s*=\\s*(?<NodeID>[^\\]]*)\\]/i",
          "source": "_raw"
        },
        "description": "Extract NodeID"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\]:\\s*(?<MESSAGE>.+)$/",
          "source": "_raw"
        },
        "description": "Extract the trailing boilerplate prose after the last bracket, e.g. 'An endpoint has unregistered.'"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "HOST",
              "newName": "host.name"
            },
            {
              "currentName": "SEVERITY",
              "newName": "event.severity"
            },
            {
              "currentName": "MSGNAME",
              "newName": "event.action"
            },
            {
              "currentName": "DeviceType",
              "newName": "device.model.identifier"
            },
            {
              "currentName": "AppID",
              "newName": "service.name"
            },
            {
              "currentName": "NodeID",
              "newName": "observer.hostname"
            },
            {
              "currentName": "MESSAGE",
              "newName": "message"
            },
            {
              "currentName": "ConnectingPort",
              "newName": "source.port"
            },
            {
              "currentName": "SEQNUM",
              "newName": "event.sequence"
            },
            {
              "currentName": "DeviceName",
              "newName": "device.id"
            },
            {
              "currentName": "Protocol",
              "newName": "network.protocol"
            }
          ]
        },
        "description": "Straight-copy the mapped ECS fields that need no value transform"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "event.code",
              "value": "'%UC_CALLMANAGER-'+event.severity+'-'+event.action"
            },
            {
              "name": "_time",
              "value": "(__e['CISCO_TS'] && !isNaN(Date.parse(__e['CISCO_TS']))) ? Date.parse(__e['CISCO_TS'])/1000 : _time"
            },
            {
              "name": "source.ip",
              "value": "(__e['IPv6Address'] && __e['IPv6Address']!=='') ? __e['IPv6Address'] : __e['IPAddress']"
            },
            {
              "name": "user.name",
              "value": "(__e['RegisteringSIPUser'] && __e['RegisteringSIPUser']!=='') ? __e['RegisteringSIPUser'] : __e['UserID_alarm']"
            },
            {
              "name": "source.mac",
              "value": "(__e['MACAddress'] && __e['MACAddress'].length==12) ? (__e['MACAddress'].substring(0,2)+':'+__e['MACAddress'].substring(2,4)+':'+__e['MACAddress'].substring(4,6)+':'+__e['MACAddress'].substring(6,8)+':'+__e['MACAddress'].substring(8,10)+':'+__e['MACAddress'].substring(10,12)).toUpperCase() : __e['MACAddress']"
            },
            {
              "name": "event.reason",
              "value": "(event.action && event.action.indexOf('TransientConnection')>-1) ? (__e['Reason']=='10'?'authenticationError':__e['Reason']=='11'?'invalidX509NameInCertificate':__e['Reason']=='12'?'invalidTLSCipher':__e['Reason']=='17'?'authenticatedDeviceAlreadyExists':__e['Reason']=='28'?'securityMismatch':('reg-fail cause '+__e['Reason']+' (unmapped)')) : (event.action && event.action.indexOf('Unregistered')>-1) ? (__e['Reason']=='10'?'deviceUnregistered':__e['Reason']=='11'?'malformedRegisterMsg':__e['Reason']=='28'?'fallbackInitiated':('unreg cause '+__e['Reason']+' (unmapped)')) : ('cause '+__e['Reason']+' (cause-code space unknown for this mnemonic)')"
            },
            {
              "name": "cisco.cucm.app_alarms.ip_addr_attributes",
              "value": "__e['IPAddrAttributes']"
            },
            {
              "name": "cisco.cucm.app_alarms.device_description",
              "value": "__e['Description'] && __e['Description'].length>256 ? __e['Description'].substring(0,256)+'...TRUNCATED' : __e['Description']"
            },
            {
              "name": "cisco.cucm.app_alarms.perfmon_obj_type",
              "value": "__e['PerfMonObjType']"
            },
            {
              "name": "cisco.cucm.app_alarms.load_id",
              "value": "__e['LoadID']"
            },
            {
              "name": "cisco.cucm.app_alarms.active_load_id",
              "value": "__e['ActiveLoadId']"
            },
            {
              "name": "cisco.cucm.app_alarms.associated_dns",
              "value": "__e['AssociatedDNs'] ? __e['AssociatedDNs'].replace(/,$/,'').split(',') : []"
            },
            {
              "name": "cisco.cucm.app_alarms.last_signal_received",
              "value": "__e['LastSignalReceived']"
            },
            {
              "name": "cisco.cucm.app_alarms.station_state",
              "value": "__e['StationState']"
            },
            {
              "name": "cisco.cucm.app_alarms.call_state",
              "value": "__e['CallState']"
            },
            {
              "name": "cisco.cucm.cluster_id",
              "value": "(__e['ClusterID'] && __e['ClusterID']!=='') ? __e['ClusterID'] : null"
            },
            {
              "name": "event.dataset",
              "value": "'cisco_cucm.app_alarms'"
            }
          ],
          "remove": [
            "CISCO_TS",
            "IPAddress",
            "IPv6Address",
            "IPAddrAttributes",
            "Description",
            "Reason",
            "RegisteringSIPUser",
            "UserID_alarm",
            "PerfMonObjType",
            "LoadID",
            "ActiveLoadId",
            "AssociatedDNs",
            "LastSignalReceived",
            "StationState",
            "CallState",
            "ClusterID",
            "MACAddress"
          ]
        },
        "description": "Build event.code from severity+mnemonic, set _time from the CiscoLog timestamp, resolve Reason against the mnemonic-selected cause-code space, reformat MACAddress, split AssociatedDNs, map cisco.cucm.app_alarms.* customs, set event.dataset"
      }
    ]
  }
}
