{
  "id": "dm_f5_bigip_ltm_request_log_syslog_kv",
  "conf": {
    "output": "default",
    "description": "F5 BIG-IP LTM HSL request logging (syslog-kv, canonical Telemetry Streaming request/response template), direct route: kvp extract into ECS + f5_bigip.ltm.* customs, SNAT-disabled fallback, virtual_name tenant/application split, ms->ns duration, keep _raw. No usable Elastic integration exists for this feed.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "F5 BIG-IP LTM HSL request logging, syslog-kv, direct route. No usable Elastic integration exists (f5_bigip only ingests Telemetry Streaming JSON), so this pipeline is the only parser. event_timestamp is assumed to be the $DATE_HTTP token per the work order's default template; a site standardised on $TIME_UNIX instead would still parse via auto_timestamp's own format detection, but that is unverified against a live sample. snat_ip/snat_port are only promoted to source.nat.* when they differ from the client address, since F5 returns the client IP itself when SNAT is disabled. response_ms->event.duration assumes the ms token; a site using $RESPONSE_USECS instead is not covered (no such field row exists in this inventory)."
        },
        "description": "Pipeline purpose, timestamp-token assumption, and the SNAT/duration caveats"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "kvp",
          "srcField": "_raw"
        },
        "description": "Extract the quoted key=value HSL template directly from _raw (delimiter handling unverified against a live sample - see README gap)"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "source.nat.ip",
              "value": "__e['snat_ip'] && __e['snat_ip'] !== __e['client_ip'] ? __e['snat_ip'] : undefined"
            },
            {
              "name": "source.nat.port",
              "value": "__e['snat_port'] && __e['snat_ip'] !== __e['client_ip'] ? __e['snat_port'] : undefined"
            },
            {
              "name": "f5_bigip.ltm.tenant",
              "value": "(__e['virtual_name'] || '').split('/')[1]"
            },
            {
              "name": "f5_bigip.ltm.application",
              "value": "(__e['virtual_name'] || '').split('/')[2]"
            },
            {
              "name": "http.version",
              "value": "(__e['http_version'] || '').replace('HTTP/', '')"
            },
            {
              "name": "url.path",
              "value": "(__e['http_uri'] || '').split('?')[0]"
            },
            {
              "name": "url.query",
              "value": "(__e['http_uri'] || '').indexOf('?') >= 0 ? __e['http_uri'].slice(__e['http_uri'].indexOf('?') + 1) : undefined"
            },
            {
              "name": "event.duration",
              "value": "__e['response_ms'] !== undefined && __e['response_ms'] !== '' ? Number(__e['response_ms']) * 1e6 : undefined"
            }
          ]
        },
        "description": "Suppress the SNAT-disabled false-positive, split virtual_name into tenant/application, strip the HTTP/ version prefix, split http_uri into path/query, and convert response_ms to nanosecond event.duration - all BEFORE rename, reading the flat vendor field names"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "event_source",
              "newName": "event.provider"
            },
            {
              "currentName": "hostname",
              "newName": "observer.hostname"
            },
            {
              "currentName": "client_ip",
              "newName": "source.ip"
            },
            {
              "currentName": "client_port",
              "newName": "source.port"
            },
            {
              "currentName": "virtual_ip",
              "newName": "destination.ip"
            },
            {
              "currentName": "virtual_port",
              "newName": "destination.port"
            },
            {
              "currentName": "virtual_name",
              "newName": "f5_bigip.ltm.virtual_server"
            },
            {
              "currentName": "virtual_pool_name",
              "newName": "f5_bigip.ltm.pool.name"
            },
            {
              "currentName": "server_ip",
              "newName": "f5_bigip.ltm.pool_member.ip"
            },
            {
              "currentName": "server_port",
              "newName": "f5_bigip.ltm.pool_member.port"
            },
            {
              "currentName": "http_method",
              "newName": "http.request.method"
            },
            {
              "currentName": "http_uri",
              "newName": "url.original"
            },
            {
              "currentName": "http_statcode",
              "newName": "http.response.status_code"
            },
            {
              "currentName": "response_size",
              "newName": "http.response.bytes"
            },
            {
              "currentName": "user_agent",
              "newName": "user_agent.original"
            }
          ]
        },
        "description": "Batch rename of every mapped/custom (no-transform) key"
      },
      {
        "id": "auto_timestamp",
        "filter": "true",
        "conf": {
          "srcField": "event_timestamp",
          "dstField": "_time"
        },
        "description": "Set _time from the request/response profile's own timestamp token"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "event.dataset",
              "value": "'f5_bigip_ltm.request_log'"
            }
          ],
          "remove": [
            "snat_ip",
            "snat_port",
            "response_ms",
            "event_timestamp",
            "http_version"
          ]
        },
        "description": "Tag event.dataset (matching this dir's existing request-log__json.json thin pipeline); drop now-consumed parse scratch. _raw is deliberately kept."
      }
    ]
  }
}
