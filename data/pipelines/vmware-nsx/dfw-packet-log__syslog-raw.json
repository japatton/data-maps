{
  "id": "dm_vmware_nsx_dfw_packet_log_syslog_raw",
  "conf": {
    "output": "default",
    "description": "VMware NSX Distributed Firewall dfw-packet-log / syslog-raw: no Elastic integration and no installed Cribl Pack exist, so this hand-built pipeline owns the positional dfwpktlogs grammar natively, branching on the match/TERM token per recommendations.direct.cribl.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "vmware-nsx/dfw-packet-log/syslog-raw. No Cribl Pack is installed here, so the DFW grammar is parsed natively, following the NSX 4.0 Administration Guide's 'Distributed Firewall Packet Logs' layout. Header: optional <pri>, RFC 3164 or RFC 5424, ident dfwpktlogs (ESXi) or FIREWALL-PKTLOG (NSX 4 syslog); a bare log-file line starts at its timestamp. Record: optional 8-hex VIF ID, INET|INET6, then match or TERM. The rule slot is ruleset/rule_id or a bare rule_id; PROTO n records carry no ports; TCP flags are optional and a trailing FQDN, L7 app ID or rule tag is kept as vmware.nsx.dfw.annotation. TERM records carry an action only on NSX 4's feed - never defaulted. Per-vNIC IN/OUT byte/packet split to source/destination stays unresolved (documented gap)."
        },
        "description": "record scope, pack substitution, and the one known gap up front"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "description": "syslog header or log-file timestamp, and the DFW ident when present",
        "conf": {
          "source": "_raw",
          "regex": "/^(?:<\\d{1,3}>)?\\s*(?:1\\s+)?(?<timestamp>\\d{4}-\\d{2}-\\d{2}T\\S+|[A-Z][a-z]{2}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2})\\s+(?:(?<dfw_host>\\S+)\\s+(?<ident>dfwpktlogs|FIREWALL-PKTLOG)\\b)?/"
        }
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "description": "DFW record wherever the framing put it: optional VIF ID, address family, record shape",
        "conf": {
          "source": "_raw",
          "regex": "/(?:^|\\s)(?:(?<vif_id>[0-9a-fA-F]{1,8})\\s+)?(?<inet_type>INET6?)\\s+(?<reason>match|TERM)\\s+(?<tail>.*)$/"
        }
      },
      {
        "id": "drop",
        "filter": "__e['reason'] === undefined",
        "conf": {},
        "description": "not a DFW packet log line"
      },
      {
        "id": "regex_extract",
        "filter": "__e['reason'] == 'match'",
        "description": "per-packet match record",
        "conf": {
          "source": "tail",
          "regex": "/^(?<action>PASS|DROP|REJECT)\\s+(?:(?<ruleset>\\S+)\\/)?(?<rule_id>\\d+)\\s+(?<direction>IN|OUT)\\s+(?<packet_size>\\d+)\\s+(?<protocol>TCP|UDP|ICMP|PROTO \\d+)\\s+(?<src_ip>[0-9a-fA-F.:]+?)(?:\\/(?<src_port>\\d+))?->(?<dst_ip>[0-9a-fA-F.:]+?)(?:\\/(?<dst_port>\\d+))?(?:\\s+(?<tcp_flags>[SAPURFEWC]+))?(?:\\s+(?<annotation>.+))?$/"
        }
      },
      {
        "id": "regex_extract",
        "filter": "__e['reason'] == 'TERM'",
        "description": "connection-close summary",
        "conf": {
          "source": "tail",
          "regex": "/^(?:(?<action>PASS|DROP|REJECT)\\s+)?(?:(?<ruleset>\\S+)\\/)?(?<rule_id>\\d+)\\s+(?<direction>IN|OUT)\\s+(?<protocol>TCP|UDP|ICMP|PROTO \\d+)\\s+(?:(?<close_reason>RST|FIN)\\s+)?(?<src_ip>[0-9a-fA-F.:]+?)(?:\\/(?<src_port>\\d+))?->(?<dst_ip>[0-9a-fA-F.:]+?)(?:\\/(?<dst_port>\\d+))?\\s+(?<packet_counts>\\d+\\/\\d+)\\s+(?<byte_counts>\\d+\\/\\d+)(?:\\s+(?<annotation>.+))?$/"
        }
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "dfw_host",
              "value": "__e['dfw_host'] !== undefined ? __e['dfw_host'] : __e['host']"
            },
            {
              "name": "'network.type'",
              "value": "__e['inet_type'] == 'INET' ? 'ipv4' : (__e['inet_type'] == 'INET6' ? 'ipv6' : undefined)"
            },
            {
              "name": "'network.direction'",
              "value": "__e['direction'] == 'IN' ? 'ingress' : (__e['direction'] == 'OUT' ? 'egress' : undefined)"
            },
            {
              "name": "'network.transport'",
              "value": "(__e['protocol'] == 'TCP' || __e['protocol'] == 'UDP' || __e['protocol'] == 'ICMP') ? __e['protocol'].toLowerCase() : undefined"
            },
            {
              "name": "'network.iana_number'",
              "value": "(__e['protocol'] && __e['protocol'].indexOf('PROTO') === 0) ? Number.parseInt(__e['protocol'].split(' ')[1], 10) : undefined"
            },
            {
              "name": "'network.packets'",
              "value": "__e['packet_counts'] ? (Number.parseInt(__e['packet_counts'].split('/')[0], 10) + Number.parseInt(__e['packet_counts'].split('/')[1], 10)) : undefined"
            },
            {
              "name": "'network.bytes'",
              "value": "__e['byte_counts'] ? (Number.parseInt(__e['byte_counts'].split('/')[0], 10) + Number.parseInt(__e['byte_counts'].split('/')[1], 10)) : undefined"
            },
            {
              "name": "'vmware.nsx.dfw.record_type'",
              "value": "__e['reason']"
            },
            {
              "name": "'vmware.nsx.dfw.packet_length'",
              "value": "__e['packet_size'] ? Number.parseInt(__e['packet_size'], 10) : undefined"
            },
            {
              "name": "'vmware.nsx.dfw.tcp_flags'",
              "value": "__e['tcp_flags']"
            },
            {
              "name": "'process.name'",
              "value": "__e['ident'] !== undefined ? __e['ident'] : (__e['appname'] !== undefined ? __e['appname'] : 'dfwpktlogs')"
            },
            {
              "name": "'event.action'",
              "value": "__e['action'] ? __e['action'].toLowerCase() : undefined"
            },
            {
              "name": "'event.outcome'",
              "value": "__e['action'] == 'PASS' ? 'success' : ((__e['action'] == 'DROP' || __e['action'] == 'REJECT') ? 'failure' : undefined)"
            },
            {
              "name": "'event.type'",
              "value": "__e['reason'] == 'TERM' ? 'end' : (__e['action'] == 'PASS' ? 'allowed' : ((__e['action'] == 'DROP' || __e['action'] == 'REJECT') ? 'denied' : undefined))"
            },
            {
              "name": "'rule.id'",
              "value": "__e['rule_id'] ? Number.parseInt(__e['rule_id'], 10) : undefined"
            }
          ]
        },
        "description": "compute every derived/normalized field from the ORIGINAL vendor names before the batched rename below (ORDER MATTERS rule) - vocab translation, action/outcome/type derivation, session totals, custom vmware.nsx.dfw.* fields"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "dfw_host",
              "newName": "'observer.name'"
            },
            {
              "currentName": "vif_id",
              "newName": "'observer.ingress.interface.id'"
            },
            {
              "currentName": "ruleset",
              "newName": "'rule.ruleset'"
            },
            {
              "currentName": "close_reason",
              "newName": "'event.reason'"
            },
            {
              "currentName": "src_ip",
              "newName": "'source.ip'"
            },
            {
              "currentName": "src_port",
              "newName": "'source.port'"
            },
            {
              "currentName": "dst_ip",
              "newName": "'destination.ip'"
            },
            {
              "currentName": "dst_port",
              "newName": "'destination.port'"
            },
            {
              "currentName": "annotation",
              "newName": "'vmware.nsx.dfw.annotation'"
            }
          ]
        },
        "description": "batch every clean-named mapped/partial field into its ECS target in one rename"
      },
      {
        "id": "auto_timestamp",
        "filter": "__e['timestamp'] !== undefined",
        "conf": {
          "srcField": "timestamp",
          "dstField": "_time"
        },
        "description": "set Cribl's canonical _time from the record's own ISO 8601 timestamp - never target @timestamp directly (constraint 1)"
      },
      {
        "id": "numerify",
        "filter": "true",
        "conf": {
          "ignoreFields": [
            "observer.ingress.interface.id"
          ]
        },
        "description": "VIF IDs are hex and stay strings, even when every digit is decimal"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "remove": [
            "tail",
            "reason",
            "action",
            "direction",
            "inet_type",
            "protocol",
            "packet_counts",
            "byte_counts",
            "timestamp",
            "packet_size",
            "tcp_flags",
            "rule_id",
            "_raw",
            "ident",
            "host"
          ],
          "add": [
            {
              "name": "'event.dataset'",
              "value": "'vmware_nsx.dfw_packet_log'"
            },
            {
              "name": "'event.category'",
              "value": "['network']"
            },
            {
              "name": "'event.kind'",
              "value": "'event'"
            }
          ]
        },
        "description": "drop now-redundant working fields (including _raw, per the direct recommendation to drop it once the parser is proven) and tag the event"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
