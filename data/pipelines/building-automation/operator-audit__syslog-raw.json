{
  "id": "dm_building_automation_operator_audit_syslog_raw",
  "conf": {
    "output": "default",
    "description": "Building Automation (Niagara) operator-audit syslog-raw direct route: hand-built RFC3164 envelope + audit-record parse, no vendor pack/integration exists for Niagara",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "Niagara AuditHistory/SecurityHistory records rendered into SyslogPlatformService BSD syslog. No Niagara Elastic integration or Cribl pack exists; hand-built regex parser keyed on the documented audit columns (Timestamp, Operation, Target, Slot Name, Old Value, Value, User Name). Re-test on every Niagara point release."
        },
        "description": "Pipeline purpose and fragility warning"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/^<(?<pri>\\d{1,3})>(?<header_ts>[A-Za-z]{3}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2})\\s+(?<HOSTNAME>\\S+)\\s+(?<TAG>[^:]+):\\s*(?<MSG>.*)$/",
          "source": "_raw"
        },
        "description": "Split the RFC3164 envelope (PRI, header timestamp, HOSTNAME, TAG) from the Niagara-rendered content (MSG)"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/Timestamp:\\s*(?<au_ts>[^;]+);\\s*Operation:\\s*(?<au_operation>[^;]+);\\s*Target:\\s*(?<au_target>[^;]+);\\s*Slot Name:\\s*(?<au_slot>[^;]*);\\s*Old Value:\\s*(?<au_oldval>[^;]*);\\s*Value:\\s*(?<au_newval>[^;]*);\\s*User Name:\\s*(?<au_user>[^;]*)/",
          "source": "MSG"
        },
        "description": "Extract the seven documented Audit/Security History columns from the rendered record (assumed semicolon-delimited label:value grammar - no confirmed sample; ORDs contain literal pipes so pipe-delimiting was avoided)"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/via\\s+(?<auth_scheme>[A-Za-z0-9\\/ ]+?)\\s+from\\s+(?<client_ip>(?:\\d{1,3}\\.){3}\\d{1,3})[^a-zA-Z]*(?<login_word>succeeded|failed|success|failure)/i",
          "source": "MSG"
        },
        "description": "Best-effort extraction of auth scheme, client address and login result from the security-audit message text; only matches log-in/log-out records"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            { "name": "bas.niagara.audit.target", "value": "__e['au_target']" },
            { "name": "bas.niagara.audit.slot_name", "value": "__e['au_slot']" },
            { "name": "bas.niagara.audit.old_value", "value": "__e['au_oldval']" },
            { "name": "bas.niagara.audit.new_value", "value": "__e['au_newval']" },
            { "name": "bas.niagara.audit.history_name", "value": "__e['historyName']" },
            { "name": "bas.niagara.auth.scheme", "value": "__e['auth_scheme']" },
            { "name": "source.ip", "value": "__e['client_ip']" },
            { "name": "observer.name", "value": "__e['stationName']" },
            { "name": "log.syslog.facility.name", "value": "Math.floor(Number(__e['pri'])/8)===16?'local0':Math.floor(Number(__e['pri'])/8)===17?'local1':Math.floor(Number(__e['pri'])/8)===18?'local2':Math.floor(Number(__e['pri'])/8)===19?'local3':Math.floor(Number(__e['pri'])/8)===20?'local4':Math.floor(Number(__e['pri'])/8)===21?'local5':Math.floor(Number(__e['pri'])/8)===22?'local6':Math.floor(Number(__e['pri'])/8)===23?'local7':undefined" },
            { "name": "event.outcome", "value": "__e['login_word'] ? (/succ/i.test(__e['login_word']) ? 'success' : 'failure') : (__e['au_operation'] ? 'success' : undefined)" }
          ]
        },
        "description": "Custom bas.niagara.* namespace copies plus derived ECS fields: facility name from PRI, source.ip/auth scheme from message text, event.outcome from operation+login wording (no outcome column exists on either history)"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            { "currentName": "au_operation", "newName": "event.action" },
            { "currentName": "au_user", "newName": "user.name" },
            { "currentName": "MSG", "newName": "message" },
            { "currentName": "HOSTNAME", "newName": "host.name" },
            { "currentName": "TAG", "newName": "log.syslog.appname" }
          ]
        },
        "description": "Batch rename of the directly-mapped columns"
      },
      {
        "id": "auto_timestamp",
        "filter": "true",
        "conf": {
          "srcField": "au_ts",
          "dstField": "_time"
        },
        "description": "Event time from the record-body Timestamp column, preferred over the BSD header which carries no year (platform constraint: never target @timestamp)"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            { "name": "event.dataset", "value": "'building_automation.operator_audit'" }
          ],
          "remove": [
            "au_target", "au_slot", "au_oldval", "au_newval", "historyName",
            "auth_scheme", "client_ip", "stationName", "login_word",
            "pri", "header_ts", "au_ts"
          ]
        },
        "description": "Set event.dataset (no hyphen) and drop staging fields consumed into their ECS/custom targets above"
      }
    ]
  }
}
