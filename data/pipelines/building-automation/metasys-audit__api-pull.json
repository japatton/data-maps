{
  "id": "dm_building_automation_metasys_audit_api_pull",
  "conf": {
    "output": "default",
    "description": "Building Automation (Metasys) audit api-pull direct route: REST v4 audits JSON parse with enum de-prefixing, preData/postData flattening and itemReference host split, per recommendations.direct.cribl",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "Metasys REST API v4 audits resource, paged/checkpointed on creationTime by the collector. No Elastic integration or Cribl pack exists for Metasys. API returns JSON already; the work here is enum de-prefixing, preData/postData flattening and ECS renaming."
        },
        "description": "Pipeline purpose"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "Extract one Metasys audit record JSON body into top-level fields"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            { "name": "event.action", "value": "(__e['actionType']||'').replace(/^.*\\./,'').replace(/AuditActionType$/,'')" },
            { "name": "bas.metasys.audit.class_level", "value": "(__e['classLevel']||'').replace(/^.*\\./,'').replace(/AuditClass$/,'')" },
            { "name": "event.provider", "value": "(__e['originApplication']||'').replace(/^.*\\./,'')" },
            { "name": "host.name", "value": "__e['itemReference'] ? __e['itemReference'].split(':')[1].split('/')[0] : undefined" },
            { "name": "bas.metasys.audit.pre_data", "value": "typeof __e['preData']==='object' ? JSON.stringify(__e['preData']) : __e['preData']" },
            { "name": "bas.metasys.audit.post_data", "value": "typeof __e['postData']==='object' ? JSON.stringify(__e['postData']) : __e['postData']" },
            { "name": "source.ip", "value": "/log(on|in|off|out)/i.test((__e['actionType']||'').replace(/^.*\\./,'').replace(/AuditActionType$/,'')) ? (typeof __e['postData']==='object' ? JSON.stringify(__e['postData']) : __e['postData']) : undefined" },
            { "name": "event.outcome", "value": "__e['status'] ? __e['status'] : ((__e['errorString']===null||__e['errorString']===undefined||__e['errorString']==='') ? 'success' : 'failure')" },
            { "name": "bas.metasys.audit.parameters", "value": "Array.isArray(__e['parameters']) ? __e['parameters'].join('; ').slice(0,500) : __e['parameters']" }
          ]
        },
        "description": "Per recommendations.direct.cribl: de-prefix actionType/classLevel/originApplication enum-set strings, split deviceHostname out of itemReference for host.name, flatten preData/postData, promote postData to source.ip only for log-in/log-out actionTypes, derive event.outcome from status+errorString together"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            { "currentName": "id", "newName": "event.id" },
            { "currentName": "user", "newName": "user.name" },
            { "currentName": "errorString", "newName": "error.message" },
            { "currentName": "description", "newName": "message" },
            { "currentName": "itemReference", "newName": "bas.metasys.audit.item_reference" },
            { "currentName": "signature", "newName": "bas.metasys.audit.signature" }
          ]
        },
        "description": "Batch rename of the directly-mapped columns, run after the eval above so host.name/source.ip could still read the original itemReference/postData"
      },
      {
        "id": "auto_timestamp",
        "filter": "true",
        "conf": {
          "srcField": "creationTime",
          "dstField": "_time"
        },
        "description": "Event time from the ISO-8601 creationTime (platform constraint: never target @timestamp)"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            { "name": "event.dataset", "value": "'building_automation.metasys_audit'" }
          ],
          "remove": [
            "actionType", "classLevel", "originApplication", "preData", "postData",
            "status", "parameters", "creationTime"
          ]
        },
        "description": "Set event.dataset (no hyphen) and drop staging fields consumed into their ECS/custom targets above"
      }
    ]
  }
}
