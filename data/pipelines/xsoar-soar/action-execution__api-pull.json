{
  "id": "dm_xsoar_soar_action_execution_api_pull",
  "conf": {
    "output": "default",
    "description": "SOAR playbook/action execution history, api-pull: normalizes Splunk SOAR action_run/app_run and XSOAR task-entry records onto one accountability schema; folds exception_occurred into event.outcome; preserves parameter/result_summary as nested objects for Elastic's flattened mapping type rather than guessing a Cribl-side flatten conf.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "xsoar-soar/action-execution/api-pull. No Elastic integration or Cribl Pack covers SOAR execution history. Splunk SOAR action_run/app_run and XSOAR task-entry field names are already clean identifiers (no awkward-name problem here). parameter/result_summary are connector-defined, unbounded, and their exact sub-keys are unknown, so they are renamed whole into the soar.action.* namespace and left nested rather than flattened/masked/lifted (documented gaps - see README) for Elastic's own 'flattened' mapping type to index."
        }
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        }
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "event.outcome",
              "value": "__e['exception_occurred'] === true ? 'failure' : (__e['status'] == 'success' ? 'success' : (__e['status'] == 'failed' ? 'failure' : (['running', 'pending', 'cancelled'].indexOf(__e['status']) >= 0 ? 'unknown' : undefined)))"
            },
            {
              "name": "event.duration",
              "value": "(typeof __e['start_time'] !== 'undefined' && typeof __e['end_time'] !== 'undefined') ? (Date.parse(__e['end_time']) - Date.parse(__e['start_time'])) * 1000000 : undefined"
            },
            {
              "name": "user.effective.name",
              "value": "typeof __e['creator'] !== 'undefined' ? __e['creator'] : undefined"
            },
            {
              "name": "event.category",
              "value": "['process', 'configuration']"
            },
            {
              "name": "event.dataset",
              "value": "'xsoar_soar.action_run'"
            }
          ]
        },
        "description": "compute event.outcome (folding the child app_run exception flag per the work order's explicit warning that a parent can report success while a child raised an exception) and event.duration from ORIGINAL vendor names before the batched rename (ORDER MATTERS); user.effective.name is a value-add from the sibling 'creator' field the notes call out, not a formal field row"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "action",
              "newName": "event.action"
            },
            {
              "currentName": "name",
              "newName": "soar.action.run_name"
            },
            {
              "currentName": "app_name",
              "newName": "soar.action.app_name"
            },
            {
              "currentName": "asset",
              "newName": "soar.action.asset"
            },
            {
              "currentName": "parameter",
              "newName": "soar.action.parameter"
            },
            {
              "currentName": "container",
              "newName": "soar.action.container_id"
            },
            {
              "currentName": "playbook",
              "newName": "soar.action.playbook_name"
            },
            {
              "currentName": "playbook_run",
              "newName": "soar.action.playbook_run_id"
            },
            {
              "currentName": "owner",
              "newName": "user.name"
            },
            {
              "currentName": "effective_user",
              "newName": "user.effective.id"
            },
            {
              "currentName": "start_time",
              "newName": "event.start"
            },
            {
              "currentName": "end_time",
              "newName": "event.end"
            },
            {
              "currentName": "id",
              "newName": "event.id"
            },
            {
              "currentName": "exception_occurred",
              "newName": "soar.action.exception_occurred"
            },
            {
              "currentName": "result_summary",
              "newName": "soar.action.result_summary"
            },
            {
              "currentName": "automation_broker",
              "newName": "soar.action.automation_broker"
            },
            {
              "currentName": "brand",
              "newName": "soar.action.integration_brand"
            },
            {
              "currentName": "investigationId",
              "newName": "soar.action.investigation_id"
            }
          ]
        },
        "description": "batch every clean-named field into its ECS/custom target in one rename ('message' is already the correct ECS name in both vendors' payloads, so it needs no rename)"
      },
      {
        "id": "numerify",
        "filter": "true",
        "conf": {}
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "remove": [
            "status",
            "creator"
          ]
        },
        "description": "drop the now-redundant status/creator working fields - _raw is deliberately KEPT (highest-forensic-value record on the technology per the work order; no concrete masking pattern given for parameter/result_summary - see README gap)"
      }
    ]
  }
}
