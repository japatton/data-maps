{
  "id": "dm_defender_endpoint_device_network_events_api_pull",
  "conf": {
    "output": "default",
    "description": "Defender for Endpoint - DeviceNetworkEvents (api-pull, REST Collector). Unwraps runHuntingQuery results[] into one connection event per row, resolves the ActionType-dependent source/destination inversion, then maps to ECS.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "Defender for Endpoint - DeviceNetworkEvents, api-pull format. Same envelope-unwrap shape as device-process-events. This table's ActionType is the ONLY signal for connection direction: RemoteIP/RemotePort/LocalIP/LocalPort invert between source/destination depending on whether ActionType names an Inbound* accepted connection. RemoteUrl holds either a full URL or a bare FQDN and needs a shape test. On this table Initiating* is the ACTING process (maps to process.*, not process.parent.*), unlike DeviceProcessEvents. Per recommendations.direct.cribl: scoped/projected query, no capping/dead-letter required on this direct path."
        },
        "description": "why this pipeline exists and its scope"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "parse the huntingQueryResults envelope JSON text into fields (schema, results)"
      },
      {
        "id": "unroll",
        "filter": "true",
        "conf": {
          "srcExpr": "__e['results']",
          "dstField": "row"
        },
        "description": "one event per row object in results[]"
      },
      {
        "id": "code",
        "filter": "true",
        "conf": {
          "code": "Object.assign(__e, __e['row']); delete __e['row']; delete __e['schema']; delete __e['results'];"
        },
        "description": "promote the unwrapped row's columns to top-level event fields"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "_time",
              "value": "__e['Timestamp'] ? Date.parse(__e['Timestamp'])/1000 : undefined"
            },
            {
              "name": "'network.direction'",
              "value": "(__e['ActionType'] && __e['ActionType'].indexOf('Inbound') !== -1) ? 'inbound' : 'outbound'"
            },
            {
              "name": "'source.ip'",
              "value": "(__e['ActionType'] && __e['ActionType'].indexOf('Inbound') !== -1) ? __e['RemoteIP'] : __e['LocalIP']"
            },
            {
              "name": "'source.port'",
              "value": "(__e['ActionType'] && __e['ActionType'].indexOf('Inbound') !== -1) ? __e['RemotePort'] : __e['LocalPort']"
            },
            {
              "name": "'destination.ip'",
              "value": "(__e['ActionType'] && __e['ActionType'].indexOf('Inbound') !== -1) ? __e['LocalIP'] : __e['RemoteIP']"
            },
            {
              "name": "'destination.port'",
              "value": "(__e['ActionType'] && __e['ActionType'].indexOf('Inbound') !== -1) ? __e['LocalPort'] : __e['RemotePort']"
            },
            {
              "name": "'url.full'",
              "value": "(__e['RemoteUrl'] && __e['RemoteUrl'].indexOf('://') !== -1) ? __e['RemoteUrl'] : undefined"
            },
            {
              "name": "'destination.domain'",
              "value": "(__e['RemoteUrl'] && __e['RemoteUrl'].indexOf('://') === -1) ? __e['RemoteUrl'] : undefined"
            },
            {
              "name": "'network.transport'",
              "value": "__e['Protocol'] ? __e['Protocol'].toLowerCase() : undefined"
            },
            {
              "name": "'event.dataset'",
              "value": "'defender_endpoint.device_network_events'"
            },
            {
              "name": "'m365_defender.event.local_ip_type'",
              "value": "__e['LocalIPType']"
            },
            {
              "name": "'m365_defender.event.remote_ip_type'",
              "value": "__e['RemoteIPType']"
            },
            {
              "name": "'m365_defender.event.account_upn'",
              "value": "__e['InitiatingProcessAccountUpn']"
            },
            {
              "name": "'m365_defender.event.account_object_id'",
              "value": "__e['InitiatingProcessAccountObjectId']"
            },
            {
              "name": "'m365_defender.event.initiating_process_integrity_level'",
              "value": "__e['InitiatingProcessIntegrityLevel']"
            },
            {
              "name": "'m365_defender.event.initiating_process_token_elevation'",
              "value": "__e['InitiatingProcessTokenElevation']"
            },
            {
              "name": "'m365_defender.event.is_initiating_process_remote_session'",
              "value": "__e['IsInitiatingProcessRemoteSession']"
            },
            {
              "name": "'m365_defender.event.initiating_process_remote_session_ip'",
              "value": "__e['InitiatingProcessRemoteSessionIP']"
            },
            {
              "name": "'m365_defender.event.report_id'",
              "value": "__e['ReportId']"
            },
            {
              "name": "'m365_defender.event.additional_fields'",
              "value": "__e['AdditionalFields']"
            }
          ],
          "remove": [
            "_raw"
          ]
        },
        "description": "derived direction-dependent source/destination assignment, RemoteUrl shape test, protocol lowercase (all computed from ORIGINAL vendor names before rename), event.dataset, and every unmapped column routed to its custom target; drop _raw"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "DeviceId",
              "newName": "'host.id'"
            },
            {
              "currentName": "DeviceName",
              "newName": "'host.name'"
            },
            {
              "currentName": "ActionType",
              "newName": "'event.action'"
            },
            {
              "currentName": "InitiatingProcessFileName",
              "newName": "'process.name'"
            },
            {
              "currentName": "InitiatingProcessCommandLine",
              "newName": "'process.command_line'"
            },
            {
              "currentName": "InitiatingProcessId",
              "newName": "'process.pid'"
            },
            {
              "currentName": "InitiatingProcessFolderPath",
              "newName": "'process.executable'"
            },
            {
              "currentName": "InitiatingProcessSHA1",
              "newName": "'process.hash.sha1'"
            },
            {
              "currentName": "InitiatingProcessSHA256",
              "newName": "'process.hash.sha256'"
            },
            {
              "currentName": "InitiatingProcessMD5",
              "newName": "'process.hash.md5'"
            },
            {
              "currentName": "InitiatingProcessCreationTime",
              "newName": "'process.start'"
            },
            {
              "currentName": "InitiatingProcessUniqueId",
              "newName": "'process.entity_id'"
            },
            {
              "currentName": "InitiatingProcessParentFileName",
              "newName": "'process.parent.name'"
            },
            {
              "currentName": "InitiatingProcessParentId",
              "newName": "'process.parent.pid'"
            },
            {
              "currentName": "InitiatingProcessParentCreationTime",
              "newName": "'process.parent.start'"
            },
            {
              "currentName": "InitiatingProcessAccountName",
              "newName": "'user.name'"
            },
            {
              "currentName": "InitiatingProcessAccountDomain",
              "newName": "'user.domain'"
            },
            {
              "currentName": "InitiatingProcessAccountSid",
              "newName": "'user.id'"
            }
          ]
        },
        "description": "batch rename every status:mapped 1:1 field to its ECS target (RemoteIP/RemotePort/LocalIP/LocalPort/RemoteUrl/Protocol excluded - handled by the direction-aware eval above)"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
