{
  "id": "dm_defender_endpoint_device_process_events_api_pull",
  "conf": {
    "output": "default",
    "description": "Defender for Endpoint - DeviceProcessEvents (api-pull, REST Collector). Unwraps runHuntingQuery results[] into one process-creation event per row, then maps to ECS.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "Defender for Endpoint - DeviceProcessEvents, api-pull format. REST Collector polls runHuntingQuery (KQL); the huntingQueryResults envelope ({schema,results}) arrives as _raw JSON text. This pipeline parses that envelope, unwraps results[] into one event per row, and maps columns to ECS matching the m365_defender pipeline_device branch shape. Per recommendations.direct.cribl: query is scoped server-side, no length-capping/dead-letter needed on this direct path. process.entity_id (ProcessUniqueId) and process.parent.entity_id (InitiatingProcessUniqueId) are populated here, unlike the stock streamed integration."
        },
        "description": "why this pipeline exists and its scope"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "parse the huntingQueryResults envelope JSON text into fields (schema, results)"
      },
      {
        "id": "unroll",
        "filter": "true",
        "conf": {
          "srcExpr": "__e['results']",
          "dstField": "row"
        },
        "description": "one event per row object in results[]"
      },
      {
        "id": "code",
        "filter": "true",
        "conf": {
          "code": "Object.assign(__e, __e['row']); delete __e['row']; delete __e['schema']; delete __e['results'];"
        },
        "description": "promote the unwrapped row's columns to top-level event fields"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "_time",
              "value": "__e['Timestamp'] ? Date.parse(__e['Timestamp'])/1000 : undefined"
            },
            {
              "name": "process.executable",
              "value": "__e['FolderPath'] ? (__e['FolderPath'] + '\\\\' + __e['FileName']) : __e['FileName']"
            },
            {
              "name": "event.dataset",
              "value": "'defender_endpoint.device_process_events'"
            },
            {
              "name": "m365_defender.event.process_integrity_level",
              "value": "__e['ProcessIntegrityLevel']"
            },
            {
              "name": "m365_defender.event.process_token_elevation",
              "value": "__e['ProcessTokenElevation']"
            },
            {
              "name": "m365_defender.event.account_upn",
              "value": "__e['AccountUpn']"
            },
            {
              "name": "m365_defender.event.account_object_id",
              "value": "__e['AccountObjectId']"
            },
            {
              "name": "m365_defender.event.logon_id",
              "value": "__e['LogonId']"
            },
            {
              "name": "m365_defender.event.initiating_process_parent_id",
              "value": "__e['InitiatingProcessParentId']"
            },
            {
              "name": "m365_defender.event.initiating_process_parent_file_name",
              "value": "__e['InitiatingProcessParentFileName']"
            },
            {
              "name": "m365_defender.event.initiating_process_account_name",
              "value": "__e['InitiatingProcessAccountName']"
            },
            {
              "name": "m365_defender.event.initiating_process_signature_status",
              "value": "__e['InitiatingProcessSignatureStatus']"
            },
            {
              "name": "m365_defender.event.initiating_process_signer_type",
              "value": "__e['InitiatingProcessSignerType']"
            },
            {
              "name": "m365_defender.event.is_initiating_process_remote_session",
              "value": "__e['IsInitiatingProcessRemoteSession']"
            },
            {
              "name": "m365_defender.event.initiating_process_remote_session_ip",
              "value": "__e['InitiatingProcessRemoteSessionIP']"
            },
            {
              "name": "m365_defender.event.report_id",
              "value": "__e['ReportId']"
            },
            {
              "name": "m365_defender.event.additional_fields",
              "value": "__e['AdditionalFields']"
            }
          ],
          "remove": [
            "_raw"
          ]
        },
        "description": "derived fields computed from ORIGINAL vendor names (process.executable join, _time), event.dataset, and every unmapped column routed to its custom target; drop _raw once the envelope is fully parsed"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "DeviceId",
              "newName": "host.id"
            },
            {
              "currentName": "DeviceName",
              "newName": "host.name"
            },
            {
              "currentName": "ActionType",
              "newName": "event.action"
            },
            {
              "currentName": "FileName",
              "newName": "process.name"
            },
            {
              "currentName": "SHA1",
              "newName": "process.hash.sha1"
            },
            {
              "currentName": "SHA256",
              "newName": "process.hash.sha256"
            },
            {
              "currentName": "MD5",
              "newName": "process.hash.md5"
            },
            {
              "currentName": "FileSize",
              "newName": "file.size"
            },
            {
              "currentName": "ProcessId",
              "newName": "process.pid"
            },
            {
              "currentName": "ProcessCommandLine",
              "newName": "process.command_line"
            },
            {
              "currentName": "ProcessCreationTime",
              "newName": "process.start"
            },
            {
              "currentName": "ProcessUniqueId",
              "newName": "process.entity_id"
            },
            {
              "currentName": "AccountName",
              "newName": "user.name"
            },
            {
              "currentName": "AccountDomain",
              "newName": "user.domain"
            },
            {
              "currentName": "AccountSid",
              "newName": "user.id"
            },
            {
              "currentName": "InitiatingProcessFileName",
              "newName": "process.parent.name"
            },
            {
              "currentName": "InitiatingProcessCommandLine",
              "newName": "process.parent.command_line"
            },
            {
              "currentName": "InitiatingProcessId",
              "newName": "process.parent.pid"
            },
            {
              "currentName": "InitiatingProcessFolderPath",
              "newName": "process.parent.executable"
            },
            {
              "currentName": "InitiatingProcessSHA1",
              "newName": "process.parent.hash.sha1"
            },
            {
              "currentName": "InitiatingProcessCreationTime",
              "newName": "process.parent.start"
            },
            {
              "currentName": "InitiatingProcessUniqueId",
              "newName": "process.parent.entity_id"
            }
          ]
        },
        "description": "batch rename every status:mapped/partial 1:1 field to its ECS target"
      }
    ]
  }
}
