{
  "id": "dm_openshift_node_container_logs_json",
  "conf": {
    "output": "default",
    "description": "OpenShift node/container ViaQ json logs (journald + container stdout/stderr): no Elastic Kubernetes-integration pipeline fits the ViaQ shape, so hand-build the field mapping into logs-kubernetes.container_logs - strip the cri-o:// prefix, split container image into name/tag, map ViaQ envelope keys to ECS/custom.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "OpenShift node/container ViaQ json logs via ClusterLogForwarder http output. No stock Elastic integration fits this ViaQ wire shape, so this pipeline hand-shapes the record: ECS mapping for host/level/namespace/container/cluster, custom kubernetes.pod.*/openshift.log_* for the rest, cri-o:// prefix stripped, image split into name/tag."
        },
        "description": "record dataset, format, and parsing approach"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "parse the ViaQ JSON line"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "hostname",
              "newName": "host.name"
            },
            {
              "currentName": "level",
              "newName": "log.level"
            },
            {
              "currentName": "kubernetes.namespace_name",
              "newName": "orchestrator.namespace"
            },
            {
              "currentName": "kubernetes.container_name",
              "newName": "container.name"
            },
            {
              "currentName": "openshift.cluster_id",
              "newName": "orchestrator.cluster.id"
            },
            {
              "currentName": "systemd.u.SYSLOG_IDENTIFIER",
              "newName": "process.name"
            }
          ]
        },
        "description": "batch the mapped ViaQ envelope fields to their ECS targets"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "kubernetes.pod.name",
              "value": "kubernetes.pod_name"
            },
            {
              "name": "kubernetes.pod.id",
              "value": "kubernetes.pod_id"
            },
            {
              "name": "openshift.log_type",
              "value": "__e['log_type']"
            },
            {
              "name": "openshift.log_source",
              "value": "__e['log_source']"
            },
            {
              "name": "container.id",
              "value": "kubernetes.container_id.replace(/^cri-o:\\/\\//,'')"
            },
            {
              "name": "container.image.tag",
              "value": "(kubernetes.container_image.lastIndexOf(':')>kubernetes.container_image.lastIndexOf('/'))?kubernetes.container_image.slice(kubernetes.container_image.lastIndexOf(':')+1):''"
            },
            {
              "name": "container.image.name",
              "value": "(kubernetes.container_image.lastIndexOf(':')>kubernetes.container_image.lastIndexOf('/'))?kubernetes.container_image.slice(0,kubernetes.container_image.lastIndexOf(':')):kubernetes.container_image"
            },
            {
              "name": "_time",
              "value": "Date.parse(__e[\"@timestamp\"])/1000"
            },
            {
              "name": "event.dataset",
              "value": "'openshift.node_container_logs'"
            }
          ],
          "remove": [
            "kubernetes.pod_name",
            "kubernetes.pod_id",
            "log_type",
            "log_source",
            "kubernetes.container_id",
            "kubernetes.container_image"
          ]
        },
        "description": "promote pod identity and routing keys to custom targets, strip the cri-o:// runtime prefix, split the image reference, set _time from the ViaQ @timestamp, tag event.dataset"
      }
    ]
  }
}
