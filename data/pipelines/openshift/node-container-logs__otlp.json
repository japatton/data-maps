{
  "id": "dm_openshift_node_container_logs_otlp",
  "conf": {
    "output": "default",
    "description": "OpenShift node/container logs via OTLP (Technology Preview): flatten the resource attributes (container or journald identity) and logRecord body/severityText into ECS/custom fields; pod-label and journald trusted-field sets are unbounded operator/kernel-defined data and are only partially carried (see README gap).",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "OpenShift node/container logs via OTLP (Tech Preview). No stock Elastic integration consumes this shape, so flatten resource attributes (container or journald identity) and the logRecord body/severityText by hand. k8s.pod.label.* and the wider systemd.t.* trusted-field set are unbounded - only the two named-useful systemd.t fields are carried."
        },
        "description": "record dataset, format, and parsing approach"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "orchestrator.cluster.id",
              "value": "resource[\"openshift.cluster.uid\"]"
            },
            {
              "name": "openshift.log_source",
              "value": "resource[\"openshift.log.source\"]"
            },
            {
              "name": "openshift.log_type",
              "value": "resource[\"openshift.log.type\"]"
            },
            {
              "name": "host.name",
              "value": "resource[\"k8s.node.name\"]"
            },
            {
              "name": "orchestrator.namespace",
              "value": "resource[\"k8s.namespace.name\"]"
            },
            {
              "name": "container.name",
              "value": "resource[\"k8s.container.name\"]"
            },
            {
              "name": "kubernetes.pod.name",
              "value": "resource[\"k8s.pod.name\"]"
            },
            {
              "name": "kubernetes.pod.id",
              "value": "resource[\"k8s.pod.uid\"]"
            },
            {
              "name": "process.command_line",
              "value": "resource[\"process.command_line\"]"
            },
            {
              "name": "process.executable",
              "value": "resource[\"process.executable.path\"]"
            },
            {
              "name": "process.name",
              "value": "resource[\"process.executable.name\"]?resource[\"process.executable.name\"]:attributes[\"systemd.u.syslog_identifier\"]"
            },
            {
              "name": "process.pid",
              "value": "resource[\"process.pid\"]"
            },
            {
              "name": "service.name",
              "value": "resource[\"service.name\"]"
            },
            {
              "name": "log.level",
              "value": "__e['severityText']"
            },
            {
              "name": "message",
              "value": "__e['body']"
            },
            {
              "name": "kubernetes.log.iostream",
              "value": "attributes[\"log.iostream\"]"
            },
            {
              "name": "systemd.t.pid",
              "value": "attributes[\"systemd.t.pid\"]"
            },
            {
              "name": "systemd.t.systemd_unit",
              "value": "attributes[\"systemd.t.systemd_unit\"]"
            },
            {
              "name": "_time",
              "value": "Number(__e['timeUnixNano'])/1e9"
            },
            {
              "name": "event.created",
              "value": "new Date(Number(__e['observedTimeUnixNano'])/1e6).toISOString()"
            },
            {
              "name": "event.dataset",
              "value": "'openshift.node_container_logs'"
            }
          ],
          "remove": [
            "body"
          ]
        },
        "description": "promote container-or-journald resource identity and body/severityText to ECS/custom fields, keep the two named-useful journald trusted fields, set _time/event.created from the OTLP clocks, tag event.dataset"
      }
    ]
  }
}
