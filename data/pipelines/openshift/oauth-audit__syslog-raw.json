{
  "id": "dm_openshift_oauth_audit_syslog_raw",
  "conf": {
    "output": "default",
    "description": "OpenShift OAuth server/API audit, syslog-raw (RFC5424): same un-frame as the API-server audit; MSG is the OAuth audit.k8s.io/v1 Event, nested under kubernetes.audit. Query-string token redaction is a source-side ClusterLogForwarder concern per the catalog and is not implemented here (see README gap).",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "OpenShift OAuth audit via ClusterLogForwarder syslog output. Un-frame RFC5424, parse MSG as the OAuth audit Event, nest under kubernetes.audit. Catalog requires token-bearing query-string redaction to happen upstream at the ClusterLogForwarder before framing - not a Cribl step, recorded as a gap."
        },
        "description": "record dataset, format, and parsing approach"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/^<(?<pri>\\d+)>(?<version>\\d+) (?<timestamp>\\S+) (?<hostname>\\S+) (?<appname>\\S+) (?<procid>\\S+) (?<msgid>\\S+) (?:-|\\[[^\\]]*\\]) (?<msg>[\\s\\S]*)$/",
          "source": "_raw"
        },
        "description": "strip the RFC5424 frame: PRI, TIMESTAMP, HOSTNAME, APP-NAME, PROCID, MSGID, MSG"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "hostname",
              "newName": "host.name"
            },
            {
              "currentName": "appname",
              "newName": "log.syslog.appname"
            },
            {
              "currentName": "procid",
              "newName": "log.syslog.procid"
            },
            {
              "currentName": "msgid",
              "newName": "log.syslog.msgid"
            }
          ]
        },
        "description": "batch the mapped header fields to their ECS targets"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "log.syslog.priority",
              "value": "Number(__e['pri'])"
            },
            {
              "name": "log.syslog.facility.code",
              "value": "Math.floor(Number(__e['pri'])/8)"
            },
            {
              "name": "log.syslog.severity.code",
              "value": "Number(__e['pri'])%8"
            },
            {
              "name": "kubernetes.audit",
              "value": "JSON.parse(__e['msg'])"
            },
            {
              "name": "openshift.log_source",
              "value": "log.syslog.appname"
            },
            {
              "name": "_time",
              "value": "Date.parse(JSON.parse(__e['msg']).requestReceivedTimestamp)/1000"
            },
            {
              "name": "event.dataset",
              "value": "'openshift.oauth_audit'"
            }
          ],
          "remove": [
            "pri",
            "version",
            "timestamp",
            "msg"
          ]
        },
        "description": "decompose PRI into facility/severity, nest the audit Event, promote log_source, set _time from the event's own timestamp, tag event.dataset"
      }
    ]
  }
}
