{
  "id": "dm_f5_bigip_asm_request_violation_syslog_kv",
  "conf": {
    "output": "default",
    "description": "F5 BIG-IP ASM request/violation log, Splunk Extended Key-Value profile: named-field KV extract, richer than CEF (violations/sig_ids/sig_names/username/session_id/virus_name/violation_rating present here and absent from CEF)",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "F5 BIG-IP ASM request/violation log, Splunk Extended Key-Value profile. Every field arrives already named (no csN/cnN indirection), so this is a straight KV extract. Splits every comma-joined multi-value key into an array per the catalog's transform notes and drops the 'N/A' placeholder literals rather than indexing them. The request key carries the raw HTTP request (Cookie/Authorization headers); masking has no defined algorithm in the catalog, so it is left unmasked and recorded as a gap."
        },
        "description": "why this pipeline is shaped this way"
      },
      {
        "id": "eval",
        "filter": "true",
        "description": "Message body: a Cribl Syslog Source leaves the full line, header included, in _raw and the body in message; anything else carries the body in _raw.",
        "conf": {
          "add": [
            {
              "name": "__body",
              "value": "__e['message'] !== undefined ? __e['message'] : __e['_raw']"
            }
          ]
        }
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "kvp",
          "srcField": "__body",
          "kvDelim": "=",
          "pairDelim": ","
        },
        "description": "Extract the comma-separated key=\"value\" pairs the Extended Splunk Key-Value logging format emits"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\r?\\nHost:\\s*(?<http_host>[^\\r\\n]+)/i",
          "source": "request"
        },
        "description": "Pull the Host header out of the embedded raw HTTP request to build url.full later"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/HTTP\\/(?<http_version>[\\d.]+)/",
          "source": "request"
        },
        "description": "Pull the HTTP version out of the embedded raw HTTP request line"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\r?\\n[Uu]ser-[Aa]gent:\\s*(?<user_agent_raw>[^\\r\\n]+)/",
          "source": "request"
        },
        "description": "Pull the User-Agent header out of the embedded raw HTTP request"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "hostname",
              "newName": "'observer.hostname'"
            },
            {
              "currentName": "management_ip_address",
              "newName": "'observer.ip'"
            },
            {
              "currentName": "support_id",
              "newName": "'event.id'"
            },
            {
              "currentName": "ip_client",
              "newName": "'source.ip'"
            },
            {
              "currentName": "method",
              "newName": "'http.request.method'"
            },
            {
              "currentName": "src_port",
              "newName": "'source.port'"
            },
            {
              "currentName": "dest_port",
              "newName": "'destination.port'"
            },
            {
              "currentName": "dest_ip",
              "newName": "'destination.ip'"
            },
            {
              "currentName": "uri",
              "newName": "'url.path'"
            },
            {
              "currentName": "fragment",
              "newName": "'url.fragment'"
            }
          ]
        },
        "description": "batch rename every status:mapped field with no transform"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'rule.ruleset'",
              "value": "__e['policy_name']"
            },
            {
              "name": "'event.action'",
              "value": "__e['request_status'] ? __e['request_status'].toLowerCase() : undefined"
            },
            {
              "name": "'event.outcome'",
              "value": "(__e['request_status'] && __e['request_status'].toLowerCase()==='blocked') ? 'failure' : ((__e['request_status'] && (__e['request_status'].toLowerCase()==='alerted' || __e['request_status'].toLowerCase()==='passed')) ? 'success' : undefined)"
            },
            {
              "name": "'http.response.status_code'",
              "value": "(__e['response_code']!==undefined && __e['response_code']!=='0') ? Number(__e['response_code']) : undefined"
            },
            {
              "name": "'network.protocol'",
              "value": "__e['protocol'] ? 'http' : undefined"
            },
            {
              "name": "'tls.established'",
              "value": "__e['protocol'] ? __e['protocol'].toUpperCase()==='HTTPS' : undefined"
            },
            {
              "name": "'url.query'",
              "value": "__e['query_string']"
            },
            {
              "name": "'url.domain'",
              "value": "__e['http_host'] ? __e['http_host'].split(':')[0] : undefined"
            },
            {
              "name": "'url.full'",
              "value": "__e['http_host'] ? ((__e['protocol'] && __e['protocol'].toUpperCase()==='HTTPS' ? 'https' : 'http') + '://' + __e['http_host'] + (__e['uri']||'')) : undefined"
            },
            {
              "name": "'user_agent.original'",
              "value": "__e['user_agent_raw']"
            },
            {
              "name": "'http.version'",
              "value": "__e['http_version']"
            },
            {
              "name": "'network.forwarded_ip'",
              "value": "(__e['x_forwarded_for_header_value'] && __e['x_forwarded_for_header_value']!=='N/A') ? __e['x_forwarded_for_header_value'].split(',')[0].trim() : undefined"
            },
            {
              "name": "'source.geo.country_iso_code'",
              "value": "(__e['geo_location'] && __e['geo_location']!=='N/A') ? __e['geo_location'] : undefined"
            },
            {
              "name": "'user.name'",
              "value": "(__e['username'] && __e['username']!=='N/A') ? __e['username'] : undefined"
            },
            {
              "name": "'event.severity'",
              "value": "__e['severity']"
            },
            {
              "name": "'f5_bigip.log.management_ip_address_2'",
              "value": "__e['management_ip_address_2']"
            },
            {
              "name": "'f5_bigip.log.http_class_name'",
              "value": "__e['http_class_name']"
            },
            {
              "name": "'f5_bigip.log.web_application_name'",
              "value": "__e['web_application_name']"
            },
            {
              "name": "'f5_bigip.log.policy_apply_date'",
              "value": "__e['policy_apply_date']"
            },
            {
              "name": "'f5_bigip.log.violations'",
              "value": "__e['violations'] ? __e['violations'].split(',') : undefined"
            },
            {
              "name": "'f5_bigip.log.route_domain'",
              "value": "__e['route_domain']!==undefined ? Number(__e['route_domain']) : undefined"
            },
            {
              "name": "'f5_bigip.log.sig_ids'",
              "value": "__e['sig_ids'] ? __e['sig_ids'].split(',') : undefined"
            },
            {
              "name": "'f5_bigip.log.sig_names'",
              "value": "__e['sig_names'] ? __e['sig_names'].split(',') : undefined"
            },
            {
              "name": "'f5_bigip.log.attack.type'",
              "value": "__e['attack_type'] ? __e['attack_type'].split(',') : undefined"
            },
            {
              "name": "'f5_bigip.log.ip_address_intelligence'",
              "value": "(__e['ip_address_intelligence'] && __e['ip_address_intelligence']!=='N/A') ? __e['ip_address_intelligence'].split(',') : undefined"
            },
            {
              "name": "'f5_bigip.log.session_id'",
              "value": "__e['session_id']"
            },
            {
              "name": "'f5_bigip.log.sub_violations'",
              "value": "__e['sub_violations'] ? __e['sub_violations'].split(/[:,]/) : undefined"
            },
            {
              "name": "'f5_bigip.log.virus_name'",
              "value": "(__e['virus_name'] && __e['virus_name']!=='N/A') ? __e['virus_name'] : undefined"
            },
            {
              "name": "'f5_bigip.log.violation_rating'",
              "value": "__e['violation_rating']!==undefined ? Number(__e['violation_rating']) : undefined"
            },
            {
              "name": "'f5_bigip.log.websocket_direction'",
              "value": "(__e['websocket_direction'] && __e['websocket_direction']!=='N/A') ? __e['websocket_direction'] : undefined"
            },
            {
              "name": "'f5_bigip.log.websocket_message_type'",
              "value": "(__e['websocket_message_type'] && __e['websocket_message_type']!=='N/A') ? __e['websocket_message_type'] : undefined"
            },
            {
              "name": "'f5_bigip.log.device_id'",
              "value": "(__e['device_id'] && __e['device_id']!=='N/A') ? __e['device_id'] : undefined"
            },
            {
              "name": "'f5_bigip.log.staged_sig_ids'",
              "value": "__e['staged_sig_ids'] ? __e['staged_sig_ids'].split(',') : undefined"
            },
            {
              "name": "'f5_bigip.log.staged_sig_names'",
              "value": "__e['staged_sig_names'] ? __e['staged_sig_names'].split(',') : undefined"
            },
            {
              "name": "'f5_bigip.log.threat_campaign_names'",
              "value": "__e['threat_campaign_names'] ? __e['threat_campaign_names'].split(',') : undefined"
            },
            {
              "name": "'f5_bigip.log.staged_threat_campaign_names'",
              "value": "__e['staged_threat_campaign_names'] ? __e['staged_threat_campaign_names'].split(',') : undefined"
            },
            {
              "name": "'f5_bigip.log.blocking_exception_reason'",
              "value": "(__e['blocking_exception_reason'] && __e['blocking_exception_reason']!=='N/A') ? __e['blocking_exception_reason'] : undefined"
            },
            {
              "name": "'f5_bigip.log.captcha_result'",
              "value": "__e['captcha_result']"
            },
            {
              "name": "'f5_bigip.log.full_request'",
              "value": "__e['request']"
            }
          ],
          "remove": [
            "policy_name",
            "request_status",
            "response_code",
            "protocol",
            "query_string",
            "x_forwarded_for_header_value",
            "geo_location",
            "username",
            "severity",
            "management_ip_address_2",
            "http_class_name",
            "web_application_name",
            "policy_apply_date",
            "violations",
            "route_domain",
            "sig_ids",
            "sig_names",
            "attack_type",
            "ip_address_intelligence",
            "session_id",
            "sub_violations",
            "virus_name",
            "violation_rating",
            "websocket_direction",
            "websocket_message_type",
            "device_id",
            "staged_sig_ids",
            "staged_sig_names",
            "threat_campaign_names",
            "staged_threat_campaign_names",
            "blocking_exception_reason",
            "captcha_result",
            "request",
            "http_host",
            "http_version",
            "user_agent_raw"
          ]
        },
        "description": "implement every partial/unmapped transform: split every comma/colon-joined multi-value key into an array, drop 'N/A' placeholders rather than indexing them, fix act/outcome direction identically to the CEF route, then drop intermediate parse artifacts"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "__dm_time",
              "value": "__e['date_time'] ? Date.parse(__e['date_time'])/1000 : undefined"
            },
            {
              "name": "_time",
              "value": "__e['__dm_time'] !== undefined && __e['__dm_time'] !== null && __e['__dm_time'] === __e['__dm_time'] ? __e['__dm_time'] : __e['_time']"
            }
          ],
          "remove": [
            "date_time"
          ]
        },
        "description": "date_time is BIG-IP local time with no zone/offset (per-device tz unresolved - recorded as a gap); write to _time per platform constraint 1, never @timestamp"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'event.dataset'",
              "value": "'f5_bigip_asm.request_violation'"
            }
          ]
        },
        "description": "tag the dataset, hyphen-free per platform constraint 5"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
