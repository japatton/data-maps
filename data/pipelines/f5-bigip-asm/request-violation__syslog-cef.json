{
  "id": "dm_f5_bigip_asm_request_violation_syslog_cef",
  "conf": {
    "output": "default",
    "description": "F5 BIG-IP ASM request/violation log, CEF profile: header+extension parse with Label-indirected csN/cnN resolution (cribl-pack mechanism implemented natively, no pack installed)",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "F5 BIG-IP ASM request/violation log, CEF (ArcSight) profile. No CEF/LEEF or F5 ASM packs are installed on this instance, so this replicates the shape recommendations.direct.cribl describes for the pack: parse the CEF header, extract the extension dict, then resolve every csN/cnN through its paired *Label field rather than positionally, since cs4/cn1 mean something else on the attack-event dataset. cs3 (full_request) carries Cookie/Authorization headers; masking it has no defined algorithm in the catalog, so it is left unmasked and recorded as a gap, not guessed."
        },
        "description": "why this pipeline is shaped this way"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/CEF:(?<cefVersion>[^|]*)\\|(?<deviceVendor>[^|]*)\\|(?<deviceProduct>[^|]*)\\|(?<deviceVersion>[^|]*)\\|(?<deviceEventClassId>[^|]*)\\|(?<name>[^|]*)\\|(?<severity>[^|]*)\\|(?<extension>.*)/",
          "source": "_raw",
          "overwrite": true
        },
        "description": "Split the CEF header into its 8 pipe-delimited fields; everything after the 7th pipe is the extension key=value string"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "kvp",
          "srcField": "extension",
          "kvDelim": "=",
          "pairDelim": " "
        },
        "description": "Extract the space-delimited CEF extension dictionary (src, dst, csN/cnN and their csNLabel/cnNLabel pairs, etc.)"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\r?\\nHost:\\s*(?<http_host>[^\\r\\n]+)/i",
          "source": "cs3"
        },
        "description": "Pull the Host header out of the embedded raw HTTP request to build url.full later"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/HTTP\\/(?<http_version>[\\d.]+)/",
          "source": "cs3"
        },
        "description": "Pull the HTTP version out of the embedded raw HTTP request line"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/\\r?\\n[Uu]ser-[Aa]gent:\\s*(?<user_agent_raw>[^\\r\\n]+)/",
          "source": "cs3"
        },
        "description": "Pull the User-Agent header out of the embedded raw HTTP request"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "name",
              "newName": "'rule.name'"
            },
            {
              "currentName": "dvchost",
              "newName": "'observer.hostname'"
            },
            {
              "currentName": "externalId",
              "newName": "'event.id'"
            },
            {
              "currentName": "src",
              "newName": "'source.ip'"
            },
            {
              "currentName": "spt",
              "newName": "'source.port'"
            },
            {
              "currentName": "dst",
              "newName": "'destination.ip'"
            },
            {
              "currentName": "dpt",
              "newName": "'destination.port'"
            },
            {
              "currentName": "requestMethod",
              "newName": "'http.request.method'"
            }
          ]
        },
        "description": "batch rename every status:mapped field with no transform"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'rule.id'",
              "value": "(__e['deviceEventClassId'] && /^[0-9]+$/.test(__e['deviceEventClassId'])) ? __e['deviceEventClassId'] : undefined"
            },
            {
              "name": "'event.severity'",
              "value": "__e['severity'] ? Number(__e['severity']) : undefined"
            },
            {
              "name": "'rule.ruleset'",
              "value": "__e['cs1Label']==='policy_name' ? __e['cs1'] : undefined"
            },
            {
              "name": "'http.response.status_code'",
              "value": "(__e['cn1Label']==='response_code' && __e['cn1']!==undefined && __e['cn1']!=='0') ? Number(__e['cn1']) : undefined"
            },
            {
              "name": "'network.protocol'",
              "value": "__e['app'] ? 'http' : undefined"
            },
            {
              "name": "'tls.established'",
              "value": "__e['app'] ? __e['app'].toUpperCase()==='HTTPS' : undefined"
            },
            {
              "name": "'url.original'",
              "value": "__e['request']"
            },
            {
              "name": "'url.path'",
              "value": "__e['request'] ? __e['request'].split('?')[0] : undefined"
            },
            {
              "name": "'url.query'",
              "value": "(__e['request'] && __e['request'].indexOf('?')>-1) ? __e['request'].split('?').slice(1).join('?') : undefined"
            },
            {
              "name": "'url.domain'",
              "value": "__e['http_host'] ? __e['http_host'].split(':')[0] : undefined"
            },
            {
              "name": "'url.full'",
              "value": "__e['http_host'] ? ((__e['app'] && __e['app'].toUpperCase()==='HTTPS' ? 'https' : 'http') + '://' + __e['http_host'] + (__e['request'] ? __e['request'].split('?')[0] : '')) : undefined"
            },
            {
              "name": "'user_agent.original'",
              "value": "__e['user_agent_raw']"
            },
            {
              "name": "'http.version'",
              "value": "__e['http_version']"
            },
            {
              "name": "'network.forwarded_ip'",
              "value": "(__e['cs5Label']==='x_forwarded_for_header_value' && __e['cs5'] && __e['cs5']!=='N/A') ? __e['cs5'].split(',')[0].trim() : undefined"
            },
            {
              "name": "'source.geo.country_iso_code'",
              "value": "(__e['cs6Label']==='geo_location' && __e['cs6'] && __e['cs6']!=='N/A') ? __e['cs6'] : undefined"
            },
            {
              "name": "'f5_bigip.log.attack.type'",
              "value": "__e['cs4Label']==='attack_type' ? __e['cs4'] : undefined"
            },
            {
              "name": "'f5_bigip.log.full_request'",
              "value": "__e['cs3Label']==='full_request' ? __e['cs3'] : undefined"
            },
            {
              "name": "'event.action'",
              "value": "__e['act'] ? __e['act'].toLowerCase() : undefined"
            },
            {
              "name": "'event.outcome'",
              "value": "(__e['act'] && __e['act'].toLowerCase()==='blocked') ? 'failure' : ((__e['act'] && (__e['act'].toLowerCase()==='alerted' || __e['act'].toLowerCase()==='passed')) ? 'success' : undefined)"
            }
          ],
          "remove": [
            "extension",
            "cefVersion",
            "deviceVendor",
            "deviceProduct",
            "deviceVersion",
            "deviceEventClassId",
            "severity",
            "cs1",
            "cs1Label",
            "cn1",
            "cn1Label",
            "cs3",
            "cs3Label",
            "cs4",
            "cs4Label",
            "cs5",
            "cs5Label",
            "cs6",
            "cs6Label",
            "act",
            "app",
            "request",
            "http_host",
            "http_version",
            "user_agent_raw"
          ]
        },
        "description": "implement every partial/unmapped transform: csN/cnN resolved via their paired *Label per recommendations.direct.cribl (not positionally), N/A placeholders dropped, act/outcome direction fixed once for the whole technology, then drop intermediate parse artifacts"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "__dm_time",
              "value": "__e['rt'] ? Date.parse(__e['rt'])/1000 : undefined"
            },
            {
              "name": "_time",
              "value": "__e['__dm_time'] !== undefined && __e['__dm_time'] !== null && __e['__dm_time'] === __e['__dm_time'] ? __e['__dm_time'] : __e['_time']"
            }
          ],
          "remove": [
            "rt"
          ]
        },
        "description": "CEF rt is BIG-IP local time with no zone/offset (per-device tz unresolved - recorded as a gap); write to _time per platform constraint 1, never @timestamp"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'event.dataset'",
              "value": "'f5_bigip_asm.request_violation'"
            }
          ]
        },
        "description": "tag the dataset, hyphen-free per platform constraint 5"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
