{
  "id": "dm_workspace_one_uem_console_events_syslog_kv",
  "conf": {
    "output": "default",
    "description": "Workspace ONE UEM console audit events, syslog-kv: same admin-authored Message Content template as device-events, filtered to EventType=Console, mapped to ECS.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "console-events/syslog-kv, shares the syslog listener and template with device-events; this pipeline keeps Console only. The vendor lookup 'Request Url' contains a literal space, so kvp extraction of 'Request Url=...' yields a stray empty 'Request' token and a real 'Url' key holding the value - this pipeline reads 'Url' directly and never references the space-bearing name. Query string stripped from url.original (can carry session tokens). MessageText/LogDescription coalesced into message per catalog note; Severity mapped to an inline low/medium/high numeric scale (Information=1, Warning=5, Critical=10) since no ECS numeric convention was specified. EventTimestamp has no UTC offset in the template - see README gap, same as device-events."
        },
        "description": "pipeline purpose, routing key, and documented gaps"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "kvp",
          "srcField": "_raw"
        },
        "description": "extract the admin-authored key=value Message Content fields"
      },
      {
        "id": "drop",
        "filter": "__e['EventType'] !== 'Console'",
        "conf": {},
        "description": "this pipeline serves console-events only; Device records belong to the device-events pipeline on the same syslog listener"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "event.action",
              "value": "__e['Event']"
            },
            {
              "name": "event.outcome",
              "value": "(__e['Event'] && (/Failed$/.test(__e['Event']) || /Denied$/.test(__e['Event']))) ? 'failure' : 'success'"
            },
            {
              "name": "workspace_one.uem.event_type",
              "value": "__e['EventType']"
            },
            {
              "name": "workspace_one.uem.login_session_id",
              "value": "__e['LoginSessionID']"
            },
            {
              "name": "message",
              "value": "__e['MessageText'] ? __e['MessageText'] : __e['LogDescription']"
            },
            {
              "name": "workspace_one.uem.log_description",
              "value": "__e['LogDescription']"
            },
            {
              "name": "event.severity",
              "value": "__e['Severity']==='Critical' ? 10 : (__e['Severity']==='Warning' ? 5 : (__e['Severity']==='Information' ? 1 : undefined))"
            },
            {
              "name": "url.original",
              "value": "__e['Url'] ? __e['Url'].split('?')[0] : undefined"
            },
            {
              "name": "workspace_one.uem.event_category",
              "value": "__e['EventCategory']"
            },
            {
              "name": "event.category",
              "value": "__e['EventCategory']==='Login' ? ['authentication'] : (__e['EventCategory']==='Admin' ? ['iam'] : (__e['EventCategory']==='Group Management' ? ['iam'] : ['configuration']))"
            },
            {
              "name": "workspace_one.uem.event_module",
              "value": "__e['EventModule']"
            },
            {
              "name": "workspace_one.uem.group_management_data",
              "value": "__e['GroupManagementData']"
            },
            {
              "name": "organization.name",
              "value": "__e['OriginatingOrganizationGroup']"
            },
            {
              "name": "_time",
              "value": "Date.parse(__e['EventTimestamp'])/1000"
            },
            {
              "name": "event.dataset",
              "value": "'workspace_one_uem.console_events'"
            }
          ],
          "remove": [
            "EventType",
            "Event",
            "LoginSessionID",
            "MessageText",
            "LogDescription",
            "Severity",
            "Url",
            "Request",
            "EventCategory",
            "EventModule",
            "GroupManagementData",
            "OriginatingOrganizationGroup",
            "EventTimestamp"
          ]
        },
        "description": "map every field to its ECS/custom target, derive outcome/category/severity, strip url query string, remove raw duplicates"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "AdminAccount",
              "newName": "user.name"
            },
            {
              "currentName": "User",
              "newName": "user.target.name"
            },
            {
              "currentName": "EventSource",
              "newName": "event.provider"
            },
            {
              "currentName": "GroupName",
              "newName": "group.name"
            }
          ]
        },
        "description": "rename the remaining strictly 1:1 mapped fields"
      }
    ]
  }
}
