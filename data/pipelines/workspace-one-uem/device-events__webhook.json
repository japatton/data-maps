{
  "id": "dm_workspace_one_uem_device_events_webhook",
  "conf": {
    "output": "default",
    "description": "Workspace ONE UEM device events, webhook: flat JSON POST from Event Notifications, mapped to ECS. Per recommendations.direct.cribl, a distinct step keyed on device.id+event.action is added because fire-and-forget redelivery and cross-feed duplication with the syslog stream is the direct route's stated concern for this format.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "device-events/webhook. Vendor-fixed flat JSON payload (unlike the admin-authored syslog template). No masking implemented for PhoneNumber/DeviceIMEI/SerialNumber: masking is a guard-crossing-only requirement in the catalog and no concrete algorithm was given even there - see README gap. MACAddress arrives with no separators; reformatted to RFC 7042 uppercase-hyphen. event.outcome favors ComplianceStatus (explicit lookup) then falls back to an EventType suffix guess. distinct() approximates the direct recommendation's Udid+EventType dedup within this one Source; true cross-stream dedup against the syslog pipeline needs a downstream/Elastic-side step."
        },
        "description": "pipeline purpose and documented gaps"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "parse the flat JSON webhook body"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "EventType",
              "newName": "'event.action'"
            },
            {
              "currentName": "DeviceFriendlyName",
              "newName": "'host.name'"
            },
            {
              "currentName": "OperatingSystem",
              "newName": "'host.os.version'"
            }
          ]
        },
        "description": "rename the strictly 1:1 mapped fields"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'device.id'",
              "value": "__e['Udid']"
            },
            {
              "name": "'host.id'",
              "value": "__e['Udid']"
            }
          ]
        },
        "description": "Udid feeds both device.id and host.id so webhook records join syslog and host-centric data on one key"
      },
      {
        "id": "distinct",
        "filter": "true",
        "conf": {
          "groupBy": [
            "'device.id'",
            "'event.action'"
          ]
        },
        "description": "best-effort idempotency for fire-and-forget redelivery and cross-feed duplication, per direct.cribl"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'event.code'",
              "value": "__e['EventId']"
            },
            {
              "name": "'workspace_one.uem.device.uem_id'",
              "value": "__e['DeviceId']"
            },
            {
              "name": "'user.target.email'",
              "value": "__e['EnrollmentEmailAddress']"
            },
            {
              "name": "'user.target.name'",
              "value": "__e['EnrollmentUserName']"
            },
            {
              "name": "'workspace_one.uem.enrollment_user_id'",
              "value": "__e['EnrollmentUserId']"
            },
            {
              "name": "_time",
              "value": "Date.parse(__e['EventTime'])/1000"
            },
            {
              "name": "'workspace_one.uem.enrollment_status'",
              "value": "__e['EnrollmentStatus']"
            },
            {
              "name": "'workspace_one.uem.device.compromised_status'",
              "value": "__e['CompromisedStatus']==='True' ? true : (__e['CompromisedStatus']==='False' ? false : null)"
            },
            {
              "name": "'workspace_one.uem.device.compromised_timestamp'",
              "value": "__e['CompromisedTimeStamp']"
            },
            {
              "name": "'workspace_one.uem.device.compliance_status'",
              "value": "__e['ComplianceStatus']"
            },
            {
              "name": "'event.outcome'",
              "value": "__e['ComplianceStatus']==='NonCompliant' ? 'failure' : (__e['ComplianceStatus']==='Compliant' ? 'success' : ((/Failed$/.test(__e['event.action']||'') || /Denied$/.test(__e['event.action']||'')) ? 'failure' : (/Complete$/.test(__e['event.action']||'') ? 'success' : 'unknown')))"
            },
            {
              "name": "'workspace_one.uem.device.phone_number'",
              "value": "__e['PhoneNumber']"
            },
            {
              "name": "'workspace_one.uem.device.serial_number'",
              "value": "__e['SerialNumber']"
            },
            {
              "name": "_mac_norm",
              "value": "__e['MACAddress'] ? __e['MACAddress'].toUpperCase() : undefined"
            },
            {
              "name": "'host.mac'",
              "value": "__e['_mac_norm'] ? __e['_mac_norm'].slice(0,2)+'-'+__e['_mac_norm'].slice(2,4)+'-'+__e['_mac_norm'].slice(4,6)+'-'+__e['_mac_norm'].slice(6,8)+'-'+__e['_mac_norm'].slice(8,10)+'-'+__e['_mac_norm'].slice(10,12) : undefined"
            },
            {
              "name": "'workspace_one.uem.device.imei'",
              "value": "__e['DeviceIMEI']"
            },
            {
              "name": "'workspace_one.uem.device.asset_number'",
              "value": "__e['AssetNumber']"
            },
            {
              "name": "'workspace_one.uem.device.platform'",
              "value": "__e['Platform']"
            },
            {
              "name": "'event.dataset'",
              "value": "'workspace_one_uem.device_events'"
            }
          ],
          "remove": [
            "EventId",
            "DeviceId",
            "EnrollmentEmailAddress",
            "EnrollmentUserName",
            "EnrollmentUserId",
            "EventTime",
            "EnrollmentStatus",
            "CompromisedStatus",
            "CompromisedTimeStamp",
            "ComplianceStatus",
            "PhoneNumber",
            "Udid",
            "SerialNumber",
            "MACAddress",
            "_mac_norm",
            "DeviceIMEI",
            "AssetNumber",
            "Platform"
          ]
        },
        "description": "map remaining fields to ECS/custom targets, derive outcome/mac/boolean normalization, remove raw duplicates"
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
