{
  "id": "dm_workspace_one_uem_intune_managed_device_api_pull",
  "conf": {
    "output": "default",
    "description": "Intune managed device records, api-pull: Cribl REST Collector against Graph deviceManagement/managedDevices, camelCase column-rename pipeline into logs-microsoft_intune.managed_device. event.dataset uses microsoft_intune.managed_device per route_direct's stated data stream. No _time is set: this is a state snapshot with no vendor-designated event timestamp (lastSyncDateTime is explicitly not @timestamp per the catalog), so Cribl's default ingest time stands in for poll time.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "intune-managed-device/api-pull. State snapshot, not an event - no _time override. jailBroken normalized to boolean plus explicit 'unknown' string (source is string True/False/Unknown/empty, not a real boolean). wiFiMacAddress/ethernetMacAddress both feed the host.mac array (RFC 7042 uppercase-hyphen, no separators in source). No masking applied to imei/meid/iccid/phoneNumber: the catalog's direct-route note that masking 'remains the right posture' names no concrete algorithm, so per the masking rule this is left unmasked and recorded as a gap rather than inventing a scheme. Guard-only unchanged-snapshot suppression is not applicable on the direct route."
        },
        "description": "pipeline purpose and documented gaps"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "deviceName",
              "newName": "host.name"
            },
            {
              "currentName": "operatingSystem",
              "newName": "host.os.name"
            },
            {
              "currentName": "osVersion",
              "newName": "host.os.version"
            },
            {
              "currentName": "manufacturer",
              "newName": "device.manufacturer"
            },
            {
              "currentName": "model",
              "newName": "device.model.name"
            },
            {
              "currentName": "userPrincipalName",
              "newName": "user.name"
            },
            {
              "currentName": "emailAddress",
              "newName": "user.email"
            },
            {
              "currentName": "userDisplayName",
              "newName": "user.full_name"
            }
          ]
        },
        "description": "rename the strictly 1:1 mapped fields"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "device.id",
              "value": "__e['id']"
            },
            {
              "name": "host.id",
              "value": "__e['id']"
            },
            {
              "name": "microsoft_intune.managed_device.ownership",
              "value": "__e['managedDeviceOwnerType']"
            },
            {
              "name": "microsoft_intune.managed_device.compliant_state",
              "value": "__e['complianceState']"
            },
            {
              "name": "event.outcome",
              "value": "__e['complianceState']==='compliant' ? 'success' : (__e['complianceState']==='noncompliant' ? 'failure' : 'unknown')"
            },
            {
              "name": "microsoft_intune.managed_device.jail_broken",
              "value": "__e['jailBroken']==='True' ? true : (__e['jailBroken']==='False' ? false : 'unknown')"
            },
            {
              "name": "microsoft_intune.managed_device.serial_number",
              "value": "__e['serialNumber']"
            },
            {
              "name": "microsoft_intune.managed_device.azure_ad_device_id",
              "value": "__e['azureADDeviceId']"
            },
            {
              "name": "_wifi_mac_fmt",
              "value": "__e['wiFiMacAddress'] ? __e['wiFiMacAddress'].toUpperCase().slice(0,2)+'-'+__e['wiFiMacAddress'].toUpperCase().slice(2,4)+'-'+__e['wiFiMacAddress'].toUpperCase().slice(4,6)+'-'+__e['wiFiMacAddress'].toUpperCase().slice(6,8)+'-'+__e['wiFiMacAddress'].toUpperCase().slice(8,10)+'-'+__e['wiFiMacAddress'].toUpperCase().slice(10,12) : undefined"
            },
            {
              "name": "_eth_mac_fmt",
              "value": "__e['ethernetMacAddress'] ? __e['ethernetMacAddress'].toUpperCase().slice(0,2)+'-'+__e['ethernetMacAddress'].toUpperCase().slice(2,4)+'-'+__e['ethernetMacAddress'].toUpperCase().slice(4,6)+'-'+__e['ethernetMacAddress'].toUpperCase().slice(6,8)+'-'+__e['ethernetMacAddress'].toUpperCase().slice(8,10)+'-'+__e['ethernetMacAddress'].toUpperCase().slice(10,12) : undefined"
            },
            {
              "name": "host.mac",
              "value": "[__e['_wifi_mac_fmt'], __e['_eth_mac_fmt']].filter(Boolean)"
            },
            {
              "name": "microsoft_intune.managed_device.imei",
              "value": "__e['imei']"
            },
            {
              "name": "microsoft_intune.managed_device.meid",
              "value": "__e['meid']"
            },
            {
              "name": "microsoft_intune.managed_device.iccid",
              "value": "__e['iccid']"
            },
            {
              "name": "microsoft_intune.managed_device.phone_number",
              "value": "__e['phoneNumber']"
            },
            {
              "name": "microsoft_intune.managed_device.subscriber_carrier",
              "value": "__e['subscriberCarrier']"
            },
            {
              "name": "microsoft_intune.managed_device.management_agent",
              "value": "__e['managementAgent']"
            },
            {
              "name": "microsoft_intune.managed_device.enrollment_type",
              "value": "__e['deviceEnrollmentType']"
            },
            {
              "name": "microsoft_intune.managed_device.is_encrypted",
              "value": "__e['isEncrypted']"
            },
            {
              "name": "microsoft_intune.managed_device.is_supervised",
              "value": "__e['isSupervised']"
            },
            {
              "name": "microsoft_intune.managed_device.partner_reported_threat_state",
              "value": "__e['partnerReportedThreatState']"
            },
            {
              "name": "microsoft_intune.managed_device.android_security_patch_level",
              "value": "__e['androidSecurityPatchLevel']"
            },
            {
              "name": "microsoft_intune.managed_device.enrolled_date_time",
              "value": "__e['enrolledDateTime']"
            },
            {
              "name": "microsoft_intune.managed_device.last_sync_date_time",
              "value": "__e['lastSyncDateTime']"
            },
            {
              "name": "event.dataset",
              "value": "'microsoft_intune.managed_device'"
            }
          ],
          "remove": [
            "id",
            "managedDeviceOwnerType",
            "complianceState",
            "jailBroken",
            "serialNumber",
            "azureADDeviceId",
            "wiFiMacAddress",
            "ethernetMacAddress",
            "_wifi_mac_fmt",
            "_eth_mac_fmt",
            "imei",
            "meid",
            "iccid",
            "phoneNumber",
            "subscriberCarrier",
            "managementAgent",
            "deviceEnrollmentType",
            "isEncrypted",
            "isSupervised",
            "partnerReportedThreatState",
            "androidSecurityPatchLevel",
            "enrolledDateTime",
            "lastSyncDateTime"
          ]
        },
        "description": "map remaining fields to ECS/custom targets, normalize jailBroken/compliance/mac, remove raw duplicates"
      }
    ]
  }
}
