{
  "id": "dm_workspace_one_uem_intune_audit_api_pull",
  "conf": {
    "output": "default",
    "description": "Intune audit logs, api-pull: Cribl REST Collector against Graph deviceManagement/auditEvents, column-rename pipeline into logs-microsoft_intune.audit. event.dataset uses microsoft_intune.audit (not a workspace_one_uem.* name) because route_direct names that exact Elastic data stream.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "intune-audit/api-pull. REST Collector already yields one parsed JS object per auditEvent (nested actor/resources objects, no serde needed). resources[] is unbounded and heterogeneous, so it is kept whole under microsoft_intune.audit.resources (covers the resource.* field-table rows: displayName/type/resourceId/modifiedProperties) rather than exploded per element, mirroring how entra-id's audit pipeline handles TargetResources[] - Cribl eval cannot rename per-element array keys. host.name is best-effort lifted from the first 3 resources[] entries whose type mentions 'device' via a bounded ternary (Cribl eval forbids .find()/loops)."
        },
        "description": "pipeline purpose and array-handling decision"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "id",
              "newName": "event.id"
            },
            {
              "currentName": "activity",
              "newName": "message"
            },
            {
              "currentName": "activityType",
              "newName": "event.action"
            },
            {
              "currentName": "actor.userPrincipalName",
              "newName": "user.name"
            },
            {
              "currentName": "actor.userId",
              "newName": "user.id"
            },
            {
              "currentName": "actor.ipAddress",
              "newName": "source.ip"
            }
          ]
        },
        "description": "rename mapped columns straight to their ECS targets"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "_time",
              "value": "Date.parse(__e['activityDateTime'])/1000"
            },
            {
              "name": "event.outcome",
              "value": "__e['activityResult'] ? __e['activityResult'].toLowerCase() : undefined"
            },
            {
              "name": "microsoft_intune.audit.display_name",
              "value": "__e['displayName']"
            },
            {
              "name": "microsoft_intune.audit.activity_operation_type",
              "value": "__e['activityOperationType']"
            },
            {
              "name": "microsoft_intune.audit.correlation_id",
              "value": "__e['correlationId']"
            },
            {
              "name": "microsoft_intune.audit.component_name",
              "value": "__e['componentName']"
            },
            {
              "name": "microsoft_intune.audit.category",
              "value": "__e['category']"
            },
            {
              "name": "microsoft_intune.audit.actor.type",
              "value": "__e['actor'] ? __e['actor']['type'] : undefined"
            },
            {
              "name": "microsoft_intune.audit.actor.application_id",
              "value": "__e['actor'] ? __e['actor']['applicationId'] : undefined"
            },
            {
              "name": "microsoft_intune.audit.actor.application_name",
              "value": "__e['actor'] ? __e['actor']['applicationDisplayName'] : undefined"
            },
            {
              "name": "microsoft_intune.audit.actor.service_principal_name",
              "value": "__e['actor'] ? __e['actor']['servicePrincipalName'] : undefined"
            },
            {
              "name": "microsoft_intune.audit.actor.user_permissions",
              "value": "__e['actor'] ? __e['actor']['userPermissions'] : undefined"
            },
            {
              "name": "microsoft_intune.audit.resources",
              "value": "__e['resources']"
            },
            {
              "name": "host.name",
              "value": "(__e['resources'] && __e['resources'][0] && __e['resources'][0]['type'] && __e['resources'][0]['type'].toLowerCase().indexOf('device')>=0) ? __e['resources'][0]['displayName'] : ((__e['resources'] && __e['resources'][1] && __e['resources'][1]['type'] && __e['resources'][1]['type'].toLowerCase().indexOf('device')>=0) ? __e['resources'][1]['displayName'] : ((__e['resources'] && __e['resources'][2] && __e['resources'][2]['type'] && __e['resources'][2]['type'].toLowerCase().indexOf('device')>=0) ? __e['resources'][2]['displayName'] : undefined))"
            },
            {
              "name": "event.dataset",
              "value": "'microsoft_intune.audit'"
            }
          ],
          "remove": [
            "displayName",
            "activityResult",
            "activityOperationType",
            "correlationId",
            "componentName",
            "category",
            "actor",
            "resources",
            "activityDateTime"
          ]
        },
        "description": "derive outcome/time, lift actor/resource sub-fields to custom targets, best-effort host.name from resources[]"
      }
    ]
  }
}
