{
  "id": "dm_cribl_internal_internal_metrics_webhook",
  "conf": {
    "output": "default",
    "description": "Cribl Stream internal-metrics via Notification webhook: discriminated-union condition events (health.outputs/system.pq_used/backpressure.outputs/total.in_bytes) plus a license-expiration fallback with no _metric; branch on _metric, derive event.action/event.outcome from the condition, cap+sanitize the three free-text keys per recommendations.direct.cribl.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "internal-metrics/webhook: Notification payload already arrives as parsed JSON fields (Cribl HTTP Source auto-extracts the body). _metric present => branch on it for the 4 documented conditions; _metric absent => the license-expiration shape (severity/title/text)."
        }
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "message",
              "value": "__e['_raw'] ? String(__e['_raw']).substring(0,2000).replace(/[\\x00-\\x1F\\x7F]/g, '') : __e['_raw']"
            },
            {
              "name": "title",
              "value": "__e['title'] ? String(__e['title']).substring(0,500) : __e['title']"
            },
            {
              "name": "text",
              "value": "__e['text'] ? String(__e['text']).substring(0,2000) : __e['text']"
            },
            {
              "name": "'event.action'",
              "value": "__e['_metric'] === 'health.outputs' ? 'destination_unhealthy' : (__e['_metric'] === 'system.pq_used' ? 'queue_usage_threshold' : (__e['_metric'] === 'backpressure.outputs' ? 'backpressure_activated' : (__e['_metric'] === 'total.in_bytes' ? 'source_volume_anomaly' : (typeof __e['severity'] !== 'undefined' ? 'license_expiration' : 'unknown'))))"
            },
            {
              "name": "'event.outcome'",
              "value": "__e['backpressure_type'] === 2 ? 'failure' : (__e['health'] === 2 ? 'failure' : (__e['severity'] === 'fatal' ? 'failure' : 'unknown'))"
            }
          ],
          "remove": [
            "_raw"
          ]
        },
        "description": "Cap+strip control chars from the only three free-text keys (message/title/text) and derive event.action/event.outcome from the condition per recommendations.direct.cribl, rather than from substring tests on text."
      },
      {
        "id": "eval",
        "filter": "typeof __e['severity'] !== 'undefined'",
        "conf": {
          "add": [
            {
              "name": "'log.level'",
              "value": "__e['severity']"
            },
            {
              "name": "'event.severity'",
              "value": "__e['severity'] === 'fatal' ? 1 : 5"
            }
          ],
          "remove": [
            "severity"
          ]
        },
        "description": "License-condition-only branch: warn maps directly to log.level; fatal also raises a numeric event.severity since it has no syslog equivalent and ends the pipeline rather than degrading it."
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "starttime",
              "newName": "'event.start'"
            },
            {
              "currentName": "endtime",
              "newName": "'event.end'"
            },
            {
              "currentName": "cribl_host",
              "newName": "'host.name'"
            },
            {
              "currentName": "cribl_notification",
              "newName": "'rule.name'"
            },
            {
              "currentName": "origin_metadata.type",
              "newName": "'cribl.notification.origin_type'"
            },
            {
              "currentName": "origin_metadata.id",
              "newName": "'cribl.notification.origin_id'"
            },
            {
              "currentName": "origin_metadata.subType",
              "newName": "'cribl.notification.origin_subtype'"
            },
            {
              "currentName": "_metric",
              "newName": "'cribl.metric.name'"
            },
            {
              "currentName": "health",
              "newName": "'cribl.stats.health'"
            },
            {
              "currentName": "output",
              "newName": "'cribl.metric.output'"
            },
            {
              "currentName": "input",
              "newName": "'cribl.metric.input'"
            },
            {
              "currentName": "backpressure_type",
              "newName": "'cribl.backpressure.type'"
            },
            {
              "currentName": "usage",
              "newName": "'cribl.pq.usage_percent'"
            },
            {
              "currentName": "usageThreshold",
              "newName": "'cribl.pq.usage_threshold'"
            },
            {
              "currentName": "bytes",
              "newName": "'cribl.notification.bytes'"
            },
            {
              "currentName": "timeWindow",
              "newName": "'cribl.notification.time_window'"
            },
            {
              "currentName": "title",
              "newName": "'cribl.notification.title'"
            },
            {
              "currentName": "text",
              "newName": "'cribl.notification.text'"
            }
          ]
        },
        "description": "Batch rename of every clean-identifier field to its ECS or cribl.* custom target, done after the discriminator/text-hygiene eval so those steps could still read the original names."
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "'event.dataset'",
              "value": "'cribl_internal.internal_metrics'"
            }
          ]
        },
        "description": "Stamp event.dataset (hyphen-free per ECS data-stream naming)."
      },
      {
        "id": "code",
        "filter": "true",
        "description": "Re-nest flat dotted keys (data-maps canonical step)",
        "conf": {
          "maxNumOfIterations": 5000,
          "code": "const ks = Object.keys(__e).filter(k => !k.startsWith('__') && k.indexOf('.') > 0 && k.split('.').every(s => s !== '')).sort((a, b) => a.split('.').length - b.split('.').length);\nfor (const k of ks) {\n  const parts = k.split('.');\n  const leaf = parts.pop();\n  let t = __e;\n  let ok = true;\n  for (const p of parts) {\n    const v = t[p];\n    if (v !== undefined && (v === null || typeof v !== 'object' || Array.isArray(v))) { ok = false; break; }\n    t = v === undefined ? null : v;\n    if (t === null) break;\n  }\n  if (!ok) continue;\n  t = __e;\n  for (const p of parts) { if (t[p] === undefined) t[p] = {}; t = t[p]; }\n  t[leaf] = __e[k];\n  delete __e[k];\n}"
        }
      }
    ]
  }
}
