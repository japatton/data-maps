{
  "id": "dm_cribl_internal_internal_metrics_json",
  "conf": {
    "output": "default",
    "description": "Cribl Stream internal-metrics, CriblMetrics JSON event feed: roll up 2s samples to 30s per recommendations.direct.cribl, normalize the configurable metric-name prefix, map ECS/custom targets.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "internal-metrics/json: events already arrive as structured Cribl metric fields (no _raw to deserialize). Rollup widens 2s Worker Process cadence to 30s per recommendations.direct.cribl using the same rollup_metrics shape as the built-in cribl_metrics_rollup system pipeline."
        }
      },
      {
        "id": "rollup_metrics",
        "filter": "true",
        "conf": {
          "dimensions": [
            "*"
          ],
          "timeWindow": "30s",
          "gaugeRollup": "last"
        },
        "description": "Widen 2s Worker-Process-granularity metric events to a 30s window before they reach Elastic."
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "cribl.metric.name",
              "value": "__e['_metric'] ? __e['_metric'].replace(/^cribl\\.logstream\\./, '') : __e['_metric']"
            },
            {
              "name": "cribl.metric.value",
              "value": "__e['_value'] !== undefined ? +__e['_value'] : __e['_value']"
            },
            {
              "name": "cribl.worker_group",
              "value": "__e['group'] ? __e['group'] : 'unknown'"
            }
          ],
          "remove": [
            "_metric",
            "_value",
            "group"
          ]
        },
        "description": "Strip the configurable cribl.logstream. prefix off the metric name, coerce _value to a double, and stamp worker-group identity explicitly (defaulting to 'unknown' rather than trusting arrival) per recommendations.direct.cribl."
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "_metric_type",
              "newName": "cribl.metric.type"
            },
            {
              "currentName": "input",
              "newName": "cribl.metric.input"
            },
            {
              "currentName": "output",
              "newName": "cribl.metric.output"
            },
            {
              "currentName": "cribl_wp",
              "newName": "service.node.name"
            },
            {
              "currentName": "event_host",
              "newName": "host.name"
            },
            {
              "currentName": "event_source",
              "newName": "event.module"
            },
            {
              "currentName": "failure_reason",
              "newName": "event.reason"
            },
            {
              "currentName": "status_code",
              "newName": "http.response.status_code"
            },
            {
              "currentName": "reject_reason",
              "newName": "cribl.metric.reject_reason"
            },
            {
              "currentName": "host",
              "newName": "cribl.data.host"
            },
            {
              "currentName": "index",
              "newName": "cribl.data.index"
            }
          ]
        },
        "description": "Batch rename every clean-identifier mapped/partial/unmapped field to its ECS or cribl.* custom target."
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "event.dataset",
              "value": "'cribl_internal.internal_metrics'"
            }
          ]
        },
        "description": "Stamp event.dataset (hyphen-free per ECS data-stream naming)."
      }
    ]
  }
}