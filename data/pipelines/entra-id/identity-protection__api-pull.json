{
  "id": "dm_entra_id_identity_protection_api_pull",
  "conf": {
    "output": "default",
    "description": "entra-id identity-protection dataset, api-pull format: Cribl REST Collector against the Log Analytics Query API (AADUserRiskEvents table), column-rename pipeline into logs-azure.identity_protection. AdditionalInfo and Location arrive as parsed dynamic columns, so sub-field extraction is a property read, not a JSON decode. RiskLevel -> event.severity numeric lookup is deliberately not implemented here (no scale specified in the source map, and hidden/none must be excluded); the raw value is preserved as a custom field instead -- see README gaps. Event time is written to _time rather than a literal '@timestamp' field.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "entra-id / identity-protection / api-pull: one JS object per row, PascalCase columns, AdditionalInfo/Location already parsed dynamics (no decode step needed, unlike the json envelope's escaped-string AdditionalInfo). RiskState is mutable (the same Id is re-emitted as it changes state) -- this pipeline does not dedupe/upsert, that is a downstream Elastic-side concern per the map's recommendations. ActivityDateTime is converted to epoch seconds and written to _time, since Cribl's property-accessor parser rejects a literal '@' in a field name."
        },
        "description": "document dynamic-column assumption, RiskState mutability caveat, and _time-vs-@timestamp platform constraint",
        "final": false,
        "disabled": false
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "TimeGenerated",
              "newName": "event.ingested"
            },
            {
              "currentName": "Id",
              "newName": "event.id"
            },
            {
              "currentName": "OperationName",
              "newName": "event.action"
            },
            {
              "currentName": "UserPrincipalName",
              "newName": "user.name"
            },
            {
              "currentName": "UserId",
              "newName": "user.id"
            },
            {
              "currentName": "UserDisplayName",
              "newName": "user.full_name"
            },
            {
              "currentName": "IpAddress",
              "newName": "source.ip"
            }
          ]
        },
        "description": "rename mapped columns straight to their ECS targets",
        "final": false,
        "disabled": false
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "_time",
              "value": "new Date(__e['ActivityDateTime']).getTime()/1000"
            },
            {
              "name": "azure.identity_protection.properties.detected_datetime",
              "value": "__e['DetectedDateTime']"
            },
            {
              "name": "azure.identity_protection.properties.last_updated_datetime",
              "value": "__e['LastUpdatedDateTime']"
            },
            {
              "name": "azure.identity_protection.properties.risk_event_type",
              "value": "__e['RiskEventType']"
            },
            {
              "name": "azure.identity_protection.properties.risk_level",
              "value": "__e['RiskLevel']"
            },
            {
              "name": "azure.identity_protection.properties.risk_state",
              "value": "__e['RiskState']"
            },
            {
              "name": "azure.identity_protection.properties.risk_detail",
              "value": "__e['RiskDetail']"
            },
            {
              "name": "azure.identity_protection.properties.detection_timing_type",
              "value": "__e['DetectionTimingType']"
            },
            {
              "name": "azure.identity_protection.properties.activity",
              "value": "__e['Activity']"
            },
            {
              "name": "source.geo.country_iso_code",
              "value": "__e['Location'] && __e['Location'].countryOrRegion"
            },
            {
              "name": "source.geo.city_name",
              "value": "__e['Location'] && __e['Location'].city"
            },
            {
              "name": "azure.identity_protection.properties.source",
              "value": "__e['Source']"
            },
            {
              "name": "azure.identity_protection.properties.correlation_id",
              "value": "__e['CorrelationId']"
            },
            {
              "name": "azure.identity_protection.properties.request_id",
              "value": "__e['RequestId']"
            },
            {
              "name": "azure.identity_protection.properties.token_issuer_type",
              "value": "__e['TokenIssuerType']"
            },
            {
              "name": "azure.identity_protection.properties.additional_info",
              "value": "__e['AdditionalInfo']"
            },
            {
              "name": "user_agent.original",
              "value": "__e['AdditionalInfo'] && __e['AdditionalInfo'].userAgent"
            },
            {
              "name": "related.ip",
              "value": "__e['AdditionalInfo'] && __e['AdditionalInfo'].clientIp"
            },
            {
              "name": "event.dataset",
              "value": "'entra_id.identity_protection'"
            }
          ]
        },
        "description": "set _time from ActivityDateTime, route unmapped columns to their azure.identity_protection.* custom targets, implement the field-table transforms (Location city/country extraction, AdditionalInfo userAgent/clientIp lift), and tag event.dataset",
        "final": false,
        "disabled": false
      }
    ]
  }
}
