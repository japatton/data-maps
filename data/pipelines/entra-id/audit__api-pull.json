{
  "id": "dm_entra_id_audit_api_pull",
  "conf": {
    "output": "default",
    "description": "entra-id audit dataset, api-pull format: Cribl REST Collector against the Log Analytics Query API (AuditLogs table), column-rename pipeline into logs-azure.auditlogs. InitiatedBy and TargetResources arrive as parsed dynamic columns, so sub-field extraction is a property read, not a JSON decode. Event time is written to _time (epoch seconds) rather than a literal '@timestamp' field, which Cribl's property-accessor parser rejects.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "entra-id / audit / api-pull: one JS object per row, PascalCase columns, InitiatedBy/TargetResources/AdditionalDetails already parsed dynamics (no decode step needed). TargetResources is preserved as a single nested array under azure.auditlogs.properties.target_resources rather than exploded per sub-attribute, since it is an unbounded heterogeneous array and Cribl eval cannot rename per-element keys without changing event cardinality -- the map recommends mapping it nested anyway. user.target.name/id and the AdditionalDetails User-Agent lift use a bounded ternary over the first 3 (resp. 5) entries instead of .find(), because Cribl's eval forbids function/arrow declarations (confirmed against this instance: 'cannot have nested scopes' / 'cannot have any declarations'). AADTenantId is the Entra tenant, not TenantId (workspace GUID). ActivityDateTime is written to _time (epoch seconds), not a literal '@timestamp' field, which this instance's property-accessor parser rejects."
        },
        "description": "document TargetResources array-handling decision, no-function-scope constraint, and _time-vs-@timestamp platform constraint",
        "final": false,
        "disabled": false
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "TimeGenerated",
              "newName": "event.ingested"
            },
            {
              "currentName": "Id",
              "newName": "event.id"
            },
            {
              "currentName": "ActivityDisplayName",
              "newName": "event.action"
            },
            {
              "currentName": "LoggedByService",
              "newName": "event.provider"
            },
            {
              "currentName": "ResultReason",
              "newName": "event.reason"
            },
            {
              "currentName": "InitiatedBy.user.id",
              "newName": "user.id"
            }
          ]
        },
        "description": "rename mapped columns straight to their ECS targets",
        "final": false,
        "disabled": false
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "_time",
              "value": "new Date(__e['ActivityDateTime']).getTime()/1000"
            },
            {
              "name": "azure.auditlogs.operation_name",
              "value": "__e['OperationName']"
            },
            {
              "name": "azure.auditlogs.aad_operation_type",
              "value": "__e['AADOperationType']"
            },
            {
              "name": "azure.auditlogs.category",
              "value": "__e['Category']"
            },
            {
              "name": "event.outcome",
              "value": "__e['Result'] === 'success' ? 'success' : (__e['Result'] === 'failure' ? 'failure' : 'unknown')"
            },
            {
              "name": "azure.auditlogs.result_type",
              "value": "__e['ResultType']"
            },
            {
              "name": "user.name",
              "value": "__e['InitiatedBy'] && __e['InitiatedBy'].user && __e['InitiatedBy'].user.userPrincipalName"
            },
            {
              "name": "source.ip",
              "value": "__e['InitiatedBy'] && __e['InitiatedBy'].user && __e['InitiatedBy'].user.ipAddress"
            },
            {
              "name": "azure.auditlogs.properties.initiated_by.app.display_name",
              "value": "__e['InitiatedBy'] && __e['InitiatedBy'].app && __e['InitiatedBy'].app.displayName"
            },
            {
              "name": "azure.auditlogs.properties.initiated_by.app.service_principal_id",
              "value": "__e['InitiatedBy'] && __e['InitiatedBy'].app && __e['InitiatedBy'].app.servicePrincipalId"
            },
            {
              "name": "azure.auditlogs.properties.target_resources",
              "value": "__e['TargetResources']"
            },
            {
              "name": "user.target.name",
              "value": "TargetResources ? ((TargetResources[0] && TargetResources[0].type==='User') ? (TargetResources[0].userPrincipalName) : ((TargetResources[1] && TargetResources[1].type==='User') ? (TargetResources[1].userPrincipalName) : ((TargetResources[2] && TargetResources[2].type==='User') ? (TargetResources[2].userPrincipalName) : (null)))) : null"
            },
            {
              "name": "user.target.id",
              "value": "TargetResources ? ((TargetResources[0] && TargetResources[0].type==='User') ? (TargetResources[0].id) : ((TargetResources[1] && TargetResources[1].type==='User') ? (TargetResources[1].id) : ((TargetResources[2] && TargetResources[2].type==='User') ? (TargetResources[2].id) : (null)))) : null"
            },
            {
              "name": "user_agent.original",
              "value": "__e['AdditionalDetails'] ? ((__e['AdditionalDetails'][0] && __e['AdditionalDetails'][0].key==='User-Agent') ? (__e['AdditionalDetails'][0].value) : ((__e['AdditionalDetails'][1] && __e['AdditionalDetails'][1].key==='User-Agent') ? (__e['AdditionalDetails'][1].value) : ((__e['AdditionalDetails'][2] && __e['AdditionalDetails'][2].key==='User-Agent') ? (__e['AdditionalDetails'][2].value) : ((__e['AdditionalDetails'][3] && __e['AdditionalDetails'][3].key==='User-Agent') ? (__e['AdditionalDetails'][3].value) : ((__e['AdditionalDetails'][4] && __e['AdditionalDetails'][4].key==='User-Agent') ? (__e['AdditionalDetails'][4].value) : (null)))))) : null"
            },
            {
              "name": "azure.auditlogs.identity",
              "value": "__e['Identity']"
            },
            {
              "name": "azure.auditlogs.datacenter_location",
              "value": "__e['Location']"
            },
            {
              "name": "azure.tenant_id",
              "value": "__e['AADTenantId']"
            },
            {
              "name": "event.dataset",
              "value": "'entra_id.audit'"
            }
          ]
        },
        "description": "set _time from ActivityDateTime, route unmapped columns to their azure.auditlogs.* custom targets, implement the field-table transforms (Result normalization with timeout/unknownFutureValue -> unknown, User-typed TargetResources extraction, additionalDetails User-Agent lift), and tag event.dataset",
        "final": false,
        "disabled": false
      }
    ]
  }
}
