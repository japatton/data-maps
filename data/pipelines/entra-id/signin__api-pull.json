{
  "id": "dm_entra_id_signin_api_pull",
  "conf": {
    "output": "default",
    "description": "entra-id signin dataset, api-pull format: Cribl REST Collector against the Log Analytics Query API (SigninLogs + 3 sibling tables), column-rename pipeline into logs-azure.signinlogs. Renames PascalCase columns to the resource-log/ECS shape the stock azure.signinlogs pipeline expects; no re-parsing of an already-structured event. Cribl cannot hold a literal '@timestamp' field (the property-accessor parser rejects the '@'), so the event-time column is written to Cribl's own _time (epoch seconds), which the Elastic destination maps to @timestamp -- this is the standard Cribl pattern, not a workaround.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "entra-id / signin / api-pull: events arrive as one JS object per row with PascalCase column keys (including dotted dynamic sub-fields such as DeviceDetail.deviceId), already reshaped by the REST Collector from the Log Analytics columns/rows table -- no _raw deserialization step is needed here. AADTenantId is the Entra tenant; the sibling TenantId column (Log Analytics workspace GUID) is deliberately never referenced. CreatedDateTime is converted to epoch seconds and written to _time rather than '@timestamp', since Cribl's property-accessor parser rejects a literal '@' in a field name (confirmed against this instance)."
        },
        "description": "document event shape assumption and the _time-vs-@timestamp platform constraint",
        "final": false,
        "disabled": false
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "TimeGenerated",
              "newName": "event.ingested"
            },
            {
              "currentName": "Id",
              "newName": "event.id"
            },
            {
              "currentName": "OperationName",
              "newName": "event.action"
            },
            {
              "currentName": "UserPrincipalName",
              "newName": "user.name"
            },
            {
              "currentName": "UserDisplayName",
              "newName": "user.full_name"
            },
            {
              "currentName": "UserId",
              "newName": "user.id"
            },
            {
              "currentName": "IPAddress",
              "newName": "source.ip"
            },
            {
              "currentName": "UserAgent",
              "newName": "user_agent.original"
            },
            {
              "currentName": "ResultDescription",
              "newName": "error.message"
            }
          ]
        },
        "description": "rename mapped columns straight to their ECS targets",
        "final": false,
        "disabled": false
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "_time",
              "value": "new Date(__e['CreatedDateTime']).getTime()/1000"
            },
            {
              "name": "azure.signinlogs.is_interactive",
              "value": "__e['IsInteractive']"
            },
            {
              "name": "azure.signinlogs.properties.user_type",
              "value": "__e['UserType']"
            },
            {
              "name": "azure.signinlogs.properties.app_display_name",
              "value": "__e['AppDisplayName']"
            },
            {
              "name": "service.target.name",
              "value": "__e['ResourceDisplayName']"
            },
            {
              "name": "azure.signinlogs.properties.resource_id",
              "value": "__e['ResourceIdentity']"
            },
            {
              "name": "source.as.number",
              "value": "Number(__e['AutonomousSystemNumber'])"
            },
            {
              "name": "azure.signinlogs.properties.client_app_used",
              "value": "__e['ClientAppUsed']"
            },
            {
              "name": "azure.signinlogs.properties.conditional_access_status",
              "value": "__e['ConditionalAccessStatus']"
            },
            {
              "name": "azure.signinlogs.properties.applied_conditional_access_policies",
              "value": "__e['ConditionalAccessPolicies']"
            },
            {
              "name": "azure.signinlogs.properties.authentication_requirement",
              "value": "__e['AuthenticationRequirement']"
            },
            {
              "name": "azure.signinlogs.properties.risk_level_during_signin",
              "value": "__e['RiskLevelDuringSignIn']"
            },
            {
              "name": "azure.signinlogs.properties.risk_level_aggregated",
              "value": "__e['RiskLevelAggregated']"
            },
            {
              "name": "azure.signinlogs.properties.risk_event_types_v2",
              "value": "__e['RiskEventTypes_V2']"
            },
            {
              "name": "event.outcome",
              "value": "(__e['ResultType'] === '0' || __e['ResultType'] === 0) ? 'success' : 'failure'"
            },
            {
              "name": "azure.signinlogs.properties.result_code",
              "value": "__e['ResultType']"
            },
            {
              "name": "azure.signinlogs.properties.status",
              "value": "__e['Status']"
            },
            {
              "name": "device.id",
              "value": "__e['DeviceDetail'] && __e['DeviceDetail'].deviceId"
            },
            {
              "name": "source.geo.country_iso_code",
              "value": "__e['Location']"
            },
            {
              "name": "source.geo.city_name",
              "value": "__e['LocationDetails'] && __e['LocationDetails'].city"
            },
            {
              "name": "source.geo.region_name",
              "value": "__e['LocationDetails'] && __e['LocationDetails'].state"
            },
            {
              "name": "azure.signinlogs.properties.service_principal_name",
              "value": "__e['ServicePrincipalName']"
            },
            {
              "name": "azure.signinlogs.properties.service_principal_id",
              "value": "__e['ServicePrincipalId']"
            },
            {
              "name": "azure.signinlogs.properties.correlation_id",
              "value": "__e['CorrelationId']"
            },
            {
              "name": "azure.tenant_id",
              "value": "__e['AADTenantId']"
            },
            {
              "name": "event.dataset",
              "value": "'entra_id.signin'"
            }
          ]
        },
        "description": "set Cribl's _time from CreatedDateTime, route unmapped columns to their azure.signinlogs.* custom targets, implement the field-table transforms (AADSTS 0/non-zero outcome + preserved result code, ASN string-to-long cast, DeviceDetail/Location/LocationDetails sub-field extraction), and tag event.dataset",
        "final": false,
        "disabled": false
      }
    ]
  }
}
