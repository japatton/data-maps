{
  "id": "dm_printers_mfd_scan_send_jobs_syslog_cef",
  "conf": {
    "output": "default",
    "description": "printers-mfd scan-send-jobs dataset, syslog-cef format (Xerox branch): CEF header+extension decode via regex_extract+serde kvp, job class/destination channel keyed on the numeric Device Event Class ID rather than a free-text summary; shares the mfd.* schema with the HP branch.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "printers-mfd / scan-send-jobs / syslog-cef: Xerox job-completion messages on the same SIEM CEF stream as the device-security-syslog CEF branch, separated downstream by the numeric Device Event Class ID (5 Print, 6 Network Scan, 9 Email, 74 Scan to USB, etc.) rather than a free-text summary -- the advantage over the HP form the map calls out explicitly. Same regex_extract+serde-kvp decode as the security CEF branch (the 'cef' function's conf shape could not be validated live -- see that pipeline's comment and the README). PRI supplies only log.syslog.facility.code; the CEF Severity header is authoritative for log.syslog.severity.code, for the same double-writer reason as the security branch. As on the HP form, recipient-level attribution stays out of scope: fname/xrxjob1 carry a filename or job title on some job families but never a destination value."
        },
        "description": "record the shared CEF decode approach, the PRI/Severity de-duplication decision, and the recipient-attribution scope limit"
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/^<(?<pri>\\d+)>(?<ts>\\S+)\\s+(?<host>\\S+)\\s+CEF:\\d+\\|(?<dvendor>[^|]*)\\|(?<dproduct>[^|]*)\\|(?<dversion>[^|]*)\\|(?<devclassid>[^|]*)\\|(?<name>[^|]*)\\|(?<sev>[^|]*)\\|(?<ext_raw>.*)$/s",
          "source": "_raw"
        },
        "description": "split the syslog PRI/timestamp/hostname header and the CEF pipe-delimited header fields from the extension block"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "kvp",
          "srcField": "ext_raw"
        },
        "description": "extract the CEF extension key=value pairs (suser, duser, src, dst, fname, xrxjob1, fileType, sourceServiceName, act, outcome, msg, xrxaccUID1, xrxaccAID1)"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "host",
              "newName": "observer.hostname"
            },
            {
              "currentName": "dvendor",
              "newName": "observer.vendor"
            },
            {
              "currentName": "dproduct",
              "newName": "observer.product"
            },
            {
              "currentName": "dversion",
              "newName": "observer.version"
            },
            {
              "currentName": "devclassid",
              "newName": "event.code"
            },
            {
              "currentName": "name",
              "newName": "event.action"
            },
            {
              "currentName": "sev",
              "newName": "log.syslog.severity.code"
            },
            {
              "currentName": "duser",
              "newName": "destination.user.name"
            },
            {
              "currentName": "fname",
              "newName": "file.name"
            },
            {
              "currentName": "msg",
              "newName": "message"
            }
          ]
        },
        "description": "batch-rename the straight-copy status:mapped/partial fields to their ECS targets"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "log.syslog.priority",
              "value": "Number(__e['pri'])"
            },
            {
              "name": "log.syslog.facility.code",
              "value": "Math.floor(Number(__e['pri'])/8)"
            },
            {
              "name": "event.severity",
              "value": "7 - Number(log.syslog.severity.code)"
            },
            {
              "name": "user.domain",
              "value": "(__e['suser'] && __e['suser'].indexOf('@')==-1 && __e['suser'].indexOf('\\\\')>-1) ? __e['suser'].split('\\\\')[0] : undefined"
            },
            {
              "name": "user.name",
              "value": "__e['suser'] ? (__e['suser'].indexOf('@')>-1 ? __e['suser'] : (__e['suser'].indexOf('\\\\')>-1 ? __e['suser'].split('\\\\')[1] : __e['suser'])) : __e['suser']"
            },
            {
              "name": "source.address",
              "value": "__e['src']"
            },
            {
              "name": "source.ip",
              "value": "(__e['src'] && (/^(\\d{1,3}\\.){3}\\d{1,3}$/.test(__e['src']) || __e['src'].indexOf(':')>-1)) ? __e['src'] : undefined"
            },
            {
              "name": "destination.address",
              "value": "__e['dst']"
            },
            {
              "name": "destination.ip",
              "value": "(__e['dst'] && (/^(\\d{1,3}\\.){3}\\d{1,3}$/.test(__e['dst']) || __e['dst'].indexOf(':')>-1)) ? __e['dst'] : undefined"
            },
            {
              "name": "mfd.job.name",
              "value": "__e['xrxjob1']"
            },
            {
              "name": "mfd.job.file_type",
              "value": "__e['fileType']"
            },
            {
              "name": "mfd.job.source_service",
              "value": "__e['sourceServiceName']"
            },
            {
              "name": "mfd.job.image_overwrite_status",
              "value": "__e['act']"
            },
            {
              "name": "event.outcome",
              "value": "__e['outcome']=='success' ? 'success' : __e['outcome']=='failure' ? 'failure' : (__e['outcome']!=null) ? 'unknown' : undefined"
            },
            {
              "name": "mfd.job.outcome_raw",
              "value": "__e['outcome']"
            },
            {
              "name": "mfd.accounting.user_id",
              "value": "__e['xrxaccUID1']"
            },
            {
              "name": "mfd.accounting.account_id",
              "value": "__e['xrxaccAID1']"
            }
          ],
          "remove": [
            "pri",
            "suser",
            "src",
            "dst",
            "xrxjob1",
            "fileType",
            "sourceServiceName",
            "act",
            "outcome",
            "xrxaccUID1",
            "xrxaccAID1",
            "ext_raw"
          ]
        },
        "description": "decompose PRI's facility code, invert Severity into event.severity, split/recognise suser as realm-prefixed or an email address, gate source/destination.ip on looking like an address, fold event.outcome, and route the Xerox job/accounting fields to mfd.job.*/mfd.accounting.*"
      },
      {
        "id": "auto_timestamp",
        "filter": "true",
        "conf": {
          "srcField": "ts",
          "dstField": "_time"
        },
        "description": "set Cribl's canonical event time from the syslog header's already-RFC3339 timestamp (never write @timestamp directly)"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "event.dataset",
              "value": "'printers_mfd.scan_send_jobs'"
            }
          ]
        },
        "description": "tag the event with its dataset (shared with the HP branch; no hyphens per the Elastic data-stream naming constraint)"
      }
    ]
  }
}
