{
  "id": "dm_bluecat_dns_activity_json",
  "conf": {
    "output": "default",
    "description": "BlueCat DDI dns-activity / json: dnstap JSON parses natively; the work is ECS renaming and flattening requestData/responseData, per recommendations.direct.cribl -- scaling the nanosecond epoch time, collapsing the six header-flag booleans into one dns.header_flags array, and lowercasing socketProtocol.",
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "bluecat / dns-activity / json. BDDS dnstap feature, JSON over HTTP/TCP. No vendor pack or Elastic integration exists. Flattens requestData/responseData and fixes the nanosecond time field per the work order's documented sample. Direct route, no guard hop."
        },
        "description": "record dataset, format, and the flattening approach"
      },
      {
        "id": "serde",
        "filter": "true",
        "conf": {
          "mode": "extract",
          "type": "json",
          "srcField": "_raw"
        },
        "description": "parse the dnstap JSON body"
      },
      {
        "id": "rename",
        "filter": "true",
        "conf": {
          "rename": [
            {
              "currentName": "serverId",
              "newName": "observer.name"
            },
            {
              "currentName": "serverVersion",
              "newName": "observer.version"
            },
            {
              "currentName": "sourceAddress",
              "newName": "source.ip"
            },
            {
              "currentName": "sourcePort",
              "newName": "source.port"
            },
            {
              "currentName": "responseAddress",
              "newName": "destination.ip"
            }
          ]
        },
        "description": "batch-rename the clean top-level mapped fields to their ECS targets"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            {
              "name": "network.transport",
              "value": "__e['socketProtocol'] !== undefined ? __e['socketProtocol'].toLowerCase() : undefined"
            },
            {
              "name": "network.type",
              "value": "__e['socketFamily']==='INET' ? 'ipv4' : (__e['socketFamily']==='INET6' ? 'ipv6' : undefined)"
            },
            {
              "name": "bluecat.bdds.dnstap.message_type",
              "value": "__e['messageType']"
            },
            {
              "name": "dns.type",
              "value": "__e['messageType'] !== undefined && __e['messageType'].indexOf('Query')>=0 ? 'query' : (__e['messageType'] !== undefined && __e['messageType'].indexOf('Response')>=0 ? 'answer' : undefined)"
            },
            {
              "name": "network.direction",
              "value": "__e['messageType']==='ClientQuery' || __e['messageType']==='ClientResponse' || __e['messageType']==='AuthQuery' || __e['messageType']==='AuthResponse' ? 'inbound' : (__e['messageType']==='ResolverQuery' || __e['messageType']==='ResolverResponse' ? 'outbound' : undefined)"
            },
            {
              "name": "_time",
              "value": "__e['timePrecision']==='ns' ? __e['time']/1e9 : (__e['timePrecision']==='us' ? __e['time']/1e6 : (__e['timePrecision']==='ms' ? __e['time']/1e3 : __e['time']))"
            },
            {
              "name": "dns.id",
              "value": "__e.requestData!==undefined && __e.requestData.header!==undefined && __e.requestData.header.id!==undefined ? String(__e.requestData.header.id) : undefined"
            },
            {
              "name": "dns.op_code",
              "value": "__e.requestData!==undefined && __e.requestData.header!==undefined && __e.requestData.header.opcode===0 ? 'QUERY' : (__e.requestData!==undefined && __e.requestData.header!==undefined && __e.requestData.header.opcode===4 ? 'NOTIFY' : (__e.requestData!==undefined && __e.requestData.header!==undefined && __e.requestData.header.opcode===5 ? 'UPDATE' : (__e.requestData!==undefined && __e.requestData.header!==undefined && __e.requestData.header.opcode!==undefined ? String(__e.requestData.header.opcode) : undefined)))"
            },
            {
              "name": "dns.header_flags",
              "value": "__e.requestData!==undefined && __e.requestData.header!==undefined ? [__e.requestData.header.aa ? 'AA' : null, __e.requestData.header.ad ? 'AD' : null, __e.requestData.header.cd ? 'CD' : null, __e.requestData.header.ra ? 'RA' : null, __e.requestData.header.rd ? 'RD' : null, __e.requestData.header.tc ? 'TC' : null].filter(Boolean) : undefined"
            },
            {
              "name": "dns.response_code",
              "value": "__e.requestData!==undefined && __e.requestData.rcodeName!==undefined ? __e.requestData.rcodeName.toUpperCase() : undefined"
            },
            {
              "name": "dns.question.name",
              "value": "__e.requestData!==undefined && __e.requestData.question!==undefined && __e.requestData.question[0]!==undefined && __e.requestData.question[0].domainName!==undefined ? __e.requestData.question[0].domainName.replace(/\\.$/, '').toLowerCase() : undefined"
            },
            {
              "name": "dns.question.type",
              "value": "__e.requestData!==undefined && __e.requestData.question!==undefined && __e.requestData.question[0]!==undefined ? __e.requestData.question[0].questionType : undefined"
            },
            {
              "name": "dns.question.class",
              "value": "__e.requestData!==undefined && __e.requestData.question!==undefined && __e.requestData.question[0]!==undefined ? __e.requestData.question[0].class : undefined"
            },
            {
              "name": "bluecat.bdds.dnstap.key",
              "value": "__e['key']"
            },
            {
              "name": "event.dataset",
              "value": "'bluecat.dns_activity'"
            }
          ]
        },
        "description": "derive ECS fields needing transforms: nanosecond time scaling, opcode/header-flag/rcode lookups, and nested question extraction"
      },
      {
        "id": "code",
        "filter": "true",
        "conf": {
          "code": "if (__e.responseData !== undefined && Array.isArray(__e.responseData.answers)) { var answers = __e.responseData.answers; var mapped = []; var resolved = []; for (var i = 0; i < answers.length; i++) { var a = answers[i]; mapped.push({data: a.rData, type: a.recordType, ttl: a.ttl}); if (a.recordType === 'A' || a.recordType === 'AAAA') { resolved.push(a.rData); } } __e.dns = __e.dns || {}; __e.dns.answers = mapped; if (resolved.length > 0) { __e.dns.resolved_ip = resolved; } }"
        },
        "description": "flatten responseData.answers[] into dns.answers[] and populate dns.resolved_ip for A/AAAA records (requires iteration, not a single eval expression)"
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "remove": [
            "requestData",
            "responseData",
            "socketProtocol",
            "socketFamily",
            "messageType",
            "timePrecision",
            "time"
          ]
        },
        "description": "drop the now-flattened nested vendor objects and superseded scalar fields"
      }
    ]
  }
}
