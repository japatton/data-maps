{% if fv.data.enable %}<p class="enable"><strong>Enable:</strong> {{ fv.data.enable }}</p>{% endif %}
{% if fv.data.references %}
<ul class="refs refs-format">
{% for ref in fv.data.references %}
<li>{{ ref }}</li>
{% endfor %}
</ul>
{% endif %}
{% if fv.recommended and fv.recommended_source == "override" %}
{% if ds.coverage_favours %}
<p class="recommendation-note">Coverage favours <code>{{ ds.coverage_favours.data.format }}</code> ({{ ds.coverage_favours.required_mapped|length }}/{{ ds.coverage_favours.required|length }}); recommended <code>{{ fv.data.format }}</code> because {{ fv.data.recommended_because }}</p>
{% else %}
<p class="recommendation-note"><strong>Recommended:</strong> {{ fv.data.recommended_because }}</p>
{% endif %}
{% endif %}
<p class="parsing"><span class="chip">{{ fv.data.parsing.mechanism }}</span>
{% if fv.data.parsing.artifact %} {{ fv.data.parsing.artifact }}{% endif %}
{% if fv.data.parsing.notes %} — {{ fv.data.parsing.notes }}{% endif %}</p>
{% if fv.data.recommendations %}
{% for side in ("guarded", "direct") %}
{% if fv.data.recommendations[side] %}
{% set recs = fv.data.recommendations[side] %}
<div class="recs {% if ds.data.route.guarded %}recs-{{ side }}{% endif %}">
{% if recs.parse_location %}<span class="chip chip-parse">parse: {{ recs.parse_location }}</span>{% if fv.parse_agrees[side] is sameas false %}<span class="parse-provenance parse-conflict">doctrine says {{ fv.parse_doctrine[side] }}</span>{% elif fv.parse_agrees[side] %}<span class="parse-provenance">doctrine</span>{% else %}<span class="parse-provenance">judgment</span>{% endif %}{% endif %}
{% if recs.cribl %}<p class="rec"><strong>Cribl:</strong> {{ recs.cribl }}</p>{% endif %}
{% if recs.elastic %}<p class="rec"><strong>Elastic:</strong> {{ recs.elastic }}</p>{% endif %}
{% if recs.relay %}<p class="rec"><strong>Relay:</strong> {{ recs.relay }}</p>{% endif %}
</div>
{% endif %}
{% endfor %}
{% endif %}
<p class="coverage-line">Alerting coverage {{ fv.required_pct }}% ({{ fv.required_mapped|length }}/{{ fv.required|length }} required fields) · {{ fv.fields_mapped }}/{{ fv.fields_total }} fields mapped</p>
{% if fv.recommended and ds.switch_gain %}
<p class="switch-gain">Switching to <code>{{ ds.switch_gain.format }}</code> would satisfy {{ ds.switch_gain.count }} more alerting field{% if ds.switch_gain.count != 1 %}s{% endif %}: {% for name in ds.switch_gain.fields %}<code>{{ name }}</code>{% if not loop.last %}, {% endif %}{% endfor %}</p>
{% endif %}
{% if fv.data.fields_omitted %}
<p class="fields-omitted"><strong>No field table:</strong> {{ fv.data.fields_omitted }}</p>
{% else %}
<div class="table-wrap">
<table>
<thead><tr><th>Vendor field</th><th>Type</th><th>Description</th><th>ECS</th><th>Custom</th><th>Transform</th><th>Status</th><th>Alerting</th></tr></thead>
<tbody>
{% for fw in fv.fields %}
<tr>
<td class="mono">{{ fw.field.vendor }}</td>
<td>{{ fw.field.type or '' }}</td>
<td>{{ fw.field.description or '' }}</td>
<td class="mono">{{ fw.field.ecs or '' }}</td>
<td class="mono">{{ fw.field.custom or '' }}</td>
<td>{{ fw.field.transform or '' }}{% if fw.field.notes %} {{ fw.field.notes }}{% endif %}</td>
<td><span class="badge badge-field-{{ fw.field.status }}">{{ fw.field.status }}</span></td>
<td>{% if fw.alerting %}<span class="alert-dot" title="required by an alerting profile"></span>{% endif %}</td>
</tr>
{% endfor %}
</tbody>
</table>
</div>
{% endif %}
