{% extends "base.html.j2" %}
{% block content %}
<section>
<div class="cards">
<div class="stat-card"><div class="stat-value">{{ model.summary.technologies }}</div><div class="stat-label">technologies</div></div>
<div class="stat-card"><div class="stat-value">{{ model.summary.datasets }}</div><div class="stat-label">datasets</div></div>
<div class="stat-card"><div class="stat-value">{{ model.summary.required_pct }}%</div><div class="stat-label">alerting coverage</div></div>
<div class="stat-card"><div class="stat-value">{{ model.summary.by_status['mapped'] }}</div><div class="stat-label">mapped</div></div>
<div class="stat-card"><div class="stat-value">{{ model.summary.drafts }}</div><div class="stat-label">drafts</div></div>
</div>
{% if model.flags %}
<details class="panel" id="data-quality">
<summary>Data quality flags ({{ model.flags|length }})</summary>
<ul>
{% for flag in model.flags %}
<li><code>{{ flag.code }}</code> {{ flag.message }}</li>
{% endfor %}
</ul>
</details>
{% endif %}
</section>
<section>
<div id="filter-row">
<button type="button" class="active" data-filter-group="status" data-filter-value="">All statuses</button>
{% for status in ['in-progress', 'mapped', 'planned', 'deprecated'] %}
<button type="button" data-filter-group="status" data-filter-value="{{ status }}">{{ status }}</button>
{% endfor %}
<button type="button" class="active" data-filter-group="category" data-filter-value="">All categories</button>
<input type="search" class="js-search" data-target="catalog-rows" placeholder="Search technologies">
</div>
<div class="table-wrap">
<table>
<thead><tr><th>Technology</th><th>Vendor</th><th>Category</th><th>Status</th><th>Priority</th><th>Datasets</th><th>Alerting coverage</th></tr></thead>
<tbody id="catalog-rows">
{% for view in model.technologies %}
<tr data-search="{{ (view.entry.name ~ ' ' ~ view.entry.vendor ~ ' ' ~ view.entry.id)|lower }}" data-status="{{ view.entry.status }}" data-category="{{ view.entry.category }}">
<td>{% if view.doc %}<a href="tech/{{ view.entry.id }}.html">{{ view.entry.name }}</a>{% else %}{{ view.entry.name }}{% endif %}{% if view.draft %} <span class="badge badge-draft">DRAFT</span>{% endif %}</td>
<td>{{ view.entry.vendor }}</td>
<td><span class="chip">{{ view.entry.category }}</span></td>
<td><span class="badge badge-status-{{ view.entry.status }}">{{ view.entry.status }}</span></td>
<td>{{ view.entry.priority }}</td>
<td>{{ view.datasets|length }}</td>
<td>{% if view.required_total %}<div class="coverage"><div class="coverage-fill" style="width:{{ view.required_pct }}%"></div></div> {{ view.required_pct }}%{% else %}<span class="missing">&mdash;</span>{% endif %}</td>
</tr>
{% endfor %}
</tbody>
</table>
</div>
</section>
{% endblock %}
