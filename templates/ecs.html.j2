{% extends "base.html.j2" %}
{% block title %}ECS index — Data maps{% endblock %}
{% macro dataset_chips(rows, cls) %}
{% for d in rows %}
<a class="chip {{ cls }}" href="tech/{{ d.tech }}.html#ds-{{ d.dataset }}">{{ d.tech }}/{{ d.dataset }}</a>
{% else %}
<span class="meta">&mdash;</span>
{% endfor %}
{% endmacro %}
{% block content %}
{% set pairs = [] %}
{% for t in model.technologies %}
{% for d in t.datasets %}
{% set _ = pairs.append((t.entry.id ~ "/" ~ d.data.id,
                         d.data.event_categories|join(" "))) %}
{% endfor %}
{% endfor %}
{% set dataset_categories = dict(pairs) %}
{% set usage_statuses = [] %}
{% for entry in model.ecs_index %}
{% for usage in entry.usages %}
{% if usage.status not in usage_statuses %}
{% set _ = usage_statuses.append(usage.status) %}
{% endif %}
{% endfor %}
{% endfor %}
<section>
<h2>Alerting coverage by category ({{ model.alerting_matrix|length }})</h2>
<p class="meta">What each alerting profile would receive if every dataset in its category were onboarded on the format this site recommends. Open a category for the field-by-field reading; a dataset in the Partial column maps the field but not to a value the profile can alert on.</p>
{% for cat in model.alerting_matrix %}
{% set covered = cat.required|selectattr("satisfied")|list|length %}
<details class="panel matrix-category" data-category="{{ cat.category }}">
<summary>{{ cat.category }} &mdash; {{ covered }} of {{ cat.required|length }} required fields satisfied by at least one dataset; {{ cat.datasets }} datasets, {{ cat.all_satisfied }} satisfy all</summary>
<div class="table-wrap">
<table>
<thead><tr>
<th>Required field</th>
<th>Satisfied ({{ cat.required|map(attribute="satisfied")|map("length")|sum }})</th>
<th>Partial ({{ cat.required|map(attribute="partial")|map("length")|sum }})</th>
<th>Missing ({{ cat.required|map(attribute="missing")|map("length")|sum }})</th>
</tr></thead>
<tbody>
{% for row in cat.required %}
<tr>
<td class="mono">{{ row.field }}</td>
<td>{{ dataset_chips(row.satisfied, "chip-satisfied") }}</td>
<td>{{ dataset_chips(row.partial, "chip-partial") }}</td>
<td>{{ dataset_chips(row.missing, "chip-gap") }}</td>
</tr>
{% endfor %}
</tbody>
</table>
</div>
</details>
{% endfor %}
</section>
<section>
<h2>Unmapped required fields ({{ model.unmapped_required|length }})</h2>
<p class="meta">Fields some alerting profile requires that no dataset currently maps.</p>
<div class="chips">
{% for name in model.unmapped_required %}
<span class="chip chip-gap mono">{{ name }}</span>
{% endfor %}
</div>
</section>
{% if model.closable_required %}
<section>
<h2>Closable by switching format ({{ model.closable_required|length }})</h2>
<p class="meta">Nothing maps these on the recommended formats, but another documented export format of the same dataset does &mdash; an export setting away, not a coverage gap.</p>
<div class="chips">
{% for name in model.closable_required %}
<span class="chip chip-gap mono">{{ name }}</span>
{% endfor %}
</div>
</section>
{% endif %}
<section>
<h2>ECS fields in use ({{ model.ecs_index|length }})</h2>
<p class="meta">Every documented format contributes a usage here, not only the recommended one, so the answer to &ldquo;who can give me this field&rdquo; includes the entry a device would have to be switched to. Each chip names the format it was read from, so two entries of the same dataset are told apart; the page opens on the recommended formats alone, and the toggle shows the rest.</p>
<div id="filter-row">
<span class="filter-label">Category</span>
<button type="button" class="active" data-usage-group="category" data-filter-value="">All</button>
{% for category in model.profiles %}
<button type="button" data-usage-group="category" data-filter-value="{{ category }}">{{ category }}</button>
{% endfor %}
<span class="filter-label">Status</span>
<button type="button" class="active" data-usage-group="status" data-filter-value="">All</button>
{% for status in ["mapped", "partial", "unmapped"] if status in usage_statuses %}
<button type="button" data-usage-group="status" data-filter-value="{{ status }}">{{ status }}</button>
{% endfor %}
<button type="button" class="active" id="recommended-only" data-usage-toggle="recommended" aria-pressed="true">recommended format only</button>
<input type="search" class="js-search" data-target="ecs-rows" placeholder="Search ECS fields">
<span class="meta" id="ecs-row-count"></span>
</div>
<div class="table-wrap">
<table class="ecs-usage">
<thead><tr><th>ECS field</th><th>Type</th><th>Description</th><th>Populated by</th></tr></thead>
<tbody id="ecs-rows">
{% for entry in model.ecs_index %}
<tr data-search="{{ entry.name|lower }}">
<td class="mono">{{ entry.name }}
{% if entry.required_in %}
<span class="badge badge-required" title="required by the alerting profile for: {{ entry.required_in|join(', ') }}">required: {{ entry.required_in|join(', ') }}</span>
{% endif %}
</td>
<td>{{ entry.type }}</td>
<td>{{ entry.short }}</td>
<td>
{% for usage in entry.usages %}
<a href="tech/{{ usage.tech.id }}.html#ds-{{ usage.dataset }}" class="chip usage-chip{% if usage.recommended %} chip-recommended{% endif %}" data-category="{{ dataset_categories.get(usage.tech.id ~ '/' ~ usage.dataset, '') }}" data-status="{{ usage.status }}" data-format="{{ usage.format }}"{% if usage.recommended %} data-recommended="1"{% endif %} title="{% if usage.recommended %}recommended format: {% endif %}{{ usage.format }}">{{ usage.tech.id }}/{{ usage.dataset }}: <span class="mono">{{ usage.vendor }}</span> ({{ usage.format }}, {{ usage.status }})</a>
{% endfor %}
</td>
</tr>
{% endfor %}
</tbody>
</table>
</div>
</section>
{% endblock %}
